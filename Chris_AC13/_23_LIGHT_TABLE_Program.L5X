<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER LIGHT TABLE AUTO
******************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[22],500) ,XIC(MAJOR_FAULT[22]) ][EQU(STEP_AUTO[5],500) ,XIC(MAJOR_FAULT[5]) ]MOV(500,STEP_AUTO[23]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INITIATE LIGHT TABLE CHECK AT STARTUP]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[23],0)[XIO(CELL_DRY_CYCLE_MODE_PB) XIO(CELL_BAG_TEST_PICK_MODE_PB) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) [OTL(PNP_BAR_PRES_LT_CHECK) ,MOV(10,STEP_AUTO[23]) ] ,[XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ,XIC(CELL_BAG_TEST_PICK_MODE_PB) ] MOV(500,STEP_AUTO[23]) ,XIC(CELL_DRY_CYCLE_MODE_PB) MOV(40,STEP_AUTO[23]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WAIT FOR PICK-N-PLACE AND ROBOT TO CLEAR LIGHT TABLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],10)XIC(PNP_BASE_CLEAR_LT_TBL)XIC(R2:I.Data[0].27)MOV(20,STEP_AUTO[23]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[VERIFY HANDSHAKES ARE OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],20)XIO(R2:I.Data[1].10)XIO(R2:I.Data[1].11)MOV(30,STEP_AUTO[23]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[REQUEST LIGHT TABLE EMPTY CHECK TO BARRIER LOAD/ BAG OFFLOAD ROBOT (R2)]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],30)[OTE(LT_TBL_EMPTY_VIS_REQ) ,[TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) MOV(812,STEP_ALARM[23]) ] ,[XIC(R2:I.Data[1].10) MOV(40,STEP_AUTO[23]) ,XIC(R2:I.Data[1].11) [XIC(PNP_BAR_PRES_LT_CHECK) MOV(50,STEP_AUTO[23]) ,XIO(PNP_BAR_PRES_LT_CHECK) [OTL(LT_TBL_EMPTY_VIS_FAIL) ,MOV(90,STEP_AUTO[23]) ] ] ] OTU(PNP_BAR_PRES_LT_CHECK) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[REQUEST BARRIER FROM PICK-N-PLACE
CHECK FOR PICK-N-PLACE EMPTY COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],40)[XIO(CELL_EMPTY_COMPLETE.1) [XIC(R2:I.Data[0].27) OTE(PNP_BARRIER_PLACE_REQ) ,XIC(PNP_BARRIER_PRESENT_ON_LT_TBL) [XIO(CELL_DRY_CYCLE_MODE_PB) MOV(50,STEP_AUTO[23]) ,XIC(CELL_DRY_CYCLE_MODE_PB) MOV(80,STEP_AUTO[23]) ] ] ,XIC(CELL_EMPTY_COMPLETE.1) [OTL(CELL_EMPTY_COMPLETE.2) ,MOV(500,STEP_AUTO[23]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR PICK-N-PLACE TO BE CLEAR OF LIGHT TABLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],50)XIC(PNP_BASE_CLEAR_LT_TBL)XIC(R2:I.Data[0].27)MOV(55,STEP_AUTO[23]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[VERIFY HANDSHAKES ARE OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],55)XIO(R2:I.Data[1].14)XIO(R2:I.Data[1].15)MOV(58,STEP_AUTO[23]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[REQUEST BARRIER PRESENCE VISION CHECK BARRIER LOAD/ BAG OFFLOAD ROBOT (R2)]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],58)[XIO(LT_TBL_VAC_ON_PB) MOV(90,STEP_AUTO[23]) ,XIC(LT_TBL_VAC_ON_PB) XIO(PNP_BARRIER_ON_LT_TBL_COR_REJECT) OTE(LT_TBL_BARRIER_PRES_VIS_REQ) ,XIC(R2:I.Data[1].14) MOV(60,STEP_AUTO[23]) ,[XIC(R2:I.Data[1].15) ,XIC(PNP_BARRIER_ON_LT_TBL_COR_REJECT) ] [XIO(CELL_SINGLE_PART_MODE_ACTIVE) [OTL(LT_TBL_BARRIER_PRES_VIS_FAIL) ,MOV(90,STEP_AUTO[23]) ] ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) MOV(426,STEP_ALARM[23]) ] OTU(PNP_BARRIER_PRESENT_ON_LT_TBL) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[VERIFY HANDSHAKES ARE OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],60)XIO(R2:I.Data[1].0)XIO(R2:I.Data[1].1)XIO(R2:I.Data[0].22)MOV(70,STEP_AUTO[23]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[REQUEST BARRIER VISION CHECK BARRIER LOAD ROBOT (R2)]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],70)[OTE(LT_TBL_BARRIER_LOC_VIS_REQ) ,XIC(R2:I.Data[1].0) [MOV(0,BAG_OFFLOAD_CTR_BARRIER_VIS_REJECT) ,RES(BAG_OFFLOAD_BARRIER_VIS_REJECT_MULTI_CNT) ,MOV(80,STEP_AUTO[23]) ] ,XIC(R2:I.Data[1].1) [XIO(CELL_SINGLE_PART_MODE_ACTIVE) [[CTU(BAG_OFFLOAD_BARRIER_VIS_REJECT_CNT,?,?) ,ADD(CELL_DATA_COLLECTION[7],1,CELL_DATA_COLLECTION[7]) ,MOV(1,BAG_OFFLOAD_CTR_BARRIER_VIS_REJECT) ,OTL(LT_TBL_BARRIER_LOC_VIS_FAIL) ,MOV(90,STEP_AUTO[23]) ] ,[CTU(BAG_OFFLOAD_BARRIER_VIS_REJECT_MULTI_CNT,?,?) ,GEQ(BAG_OFFLOAD_BARRIER_VIS_REJECT_MULTI_CNT.ACC,BAG_OFFLOAD_BARRIER_VIS_REJECT_ALLOWED) [MOV(2,BAG_OFFLOAD_CTR_BARRIER_VIS_REJECT) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ] ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) MOV(427,STEP_ALARM[23]) ] OTU(PNP_BARRIER_PRESENT_ON_LT_TBL) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[REQUEST BARRIER PICK TO ROBOT FROM LIGHT TABLE
WHEN MAIN DIAL IS IN POSITION AND THERE IS NO BARRIER DETECTED]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_AUTO[23],80) XIC(MAIN_DIAL_IN_POSITION) XIC(PNP_BASE_CLEAR_LT_TBL) [XIO(BARRIER_LOAD_BARRIER_PRESENT) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] XIO(BARRIER_LOAD_DATA_BAR_LOADED) [[LIM(20,STEP_AUTO[20],30) XIO(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIC(CELL_SINGLE_PART_PROCESS_PB) XIO(CELL_SINGLE_PART_MODE_BARRIER_COUNTER.DN) ] OTE(PNP_BARRIER_PICK_REQ) ,XIC(R2:I.Data[0].22) [OTU(PNP_BARRIER_PRESENT_ON_LT_TBL) ,OTU(LT_TBL_VAC_ON_PB) ,OTL(R2_BARRIER_PASSED) ,XIO(CELL_DRY_CYCLE_MODE_PB) MOV(10,STEP_AUTO[23]) ,XIC(CELL_DRY_CYCLE_MODE_PB) MOV(40,STEP_AUTO[23]) ] ] ,XIO(CELL_DRY_CYCLE_MODE_PB) XIO(R2_BARRIER_VAC_ON) [TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) ONS(ONS_ARRAY[0]) OTU(R2_BARRIER_PASSED) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[VERIFY HANDSHAKES ARE OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],90)XIO(R2:I.Data[1].12)XIO(R2:I.Data[1].13)XIO(R2:I.Data[0].22)MOV(100,STEP_AUTO[23]);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[REQUEST FAILED BARRIER VISION CHECK BARRIER LOAD/ BAG OFFLOAD ROBOT (R2)
FOR BARRIER REMOVAL FROM LIGHT TABLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],100)[OTE(LT_TBL_BARRIER_REM_VIS_REQ) ,XIC(R2:I.Data[1].12) [OTU(LT_TBL_EMPTY_VIS_FAIL) ,OTU(LT_TBL_BARRIER_PRES_VIS_FAIL) ,OTU(LT_TBL_BARRIER_LOC_VIS_FAIL) ,MOV(110,STEP_AUTO[23]) ] ,XIC(R2:I.Data[1].13) [XIC(LT_TBL_EMPTY_VIS_FAIL) MOV(428,STEP_ALARM[23]) ,XIC(LT_TBL_BARRIER_PRES_VIS_FAIL) MOV(424,STEP_ALARM[23]) ,XIC(LT_TBL_BARRIER_LOC_VIS_FAIL) MOV(425,STEP_ALARM[23]) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[REQUEST FAILED BARRIER PICK TO ROBOT FROM LIGHT TABLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[23],110)[OTE(PNP_FAILED_BARRIER_PICK_REQ) ,XIC(R2:I.Data[0].22) [XIC(PNP_BARRIER_ON_LT_TBL_COR_REJECT) CTU(BAG_OFFLOAD_BARRIER_COR_REJECT_CNT,?,?) ,OTU(LT_TBL_VAC_ON_PB) ,OTU(PNP_BARRIER_ON_LT_TBL_COR_REJECT) ,MOV(10,STEP_AUTO[23]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER LIGHT TABLE E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[23],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[23]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[23],1000) EQU(STEP_ALARM_CAPTURE[23],0) MOV(STEP_ALARM[23],STEP_ALARM_CAPTURE[23]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[23],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.23) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[23],1000)[NEQ(STEP_ALARM[23],0) OTE(MAJOR_FAULT[23]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[23],STEP_AUTO_RET_ESTOP[23]) ,OTU(PNP_BARRIER_ON_LT_TBL_COR_REJECT) ,OTU(LT_TBL_EMPTY_VIS_FAIL) OTU(LT_TBL_BARRIER_PRES_VIS_FAIL) OTU(LT_TBL_BARRIER_LOC_VIS_FAIL) ,MOV(0,MAN04:O.Data[0]) ,MOV(1000,STEP_AUTO[23]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[23],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[23]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[23],10)[MOV(0,STEP_ALARM[23]) ,MOV(0,STEP_ALARM_CAPTURE[23]) ,MOV(20,STEP_ESTOP_RESET[23]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[23],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_AUTO[23]) ,MOV(500,STEP_ESTOP_RESET[23]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[23]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER LIGHT TABLE HMI
***************************************************************************
]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)OTE(LT_TBL_BLOW_OFF_PB_VIS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN 
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(AUTO,0) ,JSR(ESTOP_RESET,0) ,JSR(HMI,0) ,JSR(PRESSURE_REG,0) ,JSR(OUTPUTS,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[LIGHT TABLE OUTPUTS
*******************************************************************************

LIGHT TABLE VACUUM CONTROL]]>
</Comment>
<Text>
<![CDATA[[[XIC(LT_TBL_VAC_ON_PB) ,XIC(R2:I.Data[1].2) ] OTE(MAN04:O.Data[2].9) ,[NEQ(STEP_ESTOP_RESET[0],1000) XIC(CELL_TOOL_CHANGE_REQ_PB) ,XIO(CELL_MANUAL_MODE) XIO(LT_TBL_VAC_ACTIVE_PB) ] OTU(LT_TBL_VAC_ON_PB) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INITIAL RECIPE SETTING OF LIGHT TABLE VACUUM FUNCTION]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) [OTU(LT_TBL_VAC_ACTIVE_PB) ,OTU(LT_TBL_VAC_ACTIVE_RECIPE) ] ,XIC(LT_TBL_VAC_ACTIVE_RECIPE) ONS(ONS_ARRAY[2]) OTL(LT_TBL_VAC_ACTIVE_PB) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[LIGHT TABLE MANUAL BARRIER BLOW OFF]]>
</Comment>
<Text>
<![CDATA[XIC(LT_TBL_BLOW_OFF_PB)OTE(MAN02:O.Data[4].8);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PRESSURE_REG" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[LIGHT TABLE VACUUM SUPPLY PRESSURE REGULATOR
*******************************************************************************

ADD OPERATOR ADJUSTMENT TO PRESSURE SETPOINT]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[LIM(LT_TBL_VAC_PRESSURE_MAX,PRESSURE_SP_AUTO,LT_TBL_VAC_PRESSURE_MIN) MOV(0,LT_TBL_VAC_ADJ_PRESSURE) ,ADD(LT_TBL_VAC_PRESSURE_RECIPE_SP,LT_TBL_VAC_ADJ_PRESSURE,PRESSURE_SP_AUTO) ,ADD(LT_TBL_VAC_PRESSURE_RECIPE_SP,LT_TBL_VAC_ADJ_PRESSURE,LT_TBL_VAC_PRESSURE_SP_AUTO_DISPLAY) ,MOV(PRESSURE_SP_AUTO,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CACULATE OPERATERS MAXIMUM  & MINIMUM ALLOWABLE SETPOINT ADJUSTMENT BASED ON RECIPE PRESSURE
]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[[SUB(LT_TBL_VAC_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,LT_TBL_VAC_PRESSURE_MIN) ,LES(LT_TBL_VAC_PRESSURE_MIN,PRESSURE_MIN_ALLOWED) MOV(PRESSURE_MIN_ALLOWED,LT_TBL_VAC_PRESSURE_MIN) ] ,[ADD(LT_TBL_VAC_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,LT_TBL_VAC_PRESSURE_MAX) ,GRT(LT_TBL_VAC_PRESSURE_MAX,PRESSURE_MAX_ALLOWED) MOV(PRESSURE_MAX_ALLOWED,LT_TBL_VAC_PRESSURE_MAX) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IF RECIPE VALUE CHANGES ZERO OUT OFFSET ADJUST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)MOV(0,LT_TBL_VAC_ADJ_PRESSURE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****MANUAL MODE****

SET PRESSURE SETPOINT FOR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)ONS(ONS_ARRAY[5])MOV(PRESSURE_SP_AUTO,LT_TBL_VAC_PRESSURE_SP_MAN_DISPLAY);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WHILE IN MANUAL MODE, ALLOW THE PRESSURE SLIDERS FULL SCALE OF OPERATION.]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[MUL(LT_TBL_VAC_PRESSURE_SP_MAN_DISPLAY,1,PRESSURE_SP_MAN) ,MOV(PRESSURE_MIN_ALLOWED,LT_TBL_VAC_PRESSURE_MIN) ,MOV(PRESSURE_MAX_ALLOWED,LT_TBL_VAC_PRESSURE_MAX) ,MOV(PRESSURE_SP_MAN,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SEND REGULATOR PRESSURE INPUT COUNTS

SCALE, TRUNCATE AND BYTE SWAP]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[23],1000) XIC(CELL_PRESSURE_OK) XIO(CELL_SAFETY_DOOR_OPEN) [MUL(PRESSURE_SP_GEN,LT_TBL_VAC_PRES_SCALE_PAR.OUT_M,PRESSURE_WITH_M_DONE) ,ADD(PRESSURE_WITH_M_DONE,LT_TBL_VAC_PRES_SCALE_PAR.OUT_B,SCALED_PRESSURE) ,XIC(MAN04:O.Data[2].9) TRN(SCALED_PRESSURE,MAN04:O.Data[0]) ] ,XIO(MAN04:O.Data[2].9) MOV(0,MAN04:O.Data[0]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CACULATE FEEDBACK PRESSURE FROM REGULATOR]]>
</Comment>
<Text>
<![CDATA[[MOV(MAN04:I.Data[0],REG_FEEDBACK) ,SUB(REG_FEEDBACK,LT_TBL_VAC_PRES_SCALE_PAR.IN_B,REG_FEEDBACK_M) ,DIV(REG_FEEDBACK_M,LT_TBL_VAC_PRES_SCALE_PAR.IN_M,REG_FEEDBACK_SCALED) CPT(REG_FEEDBACK_SCALED,REG_FEEDBACK_M/LT_TBL_VAC_PRES_SCALE_PAR.IN_M) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[VERIFY FORM PRESSURE USING REGULATOR FEEDBACK]]>
</Comment>
<Text>
<![CDATA[CMP(LT_TBL_VAC_PRESSURE_SP_AUTO_DISPLAY-PRESSURE_DELTA_ALLOWED<REG_FEEDBACK_SCALED)OTE(LT_TBL_VAC_PRESSURE_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
