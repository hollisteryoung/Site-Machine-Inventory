</Tags>
<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[VISION INSPECTION STATION AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[18]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[18],0)[XIC(CELL_STARTED) [XIO(RUN_PROCESS) MOV(5,STEP_AUTO[18]) ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[18]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(VISION_CYCLE_PB) MOV(20,STEP_AUTO[18]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[18],5)[OTE(VISION_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[18]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIO(CELL_EMPTY_COMPLETE.13) XIC(VISION_DATA_BAG_LOADED) XIO(VISION_DATA_BAG_REJECT) [XIC(VISION_DATA_GLUE_COMPLETE) ,XIO(GLUE_ACTIVE_RECIPE_LOADED) ] [XIC(VISION_DATA_PNC_COMPLETE) ,XIO(PNC_ACTIVE_RECIPE_LOADED) ] XIC(VISION_ACTIVE_PB) XIO(VISION_DATA_VISION_COMPLETE) OTE(RUN_PROCESS) ,XIC(VISION_DATA_BAG_LOADED) XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIC(CELL_SINGLE_PART_GLUE_ONLY_PB) [MOV(500,STEP_AUTO[18]) ,MOV(897,STEP_ALARM[18]) ] ,EQU(STEP_AUTO[18],10) [XIC(RUN_PROCESS) OTL(CAM04:O1.Data[0].0) MOV(20,STEP_AUTO[18]) ,XIO(RUN_PROCESS) MOV(150,STEP_AUTO[18]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[TRIGGER CAMERA]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[18],20)XIC(CELL_OVERHEAD_LIGHTS_OFF)XIC(VISION_TRIGGER_READY)[TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) OTL(VISION_TRIGGER_ON_PB) ,TON(TIMER_OPER[1],?,?) ,XIC(TIMER_OPER[1].DN) XIC(CAM04:I1.Data[0].1) [OTU(VISION_TRIGGER_ON_PB) ,MOV(40,STEP_AUTO[18]) ] ,XIO(CAM04:I1.Data[0].1) [TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) MOV(220,STEP_ALARM[18]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR INSPECTION PROCESS TO COMPLETE AND DELAY]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[18],40)[XIC(CAM04:I1.Data[1].3) XIC(VISION_TRIGGER_READY) [TON(TIMER_OPER[0],?,?) ,XIC(TIMER_OPER[0].DN) MOV(80,STEP_AUTO[18]) ] ,[TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) MOV(221,STEP_ALARM[18]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR VISION COMPLETE AND ANALYZE RESULTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[18],80)[XIC(CELL_STARTED) [XIC(VISION_PASSED) CTU(Vision_Pass_CNT,?,?) OTL(VISION_DATA_VISION_PASS) ,OTL(VISION_DATA_VISION_COMPLETE) ,MOV(150,STEP_AUTO[18]) ] ,XIC(CELL_MANUAL_MODE) XIC(VISION_CYCLE_PB) [OTU(VISION_CYCLE_PB) ,MOV(0,STEP_AUTO[18]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[18],150)[[OTL(VISION_PROCESS_DONE) ,OTU(CAM04:O1.Data[0].0) ] ,XIC(CELL_EMPTY_COMPLETE.12) XIC(VISION_DATA_EMPTY_LAST_BAG) OTL(CELL_EMPTY_COMPLETE.13) ,TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) MOV(160,STEP_AUTO[18]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[18],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(VISION_PROCESS_DONE) ,MOV(5,STEP_AUTO[18]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CAMERA TRIGGER ACK ALARM]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_AUTO[18],40) ,EQU(STEP_AUTO[18],70) ][TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) MOV(220,STEP_ALARM[18]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[VISION COMPLETE TIMEOUT ALARM]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_AUTO[18],20) ,EQU(STEP_AUTO[18],60) ][TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(221,STEP_ALARM[18]) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[BLUE VISION LIGHT CONTROL]]>
</Comment>
<Text>
<![CDATA[AFI()[NEQ(STEP_ESTOP_RESET[0],1000) XIO(CELL_MANUAL_MODE) [XIC(VISION_ACTIVE_PB) OTL(VISION_BLUE_LIGHT_ON_PB) ,XIO(VISION_ACTIVE_PB) OTU(VISION_BLUE_LIGHT_ON_PB) ] ,XIC(VISION_BLUE_LIGHT_ON_PB) OTE(Local:2:O.Pt09.Data) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[VISION INSPECTION STATION E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[18],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[18]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[18],1000) EQU(STEP_ALARM_CAPTURE[18],0) MOV(STEP_ALARM[18],STEP_ALARM_CAPTURE[18]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[18],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.18) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[18],1000)[NEQ(STEP_ALARM[18],0) OTE(MAJOR_FAULT[18]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[18],STEP_AUTO_RET_ESTOP[18]) ,OTU(CAM04:O1.Data[0].0) ,OTU(VISION_CYCLE_PB) ,OTU(VISION_JOB_LOAD_PB) ,OTU(VISION_TRIGGER_ON_PB) ,OTU(VISION_PROCESS_DONE) ,MOV(1000,STEP_HOME[18]) ,MOV(1000,STEP_AUTO[18]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[18],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[18]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[18],10)[MOV(0,STEP_ALARM[18]) ,MOV(0,STEP_ALARM_CAPTURE[18]) ,MOV(20,STEP_ESTOP_RESET[18]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[18],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[18]) ,MOV(30,STEP_ESTOP_RESET[18]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[18]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[18],30)EQU(STEP_HOME[18],500)MOV(500,STEP_ESTOP_RESET[18]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[VISION INSPECTION STATION HMI
***************************************************************************

PUSH BUTTONS ON HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)XIC(CELL_MANUAL_MODE)[XIO(VISION_ONLINE) OTE(VISION_JOB_LOAD_PB_VIS) ,XIC(VISION_ONLINE) XIC(VISION_TRIGGER_READY) OTE(VISION_TRIGGER_ON_PB_VIS) ,OTE(VISION_ACTIVE_PB_VIS) ,OTE(VISION_BLUE_LIGHT_VIS) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[VISION INSPECTION COMPLETE STATUS
]]>
</Comment>
<Text>
<![CDATA[XIC(VISION_TRIGGER_READY)OTE(VISION_COMPLETE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(VISION_ACTIVE_PB)XIC(CELL_TIMING_BIT_1000)OTE(VISION_BYPASS_ANIMATION);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[VISION INSPECTION STATION HOME ROUTINE
***************************************************************************


SEE IF VISION IS ACTIVE OR BYPASSED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[18],0)[XIC(VISION_ACTIVE_PB) MOV(10,STEP_HOME[18]) ,XIO(VISION_ACTIVE_PB) MOV(40,STEP_HOME[18]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[TRANSFER RECIPE HOLE AND PRINT SIZE TO CAMERA
]]>
</Comment>
<Text>
<![CDATA[AFI()EQU(STEP_HOME[18],5)[MOV(VISION_PRINT_SKU_DINT,VS_O.InspectionParameters.InspectionParameter004) ,MOV(VISION_HOLE_SIZE_RECIPE,VS_O.InspectionParameters.InspectionParameter000) ,MOV(VISION_PRINT_SIZE_RECIPE,VS_O.InspectionParameters.InspectionParameter001) ,XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) MOV(1,VS_O.InspectionParameters.InspectionParameter002) ,XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) MOV(0,VS_O.InspectionParameters.InspectionParameter002) ,XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) MOV(1,VS_O.InspectionParameters.InspectionParameter003) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) MOV(0,VS_O.InspectionParameters.InspectionParameter003) ]MOV(10,STEP_HOME[18]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[PLACE CAMERA ONLINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[18],10)[OTL(VISION_ONLINE_PB) ,XIC(VISION_ONLINE) [NEQ(VISION_PROG_NUM_RECIPE_LOADED,VISION_JOB_LOADED) MOV(20,STEP_HOME[18]) ,EQU(VISION_PROG_NUM_RECIPE_LOADED,VISION_JOB_LOADED) MOV(30,STEP_HOME[18]) ] ,AFI() [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) MOV(218,STEP_ALARM[18]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[LOAD JOB IN VISION CAMERA]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[18],20)[OTU(VISION_ERROR_RESET_PB) ,OTL(VISION_JOB_LOAD_PB) ,XIC(VISION_JOB_LOAD_COMPLETE) XIC(VISION_JOB_MATCH) XIO(VISION_JOB_LOAD_FAILED) [OTU(VISION_JOB_LOAD_PB) ,OTU(VISION_SKU_LOAD_PB) ,MOV(30,STEP_HOME[18]) ] ,[TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [XIO(VISION_JOB_LOAD_COMPLETE) XIC(VISION_JOB_LOAD_FAILED) MOV(216,STEP_ALARM[18]) ,XIC(VISION_JOB_LOAD_COMPLETE) MOV(217,STEP_ALARM[18]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ENABLE VISION CAMERA TRIGGER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[18],30)[OTL(CAM04:O1.Data[0].0) ,XIC(VISION_TRIGGER_READY) MOV(40,STEP_HOME[18]) ,[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(219,STEP_ALARM[18]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[18],40)[MOV(0,STEP_AUTO[18]) ,MOV(500,STEP_HOME[18]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[REMOVE DASH FROM RECIPE SKU FOR VISION OCR
]]>
</Comment>
<Text>
