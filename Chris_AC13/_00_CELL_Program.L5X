<Text>
<![CDATA[[XIC(CELL_ZERO_COUNTERS_PB) ,XIC(CELL_RECIPE_LOAD_COMPLETE) ][RES(PREHEAT1_INC_CYCLE_REJECT_CNT) MOV(0,PREHEAT1_CTR_INC_CYCLE) MOV(0,PREHEAT1_PREV_INC_CYCLE_REJECT_CNT) ,RES(PREHEAT1_UP_TEMP_REJECT_CNT) MOV(0,PREHEAT1_CTR_UP_TEMP) MOV(0,PREHEAT1_PREV_UP_TEMP_REJECT_CNT) ,RES(PREHEAT1_LOW_TEMP_REJECT_CNT) MOV(0,PREHEAT1_CTR_LOW_TEMP) MOV(0,PREHEAT1_PREV_LOW_TEMP_REJECT_CNT) ,RES(PREHEAT2_INC_CYCLE_REJECT_CNT) MOV(0,PREHEAT2_CTR_INC_CYCLE) MOV(0,PREHEAT2_PREV_INC_CYCLE_REJECT_CNT) ,RES(PREHEAT2_UP_TEMP_REJECT_CNT) MOV(0,PREHEAT2_CTR_UP_TEMP) MOV(0,PREHEAT2_PREV_UP_TEMP_REJECT_CNT) ,RES(PREHEAT2_LOW_TEMP_REJECT_CNT) MOV(0,PREHEAT2_CTR_LOW_TEMP) MOV(0,PREHEAT2_PREV_LOW_TEMP_REJECT_CNT) ,RES(FORMING_PRESSURE_REJECT_CNT) MOV(0,FORMING_CTR_PRESSURE) MOV(0,FORMING_PREV_PRESSURE_REJECT_CNT) ,RES(FORMING_INC_CYCLE_REJECT_CNT) MOV(0,FORMING_CTR_INC_CYCLE) MOV(0,FORMING_PREV_INC_CYCLE_REJECT_CNT) ,RES(PUNCH_INC_CYCLE_REJECT_CNT) MOV(0,PUNCH_CTR_INC_CYCLE) MOV(0,PUNCH_PREV_INC_CYCLE_REJECT_CNT) ,RES(INKJET_PRINT_INC_CYCLE_REJECT_CNT) MOV(0,INKJET_PRINT_CTR_INC_CYCLE) MOV(0,INKJET_PRINT_PREV_INC_CYCLE_REJECT_CNT) ,RES(PRINT_INC_CYCLE_REJECT_CNT) MOV(0,PRINT_CTR_INC_CYCLE) MOV(0,PRINT_PREV_INC_CYCLE_REJECT_CNT) ,RES(GLUE_OUT_PRESSURE_REJECT_CNT) MOV(0,GLUE_OUT_CTR_PRESSURE) MOV(0,GLUE_OUT_PREV_PRESSURE_REJECT_CNT) ,RES(GLUE_OPEN_TIME_REJECT_CNT) MOV(0,GLUE_CTR_OPEN_TIME) MOV(0,GLUE_PREV_OPEN_TIME_REJECT_CNT) ,RES(GLUE_INC_CYCLE_REJECT_CNT) MOV(0,GLUE_CTR_INC_CYCLE) MOV(0,GLUE_PREV_INC_CYCLE_REJECT_CNT) ,RES(PNC_PRESSURE_REJECT_CNT) MOV(0,PNC_CTR_PRESSURE) MOV(0,PNC_PREV_PRESSURE_REJECT_CNT) ,RES(PNC_OPEN_TIME_REJECT_CNT) MOV(0,PNC_CTR_OPEN_TIME) MOV(0,PNC_PREV_OPEN_TIME_REJECT_CNT) ,RES(PNC_BAG_TAIL_REJECT_CNT) MOV(1,PNC_CTR_BAG_TAIL) MOV(0,PNC_BAG_TAIL_REJECT_MULT_CNT.ACC) ,RES(VISION_REJECT_CNT) MOV(0,VISION_CTR_REJECT_CYCLE) MOV(0,VISION_PREV_REJECT_CNT) ,RES(BAG_OFFLOAD_BARRIER_REJECT_CNT) MOV(0,BAG_OFFLOAD_CTR_BARRIER_REJECT) MOV(0,BAG_OFFLOAD_PREV_BARRIER_REJECT_CNT) ,RES(BAG_OFFLOAD_BARRIER_VIS_REJECT_CNT) MOV(0,BAG_OFFLOAD_CTR_BARRIER_VIS_REJECT) MOV(0,BAG_OFFLOAD_PREV_BARRIER_VIS_REJECT_CNT) ,RES(BAG_OFFLOAD_BARRIER_COR_REJECT_CNT) ,RES(BAG_OFFLOAD_BAG_REJECT_CNT) MOV(0,BAG_OFFLOAD_CTR_BAG_REJECT) MOV(0,BAG_OFFLOAD_PREV_BAG_REJECT_CNT) ,MOV(0,OFFLOAD_CONV_GOOD_PARTS) ];]]>
