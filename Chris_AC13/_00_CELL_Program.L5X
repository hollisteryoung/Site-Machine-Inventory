<Routine Name="DATA_COLLECTION" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CUSTOMER DATA COLLECTION
***************************************************************************

SET CELL STATUS

0=READY TO RESET
1=NOT READY TO RESET
2=RUNNING IN AUTO
3=PLEASE WAIT
4=READY TO START
5=MANUAL MODE
6=ROBOT MANUAL MODE
7=E-STOP ACTIVE
8=SHUTDOWN IN PROGRESS
9=ROBOT MODE
10=ROLLOVER CAL MODE
]]>
</Comment>
<Text>
<![CDATA[MOV(CELL_STATUS,CELL_DATA_COLLECTION[1]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[AUTO MODE]]>
</Comment>
<Text>
<![CDATA[EQU(CELL_STATUS,2)OTE(CELL_DATA_COLLECTION[29].0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CELL ALARM NUMBER]]>
</Comment>
<Text>
<![CDATA[MOV(STEP_ALARM[0],CELL_DATA_COLLECTION[2]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[CELL CYCLES]]>
</Comment>
<Text>
<![CDATA[MOV(CELL_CYCLES,CELL_DATA_COLLECTION[3]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[RESET DATA COLLECTION COUNTERS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_DATA_COLLECTION[0].0)[FLL(0,CELL_DATA_COLLECTION[4],26) ,OTU(CELL_DATA_COLLECTION[0].0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DATE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CELL DATE
***************************************************************************

GATHER AND SET PLC DATE & TIME]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SET_DATE_TIME_PB) GSV(WallClockTime,,LocalDateTime,CELL_PLC_DATE_TIME.YEAR) ,XIC(CELL_SET_DATE_TIME_PB) ONS(ONS_ARRAY[14]) [SSV(WallClockTime,,DateTime,CELL_PLC_SET_DATE_TIME.YEAR) ,SSV(WallClockTime,,DateTime,CELL_PLC_SET_DATE_TIME.MONTH) ,SSV(WallClockTime,,DateTime,CELL_PLC_SET_DATE_TIME.DAY) ,SSV(WallClockTime,,DateTime,CELL_PLC_SET_DATE_TIME.HOUR) ,SSV(WallClockTime,,DateTime,CELL_PLC_SET_DATE_TIME.MINUTE) ,SSV(WallClockTime,,DateTime,CELL_PLC_SET_DATE_TIME.SECOND) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SET TIME DATE STAMP VARIABLE]]>
</Comment>
<Text>
<![CDATA[[[DTOS(CELL_PLC_DATE_TIME.YEAR,CELL_PLC_DATE_TIME_STRINGS[0]) ,DTOS(CELL_PLC_DATE_TIME.MONTH,CELL_PLC_DATE_TIME_STRINGS[1]) ,DTOS(CELL_PLC_DATE_TIME.DAY,CELL_PLC_DATE_TIME_STRINGS[2]) ,DTOS(CELL_PLC_DATE_TIME.HOUR,CELL_PLC_DATE_TIME_STRINGS[3]) ,DTOS(CELL_PLC_DATE_TIME.MINUTE,CELL_PLC_DATE_TIME_STRINGS[4]) ,EQU(CELL_PLC_DATE_TIME_STRINGS[4].LEN,1) CONCAT(CELL_PLC_DATE_TIME_STRINGS[8],CELL_PLC_DATE_TIME_STRINGS[4],CELL_PLC_DATE_TIME_STRINGS[4]) ] ,CONCAT(CELL_PLC_DATE_TIME_STRINGS[3],CELL_PLC_DATE_TIME_STRINGS[5],CELL_PLC_DATE_STAMP) ,CONCAT(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_TIME_STRINGS[4],CELL_PLC_DATE_STAMP) ,CONCAT(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_TIME_STRINGS[7],CELL_PLC_DATE_STAMP) ,CONCAT(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_TIME_STRINGS[1],CELL_PLC_DATE_STAMP) ,CONCAT(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_TIME_STRINGS[6],CELL_PLC_DATE_STAMP) ,CONCAT(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_TIME_STRINGS[2],CELL_PLC_DATE_STAMP) ,CONCAT(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_TIME_STRINGS[6],CELL_PLC_DATE_STAMP) ,CONCAT(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_TIME_STRINGS[0],CELL_PLC_DATE_STAMP) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
CELL E-STOP AND RESET
***************************************************************************
CELL ALARM]]>
</Comment>
<Text>
<![CDATA[[LIM(1,STEP_ALARM[0],900) ,XIC(S:FS) ][OTL(CELL_ALARM_RED_LIGHT) ,MOV(1000,STEP_ESTOP_RESET[0]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[MAIN SYSTEM PRESSURE CONTROL AND ALARM]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[0],1000) TON(TIMER_OPER[1],?,?) ,[XIC(A:I.Data[2].16) OTL(CELL_PRESSURE_OK) ,XIO(CELL_SAFETY_DOOR_OPEN) XIC(TIMER_OPER[1].DN) XIO(A:I.Data[2].16) [TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) MOV(20,STEP_ALARM[0]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
