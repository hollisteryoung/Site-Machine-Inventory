<Routine Name="ASI_DIAG" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ASI DIAGNOSTICS
***************************************************************************
RESET WRITE INDEX VALUE]]>
</Comment>
<Text>
<![CDATA[[XIC(S:FS) MOV(0,SAFETY_MON_STATUS_WRITE_INDEX) ,[EQU(SAFETY_MON_STATUS_WRITE_INDEX,31) ,XIO(CELL_ASI_NODES_READY) ONS(ONS_ARRAY[19]) ] MOV(0,SAFETY_MON_STATUS_WRITE_INDEX) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[GET MISSING SLAVE STATUS OF NODES]]>
</Comment>
<Text>
<![CDATA[XIO(S:FS)[XIO(CELL_ASI_NODES_READY) [EQU(SAFETY_MON_STATUS_WRITE_INDEX,0) [[ONS(ONS_ARRAY[80]) ,XIO(CELL_ASI_SAFETY_MON_DETLA_MSG_CH1.EN) XIC(CELL_ASI_SAFETY_MON_DETLA_MSG_CH1.ER) ] MSG(CELL_ASI_SAFETY_MON_DETLA_MSG_CH1) ,[ONS(ONS_ARRAY[81]) ,XIO(CELL_ASI_SAFETY_MON_DETLA_MSG_CH2.EN) XIC(CELL_ASI_SAFETY_MON_DETLA_MSG_CH2.ER) ] MSG(CELL_ASI_SAFETY_MON_DETLA_MSG_CH2) ] ,[COP(CELL_ASI_SAFETY_MON_DELTA_CH1.DATA[0],CELL_ASI_SAFETY_MON_DELTA_ARRAY_CH1[0],2) ,COP(CELL_ASI_SAFETY_MON_DELTA_CH2.DATA[0],CELL_ASI_SAFETY_MON_DELTA_ARRAY_CH2[0],2) ] ] ,XIC(CELL_ASI_NODES_READY) [CLR(CELL_ASI_SAFETY_MON_DELTA_ARRAY_CH1[0]) CLR(CELL_ASI_SAFETY_MON_DELTA_ARRAY_CH1[1]) ,CLR(CELL_ASI_SAFETY_MON_DELTA_ARRAY_CH2[0]) CLR(CELL_ASI_SAFETY_MON_DELTA_ARRAY_CH2[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[GET PERIPHERAL FAULT STATUS OF SAFETY MONITOR]]>
</Comment>
<Text>
<![CDATA[XIO(S:FS)[XIO(CELL_ASI_NODES_READY) [EQU(SAFETY_MON_STATUS_WRITE_INDEX,0) [[ONS(ONS_ARRAY[82]) ,XIO(CELL_ASI_SAFETY_MON_LPF_MSG_CH1.EN) XIC(CELL_ASI_SAFETY_MON_LPF_MSG_CH1.ER) ] MSG(CELL_ASI_SAFETY_MON_LPF_MSG_CH1) ,[ONS(ONS_ARRAY[83]) ,XIO(CELL_ASI_SAFETY_MON_LPF_MSG_CH2.EN) XIC(CELL_ASI_SAFETY_MON_LPF_MSG_CH2.ER) ] MSG(CELL_ASI_SAFETY_MON_LPF_MSG_CH2) ] ,[COP(CELL_ASI_SAFETY_MON_LPF_CH1.DATA[0],CELL_ASI_SAFETY_MON_LPF_ARRAY_CH1[0],2) ,COP(CELL_ASI_SAFETY_MON_LPF_CH2.DATA[0],CELL_ASI_SAFETY_MON_LPF_ARRAY_CH2[0],2) ] ] ,XIC(CELL_ASI_NODES_READY) [CLR(CELL_ASI_SAFETY_MON_LPF_ARRAY_CH1[0]) CLR(CELL_ASI_SAFETY_MON_LPF_ARRAY_CH1[1]) ,CLR(CELL_ASI_SAFETY_MON_LPF_ARRAY_CH2[0]) CLR(CELL_ASI_SAFETY_MON_LPF_ARRAY_CH2[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[CLEAR CHANNEL NODE STATUS]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_ASI_NODES_READY) ,XIO(CELL_ASI_NODES_READY) XIC(CELL_ASI_SAFETY_MON_DETLA_MSG_CH1.DN) XIC(CELL_ASI_SAFETY_MON_LPF_MSG_CH1.DN) XIC(CELL_ASI_SAFETY_MON_DETLA_MSG_CH2.DN) XIC(CELL_ASI_SAFETY_MON_LPF_MSG_CH2.DN) ][ADD(1,SAFETY_MON_STATUS_WRITE_INDEX,SAFETY_MON_STATUS_WRITE_INDEX) ,CLR(CELL_ASI_NODE_SAFETY_STATUS_CH1_A[SAFETY_MON_STATUS_WRITE_INDEX]) ,CLR(CELL_ASI_NODE_SAFETY_STATUS_CH1_B[SAFETY_MON_STATUS_WRITE_INDEX]) ,CLR(CELL_ASI_NODE_SAFETY_STATUS_CH2_A[SAFETY_MON_STATUS_WRITE_INDEX]) ,CLR(CELL_ASI_NODE_SAFETY_STATUS_CH2_B[SAFETY_MON_STATUS_WRITE_INDEX]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MOVE CHANNEL 1 SAFETY NODE STATUS TO HMI BIT LOCATIONS]]>
</Comment>
<Text>
