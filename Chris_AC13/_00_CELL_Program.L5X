<Routine Name="COMMS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[COMMUNICATIONS
***************************************************************************

CYCLE COMMS TIMER TO BREAK UP THE GSV OPERATIONS]]>
</Comment>
<Text>
<![CDATA[XIO(TIMER_OPER[14].DN)TON(TIMER_OPER[14],?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SET OVERALL ASI NODES STATUS TAG]]>
</Comment>
<Text>
<![CDATA[[XIO(A:I.Data[0].4) XIO(A:I.Data[8].4) XIC(CELL_ASI_NODE_SAFETY_STATUS_CH1_OK) XIC(CELL_ASI_NODE_SAFETY_STATUS_CH2_OK) OTE(CELL_ASI_NODES_READY) ,XIO(CELL_ASI_NODES_READY) [TON(TIMER_ALARM[14],?,?) ,XIC(TIMER_ALARM[14].DN) ONS(ONS_ARRAY[38]) [[XIC(A:I.Data[0].4) ,XIC(A:I.Data[8].4) ] MOV(15,STEP_ALARM[0]) ,XIO(CELL_ASI_NODE_SAFETY_STATUS_CH1_OK) MOV(22,STEP_ALARM[0]) ,XIO(CELL_ASI_NODE_SAFETY_STATUS_CH2_OK) MOV(23,STEP_ALARM[0]) ] ] ];]]>
</Text>
</Rung>
