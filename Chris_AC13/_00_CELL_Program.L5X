<Routines>
<Routine Name="ANALOG_SETUP_MAN01" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MANIFOLD 01 ANALOG SETUP ROUTINE
*****************************************************************************************************

AFTER COMMUNICATIONS ARE RESTABLISHED WAIT FOR THE HMI BUTTON TO BE PRESSED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],1000)XIC(MAN01_ETHERNET_COMMS_OK)[XIC(MAN01_LOAD_ANALOG_MAN_SET_PB) ONS(ONS_ARRAY[31]) MOV(10,MAN01_STEP_ANALOG_SETUP) ,OTE(MAN01_LOAD_ANALOG_MAN_SET_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[THE DOWN LOAD STEPS ARE OUT OF ORDER PURPOSELY IN ORDER TO CAUSE AN ON/OFF CONDITION PRIOR TO THE NEXT STEP.

LOOP TO THE NEXT STEP UNTIL STEPS ARE COMPLETED]]>
</Comment>
<Text>
<![CDATA[EQU(MAN01_STEP_ANALOG_SETUP,30)[XIO(MAN01_ANALOG_SETUP_COUNTER.DN) MOV(10,MAN01_STEP_ANALOG_SETUP) ,XIC(MAN01_ANALOG_SETUP_COUNTER.DN) [OTU(MAN01_LOAD_ANALOG_MAN_SET_PB) ,RES(MAN01_ANALOG_SETUP_COUNTER) ,MOV(500,MAN01_STEP_ANALOG_SETUP) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WRITE MESSAGE TO MANIFOLD 01

ANALOG MODULE 1
BARRIER FORMING STATION FORM PRESSURE REGULATOR INPUT/OUTPUT

 ANALOG MODULE 2
BAG GLUE STATION GLUE MELTER PRESSURE MONITOR/GLUE MELTER PRESSURE INPUT]]>
</Comment>
<Text>
<![CDATA[EQU(MAN01_STEP_ANALOG_SETUP,20)[MSG(MAN01_ANALOG_MODULE_SETUP_MSG) ,XIC(MAN01_ANALOG_MODULE_SETUP_MSG.DN) [CTU(MAN01_ANALOG_SETUP_COUNTER,?,?) ,MOV(30,MAN01_STEP_ANALOG_SETUP) ] ,XIC(MAN01_ANALOG_MODULE_SETUP_MSG.ER) [MOV(141,STEP_ALARM[0]) ,OTU(MAN01_LOAD_ANALOG_MAN_SET_PB) ,MOV(1000,MAN01_STEP_ANALOG_SETUP) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[DEPENDING ON THE LOOP NUMBER FILL THE MESSAGE VARIABLES.
 INSTANCE = MODULE NUMBER
CLASS = PARAMETER - HEX 8A (DEC. 138) SET ANALOG SCALE
ATTRIBUTE = CHANNEL NUMBER - HEX 64 (DEC. 100) CHANNELS ARE 0 - 3 OR (64h - 67h)
ANALOG_SETUP_SOURCE_ELEMENT = SCALE TYPE FOR THE CHANNEL
0 = -10 - 10 V
1 = -5 - 5 V
2 = -20 - 20 mA
3 = 0 - 10 V
4 = 0 - 5 V
5 = 1 - 5 V
6 = 0 - 20 mA
7 = 4 - 20 mA]]>
</Comment>
<Text>
<![CDATA[EQU(MAN01_STEP_ANALOG_SETUP,10)[EQU(MAN01_ANALOG_SETUP_COUNTER.ACC,0) [MOV(1,MAN01_ANALOG_MODULE_SETUP_MSG.Instance) ,MOV(138,MAN01_ANALOG_MODULE_SETUP_MSG.Class) ,MOV(100,MAN01_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(4,MAN01_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN01_STEP_ANALOG_SETUP) ] ,EQU(MAN01_ANALOG_SETUP_COUNTER.ACC,1) [MOV(102,MAN01_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(3,MAN01_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN01_STEP_ANALOG_SETUP) ] ,EQU(MAN01_ANALOG_SETUP_COUNTER.ACC,2) [MOV(101,MAN01_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(4,MAN01_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN01_STEP_ANALOG_SETUP) ] ,EQU(MAN01_ANALOG_SETUP_COUNTER.ACC,3) [MOV(103,MAN01_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(3,MAN01_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN01_STEP_ANALOG_SETUP) ] ];]]>
</Text>
</Rung>
