<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[0],1000)ONS(ONS_ARRAY[40])[RES(PREHEAT1_UP_TEMP_REJECT_MULT_CNT) MOV(0,PREHEAT1_CTR_UP_TEMP) ,RES(PREHEAT1_LOW_TEMP_REJECT_MULT_CNT) MOV(0,PREHEAT1_CTR_LOW_TEMP) ,RES(PREHEAT2_UP_TEMP_REJECT_MULT_CNT) MOV(0,PREHEAT2_CTR_UP_TEMP) ,RES(PREHEAT2_LOW_TEMP_REJECT_MULT_CNT) MOV(0,PREHEAT2_CTR_LOW_TEMP) ,RES(FORMING_PRESSURE_REJECT_MULT_CNT) MOV(0,FORMING_CTR_PRESSURE) ,RES(PUNCH_INC_CYCLE_REJECT_MULT_CNT) MOV(0,PUNCH_CTR_INC_CYCLE) ,RES(PRINT_INC_CYCLE_REJECT_MULT_CNT) MOV(0,PRINT_CTR_INC_CYCLE) ,RES(GLUE_OUT_PRESSURE_REJECT_MULT_CNT) MOV(0,GLUE_OUT_CTR_PRESSURE) ,RES(GLUE_OPEN_TIME_REJECT_MULT_CNT) MOV(0,GLUE_CTR_OPEN_TIME) ,RES(GLUE_INC_CYCLE_REJECT_MULT_CNT) MOV(0,GLUE_CTR_INC_CYCLE) ,RES(PNC_PRESSURE_REJECT_MULT_CNT) MOV(0,PNC_CTR_PRESSURE) ,RES(PNC_OPEN_TIME_REJECT_MULT_CNT) MOV(0,PNC_CTR_OPEN_TIME) ,RES(VISION_REJECT_MULT_CNT) MOV(0,VISION_CTR_REJECT_CYCLE) ,MOV(0,BAG_OFFLOAD_CTR_BARRIER_REJECT) ,RES(BAG_OFFLOAD_BARRIER_VIS_REJECT_MULTI_CNT) MOV(0,BAG_OFFLOAD_CTR_BARRIER_VIS_REJECT) ,MOV(0,BAG_OFFLOAD_CTR_BAG_REJECT) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF MACHINE CYCLES
THE TIMER WORKS WITH THE HMI TO COLLECT RECOREDED MACHINE
CYCLES WHEN DOWNLOADING NEW PLC PROGRAM
]]>
</Comment>
<Text>
<![CDATA[[XIC(MAIN_DIAL_SHIFT_DATA) [CTU(CELL_CYCLE_CNT,?,?) ,XIC(CELL_CYCLE_CNT.DN) RES(CELL_CYCLE_CNT) ] ,MOV(CELL_CYCLE_CNT.ACC,CELL_CYCLES) ,[[XIC(S:FS) ,XIC(CELL_TIMER_OPER[13].TT) ] [TON(CELL_TIMER_OPER[13],?,?) ,OTE(CELL_CYCLE_TIMING_BIT_STOP) ] ,XIO(CELL_CYCLE_TIMING_BIT_STOP) [TON(CELL_TIMER_OPER[12],?,?) ,LEQ(CELL_TIMER_OPER[12].ACC,500) OTE(CELL_CYCLE_TIMING_BIT) ,XIC(CELL_TIMER_OPER[12].DN) RES(CELL_TIMER_OPER[12]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF MACHINE AUTO RUNNING HOURS
]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_STARTED) RTO(CELL_TIMER_RUNTIME,?,?) ,GEQ(CELL_TIMER_RUNTIME.ACC,1800000000) ONS(ONS_ARRAY[107]) ADD(1,CELL_RUNTIME_MULTIPLIER,CELL_RUNTIME_MULTIPLIER) MOV(0,CELL_TIMER_RUNTIME.ACC) ,DIV(CELL_TIMER_RUNTIME.ACC,3600000,CELL_RUNTIME_REAL) MUL(CELL_RUNTIME_MULTIPLIER,500,CELL_RUNTIME_OVERFLOW) ADD(CELL_RUNTIME_REAL,CELL_RUNTIME_OVERFLOW,CELL_RUNTIME_HMI) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
