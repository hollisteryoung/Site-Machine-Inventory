CHECK FOR CELL EMPTY]]>
</Comment>
<Text>
<![CDATA[XIC(MAIN_DIAL_SHIFT_DATA)[COP(MAIN_DIAL_DATA[12],MAIN_DIAL_DATA[13],1) ,COP(MAIN_DIAL_DATA[11],MAIN_DIAL_DATA[12],1) ,COP(MAIN_DIAL_DATA[10],MAIN_DIAL_DATA[11],1) ,COP(MAIN_DIAL_DATA[9],MAIN_DIAL_DATA[10],1) ,COP(MAIN_DIAL_DATA[8],MAIN_DIAL_DATA[9],1) ,COP(MAIN_DIAL_DATA[7],MAIN_DIAL_DATA[8],1) ,COP(MAIN_DIAL_DATA[6],MAIN_DIAL_DATA[7],1) ,COP(MAIN_DIAL_DATA[5],MAIN_DIAL_DATA[6],1) ,COP(MAIN_DIAL_DATA[4],MAIN_DIAL_DATA[5],1) ,COP(MAIN_DIAL_DATA[3],MAIN_DIAL_DATA[4],1) ,COP(MAIN_DIAL_DATA[2],MAIN_DIAL_DATA[3],1) ,COP(MAIN_DIAL_DATA[1],MAIN_DIAL_DATA[2],1) ,[XIC(MAIN_DIAL_DATA[13].BARRIER_LOADED) ,XIC(MAIN_DIAL_DATA[13].BAG_LOADED) ] COP(MAIN_DIAL_DATA[13],MAIN_DIAL_DATA[1],1) ,XIC(BARRIER_LOAD_DATA_BAR_LOADED) XIO(BARRIER_LOAD_DATA_FORMING_STARTED) [OTU(BARRIER_LOAD_DATA_PREHEAT1_STARTED) ,OTU(BARRIER_LOAD_DATA_PREHEAT1_UP_TEMP_OK) ,OTU(BARRIER_LOAD_DATA_PREHEAT1_LOW_TEMP_OK) ,OTU(BARRIER_LOAD_DATA_PREHEAT1_COMPLETE) ,OTU(BARRIER_LOAD_DATA_PREHEAT2_STARTED) ,OTU(BARRIER_LOAD_DATA_PREHEAT2_UP_TEMP_OK) ,OTU(BARRIER_LOAD_DATA_PREHEAT2_LOW_TEMP_OK) ,OTU(BARRIER_LOAD_DATA_PREHEAT2_COMPLETE) ] ,XIO(MAIN_DIAL_DATA[13].BARRIER_LOADED) XIO(MAIN_DIAL_DATA[13].BAG_LOADED) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[1],1) ,COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[13],1) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[ CLEAR MAIN DIAL DATA REQUESTS FROM HMI
AND DURING SINGLE PART MODE]]>
</Comment>
<Text>
<![CDATA[[NEQ(CELL_SCREEN,51) NEQ(CELL_SCREEN,90) MOV(0,MAIN_DIAL_DATA_CLEAR_REQ_ARRAY) ,[[EQU(CELL_SCREEN,51) ,EQU(CELL_SCREEN,90) ] NEQ(MAIN_DIAL_DATA_CLEAR_REQ_ARRAY,0) OTE(CELL_DATA_CLEAR_VERIFY) ,[XIC(MAIN_DIAL_DATA_CLEAR_PB) ,XIC(CELL_SINGLE_PART_MODE_YES_PB) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIO(CELL_SINGLE_PART_MODE_PB) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) EQU(STEP_ALARM[0],897) ,XIC(MAIN_DIAL_HOMING_COMPLETED) ,XIC(CELL_EMPTY_COMPLETE.15) ] MOV(8191,MAIN_DIAL_DATA_CLEAR_REQ_ARRAY) ,[[XIC(CELL_DATA_CLEAR_NO_PB) ,XIC(CELL_SINGLE_PART_MODE_NO_PB) ] ,[XIC(CELL_DATA_CLEAR_YES_PB) ,XIC(CELL_SINGLE_PART_MODE_YES_PB) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIO(CELL_SINGLE_PART_MODE_PB) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) EQU(STEP_ALARM[0],897) ,XIC(MAIN_DIAL_HOMING_COMPLETED) ,XIC(CELL_EMPTY_COMPLETE.15) ] [XIC(BARRIER_LOAD_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[1],1) ,XIC(EMPTY_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[2],1) ,XIC(BAG_LOAD_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[3],1) ,XIC(PREHEAT1_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[4],1) ,XIC(PREHEAT2_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[5],1) ,XIC(FORMING_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[6],1) ,XIC(PUNCH_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[7],1) ,XIC(PRINT_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[8],1) ,XIC(GLUE_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[9],1) ,XIC(PNC_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[10],1) ,XIC(VISION_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[11],1) ,XIC(BAG_OFFLOAD_DATA_CLEAR_PB) COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[12],1) ,[XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIO(CELL_SINGLE_PART_MODE_PB) OTU(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(MAIN_DIAL_HOMING_COMPLETED) ] MOV(905,CELL_MESSAGE) ] ] MOV(0,MAIN_DIAL_DATA_CLEAR_REQ_ARRAY) ] ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[VERIFY RECIPE VALUES ARE WITHIN LIMITS]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) RES(TIMER_OPER[15]) ,[XIC(CELL_RECIPE_LOAD_COMPLETE) ,XIC(TIMER_OPER[15].TT) ,XIC(TIMER_OPER[15].DN) ] TON(TIMER_OPER[15],?,?) ,XIC(TIMER_OPER[15].DN) [[LIM(0,PNP_BASE_COR_POS_RECIPE,88) OTE(RECIPE_VAL_COR_POS_OK) ,XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_COR_POS_OK) MOV(120,STEP_ALARM[0]) ] ,[LIM(1,CELL_BARRIER_TYPE_RECIPE,11) OTE(RECIPE_VAL_BAR_TYPE_OK) ,XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_BAR_TYPE_OK) MOV(121,STEP_ALARM[0]) ] ,[LIM(0,R1_RIGID_VIS_PROCESS_RECIPE,5) OTE(RECIPE_VAL_R1_RIGID_VIS_PRO_OK) ,XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_R1_RIGID_VIS_PRO_OK) MOV(122,STEP_ALARM[0]) ] ,[LIM(0,R1_SNF_VIS_PROCESS_RECIPE_LOADED,26) OTE(RECIPE_VAL_R1_SNF_VIS_PRO_OK) ,XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_R1_SNF_VIS_PRO_OK) MOV(123,STEP_ALARM[0]) ] ,[[NEQ(R1_RIGID_VIS_PROCESS_RECIPE,0) EQU(R1_SNF_VIS_PROCESS_RECIPE_LOADED,0) ,EQU(R1_RIGID_VIS_PROCESS_RECIPE,0) NEQ(R1_SNF_VIS_PROCESS_RECIPE_LOADED,0) ] OTE(RECIPE_VAL_R1_VIS_PRO_OK) ,XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_R1_VIS_PRO_OK) MOV(134,STEP_ALARM[0]) ,XIC(CELL_ALARMS_ACTIVE) EQU(R1_RIGID_VIS_PROCESS_RECIPE,0) EQU(R1_SNF_VIS_PROCESS_RECIPE_LOADED,0) MOV(135,STEP_ALARM[0]) ] ,[LIM(1,CELL_BAG_TYPE_RECIPE_LOADED,7) OTE(RECIPE_VAL_R1_BAG_TYPE_OK) ,XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_R1_BAG_TYPE_OK) MOV(124,STEP_ALARM[0]) ] ,[LIM(0,PREHEAT1_LOW_TEMP_RECIPE_SP,280) OTE(RECIPE_VAL_PREHEAT1_LOW_TEMP_OK) ,XIC(PREHEAT1_ACTIVE_RECIPE_LOADED) XIO(RECIPE_VAL_PREHEAT1_LOW_TEMP_OK) [OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(125,STEP_ALARM[0]) ] ] ,[LIM(0,PREHEAT1_UP_TEMP_RECIPE_SP,280) OTE(RECIPE_VAL_PREHEAT1_UP_TEMP_OK) ,XIC(PREHEAT1_ACTIVE_RECIPE_LOADED) XIO(RECIPE_VAL_PREHEAT1_UP_TEMP_OK) [OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(126,STEP_ALARM[0]) ] ] ,[LIM(0,PREHEAT2_LOW_TEMP_RECIPE_SP,280) OTE(RECIPE_VAL_PREHEAT2_LOW_TEMP_OK) ,XIC(PREHEAT2_ACTIVE_RECIPE_LOADED) XIO(RECIPE_VAL_PREHEAT2_LOW_TEMP_OK) [OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(127,STEP_ALARM[0]) ] ] ,[LIM(0,PREHEAT2_UP_TEMP_RECIPE_SP,280) OTE(RECIPE_VAL_PREHEAT2_UP_TEMP_OK) ,XIC(PREHEAT2_ACTIVE_RECIPE_LOADED) XIO(RECIPE_VAL_PREHEAT2_UP_TEMP_OK) [OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(128,STEP_ALARM[0]) ] ] ,[LIM(0,FORMING_PRESSURE_RECIPE_SP,87) OTE(RECIPE_VAL_FORM_PRESS_OK) ,XIC(FORMING_ACTIVE_RECIPE_LOADED) XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_FORM_PRESS_OK) MOV(129,STEP_ALARM[0]) ] ,XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) [XIC(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) XIC(CELL_ALARMS_ACTIVE) MOV(136,STEP_ALARM[0]) ,EQU(INKJET_PRINT_SKU_RECIPE_LOADED,CELL_NULL_STRING) MOV(137,STEP_ALARM[0]) ] ,[LIM(GLUE_OUT_PRESSURE_MIN_ALLOWED,GLUE_OUT_PRESSURE_RECIPE_SP,GLUE_OUT_PRESSURE_MAX_ALLOWED) OTE(RECIPE_VAL_GLUE_PRESS_OK) ,XIC(GLUE_ACTIVE_RECIPE_LOADED) XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_GLUE_PRESS_OK) MOV(130,STEP_ALARM[0]) ] ,[LIM(0,GLUE_X_Y_PATH_DIA_RECIPE,81) LIM(0,GLUE_X_Y_PATH2_DIA_RECIPE,81) OTE(RECIPE_VAL_GLUE_DIA_OK) ,XIC(GLUE_ACTIVE_RECIPE_LOADED) XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_GLUE_DIA_OK) MOV(131,STEP_ALARM[0]) ] ,[LIM(0,GLUE_X_Y_PATH_SPEED_RECIPE,254) LIM(0,GLUE_X_Y_PATH2_SPEED_RECIPE,254) OTE(RECIPE_VAL_GLUE_SPEED_OK) ,XIC(GLUE_ACTIVE_RECIPE_LOADED) XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_GLUE_SPEED_OK) MOV(132,STEP_ALARM[0]) ] ,[LIM(0,PNC_PRESSURE_RECIPE_SP,87) OTE(RECIPE_VAL_PNC_PRESS_OK) ,XIC(PNC_ACTIVE_RECIPE_LOADED) XIC(CELL_ALARMS_ACTIVE) XIO(RECIPE_VAL_PNC_PRESS_OK) MOV(133,STEP_ALARM[0]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[SET WHAT FAMILY OF PART IS SELECTED]]>
</Comment>
<Text>
<![CDATA[[EQU(CELL_FAMILY_TYPE_RECIPE,CELL_FAMILY_TYPE_SMALL) OTE(CELL_SMALL_PART_FAMILY_LOADED) ,EQU(CELL_FAMILY_TYPE_RECIPE,CELL_FAMILY_TYPE_MED) OTE(CELL_MEDIUM_PART_FAMILY_LOADED) ,EQU(CELL_FAMILY_TYPE_RECIPE,CELL_FAMILY_TYPE_LG) OTE(CELL_LARGE_PART_FAMILY_LOADED) ,EQU(CELL_FAMILY_TYPE_RECIPE,CELL_FAMILY_TYPE_SM_SNF) OTE(CELL_SMALL_SNF_PART_FAMILY_LOADED) ,EQU(CELL_FAMILY_TYPE_RECIPE,CELL_FAMILY_TYPE_LG_SNF) OTE(CELL_LARGE_SNF_PART_FAMILY_LOADED) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[****CELL CYCLE TIMES****

ARRAY OF CYCLE TIMES FOR AN AVERAGE OF LAST 10 CYCLES AND LAST 100 CYCLES ARE MAINTAINED
AVERAGES FOR EACH THE LAST 10 AND 100 CYCLES ARE NOT CALCULATED UNTIL THE CORRECT NUMBER OF DATA SAMPLES ARE INITIALLY COLLECTED
AFTER THAT THE AVERAGE WILL UPDATE EVERY CYCLE

CYCLE TIME DATA CLEARS ON RECIPE DOWNLOAD]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) [FLL(0,CELL_CYCLE_TIME_AVG_10_ARRAY[0],11) ,FLL(0,CELL_CYCLE_TIME_AVG_100_ARRAY[0],101) ,MOV(0,CELL_CYCLE_TIME_AVG_10) ,MOV(0,CELL_CYCLE_TIME_AVG_100) ,MOV(0,CELL_CYCLE_TIME_AVG_10_ARRAY_CTRL.POS) ,MOV(0,CELL_CYCLE_TIME_AVG_100_ARRAY_CTRL.POS) ] ,XIC(CELL_STARTED) [XIC(MAIN_DIAL_SHIFT_DATA) [ONS(ONS_ARRAY[16]) [DIV(TIMER_OPER[4].ACC,1000,CELL_CYCLE_TIME[0].MACHINE_CYCLE) ,FFL(CELL_CYCLE_TIME[0].MACHINE_CYCLE,CELL_CYCLE_TIME_AVG_10_ARRAY[0],CELL_CYCLE_TIME_AVG_10_ARRAY_CTRL,?,?) ,FFL(CELL_CYCLE_TIME[0].MACHINE_CYCLE,CELL_CYCLE_TIME_AVG_100_ARRAY[0],CELL_CYCLE_TIME_AVG_100_ARRAY_CTRL,?,?) ] ,XIC(CELL_CYCLE_TIME_AVG_10_ARRAY_CTRL.DN) [FFU(CELL_CYCLE_TIME_AVG_10_ARRAY[0],CELL_CYCLE_TIME_AVG_10_FFU_VAL,CELL_CYCLE_TIME_AVG_10_ARRAY_CTRL,?,?) ,AVE(CELL_CYCLE_TIME_AVG_10_ARRAY[0],0,CELL_CYCLE_TIME_AVG_10,CELL_CYCLE_TIME_AVG_10_CTRL,?,?) ] ,XIC(CELL_CYCLE_TIME_AVG_100_ARRAY_CTRL.DN) [FFU(CELL_CYCLE_TIME_AVG_100_ARRAY[0],CELL_CYCLE_TIME_AVG_100_FFU_VAL,CELL_CYCLE_TIME_AVG_100_ARRAY_CTRL,?,?) ,AVE(CELL_CYCLE_TIME_AVG_100_ARRAY[0],0,CELL_CYCLE_TIME_AVG_100,CELL_CYCLE_TIME_AVG_100_CTRL,?,?) ] ,[SUB(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,1) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BARRIER_LOAD_EX) MOV(1,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,3) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BAG_LOAD_EX) MOV(3,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,4) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BARRIER_PREHEAT1_EX) MOV(4,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,5) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BARRIER_PREHEAT2_EX) MOV(5,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,6) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BARRIER_FORMING_EX) MOV(6,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,7) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BARRIER_PUNCH_EX) MOV(7,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,8) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BARRIER_PRINT_EX) MOV(8,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,9) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BAG_GLUE_EX) MOV(9,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,10) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].PNC_EX) MOV(10,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ,EQU(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,12) MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME_EX,CELL_CYCLE_TIME[0].BAG_OFFLOAD_EX) MOV(12,CELL_CYCLE_TIME[0].ST_TIME_EX_VIS) ] ,[COP(CELL_CYCLE_TIME[0],CELL_CYCLE_TIME_TEMP[0],15) ,COP(CELL_CYCLE_TIME_TEMP[0],CELL_CYCLE_TIME[1],14) ,COP(CELL_CYCLE_TIME_NULL,CELL_CYCLE_TIME[0],1) ] ] ,XIO(MAIN_DIAL_SHIFT_DATA) TON(TIMER_OPER[4],?,?) ] ,XIC(CELL_STARTED) ONS(ONS_ARRAY[5]) [MOV(0,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(0,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ,MOV(0,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(0,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="RECIPE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CELL RECIPE CONTROL
***************************************************************************

RECIPE SYNCHRONIZATION CONTROL]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RECIPE_SYNC_REQ_PB) [ONS(ONS_ARRAY[11]) OTL(CELL_RECIPE_SYNC_REQ_POPUP) ,XIC(CELL_RECIPE_SYNC_REQ_YES_PB) [OTL(CELL_RECIPE_SYNC_REQ_ACTIVE) ,OTU(CELL_RECIPE_SYNC_REQ_POPUP) ] ] ,XIC(CELL_RECIPE_SYNC_REQ_NO_PB) [OTU(CELL_RECIPE_SYNC_REQ_PB) ,OTU(CELL_RECIPE_SYNC_REQ_POPUP) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TRIGGER TO START RECIPE HARVESTING FROM HMI]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_SYNC_REQ_ACTIVE)ONS(ONS_ARRAY[9])MOV(0,STEP_AUTO[29]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[RESET ROUTINE PARAMETERS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[29],0)[COP(CELL_RECIPE_SYNC_DATA_NULL[0],CELL_RECIPE_DATA[0],500) ,COP(CELL_PRODUCT_SKU_NULL,CELL_PRODUCT_SKU,1) ,COP(CELL_PRODUCT_SKU_NULL,CELL_PRODUCT_SKU_PREV,1) ,RES(CELL_RECIPE_SYNC_CNT) ,OTU(CELL_RECIPE_SYNC_FAILED) ,MOV(10,STEP_AUTO[29]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[INCREMENT RECORD COUNTER AND LOAD RECIPE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[29],10)[CTU(CELL_RECIPE_SYNC_CNT,?,?) ,MOV(CELL_RECIPE_SYNC_CNT.ACC,CELL_RECIPE_SYNC_RECORD) ,EQU(CELL_HMI_CURRENT_SCREEN,1) [TON(TIMER_OPER[10],?,?) ,XIC(TIMER_OPER[10].DN) RES(TIMER_OPER[10]) ,LIM(500,TIMER_OPER[10].ACC,6000) [OTE(CELL_RECIPE_SYNC_RECORD_LOAD) ,NEQ(CELL_PRODUCT_SKU,CELL_PRODUCT_SKU_PREV) [NEQ(CELL_PRODUCT_SKU,CELL_PRODUCT_SKU_END_RECORD) MOV(20,STEP_AUTO[29]) ,EQU(CELL_PRODUCT_SKU,CELL_PRODUCT_SKU_END_RECORD) MOV(30,STEP_AUTO[29]) ] COP(CELL_PRODUCT_SKU,CELL_PRODUCT_SKU_PREV,1) ] ,[TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) [OTL(CELL_RECIPE_SYNC_FAILED) ,MOV(30,STEP_AUTO[29]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[POPULATE RECIPE SYNCHRONIZATION ARRAY]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[29],20)[ONS(ONS_ARRAY[10]) [COP(CELL_PRODUCT_SKU,CELL_RECIPE_DATA[CELL_RECIPE_SYNC_CNT.ACC].SKU_NAME,1) ,MOV(CELL_RECIPE_SYNC_CNT.ACC,CELL_RECIPE_DATA[CELL_RECIPE_SYNC_CNT.ACC].RECORD_NUM) ] ,XIC(CELL_SCAN_DELAY_ARRAY[0]) [XIO(CELL_RECIPE_SYNC_CNT.DN) MOV(10,STEP_AUTO[29]) ,XIC(CELL_RECIPE_SYNC_CNT.DN) [OTL(CELL_RECIPE_SYNC_FAILED) ,MOV(30,STEP_AUTO[29]) ] ] ,OTE(CELL_SCAN_DELAY_ARRAY[0]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[END ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[29],30)[OTU(CELL_RECIPE_DOWNLOAD) ,TON(TIMER_OPER[11],?,?) ,XIC(TIMER_OPER[11].DN) [OTU(CELL_RECIPE_SYNC_REQ_ACTIVE) ,OTU(CELL_RECIPE_SYNC_REQ_PB) ,XIO(CELL_RECIPE_SYNC_FAILED) MOV(902,CELL_MESSAGE) ,XIC(CELL_RECIPE_SYNC_FAILED) MOV(903,CELL_MESSAGE) ,MOV(500,STEP_AUTO[29]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[*****RECIPE LOAD CONTROL*****

WAIT FOR TRIGGER TO START RECIPE DOWNLOAD]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[0],1000) XIO(CELL_RECIPE_SYNC_REQ_ACTIVE) XIO(CELL_RECIPE_SYNC_FAILED) OTE(CELL_PRODUCT_SKU_REQ_VIS) ,NEQ(CELL_PRODUCT_SKU_REQ,CELL_PRODUCT_SKU_REQ_NULL) TON(TIMER_OPER[18],?,?) ,XIC(TIMER_OPER[18].DN) ONS(ONS_ARRAY[17]) [MOV(0,CELL_RECIPE_DATA_CONTROL_SEARCH.POS) ,COP(CELL_PRODUCT_SKU_LOADED_NULL,CELL_PRODUCT_SKU_LOADED,1) ,OTU(CELL_RECIPE_DATA_CONTROL_SEARCH.EN) ,OTU(CELL_RECIPE_DATA_CONTROL_SEARCH.IN) ,OTU(CELL_RECIPE_DATA_CONTROL_SEARCH.FD) ,OTU(CELL_RECIPE_DATA_CONTROL_SEARCH.DN) ,MOV(0,STEP_AUTO[28]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[SEARCH RECIPE DATA ARRAY FOR MATCHING SKU AND LOAD RECORD NUMBER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[28],0)[MOV(CELL_RECIPE_DATA_ARRAY_SIZE,CELL_RECIPE_DATA_CONTROL_SEARCH.LEN) ,FSC(CELL_RECIPE_DATA_CONTROL_SEARCH,?,?,ALL,CELL_PRODUCT_SKU_REQ=CELL_RECIPE_DATA[CELL_RECIPE_DATA_CONTROL_SEARCH.POS].SKU_NAME) ,XIC(CELL_RECIPE_DATA_CONTROL_SEARCH.FD) [MOV(CELL_RECIPE_DATA_CONTROL_SEARCH.POS,CELL_RECIPE_SKU_RECORD) ,[TON(TIMER_OPER[12],?,?) ,XIC(TIMER_OPER[12].DN) MOV(10,STEP_AUTO[28]) ] ] ,XIC(CELL_RECIPE_DATA_CONTROL_SEARCH.DN) XIO(CELL_RECIPE_DATA_CONTROL_SEARCH.FD) MOV(20,STEP_AUTO[28]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[REQUEST SKU RECIPE, WAIT FOR INDICATION RECIPE DOWNLOADED, AND  REQUEST PROCESS RECIPE DOWNLOAD

THIS IS ALSO USED TO RESET TEMPERATURE AND PRESSURE ADJUSTMENTS IN OTHER ROUTINES]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[28],10)[OTE(CELL_RECIPE_SKU_LOAD) ,XIC(CELL_RECIPE_DOWNLOAD_DETECTED) OTU(CELL_RECIPE_DOWNLOAD) ,XIC(CELL_RECIPE_DOWNLOAD) OTE(CELL_RECIPE_DOWNLOAD_DETECTED) ,[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) ,XIC(TIMER_OPER[5].TT) ] [TON(TIMER_OPER[5],?,?) ,OTE(CELL_RECIPE_PROCESS_LOAD) ,MOV(CELL_ASSY_TYPE_RECIPE,CELL_ASSY_TYPE_RECIPE_LOADED) ,MOV(CELL_BAG_TYPE_RECIPE,CELL_BAG_TYPE_RECIPE_LOADED) ,MOV(CELL_BARRIER_TYPE_RECIPE,CELL_BARRIER_TYPE_RECIPE_LOADED) ,MOV(R1_SNF_VIS_PROCESS_RECIPE,R1_SNF_VIS_PROCESS_RECIPE_LOADED) ,[GRT(R1_Z_OFFSET_RECIPE,6) MOV(6,R1_Z_OFFSET_RECIPE) ,LES(R1_Z_OFFSET_RECIPE,-6) MOV(-6,R1_Z_OFFSET_RECIPE) ] ,[XIC(PNP_CORONA_ACTIVE_RECIPE) OTL(PNP_CORONA_ACTIVE_RECIPE_LOADED) ,XIO(PNP_CORONA_ACTIVE_RECIPE) OTU(PNP_CORONA_ACTIVE_RECIPE_LOADED) ] ,[XIC(PREHEAT1_ACTIVE_RECIPE) OTL(PREHEAT1_ACTIVE_RECIPE_LOADED) ,XIO(PREHEAT1_ACTIVE_RECIPE) OTU(PREHEAT1_ACTIVE_RECIPE_LOADED) ] ,[XIC(PREHEAT2_ACTIVE_RECIPE) OTL(PREHEAT2_ACTIVE_RECIPE_LOADED) ,XIO(PREHEAT2_ACTIVE_RECIPE) OTU(PREHEAT2_ACTIVE_RECIPE_LOADED) ] ,[XIC(PREHEAT_BAR_RERUN_ALLOW_RECIPE) OTL(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) ,XIO(PREHEAT_BAR_RERUN_ALLOW_RECIPE) OTU(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) ] ,[XIC(PREHEAT_ADJUST_TIME_RECIPE) [OTL(PREHEAT_ADJUST_TIME_LOADED) ,MOV(PREHEAT1_TIME_RECIPE,PREHEAT1_TIME_ADJ) ,MOV(PREHEAT2_TIME_RECIPE,PREHEAT2_TIME_ADJ) ] ,XIO(PREHEAT_ADJUST_TIME_RECIPE) OTU(PREHEAT_ADJUST_TIME_LOADED) ] ,[XIC(FORMING_ACTIVE_RECIPE) OTL(FORMING_ACTIVE_RECIPE_LOADED) ,XIO(FORMING_ACTIVE_RECIPE) OTU(FORMING_ACTIVE_RECIPE_LOADED) ] ,[XIC(PUNCH_ACTIVE_RECIPE) OTL(PUNCH_ACTIVE_RECIPE_LOADED) ,XIO(PUNCH_ACTIVE_RECIPE) OTU(PUNCH_ACTIVE_RECIPE_LOADED) ] ,[XIC(PUNCH_ACTIVE_RECIPE_LOADED) XIC(PUNCH_MOON_BLOW_ACTIVE_RECIPE) OTL(PUNCH_MOON_BLOW_ACTIVE_RECIPE_LOADED) ,[XIO(PUNCH_MOON_BLOW_ACTIVE_RECIPE) ,XIO(PUNCH_ACTIVE_RECIPE_LOADED) ] OTU(PUNCH_MOON_BLOW_ACTIVE_RECIPE_LOADED) ] ,AFI() [XIC(INKJET_PRINT_ACTIVE_RECIPE) OTL(INKJET_PRINT_ACTIVE_RECIPE_LOADED) ,XIO(INKJET_PRINT_ACTIVE_RECIPE) OTU(INKJET_PRINT_ACTIVE_RECIPE_LOADED) ] ,[XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE) OTL(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE) [OTU(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ,OTU(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) ] ] ,[XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) XIC(PRINT_SKU_PAD_ACTIVE_SW_RECIPE) OTL(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) ,[XIO(PRINT_SKU_PAD_ACTIVE_SW_RECIPE) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ] OTU(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) ] ,[XIC(PRINT_ACTIVE_RECIPE) OTL(PRINT_ACTIVE_RECIPE_LOADED) ,XIO(PRINT_ACTIVE_RECIPE) OTU(PRINT_ACTIVE_RECIPE_LOADED) ] ,MOV(PRINT_INK_POS_RECIPE,PRINT_INK_POS_RECIPE_LOADED) MOV(PRINT_APPLY_POS_RECIPE,PRINT_APPLY_POS_RECIPE_LOADED) ,MOV(CELL_PRODUCT_SKU,INKJET_PRINT_SKU_RECIPE_LOADED) [XIC(METRIC_MACHINE) MOV(INKJET_PRINT_X_POS_RECIPE,INKJET_PRINT_X_POS_RECIPE_LOADED) MOV(INKJET_PRINT_Y_POS_RECIPE,INKJET_PRINT_Y_POS_RECIPE_LOADED) ,XIO(METRIC_MACHINE) MUL(INKJET_PRINT_X_POS_RECIPE,25.4,INKJET_PRINT_X_POS_RECIPE_LOADED) MUL(INKJET_PRINT_Y_POS_RECIPE,25.4,INKJET_PRINT_Y_POS_RECIPE_LOADED) ] ,[XIC(GLUE_ACTIVE_RECIPE) OTL(GLUE_ACTIVE_RECIPE_LOADED) ,XIO(GLUE_ACTIVE_RECIPE) OTU(GLUE_ACTIVE_RECIPE_LOADED) ] ,[XIC(GLUE_ACTIVE_RECIPE_LOADED) XIC(GLUE_X_Y_PATH2_ACTIVE_RECIPE) OTL(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) ,[XIO(GLUE_X_Y_PATH2_ACTIVE_RECIPE) ,XIO(GLUE_ACTIVE_RECIPE_LOADED) ] OTU(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) ] ,[XIC(GLUE_ACTIVE_RECIPE_LOADED) XIC(PNC_ACTIVE_RECIPE) OTL(PNC_ACTIVE_RECIPE_LOADED) ,[XIO(PNC_ACTIVE_RECIPE) ,XIO(GLUE_ACTIVE_RECIPE_LOADED) ] OTU(PNC_ACTIVE_RECIPE_LOADED) ] ,[XIC(PNC_ACTIVE_RECIPE_LOADED) XIC(PNC_PRESS_CYL_ACTIVE_RECIPE) OTL(PNC_PRESS_CYL_ACTIVE_RECIPE_LOADED) ,[XIO(PNC_PRESS_CYL_ACTIVE_RECIPE) ,XIO(PNC_ACTIVE_RECIPE_LOADED) ] OTU(PNC_PRESS_CYL_ACTIVE_RECIPE_LOADED) ] ,[XIC(PNC_ACTIVE_RECIPE_LOADED) XIC(PNC_SUP_CYL_ACTIVE_RECIPE) OTL(PNC_SUP_CYL_ACTIVE_RECIPE_LOADED) ,[XIO(PNC_SUP_CYL_ACTIVE_RECIPE) ,XIO(PNC_ACTIVE_RECIPE_LOADED) ] OTU(PNC_SUP_CYL_ACTIVE_RECIPE_LOADED) ] ,[XIC(VISION_ACTIVE_RECIPE) OTL(VISION_ACTIVE_PB) ,XIO(VISION_ACTIVE_RECIPE) OTU(VISION_ACTIVE_PB) ,MOV(VISION_PROG_NUM_RECIPE,VISION_PROG_NUM_RECIPE_LOADED) ] ,MOV(OFFLOAD_CONV_STACK_SIZE_RECIPE,OFFLOAD_CONV_STACK_SIZE_RECIPE_LOADED) [XIC(METRIC_MACHINE) MOV(OFFLOAD_CONV_INDEX_LEN_RECIPE,OFFLOAD_CONV_INDEX_LEN_RECIPE_LOADED) ,XIO(METRIC_MACHINE) MUL(OFFLOAD_CONV_INDEX_LEN_RECIPE,25.4,OFFLOAD_CONV_INDEX_LEN_RECIPE_LOADED) ] ,XIC(TIMER_OPER[5].DN) [EQU(CELL_PRODUCT_SKU,CELL_PRODUCT_SKU_REQ) [COP(CELL_PRODUCT_SKU_REQ,CELL_PRODUCT_SKU_LOADED,1) ,COP(CELL_PRODUCT_SKU_REQ_NULL,CELL_PRODUCT_SKU_REQ,1) ,OTE(CELL_RECIPE_LOAD_COMPLETE) ,MOV(500,STEP_AUTO[28]) ] ,NEQ(CELL_PRODUCT_SKU,CELL_PRODUCT_SKU_LOADED) MOV(20,STEP_AUTO[28]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[RECIPE LOAD ERROR]]>
</Comment>
<Text>
<![CDATA[[[EQU(STEP_AUTO[28],20) ,XIC(TIMER_ALARM[21].DN) ] [MOV(907,CELL_MESSAGE) ,COP(CELL_PRODUCT_SKU_REQ_NULL,CELL_PRODUCT_SKU_REQ,1) ,MOV(1000,STEP_AUTO[28]) ] ,[NEQ(STEP_AUTO[28],500) NEQ(STEP_AUTO[28],1000) ,NEQ(CELL_PRODUCT_SKU_REQ,CELL_PRODUCT_SKU_REQ_NULL) ] TON(TIMER_ALARM[21],?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[RECIPE BUTTONS VISIBILITY]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],1000)XIO(CELL_RECIPE_SYNC_REQ_ACTIVE)OTE(CELL_RECIPE_PB_VIS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="RFID_BADGE_READER" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[RFID BADGE READER ROUTINE
*********************************************************************************

CARD NUMBER READ FROM IDENTITY CARD]]>
</Comment>
<Text>
<![CDATA[BTD(RFID_BADGE_READER:I.Data[37],0,RFID_CR_ID_REC,0,8)BTD(RFID_BADGE_READER:I.Data[36],0,RFID_CR_ID_REC,8,8)BTD(RFID_BADGE_READER:I.Data[35],0,RFID_CR_ID_REC,16,8)BTD(RFID_BADGE_READER:I.Data[34],0,RFID_CR_ID_REC,24,8);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[IDENTITY CARD NUMBER RECEIVED]]>
</Comment>
<Text>
<![CDATA[NEQ(RFID_CR_ID_REC,0)ONS(ONS_ARRAY[34])OTU(RFID_MANUAL_OPERATOR_LOGGED_IN)OTU(RFID_SHIFT_CHANGE)OTE(RFID_NEW_RFID_READ)MOV(RFID_CR_ID_REC,RFID_CR_NEW_ID);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CHECK IF IDENTITY NUMBER RECEIVED HAS CHANGED FROM CURRENT.
HOLLISTER TO CARRY OUT ID CHECK ON NEW NUMBER
CARD_ID_REC - received from reader
CR_NEW_ID - update on new read
CR_CUR_ID - to detect change
RFID_LAST_ID - on change checked by Ignition and user name/access level updated
]]>
</Comment>
<Text>
<![CDATA[NEQ(RFID_CR_NEW_ID,RFID_CR_CUR_ID)OTE(NEW_RFID_ID)[MOV(RFID_CR_NEW_ID,RFID_CR_CUR_ID) MOV(RFID_CR_NEW_ID,RFID_LAST_ID) ,MOV(0,RFID_ACCESS_LEVEL) GRT(RFID_USER_NAME_HMI.LEN,0) DELETE(RFID_USER_NAME_HMI,RFID_USER_NAME_HMI.LEN,1,RFID_USER_NAME_HMI) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[UPDATE RFID NAME ON CARD ID CHANGE
ADD SOME DELAY BEFORE COPYING USER NAME JUST IN CASE LEVEL TAG WILL BE UPDATED FROM 
IGNITION BEFORE USER NAME TAG]]>
</Comment>
<Text>
<![CDATA[GRT(RFID_ACCESS_LEVEL,0)XIO(NEW_RFID_ID)TON(RFID_TIMER_OPER[2],?,?)XIC(RFID_TIMER_OPER[2].DN)ONS(ONS_ARRAY[94])[GRT(RFID_USER_NAME_HMI.LEN,0) DELETE(RFID_USER_NAME_HMI,RFID_USER_NAME_HMI.LEN,1,RFID_USER_NAME_HMI) ,EQU(RFID_USER_NAME_HMI.LEN,0) ]INSERT(RFID_USER_NAME_HMI,RFID_USER_NAME,1,RFID_USER_NAME_HMI);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MANUAL LOGIN/LOGOUT
CLEAR RFID LOGIND, CLEAR/UPDATE USER NAME]]>
</Comment>
<Text>
<![CDATA[[XIC(RFID_LOGIN_CMD_HMI) [GRT(RFID_USER_NAME_HMI.LEN,0) DELETE(RFID_USER_NAME_HMI,RFID_USER_NAME_HMI.LEN,1,RFID_USER_NAME_HMI) ,EQU(RFID_USER_NAME_HMI.LEN,0) ] INSERT(RFID_USER_NAME_HMI,RFID_USER_NAME_LOCAL,1,RFID_USER_NAME_HMI) OTL(RFID_MANUAL_OPERATOR_LOGGED_IN) OTU(RFID_LOGIN_CMD_HMI) OTU(RFID_SHIFT_CHANGE) ,XIC(RFID_LOGOUT_CMD_HMI) [GRT(RFID_USER_NAME_HMI.LEN,0) DELETE(RFID_USER_NAME_HMI,RFID_USER_NAME_HMI.LEN,1,RFID_USER_NAME_HMI) ,EQU(RFID_USER_NAME_HMI.LEN,0) ] OTU(RFID_MANUAL_OPERATOR_LOGGED_IN) OTU(RFID_LOGOUT_CMD_HMI) ]MOV(0,RFID_ACCESS_LEVEL)[MOV(0,RFID_LAST_ID) ,MOV(0,RFID_CR_CUR_ID) ,MOV(0,RFID_CR_NEW_ID) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CHECK IF ACCESS LEVEL IS ENOUGH TO OPERATE THE MACHINE
]]>
</Comment>
<Text>
<![CDATA[[GRT(RFID_ACCESS_LEVEL,0) ,XIC(RFID_MANUAL_OPERATOR_LOGGED_IN) ]OTE(RFID_OPERATOR_LOGGED_IN)OTL(RFID_AUTO_READY_LOGIN);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[DISPLAY LOGIN REQUEST ON HMI
HMI OPERATOR LOGGED OFF INDICATOR WILL BLINK TO INDICATE NEED TO LOG IN]]>
</Comment>
<Text>
<![CDATA[[XIO(RFID_OPERATOR_LOGGED_IN) ,XIC(RFID_SHIFT_CHANGE) ]OTE(RFID_LOGIN_REQUIRED_HMI);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[EQU(CELL_PLC_DATE_TIME.HOUR,6) ,EQU(CELL_PLC_DATE_TIME.HOUR,18) ]EQU(CELL_PLC_DATE_TIME.MINUTE,45)ONS(ONS_ARRAY[102])OTL(RFID_SHIFT_CHANGE);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[IF ACCESS LEVEL DROPS DUE TO SHIFT CHANGE  MACHINE WILL STILL RUN FOR 30 MINUTES.
HMI OPERATOR LOGGED OFF IDNICATOR WILL BLINK TO INDICATE NEED TO LOG IN
]]>
</Comment>
<Text>
<![CDATA[XIC(RFID_AUTO_READY_LOGIN)[XIC(RFID_SHIFT_CHANGE) TON(RFID_TIMER_OPER[0],?,?) ,XIO(RFID_SHIFT_CHANGE) XIO(RFID_OPERATOR_LOGGED_IN) TON(RFID_TIMER_OPER[1],?,?) ,[XIC(RFID_TIMER_OPER[0].DN) ,XIC(RFID_TIMER_OPER[1].DN) ] MOV(0,RFID_ACCESS_LEVEL) [MOV(0,RFID_LAST_ID) ,MOV(0,RFID_CR_CUR_ID) ,MOV(0,RFID_CR_NEW_ID) ] [GRT(RFID_USER_NAME_HMI.LEN,0) DELETE(RFID_USER_NAME_HMI,RFID_USER_NAME_HMI.LEN,1,RFID_USER_NAME_HMI) ,EQU(RFID_USER_NAME_HMI.LEN,0) ] OTU(RFID_AUTO_READY_LOGIN) OTU(RFID_MANUAL_OPERATOR_LOGGED_IN) OTU(RFID_SHIFT_CHANGE) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[ALARM IF START IN AUTO WITHOUT LOGGED IN USER]]>
</Comment>
<Text>
<![CDATA[AFI()XIO(RFID_AUTO_READY_LOGIN)[XIC(CELL_START_PRESSED) ,EQU(CELL_STATUS,2) ]MOV(11,STEP_ALARM[0]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[IF BADGE READER HAS NO VALUE END ROUTINE
]]>
</Comment>
<Text>
<![CDATA[EQU(RFID_BADGE_READER:I.Data[4],0)RET();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[DISTRIBUTE RAW BADGE READER DATA TO LOCAL TAG FOR COMPARISON]]>
</Comment>
<Text>
<![CDATA[BTD(RFID_BADGE_READER:I.Data[37],0,RFID_LAST_ID_OLD,0,8)BTD(RFID_BADGE_READER:I.Data[36],0,RFID_LAST_ID_OLD,8,8);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[SEARCH FOR BADGE READER VALUE IN LOOKUP ARRAY]]>
</Comment>
<Text>
<![CDATA[[RES(RFID_CONTROL) ,FSC(RFID_CONTROL,?,?,ALL,RFID_LAST_ID_OLD=RFID_CARDS[RFID_CONTROL.POS]) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[ACTIVATE OFFLOAD VISION ACTIVATION/DEACTIVATION BUTTON VISIBILTY]]>
</Comment>
<Text>
<![CDATA[XIC(RFID_CONTROL.FD)OTL(RFID_FACE_OFFL_ACT_PB_VIS_LOGIN);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SETTINGS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CELL SETTINGS
***************************************************************************

SET MACINE NUMBER TO SET MACHINE SETTINGS

1 = 1 PC AUTOCOINER #1, STUARTS DRAFT - 2 LANE INFEED - 26207PN1
2 = 1 PC AUTOCOINER #2, STUARTS DRAFT - 1 LANE INFEED - 26207PN2
3 = 1 PC AUTOCOINER #3, BALLINA - 1 LANE INFEED, STEPPER GRIPPER - 26207PN3
4 = 1 PC AUTOCOINER #4, BALLINA - 1 LANE INFEED, STEPPER GRIPPER - 26207PN3
5 = 1 PC AUTOCOINER #5, BALLINA - 1 LANE INFEED, STEPPER GRIPPER - 26207PN3
9 = 1 PC AUTOCOINER #9, STUARTS DRAFT - 1 LANE INFEED - 26207PN6
10 = 1 PC AUTOCOINER #10, LITHUAINIA - 1 LANE INFEED - 26207PN7
11 = 1 PC AUTOCOINER #11, LITHUAINIA - 1 LANE INFEED - 26207PN7
*************************************************************************************************************************

SET CELL ID NUMBER]]>
</Comment>
<Text>
<![CDATA[[XIC(A:I.Data[6].8) OTE(CELL_ID_NUM.0) ,XIC(A:I.Data[6].9) OTE(CELL_ID_NUM.1) ,XIC(A:I.Data[6].10) OTE(CELL_ID_NUM.2) ,XIC(A:I.Data[6].11) OTE(CELL_ID_NUM.3) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[MAIN DIAL MACHINE SPECIFIC SETTINGS]]>
</Comment>
<Text>
<![CDATA[MOV(CELL_PAR[CELL_ID_NUM].MAIN_DIAL_PAR.DRV_HOME_OFF,MAIN_DIAL_DRV_HOME_OFF);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[PREHEAT STATION 1 RTD TEMPERATURE SCALING VALUES]]>
</Comment>
<Text>
<![CDATA[[MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_M,PREHEAT1_LOW_TOOL_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_B,PREHEAT1_LOW_TOOL_TEMP_B_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.UP_TOOL_M,PREHEAT1_UP_TOOL_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.UP_TOOL_B,PREHEAT1_UP_TOOL_TEMP_B_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_BLOCK_M,PREHEAT1_LOW_BLOCK_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_BLOCK_B,PREHEAT1_LOW_BLOCK_TEMP_B_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.UP_BLOCK_M,PREHEAT1_UP_BLOCK_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.UP_BLOCK_B,PREHEAT1_UP_BLOCK_TEMP_B_SCALE) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[PREHEAT STATION 2 RTD TEMPERATURE SCALING VALUES]]>
</Comment>
<Text>
<![CDATA[[MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.LOW_TOOL_M,PREHEAT2_LOW_TOOL_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.LOW_TOOL_B,PREHEAT2_LOW_TOOL_TEMP_B_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.UP_TOOL_M,PREHEAT2_UP_TOOL_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.UP_TOOL_B,PREHEAT2_UP_TOOL_TEMP_B_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.LOW_BLOCK_M,PREHEAT2_LOW_BLOCK_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.LOW_BLOCK_B,PREHEAT2_LOW_BLOCK_TEMP_B_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.UP_BLOCK_M,PREHEAT2_UP_BLOCK_TEMP_M_SCALE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT2_PAR.UP_BLOCK_B,PREHEAT2_UP_BLOCK_TEMP_B_SCALE) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[PREHEAT STATION 1 LOWER TEMP PID LOOP VALUES]]>
</Comment>
<Text>
<![CDATA[[MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_ST_BIAS_SM,PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_SMALL) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_ST_BIAS_MD,PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_MEDIUM) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_ST_BIAS_LG,PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_LARGE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_ST_BIAS_SM_SNF,PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_SM_SNF) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_ST_BIAS_LG_SNF,PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_LG_SNF) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_ST_BIAS_FOAM,PREHEAT1_LOW_TOOL_PID_ST_BIAS_FOAM) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_DYN_BIAS_SM,PREHEAT1_LOW_TOOL_PID_DYN_BIAS_SMALL) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_DYN_BIAS_MD,PREHEAT1_LOW_TOOL_PID_DYN_BIAS_MEDIUM) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_DYN_BIAS_LG,PREHEAT1_LOW_TOOL_PID_DYN_BIAS_LARGE) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_DYN_BIAS_SM_SNF,PREHEAT1_LOW_TOOL_PID_DYN_BIAS_SM_SNF) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_DYN_BIAS_LG_SNF,PREHEAT1_LOW_TOOL_PID_DYN_BIAS_LG_SNF) ,MOV(CELL_PAR[CELL_ID_NUM].PREHEAT1_PAR.LOW_TOOL_PID_DYN_BIAS_FOAM,PREHEAT1_LOW_TOOL_PID_DYN_BIAS_FOAM) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[PREHEAT STATION 1 UPPER TEMP PID LOOP VALUES]]>
</Comment>
<Text>
