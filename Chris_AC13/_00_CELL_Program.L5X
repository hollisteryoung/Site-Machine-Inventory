<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CELL STATUS
***************************************************************************

CELL RESET READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_ESTOP_PRESSED) XIC(CELL_COMM_READY) XIC(BARRIER_MAG_LT_CURTAIN_CLEAR) [XIC(CELL_KEY_AUTO_MODE) XIC(R1_AUTO_MODE) XIC(R2_AUTO_MODE) XIC(R3_AUTO_MODE) ,XIC(CELL_KEY_MAN_MODE) ] XIO(CELL_SHUTDOWN_REQ) OTE(CELL_RESET_READY) ,NEQ(STEP_ESTOP_RESET[0],500) XIO(CELL_RESET_READY) XIC(CELL_TIMING_BIT_500) OTE(CELL_RESET_NOT_READY_ANIMATION) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CELL KEYSWITCH MODE
]]>
</Comment>
<Text>
<![CDATA[[XIC(A:I.Data[2].20) OTE(CELL_KEY_MAN_MODE) ,XIC(CELL_KEY_AUTO) OTE(CELL_KEY_AUTO_MODE) ,[XIO(CELL_KEY_AUTO_MODE) XIO(A:I.Data[2].20) ,XIO(CELL_KEY_MAN_MODE) XIO(CELL_KEY_AUTO) ] [TON(TIMER_ALARM[24],?,?) ,XIC(TIMER_ALARM[24].DN) MOV(21,STEP_ALARM[0]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CELL COMMUNICATIONS STATUS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_ASI_NODES_READY)XIC(CELL_ASI_ETHERNET_COMMS_OK)XIC(DRV01_ETHERNET_COMMS_OK)XIC(DRV02_ETHERNET_COMMS_OK)XIC(DRV03_ETHERNET_COMMS_OK)XIC(DRV04_ETHERNET_COMMS_OK)XIC(DRV05_ETHERNET_COMMS_OK)XIC(DRV06_ETHERNET_COMMS_OK)XIC(DRV07_ETHERNET_COMMS_OK)XIC(DRV08_ETHERNET_COMMS_OK)XIC(DRV09_ETHERNET_COMMS_OK)XIC(DRV10_ETHERNET_COMMS_OK)XIC(DRV11_ETHERNET_COMMS_OK)XIC(DRV17_ETHERNET_COMMS_OK)[XIC(DRV31_ETHERNET_COMMS_OK) ,][XIC(ENC31_ETHERNET_COMMS_OK) XIC(ENET31_ETHERNET_COMMS_OK) XIC(INKJET_PRINTER_ETHERNET_COMMS_OK) ,XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) ]XIC(MAN01_ETHERNET_COMMS_OK)XIC(MAN02_ETHERNET_COMMS_OK)XIC(MAN03_ETHERNET_COMMS_OK)XIC(MAN04_ETHERNET_COMMS_OK)XIC(R1_COMMS_OK)XIC(R2_COMMS_OK)XIC(R3_COMMS_OK)[XIC(VISION_ETHERNET_COMMS_OK) ,XIO(VISION_ACTIVE_PB) ,]XIC(PREHEAT1_RTD_ETHERNET_COMMS_OK)XIC(PREHEAT2_RTD_ETHERNET_COMMS_OK)OTE(CELL_COMM_READY);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[CELL BUTTONS]]>
</Comment>
<Text>
<![CDATA[[[[XIC(A:I.Data[1].16) ,XIC(A:I.Data[1].20) ,XIC(A:I.Data[1].24) ,XIC(A:I.Data[1].28) ,XIC(CELL_STOP_PB) ] TON(TIMER_OPER[7],?,?) ,XIC(TIMER_OPER[7].DN) OTE(CELL_STOP_PRESSED) ,EQU(STEP_ESTOP_RESET[0],500) OTE(CELL_STOP_PB_VIS) ] ,[[[XIC(A:I.Data[1].18) ,XIC(A:I.Data[1].22) ,XIC(A:I.Data[1].26) ,XIC(A:I.Data[1].30) ,XIC(CELL_RESET_PB) ] ONS(ONS_ARRAY[79]) XIC(CELL_RESET_READY) ,XIC(TIMER_OPER[8].TT) ] TON(TIMER_OPER[8],?,?) ,[XIC(TIMER_OPER[8].DN) ONS(ONS_ARRAY[85]) ,XIC(CELL_RESET_PRESSED) XIO(TIMER_OPER[6].DN) ] [OTE(CELL_RESET_PRESSED) ,ONS(ONS_ARRAY[6]) OTL(CELL_CLEAR_MESSAGE_PB) ,TON(TIMER_OPER[6],?,?) ] ] ,XIC(CELL_AUTO_READY[0]) [XIO(CELL_STOP_PRESSED) [XIC(A:I.Data[1].17) ,XIC(A:I.Data[1].21) ,XIC(A:I.Data[1].25) ,XIC(A:I.Data[1].29) ,XIC(CELL_START_PB) ] TON(TIMER_OPER[9],?,?) ,XIC(TIMER_OPER[9].DN) OTE(CELL_START_PRESSED) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CELL IS ATTEMPTING TO RESET]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RESET_READY) LIM(20,STEP_ESTOP_RESET[0],30) ,XIC(CELL_KEY_AUTO_MODE) XIC(CELL_IS_RESETTING) XIO(CELL_AUTO_ENABLED) NEQ(STEP_ESTOP_RESET[0],1000) ]OTE(CELL_IS_RESETTING);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CELL AUTO READY REQUIREMENTS
ADD STATION AUTO READY COMPONENTS]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[0],500) XIC(CELL_KEY_AUTO_MODE) XIO(CELL_MANUAL_MODE) XIC(A:I.Data[2].16) XIC(CELL_AUTO_READY[1]) XIC(CELL_AUTO_READY[2]) XIC(CELL_AUTO_READY[3]) XIC(CELL_AUTO_READY[4]) XIC(CELL_AUTO_READY[5]) XIC(CELL_AUTO_READY[7]) XIC(CELL_AUTO_READY[9]) XIC(CELL_AUTO_READY[10]) XIC(CELL_AUTO_READY[12]) XIC(CELL_AUTO_READY[13]) XIC(CELL_AUTO_READY[14]) XIC(CELL_AUTO_READY[15]) XIC(CELL_AUTO_READY[16]) XIC(CELL_AUTO_READY[17]) XIC(CELL_AUTO_READY[18]) XIC(CELL_AUTO_READY[19]) XIC(CELL_AUTO_READY[20]) XIC(CELL_AUTO_READY[21]) XIC(CELL_AUTO_READY[22]) XIC(CELL_AUTO_READY[30]) XIC(CELL_AUTO_READY[30]) OTE(CELL_AUTO_READY[0]) ,XIO(CELL_STARTED) XIC(CELL_TIMING_BIT_500) [XIO(CELL_AUTO_READY[0]) OTE(CELL_AUTO_NOT_READY_ANIMATION) ,[XIO(CELL_AUTO_READY[1]) ,XIO(CELL_AUTO_READY[4]) ,XIO(CELL_AUTO_READY[10]) ,XIO(CELL_AUTO_READY[12]) ,XIO(CELL_AUTO_READY[13]) ,XIO(CELL_AUTO_READY[14]) ,XIO(CELL_AUTO_READY[15]) ,XIO(CELL_AUTO_READY[16]) ,XIO(CELL_AUTO_READY[17]) ,XIO(CELL_AUTO_READY[18]) ,XIO(CELL_AUTO_READY[19]) ,XIO(CELL_AUTO_READY[20]) ] OTE(CELL_MAIN_DIAL_AUTO_NOT_READY_ANIMATION) ] ,XIC(CELL_KEY_AUTO_MODE) XIO(CELL_STARTED) NEQ(STEP_ESTOP_RESET[0],1000) OTE(CELL_AUTO_READY_SCREEN_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CELL IS AUTO ENABLED]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)EQU(STEP_ESTOP_RESET[0],500)XIC(CELL_AUTO_READY[0])OTE(CELL_AUTO_ENABLED);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[START CELL
]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_START_PRESSED) ,XIC(CELL_STARTED) EQU(STEP_ESTOP_RESET[0],500) ]OTE(CELL_STARTED);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[*********************** CELL HMI STATUS LINE *****************

MESSAGE "READY TO RESET"]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RESET_READY)XIO(CELL_AUTO_ENABLED)XIO(CELL_STARTED)XIO(CELL_IS_RESETTING)NEQ(STEP_ESTOP_RESET[0],500)[MOV(0,CELL_STATUS) ,OTE(CELL_RESET_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[MESSAGE "NOT READY TO RESET"]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_RESET_READY)XIO(CELL_STARTED)MOV(1,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[MESSAGE "RUNNING IN AUTO"]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_SHUTDOWN_REQ)XIC(CELL_STARTED)MOV(2,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[MESSAGE "PLEASE WAIT"]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_SHUTDOWN_REQ)XIO(CELL_STARTED)XIC(CELL_KEY_AUTO_MODE)[XIC(CELL_IS_RESETTING) ,EQU(STEP_ESTOP_RESET[0],500) ]XIO(CELL_AUTO_ENABLED)[XIC(CELL_MANUAL_MODE) NEQ(STEP_ESTOP_RESET[0],500) ,XIO(CELL_MANUAL_MODE) ]MOV(3,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[MESSAGE "READY TO START"]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_AUTO_ENABLED)[MOV(4,CELL_STATUS) ,OTE(CELL_START_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[MESSAGE "MANUAL MODE"]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_KEY_AUTO_MODE)XIC(CELL_MANUAL_MODE)EQU(STEP_ESTOP_RESET[0],500)MOV(5,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[MESSAGE "ROBOT MANUAL MODE"]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_KEY_MAN_MODE)XIC(CELL_MANUAL_MODE)EQU(STEP_ESTOP_RESET[0],500)MOV(6,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[
MESSAGE "E-STOP ACTIVE"]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_ESTOP_PRESSED)MOV(7,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[MESSAGE "SHUTDOWN IN PROGRESS"]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_SHUTDOWN_REQ)MOV(8,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[MESSAGE "ROBOT MODE"]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_KEY_MAN_MODE)XIO(CELL_MANUAL_MODE)EQU(STEP_ESTOP_RESET[0],500)MOV(9,CELL_STATUS);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[REQUIREMENTS FOR ACTIVATING CELL ALARMS]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[0],1000)XIC(CELL_KEY_AUTO_MODE)OTE(CELL_ALARMS_ACTIVE);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[SINGLE PART MODE CONTROL]]>
</Comment>
<Text>
<![CDATA[[[XIO(CELL_STARTED) [OTE(CELL_SINGLE_PART_MODE_PB_VIS) ,XIC(CELL_AUTO_READY[0]) XIC(CELL_SINGLE_PART_MODE_ACTIVE) OTE(CELL_SINGLE_PART_GLUE_ONLY_PB_VIS) ] ,XIO(CELL_SINGLE_PART_MODE_ACTIVE) OTU(CELL_SINGLE_PART_GLUE_ONLY_PB) ] ,XIC(CELL_STARTED) XIC(CELL_SINGLE_PART_MODE_ACTIVE) OTE(CELL_SINGLE_PART_PROCESS_PB_VIS) ,[XIC(CELL_SINGLE_PART_MODE_PB) [ONS(ONS_ARRAY[3]) OTL(CELL_SINGLE_PART_MODE_POPUP) ,XIC(CELL_SINGLE_PART_MODE_YES_PB) [OTL(CELL_SINGLE_PART_MODE_ACTIVE) ,OTU(CELL_SINGLE_PART_MODE_POPUP) ] ] ,XIC(CELL_SINGLE_PART_MODE_NO_PB) [OTU(CELL_SINGLE_PART_MODE_PB) ,OTU(CELL_SINGLE_PART_MODE_POPUP) ] ] ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIC(CELL_SINGLE_PART_PROCESS_PB) XIC(CELL_STARTED) XIC(CELL_SINGLE_PART_MODE_BARRIER_COUNTER.DN) XIC(CELL_SINGLE_PART_MODE_BAG_COUNTER.DN) [XIO(MAIN_DIAL_DRV_MOVING) TON(CELL_TIMER_OPER[11],?,?) ,XIC(MAIN_DIAL_EMPTY) [TON(CELL_TIMER_OPER[14],?,?) ,XIC(CELL_TIMER_OPER[14].DN) OTU(CELL_SINGLE_PART_PROCESS_PB) ] ] ,XIO(CELL_SINGLE_PART_MODE_PB) [OTU(CELL_SINGLE_PART_MODE_POPUP) ,OTU(CELL_SINGLE_PART_PROCESS_PB) ] ,XIO(CELL_SINGLE_PART_PROCESS_PB) [RES(CELL_SINGLE_PART_MODE_BARRIER_COUNTER) ,RES(CELL_SINGLE_PART_MODE_BAG_COUNTER) ,RES(BAG_LOAD_BARRIER_COUNTER) ] ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[EMPTY MODE HMI CONTROL]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_STARTED) XIO(CELL_EMPTY_ACTIVE) XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) OTE(CELL_EMPTY_PB_VIS) ,[XIC(CELL_EMPTY_PB) XIC(CELL_EMPTY_YES_PB) OTL(CELL_EMPTY_ACTIVE) ,XIC(CELL_EMPTY_NO_PB) ] OTU(CELL_EMPTY_PB) ,XIC(CELL_EMPTY_ACTIVE) [XIO(CELL_EMPTY_COMPLETE.15) MOV(15,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.13) MOV(13,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.12) MOV(12,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.11) MOV(11,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.10) MOV(10,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.9) MOV(9,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.8) MOV(8,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.7) MOV(7,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.6) MOV(6,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.5) MOV(5,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.4) MOV(4,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.2) MOV(2,CELL_EMPTY_STATUS) ,XIO(CELL_EMPTY_COMPLETE.1) MOV(1,CELL_EMPTY_STATUS) ] ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[TOOL CHANGE MODE]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) EQU(STEP_ESTOP_RESET[0],1000) OTE(CELL_TOOL_CHANGE_REQ_PB_VIS) ,XIO(CELL_KEY_AUTO_MODE) OTU(CELL_TOOL_CHANGE_REQ_PB) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[MONITOR EXCESS CYCLE TIME AND REQUEST INDEX IF NECESSARY]]>
</Comment>
<Text>
<![CDATA[[GRT(CELL_TIMER_OPER[7].ACC,CELL_MAX_WAIT_FOR_INDEX_TIME) ,GRT(CELL_TIMER_OPER[9].ACC,CELL_MAX_WAIT_FOR_INDEX_TIME) ,GRT(CELL_TIMER_OPER[10].ACC,CELL_MAX_WAIT_FOR_INDEX_TIME) ,GRT(CELL_TIMER_OPER[11].ACC,CELL_MAX_WAIT_FOR_INDEX_TIME) ]OTE(CELL_CYCLE_TIMEOUT_INDEX_REQ);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[MONITOR SAFETY RELAYS IN HEATER CIRCUIT]]>
</Comment>
<Text>
<![CDATA[[XIC(PREHEAT_ACTIVATE_HEATERS_PB) [XIO(CELL_RESET_PRESSED) [XIO(A:I.Data[2].8) ,AFI() XIO(A:I.Data[2].9) ,XIO(A:I.Data[2].10) ,XIO(A:I.Data[2].11) ] [TON(TIMER_ALARM[18],?,?) ,XIC(CELL_ALARMS_ACTIVE) XIC(TIMER_ALARM[18].DN) [XIO(A:I.Data[2].8) MOV(235,STEP_ALARM[13]) ,XIO(A:I.Data[2].9) MOV(236,STEP_ALARM[13]) ,XIO(A:I.Data[2].10) MOV(255,STEP_ALARM[14]) ,XIO(A:I.Data[2].11) MOV(256,STEP_ALARM[14]) ] ] ,XIO(TIMER_ALARM[18].DN) OTL(A:O.Data[2].19) ] ,[XIO(PREHEAT_ACTIVATE_HEATERS_PB) ,XIC(TIMER_ALARM[18].DN) ] [OTU(A:O.Data[2].19) ,OTU(PREHEAT_ACTIVATE_HEATERS_PB) ] ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[CELL INACTIVITY TIMER
FAULT MACHINE]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)XIC(CELL_KEY_AUTO_MODE)EQU(STEP_ESTOP_RESET[0],500)[TON(TIMER_OPER[16],?,?) ,XIC(TIMER_OPER[16].DN) MOV(896,STEP_ALARM[0]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SYSTEM" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CELL SYSTEM
***************************************************************************

.010 SECOND TIMING BIT ROUTINE]]>
</Comment>
<Text>
<![CDATA[[TON(CELL_TIMER_OPER[6],?,?) ,LEQ(CELL_TIMER_OPER[6].ACC,10) OTE(CELL_TIMING_BIT_10) ,GRT(CELL_TIMER_OPER[6].ACC,20) OTE(CELL_TIMING_BIT_10_FLIP) ,XIC(CELL_TIMER_OPER[6].DN) RES(CELL_TIMER_OPER[6]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[.100 SECOND TIMING BIT ROUTINE]]>
</Comment>
<Text>
<![CDATA[[TON(CELL_TIMER_OPER[1],?,?) ,LEQ(CELL_TIMER_OPER[1].ACC,100) OTE(CELL_TIMING_BIT_100) ,GRT(CELL_TIMER_OPER[1].ACC,100) OTE(CELL_TIMING_BIT_100_FLIP) ,XIC(CELL_TIMER_OPER[1].DN) RES(CELL_TIMER_OPER[1]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[.150 SECOND TIMING BIT ROUTINE]]>
</Comment>
<Text>
<![CDATA[[TON(CELL_TIMER_OPER[2],?,?) ,LEQ(CELL_TIMER_OPER[2].ACC,150) OTE(CELL_TIMING_BIT_150) ,GRT(CELL_TIMER_OPER[2].ACC,150) OTE(CELL_TIMING_BIT_150_FLIP) ,XIC(CELL_TIMER_OPER[2].DN) RES(CELL_TIMER_OPER[2]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[0.25 SECOND TIMING BIT ROUTINE]]>
</Comment>
<Text>
<![CDATA[[TON(CELL_TIMER_OPER[3],?,?) ,LEQ(CELL_TIMER_OPER[3].ACC,250) OTE(CELL_TIMING_BIT_250) ,GRT(CELL_TIMER_OPER[3].ACC,250) OTE(CELL_TIMING_BIT_250_FLIP) ,XIC(CELL_TIMER_OPER[3].DN) RES(CELL_TIMER_OPER[3]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[.500 SECOND TIMING BIT ROUTINE]]>
</Comment>
<Text>
<![CDATA[[TON(CELL_TIMER_OPER[4],?,?) ,LEQ(CELL_TIMER_OPER[4].ACC,500) OTE(CELL_TIMING_BIT_500) ,GRT(CELL_TIMER_OPER[4].ACC,500) OTE(CELL_TIMING_BIT_500_FLIP) ,XIC(CELL_TIMER_OPER[4].DN) RES(CELL_TIMER_OPER[4]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[1 SECOND TIMING BIT ROUTINE]]>
</Comment>
<Text>
<![CDATA[[TON(CELL_TIMER_OPER[5],?,?) ,LEQ(CELL_TIMER_OPER[5].ACC,1000) OTE(CELL_TIMING_BIT_1000) ,GRT(CELL_TIMER_OPER[5].ACC,1000) OTE(CELL_TIMING_BIT_1000_FLIP) ,XIC(CELL_TIMER_OPER[5].DN) RES(CELL_TIMER_OPER[5]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[OZONE DESTRUCTION CONTROL]]>
</Comment>
<Text>
<![CDATA[XIC(PNP_CORONA_ACTIVE_RECIPE_LOADED)[XIC(CELL_OZONE_DESTRUCT_ON_PB) OTE(A:O.Data[2].16) ,[XIC(CELL_STARTED) ONS(ONS_ARRAY[43]) ,XIO(CELL_MANUAL_MODE) XIC(PNP_CORONA_ON_PB) ] OTL(CELL_OZONE_DESTRUCT_ON_PB) ,[XIC(A:O.Data[2].16) XIO(PNP_CORONA_ON_PB) TON(TIMER_OPER[17],?,?) ,XIC(TIMER_OPER[17].DN) OTU(CELL_OZONE_DESTRUCT_ON_PB) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[MAINTENANCE CYLINDER CYCLE COUNTERS]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN01:O.Data[3].12) XIC(PUNCH_CYL_EXT) CTU(PUNCH_CYL_CYCLE_CNT,?,?) ,XIC(PUNCH_CYL_CYCLE_CNT_ZERO_PB) [RES(PUNCH_CYL_CYCLE_CNT) ,OTU(PUNCH_CYL_CYCLE_CNT_ZERO_PB) ] ];]]>
</Text>
</Rung>
