<Routine Name="ANALOG_SETUP_MAN02" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MANIFOLD 02 ANALOG SETUP ROUTINE
*****************************************************************************************************

AFTER COMMUNICATIONS ARE RESTABLISHED WAIT FOR THE HMI BUTTON TO BE PRESSED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],1000)XIC(MAN02_ETHERNET_COMMS_OK)[XIC(MAN02_LOAD_ANALOG_MAN_SET_PB) ONS(ONS_ARRAY[32]) MOV(10,MAN02_STEP_ANALOG_SETUP) ,OTE(MAN02_LOAD_ANALOG_MAN_SET_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[THE DOWN LOAD STEPS ARE OUT OF ORDER PURPOSELY IN ORDER TO CAUSE AN ON/OFF CONDITION PRIOR TO THE NEXT STEP.

LOOP TO THE NEXT STEP UNTIL STEPS ARE COMPLETED]]>
</Comment>
<Text>
<![CDATA[EQU(MAN02_STEP_ANALOG_SETUP,30)[XIO(MAN02_ANALOG_SETUP_COUNTER.DN) MOV(10,MAN02_STEP_ANALOG_SETUP) ,XIC(MAN02_ANALOG_SETUP_COUNTER.DN) [OTU(MAN02_LOAD_ANALOG_MAN_SET_PB) ,RES(MAN02_ANALOG_SETUP_COUNTER) ,MOV(500,MAN02_STEP_ANALOG_SETUP) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WRITE MESSAGE TO MANIFOLD 02
 
ANALOG MODULE 1
BARRIER PRESS-N-CURE ANALOG INPUT/OUTPUT

 ANALOG MODULE 2
SPARE]]>
</Comment>
<Text>
<![CDATA[EQU(MAN02_STEP_ANALOG_SETUP,20)[MSG(MAN02_ANALOG_MODULE_SETUP_MSG) ,XIC(MAN02_ANALOG_MODULE_SETUP_MSG.DN) [CTU(MAN02_ANALOG_SETUP_COUNTER,?,?) ,MOV(30,MAN02_STEP_ANALOG_SETUP) ] ,XIC(MAN02_ANALOG_MODULE_SETUP_MSG.ER) [MOV(142,STEP_ALARM[0]) ,OTU(MAN02_LOAD_ANALOG_MAN_SET_PB) ,MOV(1000,MAN02_STEP_ANALOG_SETUP) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[DEPENDING ON THE LOOP NUMBER FILL THE MESSAGE VARIABLES.
 INSTANCE = MODULE NUMBER
CLASS = PARAMETER - HEX 8A (DEC. 138) SET ANALOG SCALE
ATTRIBUTE = CHANNEL NUMBER - HEX 64 (DEC. 100) CHANNELS ARE 0 - 3 OR (64h - 67h)
ANALOG_SETUP_SOURCE_ELEMENT = SCALE TYPE FOR THE CHANNEL
0 = -10 - 10 V
1 = -5 - 5 V
2 = -20 - 20 mA
3 = 0 - 10 V
4 = 0 - 5 V
5 = 1 - 5 V
6 = 0 - 20 mA
7 = 4 - 20 mA]]>
</Comment>
<Text>
<![CDATA[EQU(MAN02_STEP_ANALOG_SETUP,10)[EQU(MAN02_ANALOG_SETUP_COUNTER.ACC,0) [MOV(1,MAN02_ANALOG_MODULE_SETUP_MSG.Instance) ,MOV(138,MAN02_ANALOG_MODULE_SETUP_MSG.Class) ,MOV(100,MAN02_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(4,MAN02_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN02_STEP_ANALOG_SETUP) ] ,EQU(MAN02_ANALOG_SETUP_COUNTER.ACC,1) [MOV(102,MAN02_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(3,MAN02_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN02_STEP_ANALOG_SETUP) ] ,EQU(MAN02_ANALOG_SETUP_COUNTER.ACC,2) [MOV(101,MAN02_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(7,MAN02_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN02_STEP_ANALOG_SETUP) ] ,EQU(MAN02_ANALOG_SETUP_COUNTER.ACC,3) [MOV(2,MAN02_ANALOG_MODULE_SETUP_MSG.Instance) ,MOV(138,MAN02_ANALOG_MODULE_SETUP_MSG.Class) ,MOV(100,MAN02_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(4,MAN02_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN02_STEP_ANALOG_SETUP) ] ,EQU(MAN02_ANALOG_SETUP_COUNTER.ACC,4) [MOV(102,MAN02_ANALOG_MODULE_SETUP_MSG.Attribute) ,MOV(3,MAN02_ANALOG_SETUP_SOURCE_ELEMENT) ,MOV(20,MAN02_STEP_ANALOG_SETUP) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
