</Comment>
<Text>
<![CDATA[[GEQ(TIMER_OPER[14].ACC,500) ONS(ONS_ARRAY[48]) GSV(Module,A,EntryStatus,CELL_ASI_ETHERNET_STATUS) ,XIO(CELL_ASI_ETHERNET_STATUS.12) XIO(CELL_ASI_ETHERNET_STATUS.13) XIC(CELL_ASI_ETHERNET_STATUS.14) XIO(CELL_ASI_ETHERNET_STATUS.15) OTE(CELL_ASI_ETHERNET_COMMS_OK) ,XIC(CELL_ALARMS_ACTIVE) XIO(CELL_ASI_ETHERNET_COMMS_OK) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(800,STEP_ALARM[0]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
