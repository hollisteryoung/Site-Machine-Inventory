<![CDATA[XIC(VISION_ACTIVE_PB)[XIC(VISION_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.13) ]XIC(VISION_DATA_BAG_LOADED)XIO(VISION_DATA_BAG_REJECT)XIC(VISION_DATA_PNC_COMPLETE)XIC(VISION_DATA_VISION_COMPLETE)[XIO(VISION_DATA_VISION_PASS) [[CTU(VISION_REJECT_CNT,?,?) ,ONS(ONS_ARRAY[70]) ADD(CELL_DATA_COLLECTION[18],1,CELL_DATA_COLLECTION[18]) ,NEQ(VISION_REJECT_CNT.ACC,VISION_PREV_REJECT_CNT) MOV(1,VISION_CTR_REJECT_CYCLE) ,EQU(VISION_REJECT_CNT.ACC,VISION_PREV_REJECT_CNT) MOV(0,VISION_CTR_REJECT_CYCLE) ,MOV(VISION_REJECT_CNT.ACC,VISION_PREV_REJECT_CNT) ] ,[CTU(VISION_REJECT_MULT_CNT,?,?) ,GEQ(VISION_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,VISION_CTR_REJECT_CYCLE) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,OTL(VISION_DATA_BAG_REJECT) ,MOV(11,VISION_DATA_POS_BAG_REJECT) ] ,XIC(VISION_DATA_VISION_PASS) [RES(VISION_REJECT_MULT_CNT) ,MOV(0,VISION_CTR_REJECT_CYCLE) ] ];]]>
