<Text>
<![CDATA[[XIC(PNC_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.12) ,XIC(PNC_PROCESS_FAILED) ]ONS(ONS_ARRAY[108])XIO(PNC_DATA_BAG_REJECT)XIC(PNC_DATA_GLUE_COMPLETE)[XIO(BAG_TAIL_PRESENT) [[CTU(PNC_BAG_TAIL_REJECT_CNT,?,?) ,ONS(ONS_ARRAY[109]) ADD(CELL_DATA_COLLECTION[22],1,CELL_DATA_COLLECTION[22]) ,NEQ(PNC_BAG_TAIL_REJECT_CNT.ACC,PNC_PREV_BAG_TAIL_REJECT_CNT) MOV(1,PNC_CTR_BAG_TAIL) ,EQU(PNC_BAG_TAIL_REJECT_CNT.ACC,PNC_PREV_BAG_TAIL_REJECT_CNT) MOV(0,PNC_CTR_BAG_TAIL) ,MOV(PNC_BAG_TAIL_REJECT_CNT.ACC,PNC_PREV_BAG_TAIL_REJECT_CNT) ] ,[CTU(PNC_BAG_TAIL_REJECT_MULT_CNT,?,?) ,GEQ(PNC_BAG_TAIL_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PNC_CTR_BAG_TAIL) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,[OTL(PNC_DATA_BAG_REJECT) ,MOV(10,PNC_DATA_POS_BAG_REJECT) ] ] ,XIC(BAG_TAIL_PRESENT) [RES(PNC_BAG_TAIL_REJECT_MULT_CNT) ,MOV(0,PNC_CTR_BAG_TAIL) ] ];]]>
