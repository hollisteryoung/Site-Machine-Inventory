<Rung Number="10" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],1000)[OTU(CELL_SHUTDOWN_REQ) OTU(CELL_MULTIPLE_FAILURES) OTU(CELL_EMPTY_PB) OTU(CELL_EMPTY_ACTIVE) OTU(CELL_SINGLE_PART_PROCESS_PB) OTU(CELL_PRESSURE_OK) OTU(CELL_SINGLE_PART_GLUE_ONLY_PB) OTU(CELL_EMPTY_LAST_BAG_REQUESTED) ,ONS(ONS_ARRAY[77]) [OTU(CELL_TEST_DOOR_LOCKS_PB) ,OTU(CELL_RESET_PB) ,OTU(CELL_START_PB) ,OTU(CELL_STOP_PB) ] ,OTU(BARRIER_LOAD_DATA_EMPTY_LAST_BAG) OTU(EMPTY_DATA_EMPTY_LAST_BAG) OTU(BAG_LOAD_DATA_EMPTY_LAST_BAG) OTU(PREHEAT1_DATA_EMPTY_LAST_BAG) ,OTU(PREHEAT2_DATA_EMPTY_LAST_BAG) OTU(FORMING_DATA_EMPTY_LAST_BAG) OTU(PUNCH_DATA_EMPTY_LAST_BAG) OTU(PRINT_DATA_EMPTY_LAST_BAG) ,OTU(GLUE_DATA_EMPTY_LAST_BAG) OTU(PNC_DATA_EMPTY_LAST_BAG) OTU(VISION_DATA_EMPTY_LAST_BAG) OTU(BAG_OFFLOAD_DATA_EMPTY_LAST_BAG) ,MOV(0,CELL_EMPTY_COMPLETE) ,MOV(1000,STEP_HOME[0]) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RESET_PRESSED)ONS(ONS_ARRAY[90])EQU(STEP_ESTOP_RESET[0],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)[XIC(CELL_RESET_READY) ,XIC(CELL_KEY_MAN_MODE) ]MOV(10,STEP_ESTOP_RESET[0]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],10)[OTU(CELL_ALARM_RED_LIGHT) ,MOV(0,STEP_ALARM[0]) ,MOV(0,CELL_MESSAGE) ,MOV(0,STEP_ALARM_TRIGGER_WORD_1) ,MOV(20,STEP_ESTOP_RESET[0]) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[RESET MACHINE BASED UPON AUTO OR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],20)XIO(CELL_RESET_PRESSED)XIC(CELL_RESET_READY)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[0]) ,MOV(30,STEP_ESTOP_RESET[0]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[0]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],30)EQU(STEP_HOME[0],500)MOV(500,STEP_ESTOP_RESET[0]);]]>
</Text>
</Rung>
