<Rung Number="40" Type="N">
<Comment>
<![CDATA[************HMI MESSAGE AND HISTORY CONTROL**********

LOAD ALARM INTO MESSAGE DISPLAY VARIABLE
AND CONTROL ALARM HISTORY]]>
</Comment>
<Text>
<![CDATA[[LIM(500,CELL_MESSAGE,0) NEQ(STEP_ALARM[0],0) MOV(STEP_ALARM[0],CELL_MESSAGE) ,NEQ(CELL_MESSAGE,CELL_MESSAGE_PREVIOUS) [MOV(CELL_MESSAGE,CELL_MESSAGE_PREVIOUS) ,LIM(1,CELL_MESSAGE,896) NEQ(CELL_MESSAGE,19) [COP(CELL_MESSAGE_HIST_ARRAY[0],CELL_MESSAGE_HIST_ARRAY_TEMP[0],75) ,COP(CELL_MESSAGE_HIST_ARRAY_TEMP[0],CELL_MESSAGE_HIST_ARRAY[1],74) ,MOV(CELL_MESSAGE,CELL_MESSAGE_HIST_ARRAY[0]) ,COP(CELL_PLC_DATE_STAMP_ARRAY[0],CELL_PLC_DATE_STAMP_ARRAY_TEMP[0],75) ,COP(CELL_PLC_DATE_STAMP_ARRAY_TEMP[0],CELL_PLC_DATE_STAMP_ARRAY[1],74) ,COP(CELL_PLC_DATE_STAMP,CELL_PLC_DATE_STAMP_ARRAY[0],1) ] ] ];]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[CLEAR MESSAGE]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_CLEAR_MESSAGE_PB) ,XIC(CELL_DISPLAY_PASSWORD_ENTRY) ] ONS(ONS_ARRAY[2]) [EQU(CELL_MESSAGE,STEP_ALARM[0]) MOV(0,STEP_ALARM[0]) ,MOV(0,CELL_MESSAGE) ,OTU(CELL_CLEAR_MESSAGE_PB) ] ,NEQ(CELL_MESSAGE,0) OTE(CELL_DISPLAY_MSG_RESET_PB) ];]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[DISPLAY MESSAGE ABOUT SCREEN SELECTION
WHEN IN MANUAL, MODE ONLY ONE SCREEN IS ALLOWED TO BE OPERATIONAL
]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_ACTIVATE_MANUAL_MODE)[XIO(CELL_HMI_BYPASS) ONS(ONS_ARRAY[8]) OTL(CELL_HMI_MANUAL_POPUP) ,[XIC(CELL_PASSWORD_GOOD) ,XIC(CELL_HMI_BYPASS) ] [XIC(CELL_HMI_1_PB) XIO(CELL_HMI_2_PB) XIO(CELL_HMI_3_PB) ,XIO(CELL_HMI_1_PB) XIC(CELL_HMI_2_PB) XIO(CELL_HMI_3_PB) ,XIO(CELL_HMI_1_PB) XIO(CELL_HMI_2_PB) XIC(CELL_HMI_3_PB) ,XIC(CELL_HMI_BYPASS) ] OTE(CELL_MANUAL_MODE) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[CLEAR MESSAGE WHEN A HMI HAS BEEN SELECTED]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_HMI_1_PB) ,XIC(CELL_HMI_2_PB) ,XIC(CELL_HMI_3_PB) ]ONS(ONS_ARRAY[42])XIO(CELL_MANUAL_MODE)OTL(CELL_DISPLAY_PASSWORD_ENTRY);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Comment>
<![CDATA[RESET MANUAL MODE SEQUENCE IF INACTIVE]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_ACTIVATE_MANUAL_MODE) OTU(CELL_PASSWORD_GOOD) ,[XIC(CELL_HMI_1_PB) ,XIC(CELL_HMI_2_PB) ,XIC(CELL_HMI_3_PB) ,XIC(CELL_ACTIVATE_MANUAL_MODE) ,XIC(CELL_DISPLAY_PASSWORD_ENTRY) ] XIO(CELL_MANUAL_MODE) TON(TIMER_OPER[3],?,?) ,[XIC(TIMER_OPER[3].DN) ,XIC(CELL_HMI_MANUAL_CANCEL_PB) ] [OTU(CELL_HMI_1_PB) ,OTU(CELL_HMI_2_PB) ,OTU(CELL_HMI_3_PB) ,OTU(CELL_ACTIVATE_MANUAL_MODE) ,OTU(CELL_DISPLAY_PASSWORD_ENTRY) ,OTU(CELL_HMI_MANUAL_POPUP) ,MOV(0,CELL_MESSAGE) ] ];]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Comment>
<![CDATA[TEST MANUAL PASSWORD]]>
</Comment>
<Text>
<![CDATA[EQU(CELL_MANUAL_MODE_PASSWORD,CELL_MANUAL_MODE_PASSWORD_STORED)[OTL(CELL_PASSWORD_GOOD) ,MOV(0,CELL_MANUAL_MODE_PASSWORD) ,OTU(CELL_DISPLAY_PASSWORD_ENTRY) ,OTU(CELL_HMI_MANUAL_POPUP) ];]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Comment>
<![CDATA[CLEAR PASSWORD AND RESET ACTIVATE MANUAL PUSH BUTTON]]>
</Comment>
<Text>
<![CDATA[NEQ(CELL_MANUAL_MODE_PASSWORD,CELL_MANUAL_MODE_PASSWORD_STORED)NEQ(CELL_MANUAL_MODE_PASSWORD,0)XIO(CELL_PASSWORD_GOOD)[MOV(0,CELL_MANUAL_MODE_PASSWORD) ,OTU(CELL_ACTIVATE_MANUAL_MODE) ,OTU(CELL_DISPLAY_PASSWORD_ENTRY) ,OTU(CELL_HMI_MANUAL_POPUP) ];]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Comment>
<![CDATA[SPECIAL CELL MODE VISIBILITY]]>
</Comment>
<Text>
<![CDATA[[[XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_TEST_PICK_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) OTE(CELL_BARRIER_PROD_ONLY_MODE_PB_VIS) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) [OTU(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,OTU(CELL_BAG_LOAD_ONLY_MODE_PB) ,OTU(CELL_BAG_TEST_PICK_MODE_PB) ,OTU(CELL_INSERT_LOAD_ONLY_MODE_PB) ] ] ,[XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_TEST_PICK_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) OTE(CELL_BARRIER_LOAD_ONLY_MODE_PB_VIS) ,XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) [OTU(CELL_BARRIER_PROD_ONLY_MODE_PB) ,OTU(CELL_BAG_LOAD_ONLY_MODE_PB) ,OTU(CELL_BAG_TEST_PICK_MODE_PB) ,OTU(CELL_INSERT_LOAD_ONLY_MODE_PB) ] ] ,[XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_TEST_PICK_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) OTE(CELL_BAG_LOAD_ONLY_MODE_PB_VIS) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) [OTU(CELL_BARRIER_PROD_ONLY_MODE_PB) ,OTU(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,OTU(CELL_BAG_TEST_PICK_MODE_PB) ,OTU(CELL_INSERT_LOAD_ONLY_MODE_PB) ] ] ,[XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) OTE(CELL_BAG_TEST_PICK_MODE_PB_VIS) ,XIC(CELL_BAG_TEST_PICK_MODE_PB) [OTU(CELL_BARRIER_PROD_ONLY_MODE_PB) ,OTU(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,OTU(CELL_BAG_LOAD_ONLY_MODE_PB) ,OTU(CELL_INSERT_LOAD_ONLY_MODE_PB) ] ] ,[XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_TEST_PICK_MODE_PB) OTE(CELL_INSERT_LOAD_ONLY_MODE_PB_VIS) ,XIC(CELL_INSERT_LOAD_ONLY_MODE_PB) [OTU(CELL_BARRIER_PROD_ONLY_MODE_PB) ,OTU(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,OTU(CELL_BAG_LOAD_ONLY_MODE_PB) ,OTU(CELL_BAG_TEST_PICK_MODE_PB) ] ] ];]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Comment>
<![CDATA[MACHINE PARAMETERS SKU PRINT METHOD INDICATOR]]>
</Comment>
<Text>
<![CDATA[[XIO(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) MOV(1,CELL_PARAM_SCREEN_SKU_METHOD) ,XIC(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) MOV(2,CELL_PARAM_SCREEN_SKU_METHOD) ,XIO(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) MOV(4,CELL_PARAM_SCREEN_SKU_METHOD) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CELL HOME ROUTINE
***************************************************************************

WAIT FOR COMPLETION OF HOME ROUTINES]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[0],0)EQU(STEP_HOME[1],500)EQU(STEP_HOME[2],500)EQU(STEP_HOME[3],500)EQU(STEP_HOME[4],500)EQU(STEP_HOME[5],500)EQU(STEP_HOME[7],500)EQU(STEP_HOME[9],500)EQU(STEP_HOME[10],500)EQU(STEP_HOME[12],500)EQU(STEP_HOME[13],500)EQU(STEP_HOME[14],500)EQU(STEP_HOME[15],500)EQU(STEP_HOME[16],500)EQU(STEP_HOME[17],500)EQU(STEP_HOME[18],500)EQU(STEP_HOME[19],500)EQU(STEP_HOME[20],500)EQU(STEP_HOME[21],500)EQU(STEP_HOME[22],500)EQU(STEP_HOME[30],500)EQU(STEP_HOME[31],500)[OTU(R2_SEQUENCE_ERROR) ,OTU(R3_SEQUENCE_ERROR) ,XIO(CELL_TOOL_CHANGE_REQ_PB) MOV(500,STEP_HOME[0]) ,XIC(CELL_TOOL_CHANGE_REQ_PB) [MOV(898,STEP_ALARM[0]) ,OTU(CELL_TOOL_CHANGE_REQ_PB) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="LIGHTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
CELL LIGHTS & AUDIBLE ALARM
***************************************************************************

LIGHTS]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_ALARM_RED_LIGHT) XIC(CELL_TIMING_BIT_500) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[2].6) ,[EQU(STEP_ESTOP_RESET[0],500) [GRT(CELL_MESSAGE,899) ,XIC(GLUE_ACTIVE_RECIPE_LOADED) XIO(GLUE_MELT_LEVEL_OK) ,XIC(INFEED_CONV_BAG_LANE_EMPTY_VIS) ] XIC(CELL_TIMING_BIT_500) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[2].5) ,[XIC(CELL_STARTED) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[2].4) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[AUDIBLE ALARM]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_AUDIBLE_SILENCE_PB) ,XIC(CELL_KEY_MAN_MODE) ,XIC(CELL_RESET_PRESSED) ,XIC(CELL_CLEAR_MESSAGE_PB) ] OTU(CELL_AUDIBLE_ALERT_ON) ,[XIC(CELL_ALARM_RED_LIGHT) ONS(ONS_ARRAY[15]) ,XIC(CELL_STARTED) NEQ(CELL_MESSAGE,0) NEQ(CELL_MESSAGE,909) ONS(ONS_ARRAY[1]) ,XIC(GLUE_ACTIVE_RECIPE_LOADED) XIO(GLUE_MELT_LEVEL_OK) ONS(ONS_ARRAY[7]) ,XIC(INFEED_CONV_BAG_LANE_EMPTY_VIS) ONS(ONS_ARRAY[12]) ] OTL(CELL_AUDIBLE_ALERT_ON) ,[XIC(CELL_AUDIBLE_ALERT_ON) [XIC(CELL_ALARM_RED_LIGHT) XIC(CELL_TIMING_BIT_1000) ,XIC(GLUE_ACTIVE_RECIPE_LOADED) XIO(GLUE_MELT_LEVEL_OK) XIC(CELL_TIMING_BIT_500) ,XIC(INFEED_CONV_BAG_LANE_EMPTY_VIS) XIC(CELL_TIMING_BIT_250) ] ,[XIC(CELL_AUDIBLE_ALARM_TEST_PB) ,LIM(1000,TIMER_OPER[9].ACC,3000) ] ] OTE(A:O.Data[2].7) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[********TGARD LIGHT CONTROLS*******

BLUE LIGHT
READY TO RESET
BUTTON]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[0],1000) XIC(CELL_RESET_READY) XIC(CELL_TIMING_BIT_1000) ,EQU(STEP_ESTOP_RESET[0],500) XIO(CELL_STARTED) ,XIC(CELL_LIGHT_TEST_PB) ][OTE(A:O.Data[1].17) ,OTE(A:O.Data[1].21) ,OTE(A:O.Data[1].25) ,OTE(A:O.Data[1].29) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[GREEN LIGHT
READY TO START]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RESET_READY) XIC(CELL_AUTO_ENABLED) XIC(CELL_TIMING_BIT_1000) ,XIC(CELL_STARTED) ,XIC(CELL_LIGHT_TEST_PB) ][OTE(A:O.Data[1].16) ,OTE(A:O.Data[1].20) ,OTE(A:O.Data[1].24) ,OTE(A:O.Data[1].28) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ E-STOP BUTTON LIGHTS]]>
</Comment>
<Text>
<![CDATA[[[XIO(A:I.Data[0].28) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[0].28) ,[XIO(A:I.Data[1].0) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[1].0) ,[XIO(A:I.Data[1].4) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[1].4) ,[XIO(A:I.Data[1].8) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[1].8) ,[XIO(A:I.Data[1].12) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[1].12) ,[XIO(A:I.Data[2].0) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[2].0) ,[XIO(A:I.Data[3].0) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[3].0) ,[XIO(A:I.Data[2].28) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[2].28) ,[XIO(A:I.Data[3].20) ,XIC(CELL_LIGHT_TEST_PB) ] OTE(A:O.Data[3].20) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ACCESS DOOR LIGHT CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[0],1000)[[XIC(BARRIER_MAG_DRV_HOMING_IND) ,XIC(BARRIER_MAG_DRV_MOVING) ,NEQ(STEP_ESTOP_RESET[0],500) ] OTE(A:O.Data[2].20) ,EQU(STEP_ESTOP_RESET[0],500) XIO(BARRIER_MAG_DRV_HOMING_IND) XIO(BARRIER_MAG_DRV_MOVING) OTE(A:O.Data[2].21) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[OVERHEAD LIGHT CONTROL]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_STARTED) OTU(CELL_OVERHEAD_LIGHTS_PB) ,EQU(STEP_ESTOP_RESET[0],1000) ONS(ONS_ARRAY[35]) OTL(CELL_OVERHEAD_LIGHTS_PB) ] ,XIC(CELL_OVERHEAD_LIGHTS_PB) OTE(A:O.Data[6].11) ,XIO(A:O.Data[6].11) TON(TIMER_OPER[13],?,?) XIC(TIMER_OPER[13].DN) OTE(CELL_OVERHEAD_LIGHTS_OFF) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(ASI_DIAG,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(COMMS,0) ,JSR(PART_DATA,0) ,JSR(SYSTEM,0) ,JSR(LIGHTS,0) ,JSR(HMI,0) ,JSR(DATE,0) ,JSR(RECIPE,0) ,JSR(SETTINGS,0) ,JSR(ANALOG_SETUP_MAN01,0) ,JSR(ANALOG_SETUP_MAN02,0) ,JSR(ANALOG_SETUP_MAN04,0) ,JSR(DATA_COLLECTION,0) ,JSR(RFID_BADGE_READER,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PART_DATA" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CELL PART DATA
***************************************************************************

TRACK THE NUMBER OF TIMES BARRIER AT PREHEAT STATION 1 WAS REJECTED DUE TO ALREADY BEING HEATED OR INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT1_ACTIVE_RECIPE_LOADED)XIC(PREHEAT2_PREHEAT1_PROCESS_FAILED)ONS(ONS_ARRAY[0])[CTU(PREHEAT1_INC_CYCLE_REJECT_CNT,?,?) ,[OTL(PREHEAT2_DATA_BAR_REJECT) ,MOV(5,PREHEAT2_DATA_POS_BAR_REJECT) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BARRIER AT PREHEAT STATION 1 WAS REJECTED DUE TO ALREADY BEING HEATED OR INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT1_ACTIVE_RECIPE_LOADED)[XIC(PREHEAT1_PROCESS_FAILED) ONS(ONS_ARRAY[103]) [[CTU(PREHEAT1_INC_CYCLE_REJECT_CNT,?,?) ,NEQ(PREHEAT1_INC_CYCLE_REJECT_CNT.ACC,PREHEAT1_PREV_INC_CYCLE_REJECT_CNT) MOV(1,PREHEAT1_CTR_INC_CYCLE) ,EQU(PREHEAT1_INC_CYCLE_REJECT_CNT.ACC,PREHEAT1_PREV_INC_CYCLE_REJECT_CNT) MOV(0,PREHEAT1_CTR_INC_CYCLE) ,MOV(PREHEAT1_INC_CYCLE_REJECT_CNT.ACC,PREHEAT1_PREV_INC_CYCLE_REJECT_CNT) ] ,[CTU(PREHEAT1_INC_CYCLE_REJECT_MULT_CNT,?,?) ,[GEQ(PREHEAT1_INC_CYCLE_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PREHEAT1_CTR_INC_CYCLE) ,OTL(CELL_MULTIPLE_FAILURES) ] ,OTL(PREHEAT1_DATA_BAR_REJECT) ,MOV(4,PREHEAT1_DATA_POS_BAR_REJECT) ] ] ] ,XIC(PREHEAT1_DATA_PREHEAT1_COMPLETE) [RES(PREHEAT1_INC_CYCLE_REJECT_MULT_CNT) ,MOV(0,PREHEAT1_CTR_INC_CYCLE) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES PREHEAT1 BARRIER WAS REJECTED DUE TO UPPER TEMP FAILURE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT1_ACTIVE_RECIPE_LOADED)[XIC(PREHEAT1_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.6) ]XIC(PREHEAT1_DATA_BAR_LOADED)XIO(PREHEAT1_DATA_BAR_REJECT)XIC(PREHEAT1_DATA_PREHEAT1_STARTED)[XIO(PREHEAT1_DATA_PREHEAT1_UP_TEMP_OK) [[CTU(PREHEAT1_UP_TEMP_REJECT_CNT,?,?) ,ADD(CELL_DATA_COLLECTION[8],1,CELL_DATA_COLLECTION[8]) ,NEQ(PREHEAT1_UP_TEMP_REJECT_CNT.ACC,PREHEAT1_PREV_UP_TEMP_REJECT_CNT) MOV(1,PREHEAT1_CTR_UP_TEMP) ,EQU(PREHEAT1_UP_TEMP_REJECT_CNT.ACC,PREHEAT1_PREV_UP_TEMP_REJECT_CNT) MOV(0,PREHEAT1_CTR_UP_TEMP) ,MOV(PREHEAT1_UP_TEMP_REJECT_CNT.ACC,PREHEAT1_PREV_UP_TEMP_REJECT_CNT) ] ,[CTU(PREHEAT1_UP_TEMP_REJECT_MULT_CNT,?,?) ,GEQ(PREHEAT1_UP_TEMP_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PREHEAT1_CTR_UP_TEMP) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,[OTL(PREHEAT1_DATA_BAR_REJECT) ,MOV(4,PREHEAT1_DATA_POS_BAR_REJECT) ] ] ,XIC(PREHEAT1_DATA_PREHEAT1_UP_TEMP_OK) [RES(PREHEAT1_UP_TEMP_REJECT_MULT_CNT) ,MOV(0,PREHEAT1_CTR_UP_TEMP) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES PREHEAT1 BARRIER WAS REJECTED DUE TO LOWER TEMP FAILURE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT1_ACTIVE_RECIPE_LOADED)[XIC(PREHEAT1_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.6) ]XIC(PREHEAT1_DATA_BAR_LOADED)XIO(PREHEAT1_DATA_BAR_REJECT)XIC(PREHEAT1_DATA_PREHEAT1_STARTED)[XIO(PREHEAT1_DATA_PREHEAT1_LOW_TEMP_OK) [[CTU(PREHEAT1_LOW_TEMP_REJECT_CNT,?,?) ,ADD(CELL_DATA_COLLECTION[9],1,CELL_DATA_COLLECTION[9]) ,NEQ(PREHEAT1_LOW_TEMP_REJECT_CNT.ACC,PREHEAT1_PREV_LOW_TEMP_REJECT_CNT) MOV(1,PREHEAT1_CTR_LOW_TEMP) ,EQU(PREHEAT1_LOW_TEMP_REJECT_CNT.ACC,PREHEAT1_PREV_LOW_TEMP_REJECT_CNT) MOV(0,PREHEAT1_CTR_LOW_TEMP) ,MOV(PREHEAT1_LOW_TEMP_REJECT_CNT.ACC,PREHEAT1_PREV_LOW_TEMP_REJECT_CNT) ] ,[CTU(PREHEAT1_LOW_TEMP_REJECT_MULT_CNT,?,?) ,GEQ(PREHEAT1_LOW_TEMP_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PREHEAT1_CTR_LOW_TEMP) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,OTL(PREHEAT1_DATA_BAR_REJECT) ,MOV(4,PREHEAT1_DATA_POS_BAR_REJECT) ] ,XIC(PREHEAT1_DATA_PREHEAT1_LOW_TEMP_OK) [RES(PREHEAT1_LOW_TEMP_REJECT_MULT_CNT) ,MOV(0,PREHEAT1_CTR_LOW_TEMP) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BARRIER AT PREHEAT STATION 2 WAS REJECTED DUE TO ALREADY BEING HEATED OR INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT2_ACTIVE_RECIPE_LOADED)[XIC(PREHEAT2_PROCESS_FAILED) ,XIC(PREHEAT2_PREHEAT1_PROCESS_FAILED) ,XIC(FORMING_PREHEAT2_PROCESS_FAILED) ]ONS(ONS_ARRAY[104])[[XIC(PREHEAT2_PROCESS_FAILED) ,XIC(FORMING_PREHEAT2_PROCESS_FAILED) ] CTU(PREHEAT2_INC_CYCLE_REJECT_CNT,?,?) ,[XIC(PREHEAT2_PROCESS_FAILED) ,XIC(PREHEAT2_PREHEAT1_PROCESS_FAILED) ] [OTL(PREHEAT2_DATA_BAR_REJECT) ,MOV(5,PREHEAT2_DATA_POS_BAR_REJECT) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BARRIER AT PREHEAT STATION 2 WAS REJECTED DUE TO ALREADY BEING HEATED OR INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT2_ACTIVE_RECIPE_LOADED)[XIC(PREHEAT2_PROCESS_FAILED) ONS(ONS_ARRAY[105]) [[CTU(PREHEAT2_INC_CYCLE_REJECT_CNT,?,?) ,NEQ(PREHEAT2_INC_CYCLE_REJECT_CNT.ACC,PREHEAT2_PREV_INC_CYCLE_REJECT_CNT) MOV(1,PREHEAT2_CTR_INC_CYCLE) ,EQU(PREHEAT2_INC_CYCLE_REJECT_CNT.ACC,PREHEAT1_PREV_INC_CYCLE_REJECT_CNT) MOV(0,PREHEAT2_CTR_INC_CYCLE) ,MOV(PREHEAT2_INC_CYCLE_REJECT_CNT.ACC,PREHEAT2_PREV_INC_CYCLE_REJECT_CNT) ] ,[CTU(PREHEAT2_INC_CYCLE_REJECT_MULT_CNT,?,?) ,[GEQ(PREHEAT2_INC_CYCLE_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PREHEAT2_CTR_INC_CYCLE) ,OTL(CELL_MULTIPLE_FAILURES) ] ,OTL(PREHEAT2_DATA_BAR_REJECT) ,MOV(5,PREHEAT2_DATA_POS_BAR_REJECT) ] ] ] ,XIC(PREHEAT2_DATA_PREHEAT2_COMPLETE) [RES(PREHEAT2_INC_CYCLE_REJECT_MULT_CNT) ,MOV(0,PREHEAT2_CTR_INC_CYCLE) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES PREHEAT2 BARRIER WAS REJECTED DUE TO UPPER TEMP FAILURE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT2_ACTIVE_RECIPE_LOADED)[XIC(PREHEAT2_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.7) ]XIC(PREHEAT2_DATA_BAR_LOADED)XIO(PREHEAT2_DATA_BAR_REJECT)XIC(PREHEAT2_DATA_PREHEAT2_STARTED)[XIO(PREHEAT2_DATA_PREHEAT2_UP_TEMP_OK) [[[CTU(PREHEAT2_UP_TEMP_REJECT_CNT,?,?) ,ADD(CELL_DATA_COLLECTION[10],1,CELL_DATA_COLLECTION[10]) ,NEQ(PREHEAT2_UP_TEMP_REJECT_CNT.ACC,PREHEAT2_PREV_UP_TEMP_REJECT_CNT) MOV(1,PREHEAT2_CTR_UP_TEMP) ,EQU(PREHEAT2_UP_TEMP_REJECT_CNT.ACC,PREHEAT2_PREV_UP_TEMP_REJECT_CNT) MOV(0,PREHEAT2_CTR_UP_TEMP) ,MOV(PREHEAT2_UP_TEMP_REJECT_CNT.ACC,PREHEAT2_PREV_UP_TEMP_REJECT_CNT) ] ,[CTU(PREHEAT2_UP_TEMP_REJECT_MULT_CNT,?,?) ,GEQ(PREHEAT2_UP_TEMP_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PREHEAT2_CTR_UP_TEMP) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ] ,[OTL(PREHEAT2_DATA_BAR_REJECT) ,MOV(5,PREHEAT2_DATA_POS_BAR_REJECT) ] ] ,XIC(PREHEAT2_DATA_PREHEAT2_UP_TEMP_OK) [RES(PREHEAT2_UP_TEMP_REJECT_MULT_CNT) ,MOV(0,PREHEAT2_CTR_UP_TEMP) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES PREHEAT2 BARRIER WAS REJECTED DUE TO LOWER TEMP FAILURE]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT2_ACTIVE_RECIPE_LOADED)[XIC(PREHEAT2_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.7) ]XIC(PREHEAT2_DATA_BAR_LOADED)XIO(PREHEAT2_DATA_BAR_REJECT)XIC(PREHEAT2_DATA_PREHEAT2_STARTED)[XIO(PREHEAT2_DATA_PREHEAT2_LOW_TEMP_OK) [[CTU(PREHEAT2_LOW_TEMP_REJECT_CNT,?,?) ,ADD(CELL_DATA_COLLECTION[11],1,CELL_DATA_COLLECTION[11]) ,NEQ(PREHEAT2_LOW_TEMP_REJECT_CNT.ACC,PREHEAT2_PREV_LOW_TEMP_REJECT_CNT) MOV(1,PREHEAT2_CTR_LOW_TEMP) ,EQU(PREHEAT2_LOW_TEMP_REJECT_CNT.ACC,PREHEAT2_PREV_LOW_TEMP_REJECT_CNT) MOV(0,PREHEAT2_CTR_LOW_TEMP) ,MOV(PREHEAT2_LOW_TEMP_REJECT_CNT.ACC,PREHEAT2_PREV_LOW_TEMP_REJECT_CNT) ] ,[CTU(PREHEAT2_LOW_TEMP_REJECT_MULT_CNT,?,?) ,GEQ(PREHEAT2_LOW_TEMP_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PREHEAT2_CTR_LOW_TEMP) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,OTL(PREHEAT2_DATA_BAR_REJECT) ,MOV(5,PREHEAT2_DATA_POS_BAR_REJECT) ] ,XIC(PREHEAT2_DATA_PREHEAT2_LOW_TEMP_OK) [RES(PREHEAT2_LOW_TEMP_REJECT_MULT_CNT) ,MOV(0,PREHEAT2_CTR_LOW_TEMP) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BARRIER AT FORMING STATION WAS REJECTED DUE TO INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(FORMING_ACTIVE_RECIPE_LOADED)[XIC(FORMING_PROCESS_FAILED) ,XIC(FORMING_PREHEAT2_PROCESS_FAILED) ]ONS(ONS_ARRAY[86])[XIC(FORMING_PROCESS_FAILED) CTU(FORMING_INC_CYCLE_REJECT_CNT,?,?) ,[XIC(FORMING_PROCESS_FAILED) ,XIC(FORMING_PREHEAT2_PROCESS_FAILED) ] [OTL(FORMING_DATA_BAR_REJECT) ,MOV(6,FORMING_DATA_POS_BAR_REJECT) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BARRIER AT FORMING WAS REJECTED DUE TO ALREADY BEING HEATED OR INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(FORMING_ACTIVE_RECIPE_LOADED)[XIC(FORMING_PROCESS_FAILED) ,XIC(FORMING_PREHEAT2_PROCESS_FAILED) ]ONS(ONS_ARRAY[106])[XIC(FORMING_PROCESS_FAILED) [[CTU(FORMING_INC_CYCLE_REJECT_CNT,?,?) ,NEQ(FORMING_INC_CYCLE_REJECT_CNT.ACC,FORMING_PREV_INC_CYCLE_REJECT_CNT) MOV(1,FORMING_CTR_INC_CYCLE) ,EQU(FORMING_INC_CYCLE_REJECT_CNT.ACC,FORMING_PREV_INC_CYCLE_REJECT_CNT) MOV(0,FORMING_CTR_INC_CYCLE) ,MOV(FORMING_INC_CYCLE_REJECT_CNT.ACC,FORMING_PREV_INC_CYCLE_REJECT_CNT) ] ,[CTU(FORMING_INC_CYCLE_REJECT_MULT_CNT,?,?) ,[GEQ(FORMING_INC_CYCLE_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,FORMING_CTR_INC_CYCLE) ,OTL(CELL_MULTIPLE_FAILURES) ] ,OTL(FORMING_DATA_BAR_REJECT) ,MOV(6,FORMING_DATA_POS_BAR_REJECT) ] ] ] ,XIC(FORMING_DATA_FORMING_COMPLETE) [RES(FORMING_INC_CYCLE_REJECT_MULT_CNT) ,MOV(0,FORMING_CTR_INC_CYCLE) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES FORMING BARRIER WAS REJECTED DUE TO PRESSURE FAILURE OR NOT COMPLETE]]>
</Comment>
<Text>
<![CDATA[XIC(FORMING_ACTIVE_RECIPE_LOADED)[XIC(FORMING_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.8) ,XIC(FORMING_PROCESS_FAILED) ]XIC(FORMING_DATA_BAR_LOADED)XIO(FORMING_DATA_BAR_REJECT)XIC(FORMING_DATA_FORMING_STARTED)[XIO(FORMING_DATA_FORMING_PRESS_OK) [[CTU(FORMING_PRESSURE_REJECT_CNT,?,?) ,ONS(ONS_ARRAY[64]) ADD(CELL_DATA_COLLECTION[12],1,CELL_DATA_COLLECTION[12]) ,NEQ(FORMING_PRESSURE_REJECT_CNT.ACC,FORMING_PREV_PRESSURE_REJECT_CNT) MOV(1,FORMING_CTR_PRESSURE) ,EQU(FORMING_PRESSURE_REJECT_CNT.ACC,FORMING_PREV_PRESSURE_REJECT_CNT) MOV(0,FORMING_CTR_PRESSURE) ,MOV(FORMING_PRESSURE_REJECT_CNT.ACC,FORMING_PREV_PRESSURE_REJECT_CNT) ] ,[CTU(FORMING_PRESSURE_REJECT_MULT_CNT,?,?) ,GEQ(FORMING_PRESSURE_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,FORMING_CTR_PRESSURE) ,OTL(CELL_MULTIPLE_FAILURES) ] ,OTL(FORMING_DATA_BAR_REJECT) ,MOV(6,FORMING_DATA_POS_BAR_REJECT) ] ] ,XIO(CELL_MULTIPLE_FAILURES) XIC(FORMING_DATA_FORMING_PRESS_OK) [RES(FORMING_PRESSURE_REJECT_MULT_CNT) ,MOV(0,FORMING_CTR_PRESSURE) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BARRIER PUNCH WAS REJECTED DUE TO INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(PUNCH_ACTIVE_RECIPE_LOADED)[XIC(PUNCH_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.9) ,XIC(PUNCH_PROCESS_FAILED) ]XIC(PUNCH_DATA_BAR_LOADED)XIO(PUNCH_DATA_BAR_REJECT)XIC(PUNCH_DATA_PUNCH_STARTED)[XIO(PUNCH_DATA_PUNCH_COMPLETE) [[CTU(PUNCH_INC_CYCLE_REJECT_CNT,?,?) ,ONS(ONS_ARRAY[65]) ADD(CELL_DATA_COLLECTION[13],1,CELL_DATA_COLLECTION[13]) ,NEQ(PUNCH_INC_CYCLE_REJECT_CNT.ACC,PUNCH_PREV_INC_CYCLE_REJECT_CNT) MOV(1,PUNCH_CTR_INC_CYCLE) ,EQU(PUNCH_INC_CYCLE_REJECT_CNT.ACC,PUNCH_PREV_INC_CYCLE_REJECT_CNT) MOV(0,PUNCH_CTR_INC_CYCLE) ,MOV(PUNCH_INC_CYCLE_REJECT_CNT.ACC,PUNCH_PREV_INC_CYCLE_REJECT_CNT) ] ,[CTU(PUNCH_INC_CYCLE_REJECT_MULT_CNT,?,?) ,GEQ(PUNCH_INC_CYCLE_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,PUNCH_CTR_INC_CYCLE) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,OTL(PUNCH_DATA_BAR_REJECT) ,MOV(7,PUNCH_DATA_POS_BAR_REJECT) ] ,XIC(PUNCH_DATA_PUNCH_COMPLETE) [RES(PUNCH_INC_CYCLE_REJECT_MULT_CNT) ,MOV(0,PUNCH_CTR_INC_CYCLE) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BARRIER INKJET WAS REJECTED DUE TO INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED)[XIC(INKJET_PRINT_PROCESS_DONE) ,XIC(INKJET_PRINT_PROCESS_FAILED) ][[XIC(PUNCH_DATA_BAR_LOADED) XIO(PUNCH_DATA_BAR_REJECT) XIC(PUNCH_DATA_INKJET_STARTED) XIO(PUNCH_DATA_INKJET_COMPLETE) ,XIC(PRINT_DATA_BAR_LOADED) XIO(PRINT_DATA_BAR_REJECT) XIC(PRINT_DATA_INKJET_STARTED) XIO(PRINT_DATA_INKJET_COMPLETE) ] [[CTU(INKJET_PRINT_INC_CYCLE_REJECT_CNT,?,?) ,ONS(ONS_ARRAY[75]) ADD(CELL_DATA_COLLECTION[21],1,CELL_DATA_COLLECTION[21]) ,NEQ(INKJET_PRINT_INC_CYCLE_REJECT_CNT.ACC,INKJET_PRINT_PREV_INC_CYCLE_REJECT_CNT) MOV(1,INKJET_PRINT_CTR_INC_CYCLE) ,EQU(INKJET_PRINT_INC_CYCLE_REJECT_CNT.ACC,INKJET_PRINT_PREV_INC_CYCLE_REJECT_CNT) MOV(0,INKJET_PRINT_CTR_INC_CYCLE) ,MOV(INKJET_PRINT_INC_CYCLE_REJECT_CNT.ACC,INKJET_PRINT_PREV_INC_CYCLE_REJECT_CNT) ] ,[CTU(INKJET_PRINT_INC_CYCLE_REJECT_MULT_CNT,?,?) ,GEQ(INKJET_PRINT_INC_CYCLE_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) [MOV(2,INKJET_PRINT_CTR_INC_CYCLE) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,XIC(PUNCH_DATA_BAR_LOADED) XIO(PUNCH_DATA_BAR_REJECT) XIC(PUNCH_DATA_INKJET_STARTED) XIO(PUNCH_DATA_INKJET_COMPLETE) [OTL(PUNCH_DATA_BAR_REJECT) ,MOV(7,PUNCH_DATA_POS_BAR_REJECT) ] ,XIC(PRINT_DATA_BAR_LOADED) XIO(PRINT_DATA_BAR_REJECT) XIC(PRINT_DATA_INKJET_STARTED) XIO(PRINT_DATA_INKJET_COMPLETE) [OTL(PRINT_DATA_BAR_REJECT) ,MOV(8,PRINT_DATA_POS_BAR_REJECT) ] ] ,[XIC(PUNCH_DATA_BAR_LOADED) XIO(PUNCH_DATA_BAR_REJECT) XIC(PUNCH_DATA_INKJET_STARTED) XIO(PUNCH_DATA_INKJET_COMPLETE) ,XIC(PRINT_DATA_BAR_LOADED) XIO(PRINT_DATA_BAR_REJECT) XIC(PRINT_DATA_INKJET_STARTED) XIC(PRINT_DATA_INKJET_COMPLETE) ] [RES(INKJET_PRINT_INC_CYCLE_REJECT_MULT_CNT) ,MOV(0,INKJET_PRINT_CTR_INC_CYCLE) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES PRINTING BARRIER WAS REJECTED DUE TO INCOMPLETE CYCLE]]>
</Comment>
<Text>
<![CDATA[XIC(PRINT_ACTIVE_RECIPE_LOADED)[XIC(PRINT_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.10) ,XIC(PRINT_PROCESS_FAILED) ]XIC(PRINT_DATA_BAR_LOADED)XIO(PRINT_DATA_BAR_REJECT)XIC(PRINT_DATA_PRINT_STARTED)[XIO(PRINT_DATA_PRINT_COMPLETE) [[CTU(PRINT_INC_CYCLE_REJECT_CNT,?,?) ,ONS(ONS_ARRAY[66]) ADD(CELL_DATA_COLLECTION[14],1,CELL_DATA_COLLECTION[14]) ,NEQ(PRINT_INC_CYCLE_REJECT_CNT.ACC,PRINT_PREV_INC_CYCLE_REJECT_CNT) MOV(1,PRINT_CTR_INC_CYCLE) ,EQU(PRINT_INC_CYCLE_REJECT_CNT.ACC,PRINT_PREV_INC_CYCLE_REJECT_CNT) MOV(0,PRINT_CTR_INC_CYCLE) ,MOV(PRINT_INC_CYCLE_REJECT_CNT.ACC,PRINT_PREV_INC_CYCLE_REJECT_CNT) ] ,[CTU(PRINT_INC_CYCLE_REJECT_MULT_CNT,?,?) ,GEQ(PRINT_INC_CYCLE_REJECT_MULT_CNT.ACC,CELL_FAILURE_ALLOWED_COUNT) XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) [MOV(2,PRINT_CTR_INC_CYCLE) ,OTL(CELL_MULTIPLE_FAILURES) ] ] ,OTL(PRINT_DATA_BAR_REJECT) ,MOV(8,PRINT_DATA_POS_BAR_REJECT) ] ,XIC(PRINT_DATA_PRINT_COMPLETE) [RES(PRINT_INC_CYCLE_REJECT_MULT_CNT) ,MOV(0,PRINT_CTR_INC_CYCLE) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[TRACK THE NUMBER OF TIMES BAG WAS REJECTED DUE TO GLUE PRESSURE FAILURE]]>
</Comment>
<Text>
