<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[10]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],0)[XIC(CELL_STARTED) [XIO(RUN_PROCESS) MOV(5,STEP_AUTO[10]) ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[10]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(GLUE_PART_CYCLE_PB) [OTL(GLUE_PART_MANUAL_CYCLE_IN_PROGRESS) ,MOV(20,STEP_AUTO[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
AND MOVE TO BAG CHECK POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],5)[OTE(GLUE_INDEX_DIAL_REQ) ,XIO(GLUE_SAMPLE_CYCLE_IN_PROGRESS) XIO(GLUE_AUTO_PURGE_REQ) XIO(GLUE_PURGE_CYCLE_IN_PROGRESS) ONS(ONS_ARRAY[18]) [OTU(GLUE_SAMPLE_POS) ,OTL(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,XIO(GLUE_AT_PART_CHK_POS) OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_PART_CHK_POS) XIC(GLUE_PART_CHK_POS) XIO(GLUE_X_Y_INDEX_PB) XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIO(CELL_EMPTY_COMPLETE.11) [XIC(GLUE_DATA_BAR_LOADED) XIO(GLUE_DATA_BAR_REJECT) [XIC(GLUE_DATA_PREHEAT1_COMPLETE) ,XIO(PREHEAT1_ACTIVE_RECIPE_LOADED) ] [XIC(GLUE_DATA_PREHEAT2_COMPLETE) ,XIO(PREHEAT2_ACTIVE_RECIPE_LOADED) ] [XIC(GLUE_DATA_FORMING_COMPLETE) ,XIO(FORMING_ACTIVE_RECIPE_LOADED) ] [XIC(GLUE_DATA_PUNCH_COMPLETE) ,XIO(PUNCH_ACTIVE_RECIPE_LOADED) ] [XIC(GLUE_DATA_INKJET_COMPLETE) ,XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) ] [XIC(GLUE_DATA_PRINT_COMPLETE) ,XIO(PRINT_ACTIVE_RECIPE_LOADED) ] ,XIC(GLUE_DATA_EMPTY_LAST_BAG) ] XIC(GLUE_DATA_BAG_LOADED) XIO(GLUE_DATA_BAG_REJECT) XIC(GLUE_ACTIVE_RECIPE_LOADED) XIO(GLUE_DATA_GLUE_COMPLETE) OTE(RUN_PROCESS) ,EQU(STEP_AUTO[10],10) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[10]) ,XIO(RUN_PROCESS) MOV(150,STEP_AUTO[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MOVE TO BAG PRESENCE CHECK POSITION IF REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],20)XIO(GLUE_SAMPLE_CYCLE_IN_PROGRESS)[XIC(CELL_STARTED) XIO(GLUE_AUTO_PURGE_REQ) ,XIC(CELL_MANUAL_MODE) ]XIO(GLUE_PURGE_CYCLE_IN_PROGRESS)[ONS(ONS_ARRAY[16]) [OTU(GLUE_SAMPLE_POS) ,OTL(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,XIO(GLUE_AT_PART_CHK_POS) OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_PART_CHK_POS) XIC(GLUE_PART_CHK_POS) XIO(GLUE_X_Y_INDEX_PB) [[XIC(GLUE_BAG_PRESENT) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_INSERT_LOAD_ONLY_MODE_PB) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] MOV(30,STEP_AUTO[10]) ,XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) XIO(CELL_DRY_CYCLE_MODE_PB) XIO(GLUE_BAG_PRESENT) MOV(167,STEP_ALARM[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MOVE TO PART GLUE POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],30)XIO(GLUE_SAMPLE_CYCLE_IN_PROGRESS)XIO(GLUE_PURGE_CYCLE_IN_PROGRESS)[ONS(ONS_ARRAY[5]) [OTU(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTL(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_PART_POS) XIO(GLUE_X_Y_INDEX_PB) MOV(40,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[EXTEND Z-AXIS CYLINDER LOAD CAM PROFILE FOR PRIMARY GLUE PATH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],40)[OTL(GLUE_Z_CYL_EXT_PB) ,OTL(GLUE_X_Y_CAM_PROFILE_LOAD) ,XIC(MOTION_DRV_X_CAM_PROFILE_CONT.IP) XIC(MOTION_DRV_Y_CAM_PROFILE_CONT.IP) XIC(GLUE_Z_CYL_EXT) MOV(60,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[VERIFY NEXT STATION HAS PART ON BARRIER PRESS-N-CURE PICK HEAD]]>
</Comment>
<Text>
<![CDATA[[LIM(60,STEP_AUTO[10],65) TON(TIMER_OPER[0],?,?) ,EQU(STEP_AUTO[10],60) [XIO(CELL_SHUTDOWN_REQ) XIC(TIMER_OPER[13].DN) [[XIC(GLUE_OUT_PRESSURE_PRE_OK) XIC(PNC_BARRIER_READY_FOR_GLUE) [XIO(PNC_DATA_BAG_REJECT) ,XIC(PNC_DATA_BAG_REJECT) XIC(PNC_DATA_PNC_COMPLETE) ] ,XIC(GLUE_PART_MANUAL_CYCLE_IN_PROGRESS) ,XIC(CELL_DRY_CYCLE_MODE_PB) ,XIO(PNC_ACTIVE_RECIPE_LOADED) ] [XIO(CELL_DRY_CYCLE_MODE_PB) XIC(GLUE_OUT_PRESSURE_PRE_OK) RES(GLUE_OUT_PRESSURE_PRE_FAIL_CNT) ,MOV(65,STEP_AUTO[10]) ] ,XIO(CELL_DRY_CYCLE_MODE_PB) XIO(GLUE_PART_MANUAL_CYCLE_IN_PROGRESS) XIC(PNC_ACTIVE_RECIPE_LOADED) [XIO(PNC_BARRIER_READY_FOR_GLUE) ,XIO(GLUE_OUT_PRESSURE_PRE_OK) ,XIC(PNC_DATA_BAG_REJECT) XIO(PNC_DATA_PNC_COMPLETE) ] [XIO(GLUE_OUT_PRESSURE_PRE_OK) CTU(GLUE_OUT_PRESSURE_PRE_FAIL_CNT,?,?) ,XIO(GLUE_OUT_PRESSURE_PRE_FAIL_CNT.DN) MOV(140,STEP_AUTO[10]) ,XIC(GLUE_OUT_PRESSURE_PRE_FAIL_CNT.DN) MOV(158,STEP_ALARM[10]) ] ] ,XIC(CELL_SHUTDOWN_REQ) MOV(140,STEP_AUTO[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[VERIFY GOOD PART IS ON LIGHT TABLE OR ROBOT PICK HEAD IF APPLICABLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],65)[XIO(CELL_SHUTDOWN_REQ) [[EQU(STEP_AUTO[23],80) ,XIC(R2_BARRIER_PASSED) ,XIC(BARRIER_LOAD_DATA_BAR_LOADED) ,XIC(CELL_EMPTY_ACTIVE) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) ] ,XIC(GLUE_PART_MANUAL_CYCLE_IN_PROGRESS) ,XIC(CELL_DRY_CYCLE_MODE_PB) ,XIO(PNC_ACTIVE_RECIPE_LOADED) ] XIC(TIMER_OPER[0].DN) MOV(70,STEP_AUTO[10]) ,XIC(CELL_SHUTDOWN_REQ) MOV(140,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[RUN PRIMARY GLUE PATH 

********************************************************
NEXT STEP 80 IS IN THE HIGH PRIORITY TASK]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],70)[[OTL(GLUE_X_Y_CIRCLE_INDEX) ,XIC(CELL_STARTED) OTL(GLUE_DATA_GLUE_STARTED) ] ,XIC(GLUE_MOTION_X_Y_CIRCLE_CONT.EN) MOV(80,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[RETRACT Z-AXIS CYLINDER AND UNLOAD CAM GLUE PROFILE AND
DECIDE IF SECONDARY GLUE BEAD IS REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],90)[[XIO(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) [[OTU(GLUE_Z_CYL_EXT_PB) ,OTU(GLUE_TEMP_DETECTED) ] ,XIC(CELL_STARTED) ONS(ONS_ARRAY[2]) [[XIC(GLUE_OUT_PRESSURE_POST_OK) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(GLUE_DATA_GLUE_PRESS_OK) ,OTL(GLUE_DATA_GLUE_COMPLETE) ] ] ,XIC(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) OTL(GLUE_X_Y_PATH2_RUN) ,OTU(GLUE_X_Y_CAM_PROFILE_LOAD) ] ,[XIO(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) XIC(GLUE_Z_CYL_RET) ,XIC(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) ] XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) [XIO(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) MOV(145,STEP_AUTO[10]) ,XIC(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) MOV(100,STEP_AUTO[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[MOVE TO SECONDARY BEAD START GLUE POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],100)[ONS(ONS_ARRAY[15]) [OTU(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTL(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_PART_POS2) XIO(GLUE_X_Y_INDEX_PB) MOV(105,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[LOAD CAM PROFILE FOR SECONDARY GLUE PATH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],105)[OTL(GLUE_X_Y_CAM_PROFILE_LOAD) ,XIC(MOTION_DRV_X_CAM_PROFILE_CONT.IP) XIC(MOTION_DRV_Y_CAM_PROFILE_CONT.IP) MOV(110,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[RUN SECONDARY GLUE PATH 

********************************************************
NEXT STEP 120 IS IN THE HIGH PRIORITY TASK]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],110)[OTL(GLUE_X_Y_CIRCLE_INDEX) ,XIC(GLUE_MOTION_X_Y_CIRCLE_CONT.EN) MOV(120,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[SET BAG GLUE COMPLETE IF REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],130)[XIC(CELL_STARTED) [[XIC(GLUE_OUT_PRESSURE_POST_OK) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(GLUE_DATA_GLUE_PRESS_OK) ,OTL(GLUE_DATA_GLUE_COMPLETE) ] ,[OTU(GLUE_TEMP_DETECTED) ,MOV(140,STEP_AUTO[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[RETRACT Z-AXIS CYLINDER AND UNLOAD CAM GLUE PROFILE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],140)[[OTU(GLUE_Z_CYL_EXT_PB) ,OTU(GLUE_X_Y_PATH2_RUN) ,OTU(GLUE_X_Y_CAM_PROFILE_LOAD) ] ,XIC(GLUE_Z_CYL_RET) XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) MOV(145,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],145)XIO(GLUE_X_Y_INDEX_PB)[XIC(CELL_STARTED) MOV(150,STEP_AUTO[10]) ,XIC(CELL_MANUAL_MODE) XIO(GLUE_PART_CYCLE_PB) [OTU(GLUE_PART_MANUAL_CYCLE_IN_PROGRESS) ,MOV(0,STEP_AUTO[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],150)[OTL(GLUE_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.10) XIC(GLUE_DATA_EMPTY_LAST_BAG) OTL(CELL_EMPTY_COMPLETE.11) ,TON(TIMER_OPER[15],?,?) ,XIC(TIMER_OPER[15].DN) MOV(160,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[10],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(GLUE_PROCESS_DONE) ,MOV(5,STEP_AUTO[10]) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[ SAMPLE GLUE WEIGHT ROUTINE
*************************************************

WAIT FOR REQUEST

]]>
</Comment>
<Text>
<![CDATA[XIC(GLUE_SAMPLE_CYCLE_PB)[LIM(0,STEP_AUTO[10],20) ,LIM(150,STEP_AUTO[10],200) ]XIO(GLUE_SAMPLE_CYCLE_IN_PROGRESS)XIO(GLUE_PURGE_CYCLE_IN_PROGRESS)ONS(ONS_ARRAY[9])[OTL(GLUE_SAMPLE_CYCLE_IN_PROGRESS) ,MOV(0,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[MOVE TO SAMPLE GLUE POSITION IF NOT ALREADY THERE AND RETRACT GLUE GUN]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],0)[OTU(GLUE_Z_CYL_EXT_PB) ,XIO(GLUE_AT_SAMPLE_POS) [OTL(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_Z_CYL_RET) XIC(GLUE_AT_SAMPLE_POS) XIO(GLUE_X_Y_INDEX_PB) MOV(5,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[LOAD CAM PROFILE FOR GLUE PATH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],5)[OTL(GLUE_X_Y_CAM_PROFILE_LOAD) ,XIC(MOTION_DRV_X_CAM_PROFILE_CONT.IP) XIC(MOTION_DRV_Y_CAM_PROFILE_CONT.IP) MOV(10,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[RUN GLUE PATH 


********************************************************
NEXT STEP 20 IS IN THE HIGH PRIORITY TASK]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],10)[OTL(GLUE_X_Y_CIRCLE_INDEX) ,XIC(GLUE_MOTION_X_Y_CIRCLE_CONT.EN) MOV(20,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[UNLOAD CAM GLUE PROFILE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],30)[OTU(GLUE_X_Y_CAM_PROFILE_LOAD) ,XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) MOV(35,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[CAM GLUE PROFILE AND
DECIDE IF SECONDARY GLUE BEAD IS REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],35)[[XIC(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) OTL(GLUE_X_Y_PATH2_RUN) ,OTU(GLUE_X_Y_CAM_PROFILE_LOAD) ] ,XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) [XIO(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) MOV(100,STEP_AUTO[11]) ,XIC(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED) MOV(40,STEP_AUTO[11]) ] ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[MOVE TO SAMPLE GLUE POSITION IF NOT ALREADY THERE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],40)[XIO(GLUE_AT_SAMPLE_POS) [OTL(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_SAMPLE_POS) XIO(GLUE_X_Y_INDEX_PB) MOV(45,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[LOAD CAM PROFILE FOR GLUE PATH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],45)[OTL(GLUE_X_Y_CAM_PROFILE_LOAD) ,XIC(MOTION_DRV_X_CAM_PROFILE_CONT.IP) XIC(MOTION_DRV_Y_CAM_PROFILE_CONT.IP) MOV(50,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[RUN SECONDARY GLUE PATH 


********************************************************
NEXT STEP 60 IS IN THE HIGH PRIORITY TASK]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],50)[OTL(GLUE_X_Y_CIRCLE_INDEX) ,XIC(GLUE_MOTION_X_Y_CIRCLE_CONT.EN) MOV(60,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[UNLOAD CAM GLUE PROFILE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],70)[OTU(GLUE_X_Y_CAM_PROFILE_LOAD) ,OTU(GLUE_X_Y_PATH2_RUN) ,XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) MOV(100,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[MOVE TO SAMPLE GLUE POSITION IF NOT ALREADY THERE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[11],100)[XIO(GLUE_AT_SAMPLE_POS) [OTL(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_SAMPLE_POS) XIO(GLUE_X_Y_INDEX_PB) [OTU(GLUE_SAMPLE_CYCLE_IN_PROGRESS) ,OTU(GLUE_SAMPLE_CYCLE_PB) ,MOV(500,STEP_AUTO[11]) ] ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[AUTO GLUE PURGE ROUTINE
*************************************************

WAIT FOR REQUEST

]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(GLUE_AUTO_PURGE_REQ)[LIM(0,STEP_AUTO[10],20) ,LIM(150,STEP_AUTO[10],200) ]XIO(GLUE_SAMPLE_CYCLE_IN_PROGRESS)XIO(GLUE_PURGE_CYCLE_IN_PROGRESS)ONS(ONS_ARRAY[17])[OTL(GLUE_PURGE_CYCLE_IN_PROGRESS) ,MOV(0,STEP_AUTO[8]) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[MOVE TO SAMPLE GLUE POSITION IF NOT ALREADY THERE AND RETRACT GLUE GUN]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[8],0)[RES(GLUE_PURGE_COUNTER) ,OTU(GLUE_Z_CYL_EXT_PB) ,XIO(GLUE_AT_SAMPLE_POS) [OTL(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_Z_CYL_RET) XIC(GLUE_AT_SAMPLE_POS) XIO(GLUE_X_Y_INDEX_PB) MOV(5,STEP_AUTO[8]) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[TURN ON GLUE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[8],5)XIC(GLUE_AT_SAMPLE_POS)[OTL(Local:2:O.Pt00.Data) ,XIC(Local:2:O.Pt00.Data) MOV(10,STEP_AUTO[8]) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[TIME GLUE PURGE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[8],10)[XIC(Local:2:O.Pt00.Data) [MUL(GLUE_GUN_PURGE_TIME,1000,TIMER_OPER[4].PRE) ,TON(TIMER_OPER[4],?,?) ] ,XIC(TIMER_OPER[4].DN) MOV(20,STEP_AUTO[8]) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[TURN OFF GLUE GUN AND
 DECIDE IF SHORT OR EXTENDED PURGE REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[8],20)[OTU(Local:2:O.Pt00.Data) ,XIO(GLUE_AUTO_EXT_PURGE_REQ) MOV(30,STEP_AUTO[8]) ,XIC(GLUE_AUTO_EXT_PURGE_REQ) [CTU(GLUE_PURGE_COUNTER,?,?) ,XIO(GLUE_PURGE_COUNTER.DN) [TON(TIMER_OPER[16],?,?) ,XIC(TIMER_OPER[16].DN) MOV(5,STEP_AUTO[8]) ] ,XIC(GLUE_PURGE_COUNTER.DN) MOV(30,STEP_AUTO[8]) ] ];]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[8],30)[OTU(GLUE_PURGE_CYCLE_IN_PROGRESS) ,OTU(GLUE_AUTO_PURGE_REQ) ,OTU(GLUE_AUTO_EXT_PURGE_REQ) ,MOV(500,STEP_AUTO[8]) ];]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[GLUE CYCLE DELAY TIMER TO MINIMIZE OPEN AIR TIME]]>
</Comment>
<Text>
<![CDATA[LIM(10,STEP_AUTO[10],60)[ONS(ONS_ARRAY[19]) [[NEQ(CELL_CYCLE_TIME[0].BAG_GLUE,0) CPT(GLUE_CYCLE_TARGET_TIME_DELTA,GLUE_CYCLE_TARGET_TIME-(CELL_CYCLE_TIME[0].BAG_GLUE*1000)) ,EQU(CELL_CYCLE_TIME[0].BAG_GLUE,0) MOV(0,GLUE_CYCLE_TARGET_TIME_DELTA) ] ,ADD(GLUE_DELAY_TIME,GLUE_CYCLE_TARGET_TIME_DELTA,GLUE_DELAY_TIME) ,LES(GLUE_DELAY_TIME,0) MOV(0,TIMER_OPER[13].PRE) ,LIM(0,GLUE_DELAY_TIME,GLUE_DELAY_MAX_TIME) MOV(GLUE_DELAY_TIME,TIMER_OPER[13].PRE) ,GRT(GLUE_DELAY_TIME,GLUE_DELAY_MAX_TIME) [MOV(GLUE_DELAY_MAX_TIME,TIMER_OPER[13].PRE) ,MOV(GLUE_DELAY_MAX_TIME,GLUE_DELAY_TIME) ] ] ,TON(TIMER_OPER[13],?,?) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(20,STEP_AUTO[10],150) TON(TIMER_OPER[14],?,?) ,EQU(STEP_AUTO[10],150) ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[14].ACC,1000,CELL_CYCLE_TIME[0].BAG_GLUE) ];]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[10],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].BAG_GLUE,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(9,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].BAG_GLUE,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].BAG_GLUE,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].BAG_GLUE,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(9,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].BAG_GLUE,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION TREAT E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[10],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[10]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[10],1000) EQU(STEP_ALARM_CAPTURE[10],0) MOV(STEP_ALARM[10],STEP_ALARM_CAPTURE[10]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[10],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.10) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[10],1000)[NEQ(STEP_ALARM[10],0) OTE(MAJOR_FAULT[10]) ,ONS(ONS_ARRAY[1]) [MOV(STEP_AUTO[10],STEP_AUTO_RET_ESTOP[10]) ,MOV(STEP_AUTO[11],STEP_AUTO_RET_ESTOP[11]) ,MOV(STEP_AUTO[8],STEP_AUTO_RET_ESTOP[8]) ] ,OTU(GLUE_X_DRV_RESET_PB) OTU(GLUE_X_DRV_ENABLE_PB) OTU(GLUE_Y_DRV_RESET_PB) OTU(GLUE_Y_DRV_ENABLE_PB) OTU(DRV_INTERNAL_HOME_REQ) ,OTU(GLUE_X_Y_INDEX_PB) OTU(GLUE_X_Y_ABORT_INDEX_PB) OTU(GLUE_X_Y_CIRCLE_INDEX) OTU(GLUE_X_Y_CAM_PROFILE_LOAD) OTU(GLUE_X_Y_DRV_HOME_PB) OTU(GLUE_X_Y_PATH2_RUN) OTU(GLUE_X_Y_DRV_HOMING_IND) ,OTU(GLUE_SAMPLE_CYCLE_PB) OTU(GLUE_PART_CYCLE_PB) OTU(GLUE_SAMPLE_CYCLE_IN_PROGRESS) OTU(GLUE_PART_MANUAL_CYCLE_IN_PROGRESS) OTU(GLUE_PURGE_CYCLE_IN_PROGRESS) ,OTU(GLUE_Z_CYL_EXT_PB) OTU(GLUE_ON_PB) OTL(GLUE_AUTO_PURGE_REQ) ,OTU(Local:2:O.Pt00.Data) ,RES(GLUE_OUT_PRESSURE_PRE_FAIL_CNT) OTU(GLUE_TEMP_DETECTED) OTU(GLUE_PRESSURE_CAL_MODE) OTU(GLUE_PROCESS_DONE) ,XIO(CELL_DRY_CYCLE_MODE_PB) XIC(GLUE_DATA_BAG_LOADED) XIO(GLUE_DATA_BAG_REJECT) XIC(GLUE_DATA_GLUE_STARTED) XIO(GLUE_DATA_PNC_COMPLETE) OTE(BAG_GLUE_PROCESS_FAILED) ,MOV(1000,STEP_AUTO[8]) MOV(1000,STEP_HOMING[10]) MOV(1000,STEP_HOME[10]) MOV(1000,STEP_AUTO[10]) MOV(1000,STEP_AUTO[11]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[10],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[10]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[10],10)[RES(DRV_ENABLE_COUNTER) ,MOV(0,STEP_ALARM[10]) ,MOV(0,STEP_ALARM_CAPTURE[10]) ,MOV(20,STEP_ESTOP_RESET[10]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[10],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[10]) ,MOV(30,STEP_ESTOP_RESET[10]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[10]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[10],30)EQU(STEP_HOME[10],500)MOV(500,STEP_ESTOP_RESET[10]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION HMI
***************************************************************************

DRIVES INDEXING ANIMATION]]>
</Comment>
<Text>
<![CDATA[XIC(GLUE_X_Y.MoveStatus)OTE(GLUE_X_Y_INDEXING_IND);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[10],500)[XIO(CELL_STARTED) XIO(GLUE_X_DRV_FAULT) XIO(GLUE_X_DRV_SHUTDOWN) XIO(GLUE_Y_DRV_FAULT) XIO(GLUE_Y_DRV_SHUTDOWN) [XIO(GLUE_X_Y_DRV_HOMING_IND) OTE(GLUE_X_Y_DRV_ENABLE_PB_VIS) ,XIC(GLUE_CLEAR_TO_INDEX) XIC(GLUE_X_DRV_READY) XIC(GLUE_Y_DRV_READY) [OTE(GLUE_X_Y_DRV_HOME_PB_VIS) ,XIC(GLUE_X_DRV_HOMED_STATUS) XIC(GLUE_Y_DRV_HOMED_STATUS) OTE(GLUE_X_Y_DRV_PB_VIS) ] ] ,[XIC(GLUE_X_DRV_FAULT) ,XIC(GLUE_X_DRV_SHUTDOWN) ,XIC(MOTION_DRV_X_ENABLE_CONT.ER) ] OTE(GLUE_X_DRV_FAULT_PB_VIS) ,[XIC(GLUE_Y_DRV_FAULT) ,XIC(GLUE_Y_DRV_SHUTDOWN) ,XIC(MOTION_DRV_Y_ENABLE_CONT.ER) ] OTE(GLUE_Y_DRV_FAULT_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[GLUE HEAD PUSH BUTTONS ON HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)XIC(GLUE_X_DRV_HOMED_STATUS)XIC(GLUE_Y_DRV_HOMED_STATUS)[XIC(GLUE_AT_SAMPLE_POS) XIC(GLUE_MELTER_AUTO_READY) OTE(GLUE_ON_PB_VIS) ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(GLUE_AT_PART_POS) OTE(GLUE_Z_CYL_EXT_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[MANUAL MODE CYCLES HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_KEY_AUTO_MODE)XIC(MAIN_DIAL_IN_POSITION)XIO(GLUE_X_DRV_FAULT)XIO(GLUE_Y_DRV_FAULT)XIC(GLUE_X_DRV_HOMED_STATUS)XIC(GLUE_Y_DRV_HOMED_STATUS)XIC(GLUE_X_DRV_READY)XIC(GLUE_Y_DRV_READY)XIC(GLUE_MELTER_AUTO_READY)[OTE(GLUE_SAMPLE_CYCLE_PB_VIS) ,XIC(CELL_MANUAL_MODE) XIO(CELL_STARTED) OTE(GLUE_PART_CYCLE_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[SECONDARY GLUE BEAD SETTINGS ON HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIC(GLUE_X_Y_PATH2_ACTIVE_RECIPE_LOADED)[XIC(CELL_MANUAL_MODE) OTE(GLUE_X_Y_PATH2_VIS) ,XIC(GLUE_ACTIVE_RECIPE_LOADED) OTE(GLUE_X_Y_PATH2_PARAM_VIS) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CONVERSION FOR GLUE HMI PARAMETER ADJUSTMENTS]]>
</Comment>
<Text>
<![CDATA[[XIC(METRIC_MACHINE) [MOV(GLUE_X_Y_PATH_DIA_RECIPE,GLUE_X_Y_PATH_DIA_RECIPE_MM) MOV(GLUE_X_Y_PATH_OVERLAP_RECIPE,GLUE_X_Y_PATH_OVERLAP_RECIPE_MM) MOV(GLUE_X_Y_PATH_SPEED_RECIPE,GLUE_X_Y_PATH_SPEED_MM) ,MOV(GLUE_X_PART_CENTER_POS_RECIPE,GLUE_X_PART_CENTER_POS_MM_RECIPE) MOV(GLUE_Y_PART_CENTER_POS_RECIPE,GLUE_Y_PART_CENTER_POS_MM_RECIPE) ,MOV(GLUE_X_Y_PATH2_DIA_RECIPE,GLUE_X_Y_PATH2_DIA_RECIPE_MM) MOV(GLUE_X_Y_PATH_OVERLAP2_RECIPE,GLUE_X_Y_PATH_OVERLAP2_RECIPE_MM) MOV(GLUE_X_Y_PATH2_SPEED_RECIPE,GLUE_X_Y_PATH2_SPEED_MM) ] ,XIO(METRIC_MACHINE) [MUL(GLUE_X_Y_PATH_DIA_RECIPE,25.4,GLUE_X_Y_PATH_DIA_RECIPE_MM) MUL(GLUE_X_Y_PATH_OVERLAP_RECIPE,25.4,GLUE_X_Y_PATH_OVERLAP_RECIPE_MM) MUL(GLUE_X_Y_PATH_SPEED_RECIPE,25.4,GLUE_X_Y_PATH_SPEED_MM) ,MUL(GLUE_X_PART_CENTER_POS_RECIPE,25.4,GLUE_X_PART_CENTER_POS_MM_RECIPE) MUL(GLUE_Y_PART_CENTER_POS_RECIPE,25.4,GLUE_Y_PART_CENTER_POS_MM_RECIPE) ,MUL(GLUE_X_Y_PATH2_DIA_RECIPE,25.4,GLUE_X_Y_PATH2_DIA_RECIPE_MM) MUL(GLUE_X_Y_PATH_OVERLAP2_RECIPE,25.4,GLUE_X_Y_PATH_OVERLAP2_RECIPE_MM) MUL(GLUE_X_Y_PATH2_SPEED_RECIPE,25.4,GLUE_X_Y_PATH2_SPEED_MM) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[GLUE LEVEL LOW INDICATOR ON HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(GLUE_MELT_LEVEL_OK)OTE(GLUE_MELT_LEVEL_OK_VIS);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(GLUE_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(GLUE_BYPASS_ANIMATION);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION HOME ROUTINE
***************************************************************************

RESET DRIVE FAULTS
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[10],0)[[XIC(GLUE_X_DRV_FAULT) ,XIC(GLUE_X_DRV_SHUTDOWN) ] OTL(GLUE_X_DRV_RESET_PB) ,[XIC(GLUE_Y_DRV_FAULT) ,XIC(GLUE_Y_DRV_SHUTDOWN) ] OTL(GLUE_Y_DRV_RESET_PB) ,XIO(GLUE_X_DRV_FAULT) XIO(GLUE_X_DRV_SHUTDOWN) XIO(GLUE_Y_DRV_FAULT) XIO(GLUE_Y_DRV_SHUTDOWN) MOV(10,STEP_HOME[10]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TORQUE SAFE INPUT TO ACTIVATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[10],10)[XIO(GLUE_X_DRV_SAFE_TRQ_OFF) XIO(GLUE_Y_DRV_SAFE_TRQ_OFF) MOV(20,STEP_HOME[10]) ,[TON(TIMER_ALARM[18],?,?) ,XIC(TIMER_ALARM[18].DN) [XIC(GLUE_X_DRV_SAFE_TRQ_OFF) MOV(154,STEP_ALARM[10]) ,XIC(GLUE_Y_DRV_SAFE_TRQ_OFF) MOV(174,STEP_ALARM[10]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[10],20)[OTL(GLUE_X_DRV_ENABLE_PB) OTL(GLUE_Y_DRV_ENABLE_PB) ,XIC(GLUE_X_DRV_READY) XIC(GLUE_Y_DRV_READY) MOV(25,STEP_HOME[10]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[RETRACT Z-AXIS CYLINDER AND UNLOAD CAM GLUE PROFILE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[10],25)[[OTU(GLUE_Z_CYL_EXT_PB) ,OTU(Local:2:O.Pt00.Data) ,OTU(GLUE_X_Y_CAM_PROFILE_LOAD) ] ,XIC(GLUE_Z_CYL_RET) XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) XIO(MOTION_DRV_X_CAM_PROFILE_CONT.IP) XIO(MOTION_DRV_Y_CAM_PROFILE_CONT.IP) MOV(30,STEP_HOME[10]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF EITHER DRIVE REQUIRES HOMING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[10],30)[[XIO(GLUE_X_DRV_HOMED) ,XIO(GLUE_Y_DRV_HOMED) ] MOV(35,STEP_HOME[10]) ,XIC(GLUE_X_DRV_HOMED) XIC(GLUE_Y_DRV_HOMED) MOV(40,STEP_HOME[10]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[START DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[10],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[10]) ,XIC(GLUE_X_DRV_HOMED) XIC(GLUE_Y_DRV_HOMED) MOV(40,STEP_HOME[10]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[MOVE TO SAMPLE GLUE POSITION IF NOT ALREADY THERE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[10],40)[XIO(GLUE_AT_SAMPLE_POS) [OTL(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_SAMPLE_POS) XIO(GLUE_X_Y_INDEX_PB) [MOV(0,STEP_AUTO[10]) ,MOV(500,STEP_HOME[10]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(SERVO_HOMING,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(POSITION_MONITOR,0) ,JSR(PRESSURE_IN_REG,0) ,JSR(PRESSURE_OUT_PID,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION OUTPUTS
***************************************************************************

INITIATE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(GLUE_CLEAR_TO_INDEX)XIC(DRV_INTERNAL_HOME_REQ)[[EQU(DRV10.CIPAxisState,16#0002) ,EQU(DRV10.CIPAxisState,16#0004) ] [EQU(DRV11.CIPAxisState,16#0002) ,EQU(DRV11.CIPAxisState,16#0004) ] [[[MAH(DRV10,GLUE_X_HOME_CONT) ,XIC(GLUE_X_HOME_CONT.PC) MAH(DRV11,GLUE_Y_HOME_CONT) ] ,XIC(GLUE_X_HOME_CONT.PC) XIC(GLUE_Y_HOME_CONT.PC) [XIO(GLUE_AT_SAMPLE_POS) [OTL(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ,OTL(GLUE_X_Y_INDEX_PB) ] ,XIC(GLUE_AT_SAMPLE_POS) XIO(GLUE_X_Y_INDEX_PB) [OTU(GLUE_X_Y_DRV_HOME_PB) ,OTU(DRV_HOMING_REQ) ,OTU(DRV_INTERNAL_HOME_REQ) ] ] ] ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) [OTU(DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) [XIO(GLUE_X_HOME_CONT.PC) MOV(151,STEP_ALARM[10]) ,XIC(GLUE_X_HOME_CONT.PC) XIO(GLUE_Y_HOME_CONT.PC) MOV(171,STEP_ALARM[10]) ] ] ] ] ,[NEQ(DRV10.CIPAxisState,16#0002) NEQ(DRV10.CIPAxisState,16#0004) [TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) XIC(CELL_ALARMS_ACTIVE) MOV(178,STEP_ALARM[10]) ] ,NEQ(DRV11.CIPAxisState,16#0002) NEQ(DRV11.CIPAxisState,16#0004) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) XIC(CELL_ALARMS_ACTIVE) MOV(179,STEP_ALARM[10]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONTROLS MANUAL MODE  HMI GLUE X-Y DRIVE INDEXES]]>
</Comment>
<Text>
<![CDATA[EQU(CELL_HMI_CURRENT_SCREEN,13)XIO(CELL_STARTED)[EQU(GLUE_X_Y_POS,1) ONS(ONS_ARRAY[6]) [OTL(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ] ,EQU(GLUE_X_Y_POS,2) ONS(ONS_ARRAY[7]) [OTU(GLUE_SAMPLE_POS) ,OTL(GLUE_PART_CHK_POS) ,OTU(GLUE_PART_POS) ] ,EQU(GLUE_X_Y_POS,4) ONS(ONS_ARRAY[8]) [OTU(GLUE_SAMPLE_POS) ,OTU(GLUE_PART_CHK_POS) ,OTL(GLUE_PART_POS) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[INDEX SAMPLE GLUE START POSITION]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(GLUE_CLEAR_TO_INDEX)XIC(GLUE_X_Y_INDEX_PB)[XIC(GLUE_SAMPLE_POS) XIC(GLUE_AT_SAMPLE_POS) OTU(GLUE_X_Y_INDEX_PB) ,[XIO(MOTION_DRV_X_PART_CONT.IP) XIO(MOTION_DRV_Y_PART_CONT.IP) [XIC(GLUE_SAMPLE_POS) ,XIC(MOTION_DRV_X_SAMPLE_CONT.IP) ,XIC(MOTION_DRV_Y_SAMPLE_CONT.IP) ] XIO(GLUE_X_Y_CAM_PROFILE_LOAD) XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) [[XIO(GLUE_X_Y_PATH2_RUN) [CPT(GLUE_X_SAMPLE_POS_MM,GLUE_X_PART_CTR_SAMPLE_POS+(GLUE_X_Y_PATH_DIA_RECIPE_MM/2*COS(GLUE_START_ANGLE*22/7/180))) ,CPT(GLUE_Y_SAMPLE_POS_MM,GLUE_Y_PART_CTR_SAMPLE_POS+(GLUE_X_Y_PATH_DIA_RECIPE_MM/2*SIN(GLUE_START_ANGLE*22/7/180))) ] ,XIC(GLUE_X_Y_PATH2_RUN) [CPT(GLUE_X_SAMPLE_POS_MM,GLUE_X_PART_CTR_SAMPLE_POS+(GLUE_X_Y_PATH2_DIA_RECIPE_MM/2*COS(GLUE_START_ANGLE2*22/7/180))) ,CPT(GLUE_Y_SAMPLE_POS_MM,GLUE_Y_PART_CTR_SAMPLE_POS+(GLUE_X_Y_PATH2_DIA_RECIPE_MM/2*SIN(GLUE_START_ANGLE2*22/7/180))) ] ,[XIC(METRIC_MACHINE) ADD(GLUE_X_SAMPLE_POS_MM,GLUE_X_OFFSET_PB,GLUE_X_SAMPLE_POS_MM) ADD(GLUE_Y_SAMPLE_POS_MM,GLUE_Y_OFFSET_PB,GLUE_Y_SAMPLE_POS_MM) ,XIO(METRIC_MACHINE) CPT(GLUE_X_SAMPLE_POS_MM,GLUE_X_SAMPLE_POS_MM+(GLUE_X_OFFSET_PB*25.4)) CPT(GLUE_Y_SAMPLE_POS_MM,GLUE_Y_SAMPLE_POS_MM+(GLUE_Y_OFFSET_PB*25.4)) ] ,ONS(ONS_ARRAY[10]) [XIC(GLUE_AT_SAMPLE_POS) MOV(GLUE_X_INDEX_SPEED_MM_SEC_FAST,GLUE_X_INDEX_SPEED_MM_SEC) MOV(GLUE_Y_INDEX_SPEED_MM_SEC_FAST,GLUE_Y_INDEX_SPEED_MM_SEC) ,XIO(GLUE_AT_SAMPLE_POS) MOV(GLUE_X_INDEX_SPEED_MM_SEC_SLOW,GLUE_X_INDEX_SPEED_MM_SEC) MOV(GLUE_Y_INDEX_SPEED_MM_SEC_SLOW,GLUE_Y_INDEX_SPEED_MM_SEC) ] ] ,MAM(DRV10,MOTION_DRV_X_SAMPLE_CONT,0,GLUE_X_SAMPLE_POS_MM,GLUE_X_INDEX_SPEED_MM_SEC,Units per sec,GLUE_X_INDEX_ACC,% of Maximum,GLUE_X_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) MAM(DRV11,MOTION_DRV_Y_SAMPLE_CONT,0,GLUE_Y_SAMPLE_POS_MM,GLUE_Y_INDEX_SPEED_MM_SEC,Units per sec,GLUE_Y_INDEX_ACC,% of Maximum,GLUE_Y_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_X_SAMPLE_CONT.PC) XIC(MOTION_DRV_Y_SAMPLE_CONT.PC) OTU(GLUE_X_Y_INDEX_PB) ] ,[TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(GLUE_X_Y_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(163,STEP_ALARM[10]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[INDEX BAG PRESENCE CHECK POSITION]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(GLUE_CLEAR_TO_INDEX)XIC(GLUE_X_Y_INDEX_PB)[XIC(GLUE_PART_CHK_POS) XIC(GLUE_AT_PART_CHK_POS) OTU(GLUE_X_Y_INDEX_PB) ,[XIO(MOTION_DRV_X_PART_CONT.IP) XIO(MOTION_DRV_Y_PART_CONT.IP) [XIC(GLUE_PART_CHK_POS) ,XIC(MOTION_DRV_X_PART_CHK_CONT.IP) ,XIC(MOTION_DRV_Y_PART_CHK_CONT.IP) ] XIO(GLUE_X_Y_CAM_PROFILE_LOAD) XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) [ONS(ONS_ARRAY[11]) [XIC(GLUE_AT_SAMPLE_POS) MOV(GLUE_X_INDEX_SPEED_MM_SEC_FAST,GLUE_X_INDEX_SPEED_MM_SEC) MOV(GLUE_Y_INDEX_SPEED_MM_SEC_FAST,GLUE_Y_INDEX_SPEED_MM_SEC) ,XIO(GLUE_AT_SAMPLE_POS) MOV(GLUE_X_INDEX_SPEED_MM_SEC_SLOW,GLUE_X_INDEX_SPEED_MM_SEC) MOV(GLUE_Y_INDEX_SPEED_MM_SEC_SLOW,GLUE_Y_INDEX_SPEED_MM_SEC) ] ,MAM(DRV10,MOTION_DRV_X_PART_CHK_CONT,0,GLUE_X_PART_CHK_POS_MM,GLUE_X_INDEX_SPEED_MM_SEC,Units per sec,GLUE_X_INDEX_ACC,% of Maximum,GLUE_X_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) MAM(DRV11,MOTION_DRV_Y_PART_CHK_CONT,0,GLUE_Y_PART_CHK_POS_MM,GLUE_Y_INDEX_SPEED_MM_SEC,Units per sec,GLUE_Y_INDEX_ACC,% of Maximum,GLUE_Y_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_X_PART_CHK_CONT.PC) XIC(MOTION_DRV_Y_PART_CHK_CONT.PC) OTU(GLUE_X_Y_INDEX_PB) ] ,[TON(TIMER_ALARM[11],?,?) ,XIC(TIMER_ALARM[11].DN) [OTU(GLUE_X_Y_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(169,STEP_ALARM[10]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[INDEX PART GLUE START POSITION]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(GLUE_X_Y_INDEX_PB)[XIC(GLUE_CLEAR_TO_INDEX) XIO(GLUE_X_Y_PATH2_RUN) ,XIC(GLUE_X_Y_PATH2_RUN) ][XIC(GLUE_PART_POS) [XIO(GLUE_X_Y_PATH2_RUN) XIC(GLUE_AT_PART_POS) ,XIC(GLUE_X_Y_PATH2_RUN) XIC(GLUE_AT_PART_POS2) ] OTU(GLUE_X_Y_INDEX_PB) ,[XIO(MOTION_DRV_X_SAMPLE_CONT.IP) XIO(MOTION_DRV_Y_SAMPLE_CONT.IP) [XIC(GLUE_PART_POS) ,XIC(MOTION_DRV_X_PART_CONT.IP) ,XIC(MOTION_DRV_Y_PART_CONT.IP) ] XIO(GLUE_X_Y_CAM_PROFILE_LOAD) XIC(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) [[CPT(GLUE_X_PART_START_POS_MM,GLUE_X_PART_CENTER_POS_MM_RECIPE+(GLUE_X_Y_PATH_DIA_RECIPE_MM/2*COS(GLUE_START_ANGLE*22/7/180))) ,CPT(GLUE_X_PART_START_POS2_MM,GLUE_X_PART_CENTER_POS_MM_RECIPE+(GLUE_X_Y_PATH2_DIA_RECIPE_MM/2*COS(GLUE_START_ANGLE2*22/7/180))) ,XIC(METRIC_MACHINE) ADD(GLUE_X_PART_START_POS_MM,GLUE_X_OFFSET_PB,GLUE_X_PART_START_POS_MM) ADD(GLUE_X_PART_START_POS2_MM,GLUE_X_OFFSET_PB,GLUE_X_PART_START_POS2_MM) ,XIO(METRIC_MACHINE) CPT(GLUE_X_PART_START_POS_MM,GLUE_X_PART_START_POS_MM+(GLUE_X_OFFSET_PB*25.4)) CPT(GLUE_X_PART_START_POS2_MM,GLUE_X_PART_START_POS2_MM+(GLUE_X_OFFSET_PB*25.4)) ] [CPT(GLUE_Y_PART_START_POS_MM,GLUE_Y_PART_CENTER_POS_MM_RECIPE+(GLUE_X_Y_PATH_DIA_RECIPE_MM/2*SIN(GLUE_START_ANGLE*22/7/180))) ,CPT(GLUE_Y_PART_START_POS2_MM,GLUE_Y_PART_CENTER_POS_MM_RECIPE+(GLUE_X_Y_PATH2_DIA_RECIPE_MM/2*SIN(GLUE_START_ANGLE2*22/7/180))) ,XIC(METRIC_MACHINE) ADD(GLUE_Y_PART_START_POS_MM,GLUE_Y_OFFSET_PB,GLUE_Y_PART_START_POS_MM) ADD(GLUE_Y_PART_START_POS2_MM,GLUE_Y_OFFSET_PB,GLUE_Y_PART_START_POS2_MM) ,XIO(METRIC_MACHINE) CPT(GLUE_Y_PART_START_POS_MM,GLUE_Y_PART_START_POS_MM+(GLUE_Y_OFFSET_PB*25.4)) CPT(GLUE_Y_PART_START_POS2_MM,GLUE_Y_PART_START_POS2_MM+(GLUE_Y_OFFSET_PB*25.4)) ] ,ONS(ONS_ARRAY[3]) [XIC(GLUE_AT_SAMPLE_POS) MOV(GLUE_X_INDEX_SPEED_MM_SEC_FAST,GLUE_X_INDEX_SPEED_MM_SEC) MOV(GLUE_Y_INDEX_SPEED_MM_SEC_FAST,GLUE_Y_INDEX_SPEED_MM_SEC) ,XIO(GLUE_AT_SAMPLE_POS) MOV(GLUE_X_INDEX_SPEED_MM_SEC_SLOW,GLUE_X_INDEX_SPEED_MM_SEC) MOV(GLUE_Y_INDEX_SPEED_MM_SEC_SLOW,GLUE_Y_INDEX_SPEED_MM_SEC) ] ,[XIO(GLUE_X_Y_PATH2_RUN) MAM(DRV10,MOTION_DRV_X_PART_CONT,0,GLUE_X_PART_START_POS_MM,GLUE_X_INDEX_SPEED_MM_SEC,Units per sec,GLUE_X_INDEX_ACC,% of Maximum,GLUE_X_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) MAM(DRV11,MOTION_DRV_Y_PART_CONT,0,GLUE_Y_PART_START_POS_MM,GLUE_Y_INDEX_SPEED_MM_SEC,Units per sec,GLUE_Y_INDEX_ACC,% of Maximum,GLUE_Y_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(GLUE_X_Y_PATH2_RUN) MAM(DRV10,MOTION_DRV_X_PART_CONT,0,GLUE_X_PART_START_POS2_MM,GLUE_X_INDEX_SPEED_MM_SEC,Units per sec,GLUE_X_INDEX_ACC,% of Maximum,GLUE_X_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) MAM(DRV11,MOTION_DRV_Y_PART_CONT,0,GLUE_Y_PART_START_POS2_MM,GLUE_Y_INDEX_SPEED_MM_SEC,Units per sec,GLUE_Y_INDEX_ACC,% of Maximum,GLUE_Y_INDEX_DEC,% of Maximum,Trapezoidal,GLUE_JERK_RATE,GLUE_JERK_RATE,% of Maximum,Disabled,Programmed,0,None,0,0) ] ,XIC(MOTION_DRV_X_PART_CONT.PC) XIC(MOTION_DRV_Y_PART_CONT.PC) OTU(GLUE_X_Y_INDEX_PB) ] ,[TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) [OTU(GLUE_X_Y_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(164,STEP_ALARM[10]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[LOAD/UNLOAD CAM PROFILE FOR GLUE PATH COORDINATED MOTION]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(GLUE_X_DRV_READY)XIC(GLUE_Y_DRV_READY)[XIC(GLUE_X_Y_CAM_PROFILE_LOAD) [MAH(GLUE_X_Y,MOTION_DRV_X_Y_HOME_CONT) ,[XIO(GLUE_X_Y_PATH2_RUN) CPT(GLUE_X_Y_CAM_PROFILE_RATIO,GLUE_X_Y_PATH_DIA_RECIPE_MM/GLUE_X_Y_CAM_PROFILE_BASE_DIA*25.4) ,XIC(GLUE_X_Y_PATH2_RUN) CPT(GLUE_X_Y_CAM_PROFILE_RATIO,GLUE_X_Y_PATH2_DIA_RECIPE_MM/GLUE_X_Y_CAM_PROFILE_BASE_DIA*25.4) ] ,[XIO(GLUE_X_Y_PATH2_RUN) MAPC(DRV10,GLUE_X_Y,MOTION_DRV_X_CAM_PROFILE_CONT,0,GLUE_X_CAM_PROFILE_CCW_315[0],GLUE_X_Y_CAM_PROFILE_RATIO,1,Continuous,Immediate,0,0,New Cam,Actual,Bi-Directional) MAPC(DRV11,GLUE_X_Y,MOTION_DRV_Y_CAM_PROFILE_CONT,0,GLUE_Y_CAM_PROFILE_CCW_315[0],GLUE_X_Y_CAM_PROFILE_RATIO,1,Continuous,Immediate,0,0,New Cam,Actual,Bi-Directional) ,XIC(GLUE_X_Y_PATH2_RUN) MAPC(DRV10,GLUE_X_Y,MOTION_DRV_X_CAM_PROFILE_CONT,0,GLUE_X_CAM_PROFILE_CCW_135[0],GLUE_X_Y_CAM_PROFILE_RATIO,1,Continuous,Immediate,0,0,New Cam,Actual,Bi-Directional) MAPC(DRV11,GLUE_X_Y,MOTION_DRV_Y_CAM_PROFILE_CONT,0,GLUE_Y_CAM_PROFILE_CCW_135[0],GLUE_X_Y_CAM_PROFILE_RATIO,1,Continuous,Immediate,0,0,New Cam,Actual,Bi-Directional) ] ,[XIO(MOTION_DRV_X_CAM_PROFILE_CONT.IP) ,XIO(MOTION_DRV_Y_CAM_PROFILE_CONT.IP) ] [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) MOV(165,STEP_ALARM[10]) ] ] ,XIO(GLUE_X_Y_CAM_PROFILE_LOAD) [MAS(DRV10,MOTION_DRV_X_ABORT_CAM_PROFILE_CONT,Position Cam,No,100,% of Maximum,No,100,% of Maximum) MAS(DRV11,MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT,Position Cam,No,100,% of Maximum,No,100,% of Maximum) ,[XIO(MOTION_DRV_X_ABORT_CAM_PROFILE_CONT.PC) ,XIO(MOTION_DRV_Y_ABORT_CAM_PROFILE_CONT.PC) ] [TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) XIC(CELL_ALARMS_ACTIVE) MOV(166,STEP_ALARM[10]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[RUN GLUE PATH COORDINATED MOTION]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(GLUE_X_Y_CIRCLE_INDEX)XIC(GLUE_X_Y_CAM_PROFILE_LOAD)XIC(MOTION_DRV_X_CAM_PROFILE_CONT.IP)XIC(MOTION_DRV_Y_CAM_PROFILE_CONT.IP)[[XIO(GLUE_X_Y_PATH2_RUN) [[XIC(METRIC_MACHINE) [DIV(GLUE_X_Y_PATH_DIA_RECIPE,25.4,GLUE_X_Y_PATH_DIA_RECIPE_IN) ,DIV(GLUE_X_Y_PATH_OVERLAP_RECIPE,25.4,GLUE_X_Y_PATH_OVERLAP_RECIPE_IN) ] ,XIO(METRIC_MACHINE) [MOV(GLUE_X_Y_PATH_DIA_RECIPE,GLUE_X_Y_PATH_DIA_RECIPE_IN) ,MOV(GLUE_X_Y_PATH_OVERLAP_RECIPE,GLUE_X_Y_PATH_OVERLAP_RECIPE_IN) ] ] ,CPT(GLUE_X_Y_PATH_LENGTH_DEG,GLUE_X_Y_PATH_GLUE_START_DEG+360+((GLUE_X_Y_PATH_OVERLAP_RECIPE_IN-0.2)/(3.1416*GLUE_X_Y_PATH_DIA_RECIPE_IN)*360)+GLUE_X_Y_PATH_STOP_DELTA_DEG) ,CPT(GLUE_X_Y_PATH_SPEED_DEG,GLUE_X_Y_PATH_SPEED_MM*360/(3.1416*GLUE_X_Y_PATH_DIA_RECIPE_MM)) ] ,XIC(GLUE_X_Y_PATH2_RUN) [[XIC(METRIC_MACHINE) [DIV(GLUE_X_Y_PATH2_DIA_RECIPE,25.4,GLUE_X_Y_PATH2_DIA_RECIPE_IN) ,DIV(GLUE_X_Y_PATH_OVERLAP2_RECIPE,25.4,GLUE_X_Y_PATH_OVERLAP2_RECIPE_IN) ] ,XIO(METRIC_MACHINE) [MOV(GLUE_X_Y_PATH2_DIA_RECIPE,GLUE_X_Y_PATH2_DIA_RECIPE_IN) ,MOV(GLUE_X_Y_PATH_OVERLAP2_RECIPE,GLUE_X_Y_PATH_OVERLAP2_RECIPE_IN) ] ] ,CPT(GLUE_X_Y_PATH_LENGTH_DEG,GLUE_X_Y_PATH_GLUE_START_DEG+360+((GLUE_X_Y_PATH_OVERLAP2_RECIPE_IN-0.2)/(3.1416*GLUE_X_Y_PATH2_DIA_RECIPE_IN)*360)+GLUE_X_Y_PATH_STOP_DELTA_DEG) ,CPT(GLUE_X_Y_PATH_SPEED_DEG,GLUE_X_Y_PATH2_SPEED_MM*360/(3.1416*GLUE_X_Y_PATH2_DIA_RECIPE_MM)) ] ] ,MAM(GLUE_X_Y,GLUE_MOTION_X_Y_CIRCLE_CONT,0,GLUE_X_Y_PATH_LENGTH_DEG,GLUE_X_Y_PATH_SPEED_DEG,Units per sec,GLUE_X_Y_PATH_ACC,% of Maximum,GLUE_X_Y_PATH_DEC,% of Maximum,Trapezoidal,25,25,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(GLUE_MOTION_X_Y_CIRCLE_CONT.PC) OTU(GLUE_X_Y_CIRCLE_INDEX) ,[TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) XIC(CELL_ALARMS_ACTIVE) MOV(162,STEP_ALARM[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ABORT INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(GLUE_X_Y_ABORT_INDEX_PB)[[MAS(DRV10,MOTION_DRV_X_ABORT_MOVE_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,MAS(DRV11,MOTION_DRV_Y_ABORT_MOVE_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ] ,XIC(MOTION_DRV_X_ABORT_MOVE_CONT.PC) XIC(MOTION_DRV_Y_ABORT_MOVE_CONT.PC) OTU(GLUE_X_Y_ABORT_INDEX_PB) OTU(GLUE_X_Y_INDEX_PB) ,[XIO(MOTION_DRV_X_ABORT_MOVE_CONT.PC) ,XIO(MOTION_DRV_Y_ABORT_MOVE_CONT.PC) ] [TON(TIMER_ALARM[19],?,?) ,XIC(TIMER_ALARM[19].DN) [OTU(GLUE_X_Y_ABORT_INDEX_PB) OTU(GLUE_X_Y_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIO(MOTION_DRV_X_ABORT_MOVE_CONT.PC) MOV(149,STEP_ALARM[10]) ,XIO(MOTION_DRV_Y_ABORT_MOVE_CONT.PC) MOV(175,STEP_ALARM[10]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[10],1000) [XIC(GLUE_X_DRV_RESET_PB) [MASR(DRV10,GLUE_X_RESET_SHUT_CONT) ,XIC(MOTION_DRV_X_ENABLE_CONT.ER) OTU(MOTION_DRV_X_ENABLE_CONT.ER) ,XIO(GLUE_X_DRV_FAULT) XIO(GLUE_X_DRV_SHUTDOWN) XIO(MOTION_DRV_X_ENABLE_CONT.ER) OTU(GLUE_X_DRV_RESET_PB) ,[TON(TIMER_ALARM[16],?,?) ,XIC(TIMER_ALARM[16].DN) [OTU(GLUE_X_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(GLUE_X_DRV_FAULT) MOV(152,STEP_ALARM[10]) ,XIC(GLUE_X_DRV_SHUTDOWN) MOV(153,STEP_ALARM[10]) ] ] ] ] ,XIC(GLUE_Y_DRV_RESET_PB) [MASR(DRV11,GLUE_Y_RESET_SHUT_CONT) ,XIC(MOTION_DRV_Y_ENABLE_CONT.ER) OTU(MOTION_DRV_Y_ENABLE_CONT.ER) ,XIO(GLUE_Y_DRV_FAULT) XIO(GLUE_Y_DRV_SHUTDOWN) XIO(MOTION_DRV_Y_ENABLE_CONT.ER) OTU(GLUE_Y_DRV_RESET_PB) ,[TON(TIMER_ALARM[17],?,?) ,XIC(TIMER_ALARM[17].DN) [OTU(GLUE_Y_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(GLUE_Y_DRV_FAULT) MOV(172,STEP_ALARM[10]) ,XIC(GLUE_Y_DRV_SHUTDOWN) MOV(173,STEP_ALARM[10]) ] ] ] ] ] ,XIC(CELL_STARTED) [XIC(GLUE_X_DRV_SHUTDOWN) MOV(153,STEP_ALARM[10]) ,XIC(GLUE_Y_DRV_SHUTDOWN) MOV(173,STEP_ALARM[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVES]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)[[XIC(GLUE_X_DRV_ENABLE_PB) [MSO(DRV10,MOTION_DRV_X_ENABLE_CONT) ,[XIO(MOTION_DRV_X_ENABLE_CONT.DN) ,XIO(GLUE_X_DRV_READY) ,XIC(GLUE_X_DRV_FAULT) ,XIC(GLUE_X_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[20],?,?) ,XIC(TIMER_ALARM[20].DN) [OTU(GLUE_X_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(150,STEP_ALARM[10]) ] ] ] ,XIO(GLUE_X_DRV_ENABLE_PB) [MSF(DRV10,MOTION_DRV_X_DISABLE_CONT) ,XIO(MOTION_DRV_X_DISABLE_CONT.DN) [TON(TIMER_ALARM[21],?,?) ,XIC(TIMER_ALARM[21].DN) XIC(CELL_ALARMS_ACTIVE) MOV(148,STEP_ALARM[10]) ] ] ] ,[XIC(GLUE_Y_DRV_ENABLE_PB) [MSO(DRV11,MOTION_DRV_Y_ENABLE_CONT) ,[XIO(MOTION_DRV_Y_ENABLE_CONT.DN) ,XIO(GLUE_Y_DRV_READY) ,XIC(GLUE_Y_DRV_FAULT) ,XIC(GLUE_Y_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[22],?,?) ,XIC(TIMER_ALARM[22].DN) [OTU(GLUE_Y_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(170,STEP_ALARM[10]) ] ] ] ,XIO(GLUE_Y_DRV_ENABLE_PB) [MSF(DRV11,MOTION_DRV_Y_DISABLE_CONT) ,XIO(MOTION_DRV_Y_DISABLE_CONT.DN) [TON(TIMER_ALARM[23],?,?) ,XIC(TIMER_ALARM[23].DN) XIC(CELL_ALARMS_ACTIVE) MOV(176,STEP_ALARM[10]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Z-AXIS CYLINDER CONTROL
]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)[XIC(GLUE_Z_CYL_EXT_PB) [OTE(MAN01:O.Data[2].4) ,XIC(CELL_ALARMS_ACTIVE) XIO(GLUE_Z_CYL_EXT) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) MOV(160,STEP_ALARM[10]) ] ] ,XIO(GLUE_Z_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(GLUE_Z_CYL_RET) [TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(161,STEP_ALARM[10]) ] ,XIC(GLUE_X_Y_INDEX_PB) XIO(GLUE_X_Y_PATH2_RUN) OTU(GLUE_Z_CYL_EXT_PB) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[GLUE SOLENOID CONTROL]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[10],1000) [XIC(GLUE_ON_PB_VIS) XIC(GLUE_ON_PB) [OTL(Local:2:O.Pt00.Data) ,MOV(GLUE_PURGE_TIME,TIMER_OPER[20].PRE) TON(TIMER_OPER[20],?,?) ,SUB(TIMER_OPER[20].PRE,TIMER_OPER[20].ACC,GLUE_PURGE_TIME_REMAINING) ,XIC(TIMER_OPER[20].DN) [OTU(GLUE_ON_PB) ,OTU(Local:2:O.Pt00.Data) ,MOV(10000,GLUE_PURGE_TIME) ] ] ,XIO(GLUE_ON_PB) ONS(ONS_ARRAY[13]) OTU(Local:2:O.Pt00.Data) ] ,XIO(GLUE_ON_PB_VIS) OTU(GLUE_ON_PB) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR BAG GLUE STATION
***************************************************************************

POSITION VERIFICATION]]>
</Comment>
<Text>
<![CDATA[XIC(GLUE_X_DRV_HOMED_STATUS)XIC(GLUE_Y_DRV_HOMED_STATUS)[[[SUB(GLUE_X_PART_START_POS_MM,GLUE_POS_TOL,GLUE_X_PART_START_POS_MM_LOWER) ADD(GLUE_X_PART_START_POS_MM,GLUE_POS_TOL,GLUE_X_PART_START_POS_MM_UPPER) ,SUB(GLUE_X_PART_START_POS2_MM,GLUE_POS_TOL,GLUE_X_PART_START_POS2_MM_LOWER) ADD(GLUE_X_PART_START_POS2_MM,GLUE_POS_TOL,GLUE_X_PART_START_POS2_MM_UPPER) ] [SUB(GLUE_Y_PART_START_POS_MM,GLUE_POS_TOL,GLUE_Y_PART_START_POS_MM_LOWER) ADD(GLUE_Y_PART_START_POS_MM,GLUE_POS_TOL,GLUE_Y_PART_START_POS_MM_UPPER) ,SUB(GLUE_Y_PART_START_POS2_MM,GLUE_POS_TOL,GLUE_Y_PART_START_POS2_MM_LOWER) ADD(GLUE_Y_PART_START_POS2_MM,GLUE_POS_TOL,GLUE_Y_PART_START_POS2_MM_UPPER) ] ,SUB(GLUE_X_PART_CHK_POS_MM,GLUE_POS_TOL,GLUE_X_PART_CHK_POS_MM_LOWER) ADD(GLUE_X_PART_CHK_POS_MM,GLUE_POS_TOL,GLUE_X_PART_CHK_POS_MM_UPPER) SUB(GLUE_Y_PART_CHK_POS_MM,GLUE_POS_TOL,GLUE_Y_PART_CHK_POS_MM_LOWER) ADD(GLUE_Y_PART_CHK_POS_MM,GLUE_POS_TOL,GLUE_Y_PART_CHK_POS_MM_UPPER) ,SUB(GLUE_X_SAMPLE_POS_MM,GLUE_POS_TOL,GLUE_X_SAMPLE_POS_MM_LOWER) ADD(GLUE_X_SAMPLE_POS_MM,GLUE_POS_TOL,GLUE_X_SAMPLE_POS_MM_UPPER) SUB(GLUE_Y_SAMPLE_POS_MM,GLUE_POS_TOL,GLUE_Y_SAMPLE_POS_MM_LOWER) ADD(GLUE_Y_SAMPLE_POS_MM,GLUE_POS_TOL,GLUE_Y_SAMPLE_POS_MM_UPPER) ] ,LIM(GLUE_X_PART_START_POS_MM_LOWER,DRV10.ActualPosition,GLUE_X_PART_START_POS_MM_UPPER) LIM(GLUE_Y_PART_START_POS_MM_LOWER,DRV11.ActualPosition,GLUE_Y_PART_START_POS_MM_UPPER) OTE(GLUE_AT_PART_POS) ,LIM(GLUE_X_PART_START_POS2_MM_LOWER,DRV10.ActualPosition,GLUE_X_PART_START_POS2_MM_UPPER) LIM(GLUE_Y_PART_START_POS2_MM_LOWER,DRV11.ActualPosition,GLUE_Y_PART_START_POS_MM_UPPER) OTE(GLUE_AT_PART_POS2) ,LIM(GLUE_X_PART_CHK_POS_MM_LOWER,DRV10.ActualPosition,GLUE_X_PART_CHK_POS_MM_UPPER) LIM(GLUE_Y_PART_CHK_POS_MM_LOWER,DRV11.ActualPosition,GLUE_Y_PART_CHK_POS_MM_UPPER) OTE(GLUE_AT_PART_CHK_POS) ,LIM(GLUE_X_SAMPLE_POS_MM_LOWER,DRV10.ActualPosition,GLUE_X_SAMPLE_POS_MM_UPPER) LIM(GLUE_Y_SAMPLE_POS_MM_LOWER,DRV11.ActualPosition,GLUE_Y_SAMPLE_POS_MM_UPPER) OTE(GLUE_AT_SAMPLE_POS) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PRESSURE_IN_REG" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION PRESSURE REGULATOR
*******************************************************************************

SEND REGULATOR PRESSURE INPUT COUNTS

SCALE, TRUNCATE AND BYTE SWAP]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[10],1000)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[GRT(GLUE_IN_PRESSURE_DISPLAY,GLUE_IN_PRESSURE_MAX) MOV(GLUE_IN_PRESSURE_MAX,GLUE_IN_PRESSURE_DISPLAY) ,MUL(GLUE_IN_PRESSURE_DISPLAY,GLUE_IN_PRES_SCALE_PAR.OUT_M,GLUE_IN_PRESSURE_WITH_M_DONE) ,ADD(GLUE_IN_PRESSURE_WITH_M_DONE,GLUE_IN_PRES_SCALE_PAR.OUT_B,GLUE_IN_SCALED_PRESSURE) ,TRN(GLUE_IN_SCALED_PRESSURE,GLUE_IN_SCALED_PRESS_TRUNC) ,MOV(GLUE_IN_SCALED_PRESS_TRUNC,MAN01:O.Data[1]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CACULATE FEEDBACK PRESSURE FROM REGULATOR]]>
</Comment>
<Text>
<![CDATA[[MOV(MAN01:I.Data[1],GLUE_IN_PRESSURE_REG_FEEDBACK) ,SUB(GLUE_IN_PRESSURE_REG_FEEDBACK,GLUE_IN_PRES_SCALE_PAR.IN_B,GLUE_IN_REG_FEEDBACK_M) ,DIV(GLUE_IN_REG_FEEDBACK_M,GLUE_IN_PRES_SCALE_PAR.IN_M,GLUE_IN_PRESSURE_REG_FEEDBACK_SCALED) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[VERIFY PRESSURE USING REGULATOR FEEDBACK]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_MANUAL_MODE) CMP(GLUE_IN_PRESSURE_DISPLAY-GLUE_IN_PRESSURE_DELTA_ALLOWED<GLUE_IN_PRESSURE_REG_FEEDBACK_SCALED) ,XIC(CELL_MANUAL_MODE) ]OTE(GLUE_IN_PRESSURE_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PRESSURE_OUT_PID" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION OUTPUT PRESSURE PID
************************************************************************************

LOAD RAW PRESSURE DATA INTO VARIABLES]]>
</Comment>
<Text>
<![CDATA[[[BTD(A:I.Data[20],0,GLUE_OUT_PRESSURE,0,16) ,CPT(GLUE_OUT_PRESSURE_UNSCALED,(GLUE_OUT_PRESSURE-GLUE_OUT_PRESS_TRANS_OUTPUT_LOW)/(GLUE_OUT_PRESS_TRANS_OUTPUT_HIGH-GLUE_OUT_PRESS_TRANS_OUTPUT_LOW)*GLUE_OUT_PRESS_TRANS_INPUT_RANGE) ,LES(GLUE_OUT_PRESSURE_UNSCALED,0) MOV(20,GLUE_OUT_PRESSURE_UNSCALED) ,MUL(GLUE_OUT_PRESSURE_UNSCALED,1,GLUE_OUT_PRESSURE_REAL) MUL(GLUE_OUT_PRESSURE_REAL,CELL_GEN_PRESSURE_SCALE,GLUE_OUT_PRESSURE_DISPLAY) ] ,EQU(STEP_ESTOP_RESET[10],500) XIC(CELL_KEY_AUTO_MODE) EQU(GLUE_OUT_PRESSURE,32767) MOV(157,STEP_ALARM[10]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[VERIFY GLUE OUTPUT SIDE PRESSURE IS WITHIN REQUIREMENTS DURING PRE AND POST PROCESS]]>
</Comment>
<Text>
<![CDATA[[CMP(GLUE_OUT_PRESSURE_PID_SP+GLUE_OUT_PRESSURE_PRE_DELTA_ALLOWED>GLUE_OUT_PRESSURE_REAL) CMP(GLUE_OUT_PRESSURE_PID_SP-GLUE_OUT_PRESSURE_PRE_DELTA_ALLOWED<GLUE_OUT_PRESSURE_REAL) OTE(GLUE_OUT_PRESSURE_PRE_OK) ,CMP(GLUE_OUT_PRESSURE_PID_SP+GLUE_OUT_PRESSURE_POST_DELTA_ALLOWED>GLUE_OUT_PRESSURE_REAL) CMP(GLUE_OUT_PRESSURE_PID_SP-GLUE_OUT_PRESSURE_POST_DELTA_ALLOWED<GLUE_OUT_PRESSURE_REAL) OTE(GLUE_OUT_PRESSURE_POST_OK) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[GLUE OUTPUT SIDE PRESSURE CONTROL PID]]>
</Comment>
<Text>
<![CDATA[XIO(GLUE_PRESSURE_CAL_MODE)[NEQ(STEP_ESTOP_RESET[10],1000) XIC(CELL_PRESSURE_OK) XIC(GLUE_MELT_READY) XIC(GLUE_MELT_NOT_FAULTED) XIC(GLUE_MELT_HEATER_ON) XIC(GLUE_MELT_PUMP_ENABLE) XIO(GLUE_MELT_HOSE_DISABLE) NEQ(GLUE_OUT_PRESSURE,32767) [TON(TIMER_OPER[18],?,?) ,OTE(GLUE_OUT_PRESSURE_PID_ACTIVE) ,XIC(TIMER_OPER[18].DN) XIO(Local:2:O.Pt00.Data) [TON(TIMER_OPER[19],?,?) ,XIC(TIMER_OPER[19].DN) [TON(TIMER_OPER[17],?,?) ,XIC(TIMER_OPER[17].DN) [PID(GLUE_OUT_PRESSURE_PID,GLUE_OUT_PRESSURE_REAL,0,GLUE_OUT_PRESSURE_PID_CV,0,0,0) ,RES(TIMER_OPER[17]) ] ] ] ,MUL(GLUE_OUT_PRESSURE_PID_CV,CELL_GEN_PRESSURE_SCALE,GLUE_IN_PRESSURE_DISPLAY) ] ,XIO(GLUE_OUT_PRESSURE_PID_ACTIVE) [MOV(0,GLUE_IN_PRESSURE_DISPLAY) ,MOV(0,MAN01:O.Data[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[TEST PRESSURE SET POINT AGAINST MIN AND MAX SETTINGS]]>
</Comment>
<Text>
<![CDATA[[LES(GLUE_OUT_PRESSURE_RECIPE_SP,GLUE_OUT_PRESSURE_MIN_ALLOWED) ,GRT(GLUE_OUT_PRESSURE_RECIPE_SP,GLUE_OUT_PRESSURE_MAX_ALLOWED) ][MOV(300,GLUE_OUT_PRESSURE_RECIPE_SP) ,MOV(300,GLUE_OUT_PRESSURE_SP_MAN_DISPLAY) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[IF RECIPE DOWNLOAD DETECTED
SET X & Y OFFSETS TO ZERO
RESET AUTO VALUE TO RECIPE VALUE
]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)[[MOV(0,GLUE_X_OFFSET_PB) ,MOV(0,GLUE_Y_OFFSET_PB) ] ,MOV(GLUE_OUT_PRESSURE_RECIPE_SP,GLUE_OUT_PRESSURE_SP_AUTO_DISPLAY) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WHILE IN AUTO MODE, SET AUTO DISPLAY VALUE TO PID SET POINT]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[DIV(GLUE_OUT_PRESSURE_SP_AUTO_DISPLAY,CELL_GEN_PRESSURE_SCALE,GLUE_OUT_PRESSURE_SP_AUTO) ,MOV(GLUE_OUT_PRESSURE_SP_AUTO,GLUE_OUT_PRESSURE_PID_SP) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[****MANUAL MODE****

SET PRESSURE SETPOINT FOR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)ONS(ONS_ARRAY[20])MOV(GLUE_OUT_PRESSURE_SP_AUTO_DISPLAY,GLUE_OUT_PRESSURE_SP_MAN_DISPLAY);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WHILE IN MANUAL MODE, SET MANUAL DISPLAY VALUE TO PID SET POINT]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[DIV(GLUE_OUT_PRESSURE_SP_MAN_DISPLAY,CELL_GEN_PRESSURE_SCALE,GLUE_OUT_PRESSURE_SP_MAN) ,MOV(GLUE_OUT_PRESSURE_SP_MAN,GLUE_OUT_PRESSURE_PID_SP) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[CONTROLS IF THE AUTO OR MANUAL SETPOINT IS DISPLAYED ON THE HMI PRESSURE GRAPH]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_MANUAL_MODE) MOV(GLUE_OUT_PRESSURE_SP_MAN_DISPLAY,GLUE_OUT_PRESSURE_SP_TRACE_DISPLAY) ,XIO(CELL_MANUAL_MODE) MOV(GLUE_OUT_PRESSURE_SP_AUTO_DISPLAY,GLUE_OUT_PRESSURE_SP_TRACE_DISPLAY) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION DRIVE HOMING ROUTINE
***************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVES ARE HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(GLUE_X_Y_DRV_HOME_PB)XIO(DRV_HOMING_REQ)XIO(GLUE_X_Y_DRV_HOMING_IND)[XIC(GLUE_X_DRV_HOMED_STATUS) OTE(GLUE_X_DRV_HOMED) ,XIC(GLUE_Y_DRV_HOMED_STATUS) OTE(GLUE_Y_DRV_HOMED) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[10],0) ,XIC(GLUE_X_Y_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[10],500) [EQU(STEP_HOMING[10],500) ,EQU(STEP_HOMING[10],1000) ] ]NEQ(DRV10.CIPAxisState,16#0009)NEQ(DRV11.CIPAxisState,16#0009)[MOV(10,STEP_HOMING[10]) ,OTL(GLUE_X_Y_DRV_HOMING_IND) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINES]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[10],10)[XIC(GLUE_CLEAR_TO_INDEX) ONS(ONS_ARRAY[12]) OTL(DRV_INTERNAL_HOME_REQ) ,XIC(GLUE_X_HOME_CONT.IP) MOV(20,STEP_HOMING[10]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINES]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[10],20)XIC(GLUE_X_HOME_CONT.PC)XIC(GLUE_X_HOME_CONT.PC)XIC(GLUE_X_DRV_HOMED_STATUS)XIC(GLUE_Y_DRV_HOMED_STATUS)XIO(DRV_INTERNAL_HOME_REQ)MOV(100,STEP_HOMING[10]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[10],100)[OTU(GLUE_X_Y_DRV_HOMING_IND) OTU(GLUE_X_Y_DRV_HOME_PB) ,XIO(GLUE_X_DRV_FAULT) XIO(GLUE_Y_DRV_FAULT) OTU(DRV_HOMING_REQ) ,MOV(500,STEP_HOMING[10]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION STATUS
************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIO(GLUE_X_DRV_FAULT)XIO(GLUE_Y_DRV_FAULT)XIC(GLUE_X_DRV_HOMED_STATUS)XIC(GLUE_Y_DRV_HOMED_STATUS)XIC(GLUE_X_DRV_READY)XIC(GLUE_Y_DRV_READY)XIC(GLUE_AT_SAMPLE_POS)XIC(GLUE_Z_CYL_RET)XIO(GLUE_ON_PB)[XIC(GLUE_MELTER_AUTO_READY) XIC(GLUE_OUT_PRESSURE_PRE_OK) ,XIO(GLUE_ACTIVE_RECIPE_LOADED) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ,XIC(CELL_BAG_TEST_PICK_MODE_PB) ]EQU(STEP_HOME[10],500)OTE(CELL_AUTO_READY[10]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK THAT EVERYTHING IS CLEAR BEFORE INDEXING LINEAR MOVES
DOES NOT INCLUDE THE COORDINATED MOVES FOR GLUE PATHS]]>
</Comment>
<Text>
<![CDATA[XIC(GLUE_Z_CYL_RET)OTE(GLUE_CLEAR_TO_INDEX);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[********GLUE MELTER********

TURN ON GLUE MELTER HEATERS AND PUMP MOTOR]]>
</Comment>
<Text>
<![CDATA[[OTE(GLUE_MELT_HEATER_ON) ,OTE(GLUE_MELT_PUMP_ENABLE) ,OTU(GLUE_MELT_HOSE_DISABLE) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[GLUE MELTER STATUS]]>
</Comment>
<Text>
<![CDATA[[XIC(GLUE_MELT_READY) XIC(GLUE_MELT_NOT_FAULTED) XIC(GLUE_MELT_HEATER_ON) XIC(GLUE_MELT_PUMP_ENABLE) XIO(GLUE_MELT_HOSE_DISABLE) OTE(GLUE_MELTER_AUTO_READY) ,NEQ(STEP_ESTOP_RESET[10],1000) XIC(CELL_STARTED) XIC(GLUE_ACTIVE_RECIPE_LOADED) XIO(CELL_BAG_TEST_PICK_MODE_PB) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(GLUE_MELTER_AUTO_READY) [TON(TIMER_ALARM[10],?,?) ,XIC(TIMER_ALARM[10].DN) MOV(155,STEP_ALARM[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GLUE MELTER INACTIVITY TIMER
STANDBY MODE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[0],500)[MUL(GLUE_MELT_INACTIVE_TIME_PB,60000,TIMER_OPER[5].PRE) ,TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) OTE(A:O.Data[6].16) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MONITOR STATION INACTIVITY
AND SEND GLUE PURGE REQUESTS
]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_DRY_CYCLE_MODE_PB)[XIO(GLUE_PURGE_CYCLE_IN_PROGRESS) XIO(Local:2:O.Pt00.Data) [MUL(GLUE_GUN_INACTIVITY_TIME,60000,TIMER_OPER[6].PRE) ,TON(TIMER_OPER[6],?,?) ] ,[XIC(TIMER_OPER[6].DN) ,XIC(GLUE_AUTO_EXT_PURGE_REQ) ] ONS(ONS_ARRAY[4]) [OTL(GLUE_AUTO_EXT_PURGE_REQ) ,OTL(GLUE_AUTO_PURGE_REQ) ,MOV(177,STEP_ALARM[10]) ] ,AFI() XIC(RFID_CONTROL.FD) [OTU(GLUE_AUTO_PURGE_REQ) ,RES(RFID_CONTROL) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
