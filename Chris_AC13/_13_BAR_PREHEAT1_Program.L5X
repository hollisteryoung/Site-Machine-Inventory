<Data Format="L5K">
<![CDATA[[5.50000000e+000,2.26199997e+002,2.13400009e+002,0.00000000e+000,0.00000000e+000]]]>
</Data>
<Data Format="Decorated">
<Array DataType="REAL" Dimensions="5" Radix="Float">
<Element Index="[0]" Value="5.5"/>
<Element Index="[1]" Value="226.2"/>
<Element Index="[2]" Value="213.40001"/>
<Element Index="[3]" Value="0.0"/>
<Element Index="[4]" Value="0.0"/>
</Array>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS

]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[13]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],0)[XIC(CELL_STARTED) [XIO(RUN_PROCESS) MOV(5,STEP_AUTO[13]) ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[13]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(PREHEAT1_CYCLE_PB) MOV(20,STEP_AUTO[13]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],5)[OTE(PREHEAT1_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[13]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIO(CELL_EMPTY_COMPLETE.6) XIC(PREHEAT1_DATA_BAR_LOADED) XIO(PREHEAT1_DATA_BAR_REJECT) [XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIC(PREHEAT1_DATA_BAG_LOADED) XIO(PREHEAT1_DATA_GLUE_STARTED) XIO(PREHEAT1_DATA_BAG_REJECT) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ] [XIO(PREHEAT1_DATA_FORMING_STARTED) ,XIO(FORMING_ACTIVE_RECIPE_LOADED) ] XIC(PREHEAT1_ACTIVE_RECIPE_LOADED) OTE(RUN_PROCESS) ,EQU(STEP_AUTO[13],10) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[13]) ,XIO(RUN_PROCESS) MOV(150,STEP_AUTO[13]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[EXTEND UPPER CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],20)[[XIO(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) XIO(GLUE_AT_SAMPLE_POS) ,XIC(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) ] OTL(PREHEAT1_UP_CYL_EXT_PB) ,XIC(PREHEAT1_UP_CYL_EXT) [OTL(PREHEAT1_DATA_PREHEAT1_STARTED) ,MOV(30,STEP_AUTO[13]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[EXTEND LOWER CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],30)[OTL(PREHEAT1_LOW_CYL_EXT_PB) ,XIC(PREHEAT1_LOW_CYL_EXT) MOV(40,STEP_AUTO[13]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR PREHEAT TIME]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],40)[XIC(PREHEAT_ADJUST_TIME_LOADED) MOV(PREHEAT1_TIME_ADJ,TIMER_OPER[0].PRE) ,XIO(PREHEAT_ADJUST_TIME_LOADED) MOV(PREHEAT1_TIME_RECIPE,TIMER_OPER[0].PRE) ,TON(TIMER_OPER[0],?,?) ,[XIC(TIMER_OPER[0].DN) ,XIO(PREHEAT1_UP_TEMP_OK) ,XIO(PREHEAT1_LOW_TEMP_OK) ] [XIC(CELL_STARTED) [XIC(PREHEAT1_UP_TEMP_OK) OTL(PREHEAT1_DATA_PREHEAT1_UP_TEMP_OK) ,XIC(PREHEAT1_LOW_TEMP_OK) OTL(PREHEAT1_DATA_PREHEAT1_LOW_TEMP_OK) ,XIC(TIMER_OPER[0].DN) OTL(PREHEAT1_DATA_PREHEAT1_COMPLETE) ] ,MOV(50,STEP_AUTO[13]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RETRACT UPPER AND LOWER CYLINDERS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],50)[OTU(PREHEAT1_UP_CYL_EXT_PB) ,OTU(PREHEAT1_LOW_CYL_EXT_PB) ,XIC(PREHEAT1_UP_CYL_RET) XIC(PREHEAT1_LOW_CYL_RET) [XIC(CELL_STARTED) MOV(150,STEP_AUTO[13]) ,XIC(CELL_MANUAL_MODE) XIO(PREHEAT1_CYCLE_PB) MOV(0,STEP_AUTO[13]) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],150)[OTL(PREHEAT1_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.5) XIO(BARRIER_LOAD_DATA_BAR_LOADED) OTL(CELL_EMPTY_COMPLETE.6) ,TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) MOV(160,STEP_AUTO[13]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[13],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(PREHEAT1_PROCESS_DONE) ,MOV(5,STEP_AUTO[13]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[MONITOR OPEN AIR TIME FOR BARRIER THAT HAS BEEN PREHEATED]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_DRY_CYCLE_MODE_PB)XIC(CELL_STARTED)XIO(MAIN_DIAL_DRV_MOVING)XIO(PREHEAT1_DATA_BAR_REJECT)XIC(PREHEAT1_DATA_PREHEAT1_COMPLETE)XIO(PREHEAT1_DATA_FORMING_COMPLETE)[TON(CELL_TIMER_OPER[9],?,?) ,XIC(CELL_TIMER_OPER[9].DN) [OTU(PREHEAT1_DATA_PREHEAT1_STARTED) ,OTU(PREHEAT1_DATA_PREHEAT1_UP_TEMP_OK) ,OTU(PREHEAT1_DATA_PREHEAT1_LOW_TEMP_OK) ,OTU(PREHEAT1_DATA_PREHEAT1_COMPLETE) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[[EQU(STEP_AUTO[13],150) ,EQU(STEP_AUTO[13],1000) ] ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[4].ACC,1000,CELL_CYCLE_TIME[0].BARRIER_PREHEAT1) ,[LIM(20,STEP_AUTO[13],149) ONS(ONS_ARRAY[29]) ,XIC(TIMER_OPER[4].TT) NEQ(STEP_AUTO[13],150) NEQ(STEP_AUTO[13],1000) ] TON(TIMER_OPER[4],?,?) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[13],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].BARRIER_PREHEAT1,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(4,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_PREHEAT1,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].BARRIER_PREHEAT1,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].BARRIER_PREHEAT1,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(4,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_PREHEAT1,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 ESTOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[13],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[13]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[13],1000) EQU(STEP_ALARM_CAPTURE[13],0) MOV(STEP_ALARM[13],STEP_ALARM_CAPTURE[13]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[13],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.13) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[13],1000)[NEQ(STEP_ALARM[13],0) OTE(MAJOR_FAULT[13]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[13],STEP_AUTO_RET_ESTOP[13]) ,OTU(PREHEAT1_UP_CYL_EXT_PB) OTU(PREHEAT1_LOW_CYL_EXT_PB) ,OTU(PREHEAT1_CYCLE_PB) OTU(PREHEAT1_PROCESS_DONE) ,XIO(PREHEAT1_DATA_BAR_REJECT) XIO(PREHEAT1_DATA_FORMING_COMPLETE) [XIO(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) XIC(PREHEAT1_DATA_PREHEAT1_STARTED) OTE(PREHEAT1_PROCESS_FAILED) ,XIC(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) [OTU(PREHEAT1_DATA_PREHEAT1_STARTED) ,OTU(PREHEAT1_DATA_PREHEAT1_UP_TEMP_OK) ,OTU(PREHEAT1_DATA_PREHEAT1_LOW_TEMP_OK) ,OTU(PREHEAT1_DATA_PREHEAT1_COMPLETE) ] ] ,MOV(1000,STEP_HOME[13]) MOV(1000,STEP_AUTO[13]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[13],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[13]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[13],10)[MOV(0,STEP_ALARM[13]) ,MOV(0,STEP_ALARM_CAPTURE[13]) ,MOV(20,STEP_ESTOP_RESET[13]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[13],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[13]) ,MOV(30,STEP_ESTOP_RESET[13]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[13]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[13],30)EQU(STEP_HOME[13],500)MOV(500,STEP_ESTOP_RESET[13]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 HMI
***************************************************************************

BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(PREHEAT1_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(PREHEAT1_BYPASS_ANIMATION);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 HOME ROUTINE
*******************************************************************************

SET COMPONENTS TO HOME STATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[13],0)[OTU(PREHEAT1_UP_CYL_EXT_PB) ,OTU(PREHEAT1_LOW_CYL_EXT_PB) ,XIC(PREHEAT1_UP_CYL_RET) XIC(PREHEAT1_LOW_CYL_RET) [MOV(0,STEP_AUTO[13]) ,MOV(500,STEP_HOME[13]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(TEMP_UP_PID,0) ,JSR(TEMP_LOW_PID,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 OUTPUTS
*******************************************************************************

BARRIER PREHEAT STATION 1 UPPER CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[13],1000) XIC(CELL_PRESSURE_OK) [XIC(PREHEAT1_UP_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN01:O.Data[3].2) ,XIC(CELL_ALARMS_ACTIVE) XIO(PREHEAT1_UP_CYL_EXT) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(231,STEP_ALARM[13]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(PREHEAT1_UP_CYL_EXT_PB) ] ,XIO(PREHEAT1_UP_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PREHEAT1_UP_CYL_RET) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) MOV(232,STEP_ALARM[13]) ] ] ,XIC(PREHEAT_ACTIVATE_HEATERS_PB) XIO(CELL_STARTED) XIO(PREHEAT1_UP_CYL_RET) [TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) [OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,MOV(245,STEP_ALARM[13]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 LOWER CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[13],1000)XIC(CELL_PRESSURE_OK)[XIC(PREHEAT1_LOW_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN01:O.Data[3].4) ,XIC(CELL_ALARMS_ACTIVE) XIO(PREHEAT1_LOW_CYL_EXT) [TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(233,STEP_ALARM[13]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(PREHEAT1_LOW_CYL_EXT_PB) ] ,XIO(PREHEAT1_LOW_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PREHEAT1_LOW_CYL_RET) [TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) MOV(234,STEP_ALARM[13]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[[EQU(PREHEAT1_RTD:I.Fault,0) XIO(PREHEAT1_RTD:I.Ch0Fault) XIO(PREHEAT1_RTD:I.Ch1Fault) XIO(PREHEAT1_RTD:I.Ch2Fault) XIO(PREHEAT1_RTD:I.Ch3Fault) OTE(PREHEAT1_RTD_MOD_OK) ,EQU(STEP_HOME[13],500) XIC(PREHEAT1_UP_CYL_RET) XIC(PREHEAT1_LOW_CYL_RET) [XIC(PREHEAT1_UP_TEMP_OK) XIC(PREHEAT1_LOW_TEMP_OK) XIC(PREHEAT1_RTD_MOD_OK) ,XIO(PREHEAT1_ACTIVE_RECIPE_LOADED) ,XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ] OTE(CELL_AUTO_READY[13]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="TEMP_LOW_PID" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 LOWER TOOL TEMPERATURE PID
************************************************************************************

LOAD LOWER RAW TEMPERATURE DATA INTO VARIABLES]]>
</Comment>
<Text>
<![CDATA[[[[MOV(PREHEAT1_RTD:I.Ch3Data,PREHEAT1_LOW_TOOL_TEMP) ,MUL(PREHEAT1_LOW_TOOL_TEMP,0.1,PREHEAT1_LOW_TOOL_TEMP_REAL) ,MOV(PREHEAT1_LOW_TOOL_TEMP_REAL,PREHEAT1_LOW_TOOL_TEMP_DISPLAY) ] ,XIC(PREHEAT_ACTIVATE_HEATERS_PB) LES(PREHEAT1_RTD:I.Ch3Data,0) [MOV(239,STEP_ALARM[13]) ,OTU(PREHEAT_ACTIVATE_HEATERS_PB) ] ] ,[[MOV(PREHEAT1_RTD:I.Ch2Data,PREHEAT1_LOW_BLOCK_TEMP) ,MUL(PREHEAT1_LOW_BLOCK_TEMP,0.1,PREHEAT1_LOW_BLOCK_TEMP_REAL) ,MOV(PREHEAT1_LOW_BLOCK_TEMP_REAL,PREHEAT1_LOW_BLOCK_TEMP_DISPLAY) ] ,XIC(PREHEAT_ACTIVATE_HEATERS_PB) LES(PREHEAT1_RTD:I.Ch2Data,0) [MOV(240,STEP_ALARM[13]) ,OTU(PREHEAT_ACTIVATE_HEATERS_PB) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[VERIFY TOOLING TEMPERATURE IS WITHIN REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT_ACTIVATE_HEATERS_PB)CMP(PREHEAT1_LOW_TOOL_PID_SP+LOW_TEMP_DELTA_ALLOWED>PREHEAT1_LOW_TOOL_PID_PV)CMP(PREHEAT1_LOW_TOOL_PID_SP-LOW_TEMP_DELTA_ALLOWED<PREHEAT1_LOW_TOOL_PID_PV)OTE(PREHEAT1_LOW_TEMP_OK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IF STATION DOESN'T CYCLE, LOAD STATIC BIAS VALUE
IF STATION IS CYCLING, LOAD DYNAMIC BIAS VALUE]]>
</Comment>
<Text>
<![CDATA[[[XIC(PREHEAT1_LOW_CYL_RET) ,XIO(CELL_STARTED) ] TON(TIMER_OPER[9],?,?) ,XIO(CELL_RECIPE_LOAD_COMPLETE) [XIC(TIMER_OPER[9].DN) ,XIC(CELL_SHUTDOWN_REQ) ] ONS(ONS_ARRAY[2]) [XIC(CELL_SMALL_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_SMALL,PREHEAT1_LOW_TOOL_PID.BIAS) ,XIC(CELL_MEDIUM_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_MEDIUM,PREHEAT1_LOW_TOOL_PID.BIAS) ,XIC(CELL_LARGE_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_LARGE,PREHEAT1_LOW_TOOL_PID.BIAS) ,XIC(CELL_SMALL_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_SM_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_LARGE_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_STATIC_BIAS_LG_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ] ,XIC(CELL_STARTED) XIO(CELL_SHUTDOWN_REQ) XIO(TIMER_OPER[9].DN) ONS(ONS_ARRAY[3]) [XIC(CELL_SMALL_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_DYN_BIAS_SMALL,PREHEAT1_LOW_TOOL_PID.BIAS) ,XIC(CELL_MEDIUM_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_DYN_BIAS_MEDIUM,PREHEAT1_LOW_TOOL_PID.BIAS) ,XIC(CELL_LARGE_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_DYN_BIAS_LARGE,PREHEAT1_LOW_TOOL_PID.BIAS) ,XIC(CELL_SMALL_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_DYN_BIAS_SM_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_LARGE_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_LOW_TOOL_PID_DYN_BIAS_LG_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[TOOL TEMPERATURE CONTROL PID]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT_ACTIVATE_HEATERS_PB)[XIO(TIMER_OPER[14].DN) TON(TIMER_OPER[14],?,?) ,XIC(TIMER_OPER[14].DN) PID(PREHEAT1_LOW_TOOL_PID,PREHEAT1_LOW_TOOL_TEMP_REAL,0,PREHEAT1_LOW_TOOL_TEMP_PID_CV,0,0,0) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[TEST TEMPERATURE SET POINT AND DON'T ALLOW MAX LIMIT]]>
</Comment>
<Text>
<![CDATA[GRT(PREHEAT1_LOW_TOOL_PID_SP,356)[MOV(1,PREHEAT1_LOW_TEMP_RECIPE_SP) ,MOV(1,PREHEAT1_LOW_TEMP_SP_MAN_DISPLAY) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CONTROL OVERSHOOT TEMP BY CHECKING TEMPERATURE AND RATE OF TEMPERATURE CHANGE OF BLOCK]]>
</Comment>
<Text>
<![CDATA[[[XIC(TIMER_OPER[11].TT) ONS(ONS_ARRAY[8]) MOV(PREHEAT1_LOW_BLOCK_TEMP_DISPLAY,LOW_BLOCK_TEMP_SAMPLE1) ,TON(TIMER_OPER[11],?,?) ,XIC(TIMER_OPER[11].DN) [MOV(PREHEAT1_LOW_BLOCK_TEMP_DISPLAY,LOW_BLOCK_TEMP_SAMPLE2) ,CPT(LOW_BLOCK_TEMP_CHANGE_RATE,(LOW_BLOCK_TEMP_SAMPLE2-LOW_BLOCK_TEMP_SAMPLE1)/TIMER_OPER[10].PRE*1000) ,RES(TIMER_OPER[11]) ] ] ,[XIC(CELL_MANUAL_MODE) [SUB(PREHEAT1_LOW_TEMP_SP_MAN_DISPLAY,LOW_BLOCK_TEMP_STARTUP_LEVEL_LOW_DELTA,LOW_BLOCK_TEMP_STARTUP_LOW_LEVEL) ,SUB(PREHEAT1_LOW_TEMP_SP_MAN_DISPLAY,LOW_BLOCK_TEMP_STARTUP_LEVEL_UP_DELTA,LOW_BLOCK_TEMP_STARTUP_UP_LEVEL) ] ,XIO(CELL_MANUAL_MODE) [SUB(PREHEAT1_LOW_TEMP_SP_AUTO_DISPLAY,LOW_BLOCK_TEMP_STARTUP_LEVEL_LOW_DELTA,LOW_BLOCK_TEMP_STARTUP_LOW_LEVEL) ,SUB(PREHEAT1_LOW_TEMP_SP_AUTO_DISPLAY,LOW_BLOCK_TEMP_STARTUP_LEVEL_UP_DELTA,LOW_BLOCK_TEMP_STARTUP_UP_LEVEL) ] ] ,[CMP(PREHEAT1_LOW_BLOCK_TEMP_REAL-PREHEAT1_LOW_TOOL_PID_SP>BLOCK_SAFE_MAX_TEMP_DELTA) ,XIO(CELL_STARTED) GRT(PREHEAT1_LOW_BLOCK_TEMP_DISPLAY,LOW_BLOCK_TEMP_STARTUP_LOW_LEVEL) LES(PREHEAT1_LOW_BLOCK_TEMP_DISPLAY,LOW_BLOCK_TEMP_STARTUP_UP_LEVEL) GRT(LOW_BLOCK_TEMP_CHANGE_RATE,LOW_BLOCK_TEMP_MAX_CHANGE_RATE) ] OTE(LOW_STOP_HEATER_OVER_SHOOT) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CONVERT PERCENTAGE OUTPUT FROM PID CONTROLLER TO A PULSE TIME FOR THE HEATER]]>
</Comment>
<Text>
<![CDATA[[XIC(PREHEAT_ACTIVATE_HEATERS_PB) XIO(TIMER_OPER[3].DN) XIO(LOW_STOP_HEATER_OVER_SHOOT) [TON(TIMER_OPER[3],?,?) ,MUL(PREHEAT1_LOW_TOOL_TEMP_PID_CV,10,LOW_TOOL_TEMP_PID_CV_SCALED) LES(TIMER_OPER[3].ACC,LOW_TOOL_TEMP_PID_CV_SCALED) OTE(A:O.Data[2].9) ] ,[XIC(PREHEAT_ACTIVATE_HEATERS_PB) XIO(LOW_STOP_HEATER_OVER_SHOOT) MOV(PREHEAT1_LOW_TOOL_TEMP_PID_CV,PREHEAT1_LOW_TOOL_HEATER_OUTPUT_RATE) ,[XIC(LOW_STOP_HEATER_OVER_SHOOT) ,XIO(PREHEAT_ACTIVATE_HEATERS_PB) ] MOV(0,PREHEAT1_LOW_TOOL_HEATER_OUTPUT_RATE) ] ,XIO(PREHEAT_ACTIVATE_HEATERS_PB) MOV(0,PREHEAT1_LOW_TOOL_TEMP_PID_CV) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ADD OPERATOR ADJUSTMENT TO TEMPERATURE SETPOINT]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[LIM(PREHEAT1_LOW_TEMP_MAX,PREHEAT1_LOW_TEMP_SP_AUTO,PREHEAT1_LOW_TEMP_MIN) MOV(0,PREHEAT1_LOW_ADJ_TEMP) ,ADD(PREHEAT1_LOW_TEMP_RECIPE_SP,PREHEAT1_LOW_ADJ_TEMP,PREHEAT1_LOW_TEMP_SP_AUTO) ,MOV(PREHEAT1_LOW_TEMP_SP_AUTO,PREHEAT1_LOW_TEMP_SP_AUTO_DISPLAY) ,MOV(PREHEAT1_LOW_TEMP_SP_AUTO,PREHEAT1_LOW_TOOL_PID_SP) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ CACULATE OPERATERS MAXIMUM & MINIMUM ALLOWABLE SETPOINT ADJUSTMENT BASED ON RECIPE TEMPERATURE]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[[SUB(PREHEAT1_LOW_TEMP_RECIPE_SP,LOW_TEMP_OP_DELTA_ALLOWED,PREHEAT1_LOW_TEMP_MIN) ,LES(PREHEAT1_LOW_TEMP_MAX,LOW_TEMP_MIN_ALLOWED) MOV(LOW_TEMP_MIN_ALLOWED,PREHEAT1_LOW_TEMP_MIN) ] ,[ADD(PREHEAT1_LOW_TEMP_RECIPE_SP,LOW_TEMP_OP_DELTA_ALLOWED,PREHEAT1_LOW_TEMP_MAX) ,GRT(PREHEAT1_LOW_TEMP_MAX,LOW_TEMP_MAX_ALLOWED) MOV(LOW_TEMP_MAX_ALLOWED,PREHEAT1_LOW_TEMP_MAX) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[IF RECIPE VALUE CHANGES ZERO OUT OFFSET ADJUST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)MOV(0,PREHEAT1_LOW_ADJ_TEMP);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[****MANUAL MODE****

SET TEMPERATURE SETPOINT FOR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)ONS(ONS_ARRAY[4])MOV(PREHEAT1_LOW_TEMP_SP_AUTO_DISPLAY,PREHEAT1_LOW_TEMP_SP_MAN_DISPLAY);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[WHILE IN MANUAL MODE, ALLOW THE TEMPERATURE SLIDERS FULL SCALE OF OPERATION.]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[MUL(PREHEAT1_LOW_TEMP_SP_MAN_DISPLAY,1,PREHEAT1_LOW_TEMP_SP_MAN) ,MOV(LOW_TEMP_MIN_ALLOWED,PREHEAT1_LOW_TEMP_MIN) ,MOV(LOW_TEMP_MAX_ALLOWED,PREHEAT1_LOW_TEMP_MAX) ,MOV(PREHEAT1_LOW_TEMP_SP_MAN,PREHEAT1_LOW_TOOL_PID_SP) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[CONTROLS IF THE AUTO OR MANUAL SETPOINT IS DISPLAYED ON THE HMI TEMP GRAPH]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_MANUAL_MODE) MOV(PREHEAT1_LOW_TEMP_SP_MAN_DISPLAY,PREHEAT1_LOW_TEMP_SP_TRACE_DISPLAY) ,XIO(CELL_MANUAL_MODE) MOV(PREHEAT1_LOW_TEMP_SP_AUTO_DISPLAY,PREHEAT1_LOW_TEMP_SP_TRACE_DISPLAY) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[MONITOR RTDS FOR RUNAWAY PROTECTION]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT_ACTIVATE_HEATERS_PB)[[GRT(PREHEAT1_LOW_TOOL_TEMP_DISPLAY,PREHEAT_MAX_ALLOWED_TEMP) ,GRT(PREHEAT1_LOW_BLOCK_TEMP_DISPLAY,PREHEAT_MAX_ALLOWED_TEMP) ] ,[LES(PREHEAT1_LOW_TOOL_TEMP_DISPLAY,PREHEAT_MIN_ALLOWED_TEMP) ,LES(PREHEAT1_LOW_BLOCK_TEMP_DISPLAY,PREHEAT_MIN_ALLOWED_TEMP) ] ][OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,OTU(A:O.Data[2].19) ,MOV(241,STEP_ALARM[13]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[IF PID OUTPUT IS ABOVE CERTAIN LEVEL, MONITOR FOR TEMPERATURE CHANGES
TO PROTECT AGAINST RUN AWAY
]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_PREHEAT_RUNAWAY_CHK_ENABLED)[XIC(PREHEAT_ACTIVATE_HEATERS_PB) GRT(PREHEAT1_LOW_TOOL_TEMP_PID_CV,50) XIO(LOW_STOP_HEATER_OVER_SHOOT) [TON(TIMER_OPER[6],?,?) ,XIC(TIMER_OPER[6].DN) [XIC(TIMER_OPER[7].DN) [CTU(LOW_TOOL_SAMPLE_TEMP_COUNTER,?,?) ,MOV(LOW_TOOL_SAMPLE_TEMP_COUNTER.ACC,LOW_TOOL_SAMPLE_TEMP_INDEX) MOV(PREHEAT1_LOW_TOOL_TEMP_DISPLAY,LOW_TOOL_TEMP_SAMPLE[LOW_TOOL_SAMPLE_TEMP_INDEX]) ,GEQ(LOW_TOOL_SAMPLE_TEMP_COUNTER.ACC,2) [SUB(LOW_TOOL_TEMP_SAMPLE[2],LOW_TOOL_TEMP_SAMPLE[1],LOW_TOOL_TEMP_SAMPLE[0]) ,LES(LOW_TOOL_TEMP_SAMPLE[0],0.3) [OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,MOV(243,STEP_ALARM[13]) ] ,RES(LOW_TOOL_SAMPLE_TEMP_COUNTER) ] ] ,XIO(TIMER_OPER[7].DN) TON(TIMER_OPER[7],?,?) ] ] ,[XIO(PREHEAT_ACTIVATE_HEATERS_PB) ,LEQ(PREHEAT1_LOW_TOOL_TEMP_PID_CV,50) ,XIC(LOW_STOP_HEATER_OVER_SHOOT) ] RES(LOW_TOOL_SAMPLE_TEMP_COUNTER) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="TEMP_UP_PID" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PREHEAT STATION 1 UPPER TOOL TEMPERATURE PID
************************************************************************************

LOAD UPPER RAW TEMPERATURE DATA INTO VARIABLES]]>
</Comment>
<Text>
<![CDATA[[[[MOV(PREHEAT1_RTD:I.Ch1Data,PREHEAT1_UP_TOOL_TEMP) ,MUL(PREHEAT1_UP_TOOL_TEMP,0.1,PREHEAT1_UP_TOOL_TEMP_REAL) ,MOV(PREHEAT1_UP_TOOL_TEMP_REAL,PREHEAT1_UP_TOOL_TEMP_DISPLAY) ] ,XIC(PREHEAT_ACTIVATE_HEATERS_PB) LES(PREHEAT1_RTD:I.Ch1Data,0) [MOV(237,STEP_ALARM[13]) ,OTU(PREHEAT_ACTIVATE_HEATERS_PB) ] ] ,[[MOV(PREHEAT1_RTD:I.Ch0Data,PREHEAT1_UP_BLOCK_TEMP) ,MUL(PREHEAT1_UP_BLOCK_TEMP,0.1,PREHEAT1_UP_BLOCK_TEMP_REAL) ,MOV(PREHEAT1_UP_BLOCK_TEMP_REAL,PREHEAT1_UP_BLOCK_TEMP_DISPLAY) ] ,XIC(PREHEAT_ACTIVATE_HEATERS_PB) LES(PREHEAT1_RTD:I.Ch0Data,0) [MOV(238,STEP_ALARM[13]) ,OTU(PREHEAT_ACTIVATE_HEATERS_PB) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[VERIFY TOOLING TEMPERATURE IS WITHIN REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT_ACTIVATE_HEATERS_PB)CMP(PREHEAT1_UP_TOOL_PID_SP+UP_TEMP_DELTA_ALLOWED>PREHEAT1_UP_TOOL_PID_PV)CMP(PREHEAT1_UP_TOOL_PID_SP-UP_TEMP_DELTA_ALLOWED<PREHEAT1_UP_TOOL_PID_PV)OTE(PREHEAT1_UP_TEMP_OK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IF STATION DOESN'T CYCLE, LOAD STATIC BIAS VALUE
IF STATION IS CYCLING, LOAD DYNAMIC BIAS VALUE]]>
</Comment>
<Text>
<![CDATA[[[XIC(PREHEAT1_UP_CYL_RET) ,XIO(CELL_STARTED) ] TON(TIMER_OPER[8],?,?) ,XIO(CELL_RECIPE_LOAD_COMPLETE) [XIC(TIMER_OPER[8].DN) ,XIC(CELL_SHUTDOWN_REQ) ] ONS(ONS_ARRAY[5]) [XIC(CELL_SMALL_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_STATIC_BIAS_SMALL,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_MEDIUM_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_STATIC_BIAS_MEDIUM,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_LARGE_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_STATIC_BIAS_LARGE,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_SMALL_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_STATIC_BIAS_SM_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_LARGE_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_STATIC_BIAS_LG_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ] ,XIC(CELL_STARTED) XIO(CELL_SHUTDOWN_REQ) XIO(TIMER_OPER[8].DN) ONS(ONS_ARRAY[6]) [XIC(CELL_SMALL_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_DYN_BIAS_SMALL,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_MEDIUM_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_DYN_BIAS_MEDIUM,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_LARGE_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_DYN_BIAS_LARGE,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_SMALL_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_DYN_BIAS_SM_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ,XIC(CELL_LARGE_SNF_PART_FAMILY_LOADED) MOV(PREHEAT1_UP_TOOL_PID_DYN_BIAS_LG_SNF,PREHEAT1_UP_TOOL_PID.BIAS) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[TOOL TEMPERATURE CONTROL PID]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT_ACTIVATE_HEATERS_PB)[XIO(TIMER_OPER[15].DN) TON(TIMER_OPER[15],?,?) ,XIC(TIMER_OPER[15].DN) PID(PREHEAT1_UP_TOOL_PID,PREHEAT1_UP_TOOL_TEMP_REAL,0,PREHEAT1_UP_TOOL_TEMP_PID_CV,0,0,0) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[TEST TEMPERATURE SET POINT AND DON'T ALLOW ABOVE MAX LIMIT]]>
</Comment>
<Text>
<![CDATA[GRT(PREHEAT1_UP_TOOL_PID_SP,356)[MOV(1,PREHEAT1_UP_TEMP_RECIPE_SP) ,MOV(1,PREHEAT1_UP_TEMP_SP_MAN_DISPLAY) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CONTROL OVERSHOOT TEMP BY CHECKING TEMPERATURE AND RATE OF TEMPERATURE CHANGE OF BLOCK]]>
</Comment>
<Text>
<![CDATA[[[XIC(TIMER_OPER[10].TT) ONS(ONS_ARRAY[7]) MOV(PREHEAT1_UP_BLOCK_TEMP_DISPLAY,UP_BLOCK_TEMP_SAMPLE1) ,TON(TIMER_OPER[10],?,?) ,XIC(TIMER_OPER[10].DN) [MOV(PREHEAT1_UP_BLOCK_TEMP_DISPLAY,UP_BLOCK_TEMP_SAMPLE2) ,CPT(UP_BLOCK_TEMP_CHANGE_RATE,(UP_BLOCK_TEMP_SAMPLE2-UP_BLOCK_TEMP_SAMPLE1)/TIMER_OPER[10].PRE*1000) ,RES(TIMER_OPER[10]) ] ] ,[XIC(CELL_MANUAL_MODE) [SUB(PREHEAT1_UP_TEMP_SP_MAN_DISPLAY,UP_BLOCK_TEMP_STARTUP_LEVEL_LOW_DELTA,UP_BLOCK_TEMP_STARTUP_LOW_LEVEL) ,SUB(PREHEAT1_UP_TEMP_SP_MAN_DISPLAY,UP_BLOCK_TEMP_STARTUP_LEVEL_UP_DELTA,UP_BLOCK_TEMP_STARTUP_UP_LEVEL) ] ,XIO(CELL_MANUAL_MODE) [SUB(PREHEAT1_UP_TEMP_SP_AUTO_DISPLAY,UP_BLOCK_TEMP_STARTUP_LEVEL_LOW_DELTA,UP_BLOCK_TEMP_STARTUP_LOW_LEVEL) ,SUB(PREHEAT1_UP_TEMP_SP_AUTO_DISPLAY,UP_BLOCK_TEMP_STARTUP_LEVEL_UP_DELTA,UP_BLOCK_TEMP_STARTUP_UP_LEVEL) ] ] ,[CMP(PREHEAT1_UP_BLOCK_TEMP_REAL-PREHEAT1_UP_TOOL_PID_SP>BLOCK_SAFE_MAX_TEMP_DELTA) ,XIO(CELL_STARTED) GRT(PREHEAT1_UP_BLOCK_TEMP_DISPLAY,UP_BLOCK_TEMP_STARTUP_LOW_LEVEL) LES(PREHEAT1_UP_BLOCK_TEMP_DISPLAY,UP_BLOCK_TEMP_STARTUP_UP_LEVEL) GRT(UP_BLOCK_TEMP_CHANGE_RATE,UP_BLOCK_TEMP_MAX_CHANGE_RATE) ] OTE(UP_STOP_HEATER_OVER_SHOOT) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CONVERT PERCENTAGE OUTPUT FROM PID CONTROLLER TO A PULSE TIME FOR THE HEATER]]>
</Comment>
<Text>
<![CDATA[[XIC(PREHEAT_ACTIVATE_HEATERS_PB) XIO(TIMER_OPER[2].DN) XIO(UP_STOP_HEATER_OVER_SHOOT) [TON(TIMER_OPER[2],?,?) ,MUL(PREHEAT1_UP_TOOL_TEMP_PID_CV,10,UP_TOOL_TEMP_PID_CV_SCALED) LES(TIMER_OPER[2].ACC,UP_TOOL_TEMP_PID_CV_SCALED) OTE(A:O.Data[2].8) ] ,[XIC(PREHEAT_ACTIVATE_HEATERS_PB) XIO(UP_STOP_HEATER_OVER_SHOOT) MOV(PREHEAT1_UP_TOOL_TEMP_PID_CV,PREHEAT1_UP_TOOL_HEATER_OUTPUT_RATE) ,[XIC(UP_STOP_HEATER_OVER_SHOOT) ,XIO(PREHEAT_ACTIVATE_HEATERS_PB) ] MOV(0,PREHEAT1_UP_TOOL_HEATER_OUTPUT_RATE) ] ,XIO(PREHEAT_ACTIVATE_HEATERS_PB) MOV(0,PREHEAT1_UP_TOOL_TEMP_PID_CV) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ADD OPERATOR ADJUSTMENT TO TEMPERATURE SETPOINT]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[LIM(PREHEAT1_UP_TEMP_MAX,PREHEAT1_UP_TEMP_SP_AUTO,PREHEAT1_UP_TEMP_MIN) MOV(0,PREHEAT1_UP_ADJ_TEMP) ,ADD(PREHEAT1_UP_TEMP_RECIPE_SP,PREHEAT1_UP_ADJ_TEMP,PREHEAT1_UP_TEMP_SP_AUTO) ,MOV(PREHEAT1_UP_TEMP_SP_AUTO,PREHEAT1_UP_TEMP_SP_AUTO_DISPLAY) ,MOV(PREHEAT1_UP_TEMP_SP_AUTO,PREHEAT1_UP_TOOL_PID_SP) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ CACULATE OPERATERS MAXIMUM & MINIMUM ALLOWABLE SETPOINT ADJUSTMENT BASED ON RECIPE TEMPERATURE]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[[SUB(PREHEAT1_UP_TEMP_RECIPE_SP,UP_TEMP_OP_DELTA_ALLOWED,PREHEAT1_UP_TEMP_MIN) ,LES(PREHEAT1_UP_TEMP_MIN,UP_TEMP_MIN_ALLOWED) MOV(UP_TEMP_MIN_ALLOWED,PREHEAT1_UP_TEMP_MIN) ] ,[ADD(PREHEAT1_UP_TEMP_RECIPE_SP,UP_TEMP_OP_DELTA_ALLOWED,PREHEAT1_UP_TEMP_MAX) ,GRT(PREHEAT1_UP_TEMP_MAX,UP_TEMP_MAX_ALLOWED) MOV(UP_TEMP_MAX_ALLOWED,PREHEAT1_UP_TEMP_MAX) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[IF RECIPE VALUE CHANGES ZERO OUT OFFSET ADJUST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)MOV(0,PREHEAT1_UP_ADJ_TEMP);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[****MANUAL MODE****

SET TEMPERATURE SETPOINT FOR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)ONS(ONS_ARRAY[0])MOV(PREHEAT1_UP_TEMP_SP_AUTO_DISPLAY,PREHEAT1_UP_TEMP_SP_MAN_DISPLAY);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[WHILE IN MANUAL MODE, ALLOW THE TEMPERATURE SLIDERS FULL SCALE OF OPERATION.]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[MUL(PREHEAT1_UP_TEMP_SP_MAN_DISPLAY,1,PREHEAT1_UP_TEMP_SP_MAN) CPT(PREHEAT1_UP_TEMP_SP_MAN,PREHEAT1_UP_TEMP_SP_MAN_DISPLAY*1) ,MOV(UP_TEMP_MIN_ALLOWED,PREHEAT1_UP_TEMP_MIN) ,MOV(UP_TEMP_MAX_ALLOWED,PREHEAT1_UP_TEMP_MAX) ,MOV(PREHEAT1_UP_TEMP_SP_MAN,PREHEAT1_UP_TOOL_PID_SP) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[CONTROLS IF THE AUTO OR MANUAL SETPOINT IS DISPLAYED ON THE HMI TEMP GRAPH]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_MANUAL_MODE) MOV(PREHEAT1_UP_TEMP_SP_MAN_DISPLAY,PREHEAT1_UP_TEMP_SP_TRACE_DISPLAY) ,XIO(CELL_MANUAL_MODE) MOV(PREHEAT1_UP_TEMP_SP_AUTO_DISPLAY,PREHEAT1_UP_TEMP_SP_TRACE_DISPLAY) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[MONITOR RTDS FOR RUNAWAY PROTECTION]]>
</Comment>
<Text>
<![CDATA[XIC(PREHEAT_ACTIVATE_HEATERS_PB)[[GRT(PREHEAT1_UP_TOOL_TEMP_DISPLAY,PREHEAT_MAX_ALLOWED_TEMP) ,GRT(PREHEAT1_UP_BLOCK_TEMP_DISPLAY,PREHEAT_MAX_ALLOWED_TEMP) ] ,[LES(PREHEAT1_UP_TOOL_TEMP_DISPLAY,PREHEAT_MIN_ALLOWED_TEMP) ,LES(PREHEAT1_UP_BLOCK_TEMP_DISPLAY,PREHEAT_MIN_ALLOWED_TEMP) ] ][OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,OTU(A:O.Data[2].19) ,MOV(242,STEP_ALARM[13]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[IF PID OUTPUT IS ABOVE CERTAIN LEVEL, MONITOR FOR TEMPERATURE CHANGES
TO PROTECT AGAINST RUN AWAY
]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_PREHEAT_RUNAWAY_CHK_ENABLED)[XIC(PREHEAT_ACTIVATE_HEATERS_PB) GRT(PREHEAT1_UP_TOOL_TEMP_PID_CV,50) XIO(UP_STOP_HEATER_OVER_SHOOT) [TON(TIMER_OPER[12],?,?) ,XIC(TIMER_OPER[12].DN) [XIC(TIMER_OPER[13].DN) [CTU(UP_TOOL_SAMPLE_TEMP_COUNTER,?,?) ,MOV(UP_TOOL_SAMPLE_TEMP_COUNTER.ACC,UP_TOOL_SAMPLE_TEMP_INDEX) MOV(PREHEAT1_UP_TOOL_TEMP_DISPLAY,UP_TOOL_TEMP_SAMPLE[UP_TOOL_SAMPLE_TEMP_INDEX]) ,GEQ(UP_TOOL_SAMPLE_TEMP_COUNTER.ACC,2) [SUB(UP_TOOL_TEMP_SAMPLE[2],UP_TOOL_TEMP_SAMPLE[1],UP_TOOL_TEMP_SAMPLE[0]) ,LES(UP_TOOL_TEMP_SAMPLE[0],0.15) [OTU(PREHEAT_ACTIVATE_HEATERS_PB) ,MOV(244,STEP_ALARM[13]) ] ,RES(UP_TOOL_SAMPLE_TEMP_COUNTER) ] ] ,XIO(TIMER_OPER[13].DN) TON(TIMER_OPER[13],?,?) ] ] ,[XIO(PREHEAT_ACTIVATE_HEATERS_PB) ,LEQ(PREHEAT1_UP_TOOL_TEMP_PID_CV,50) ,XIC(UP_STOP_HEATER_OVER_SHOOT) ] RES(UP_TOOL_SAMPLE_TEMP_COUNTER) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
