<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET STATION AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[31]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIC(PUNCH_DATA_BAR_LOADED) XIO(PUNCH_DATA_BAR_REJECT) [XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIC(PUNCH_DATA_BAG_LOADED) XIO(PUNCH_DATA_GLUE_STARTED) XIO(PUNCH_DATA_BAG_REJECT) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ] [XIC(PUNCH_DATA_PREHEAT1_COMPLETE) ,XIO(PREHEAT1_ACTIVE_RECIPE_LOADED) ] [XIC(PUNCH_DATA_PREHEAT2_COMPLETE) ,XIO(PREHEAT2_ACTIVE_RECIPE_LOADED) ] [XIC(PUNCH_DATA_FORMING_COMPLETE) ,XIO(FORMING_ACTIVE_RECIPE_LOADED) ] [XIC(PUNCH_DATA_PUNCH_COMPLETE) ,XIO(PUNCH_ACTIVE_RECIPE_LOADED) ] XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) XIO(MAIN_DIAL_DATA[7].INKJET_COMPLETE) OTE(RUN_PROCESS) ,EQU(STEP_AUTO[31],0) [XIC(CELL_STARTED) XIC(PUNCH_INDEX_DIAL_REQ) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[31]) ,XIO(RUN_PROCESS) MOV(30,STEP_AUTO[31]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(INKJET_PRINT_DRV_PRINT_POS) XIC(INKJET_PRINT_CYCLE_PB) MOV(20,STEP_AUTO[31]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[REQUEST INKJET PRINT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[31],20)[XIO(CELL_DRY_CYCLE_MODE_PB) OTL(INKJET_PRINTER_PRINT_REQ_PB) ,MOV(30,STEP_AUTO[31]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[31],30)[XIC(CELL_STARTED) OTE(INKJET_PRINT_INDEX_DIAL_REQ) ,XIO(CELL_STARTED) ONS(ONS_ARRAY[6]) OTL(MAIN_DIAL_INDEX_PB) ,XIC(MAIN_DIAL_INDEX_PB) XIC(MAIN_DIAL_DRV_MOVING) [[XIC(CELL_STARTED) XIC(RUN_PROCESS) ,XIO(CELL_STARTED) ] MOV(40,STEP_AUTO[31]) ,XIC(CELL_STARTED) XIO(RUN_PROCESS) MOV(150,STEP_AUTO[31]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MONITOR PRINT PROCESS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[31],40)[XIC(CELL_STARTED) [[XIC(INKJET_PRINTER_PRINT_IP) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(MAIN_DIAL_DATA[7].INKJET_STARTED) ,XIC(MAIN_DIAL_DATA[7].INKJET_STARTED) XIO(INKJET_PRINTER_PRINT_IP) OTL(MAIN_DIAL_DATA[7].INKJET_COMPLETE) ] ,XIO(MAIN_DIAL_DRV_MOVING) XIO(INKJET_PRINTER_PRINT_STARTED) [XIC(CELL_STARTED) XIC(MAIN_DIAL_DATA[7].INKJET_STARTED) XIC(MAIN_DIAL_DATA[7].INKJET_COMPLETE) MOV(150,STEP_AUTO[31]) ,XIO(CELL_STARTED) XIO(INKJET_PRINT_CYCLE_PB) MOV(0,STEP_AUTO[31]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[31],150)[OTL(INKJET_PRINT_PROCESS_DONE) ,TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) MOV(160,STEP_AUTO[31]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN ON INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[31],160)XIC(MAIN_DIAL_INDEX_DONE)[OTU(INKJET_PRINT_PROCESS_DONE) ,MOV(0,STEP_AUTO[31]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET STATION E-STOP RESET
***************************************************************************
ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[31],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[31]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[31],1000) EQU(STEP_ALARM_CAPTURE[31],0) MOV(STEP_ALARM[31],STEP_ALARM_CAPTURE[31]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[31],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.31) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[31],1000)[NEQ(STEP_ALARM[31],0) OTE(MAJOR_FAULT[31]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[31],STEP_AUTO_RET_ESTOP[31]) ,[OTU(INKJET_PRINT_DRV_RESET_PB) OTU(INKJET_PRINT_DRV_ENABLE_PB) OTU(INKJET_PRINT_DRV_INDEX_PB) ,OTU(INKJET_PRINT_DRV_HOME_PB) OTU(DRV_INTERNAL_HOME_REQ) OTU(INKJET_PRINT_DRV_HOMING_IND) ] ,OTU(INKJET_PRINTER_PRINT_REQ_PB) OTU(INKJET_PRINTER_PRINT_STARTED) ,OTU(INKJET_PRINT_PROCESS_DONE) ,OTU(INKJET_PRINTER_ENABLE_PB) OTL(INKJET_PRINTER_DISABLE_PB) ,ONS(ONS_ARRAY[7]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[0]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[1]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[2]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[3]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[4]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[5]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[7]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[8]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[9]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[10]) ,RES(LABEL_WRITE_RETRY_COUNT) RES(SKU_WRITE_RETRY_COUNT) RES(OFFSET_WRITE_RETRY_COUNT) ,[XIC(PUNCH_DATA_BAR_LOADED) XIO(PUNCH_DATA_BAR_REJECT) XIC(PUNCH_DATA_INKJET_STARTED) XIO(PUNCH_DATA_INKJET_COMPLETE) ,XIC(PRINT_DATA_BAR_LOADED) XIO(PRINT_DATA_BAR_REJECT) XIC(PRINT_DATA_INKJET_STARTED) XIO(PRINT_DATA_INKJET_COMPLETE) ] OTE(INKJET_PRINT_PROCESS_FAILED) ,MOV(1000,STEP_HOME[31]) MOV(1000,STEP_HOMING[31]) MOV(1000,STEP_AUTO[31]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[31],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[31]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[31],10)[MOV(0,STEP_ALARM[31]) ,MOV(0,STEP_ALARM_CAPTURE[31]) ,OTU(INKJET_PRINTER_DISABLE_PB) ,MOV(20,STEP_ESTOP_RESET[31]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[31],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[31]) ,MOV(30,STEP_ESTOP_RESET[31]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[31]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[31],30)EQU(STEP_HOME[31],500)MOV(500,STEP_ESTOP_RESET[31]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET STATION HMI
***************************************************************************

INKJET IAI INDEXING ANIMATION]]>
</Comment>
<Text>
<![CDATA[[[LIM(0.1,INKJET_PRINT_DRV_INPUTS.Actual_Speed,-0.1) XIC(INKJET_PRINT_DRV_INPUTS.Moving) ,XIC(INKJET_PRINT_DRV_INDEX_PB) ] [OTE(INKJET_PRINT_DRV_INDEXING_IND) ,TON(TIMER_OPER[1],?,?) ] ,XIC(TIMER_OPER[1].TT) MOV(TIMER_OPER[1].ACC,INKJET_DRV_INDEXING_CYCLE_TIME) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[31],500)[XIO(CELL_STARTED) XIO(INKJET_PRINT_DRV_FAULT) [OTE(INKJET_PRINT_DRV_ENABLE_PB_VIS) ,XIC(INKJET_PRINT_DRV_READY) [OTE(INKJET_PRINT_DRV_HOME_PB_VIS) ,XIC(INKJET_PRINT_DRV_HOMED) OTE(INKJET_PRINT_DRV_PB_VIS) ] ] ,XIC(INKJET_PRINT_DRV_FAULT) OTE(INKJET_PRINT_DRV_FAULT_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[INKJET PRINTER PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[31],500)XIO(CELL_STARTED)XIC(CELL_MANUAL_MODE)[XIO(INKJET_PRINTER_READY) OTE(INKJET_PRINTER_ENABLE_PB_VIS) ,XIC(INKJET_PRINTER_READY) OTE(INKJET_PRINTER_DISABLE_PB_VIS) ,XIC(INKJET_PRINT_DRV_PRINT_POS) XIC(INKJET_PRINTER_READY) OTE(INKJET_PRINTER_TRIGGER_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[INKJET STATION ANIMATION]]>
</Comment>
<Text>
<![CDATA[XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(INKJET_PRINT_BYPASS_ANIMATION);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CORRECT THE INKJET PRINT PLACEMENT ON THE MAIN DIAL BASED ON HMI OFFSET VALUE

ADJUSTMENTS ARE LOCATED ON THE HMI SCREEN FOR THE INKJET PRINTER STATION]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) [MOV(0,INKJET_PRINT_X_OFFSET_PB) ,MOV(0,INKJET_PRINT_Y_OFFSET_PB) ] ,[[XIC(METRIC_MACHINE) ADD(INKJET_PRINT_X_POS_RECIPE_LOADED,INKJET_PRINT_X_OFFSET_PB,INKJET_PRINT_X_POS_OFF_VAL) ,XIO(METRIC_MACHINE) CPT(INKJET_PRINT_X_POS_OFF_VAL,((INKJET_PRINT_X_OFFSET_PB*25.4)+INKJET_PRINT_X_POS_RECIPE_LOADED)) ] ,LES(INKJET_PRINT_X_POS_OFF_VAL,0) MOV(0,INKJET_PRINT_X_POS_OFF_VAL) ] ,[XIC(METRIC_MACHINE) CPT(INKJET_PRINT_Y_POS_OFF_VAL,(INKJET_PRINT_Y_OFFSET_PB+INKJET_PRINT_Y_POS_RECIPE_LOADED)*100) ,XIO(METRIC_MACHINE) CPT(INKJET_PRINT_Y_POS_OFF_VAL,((INKJET_PRINT_Y_OFFSET_PB*25.4)+INKJET_PRINT_Y_POS_RECIPE_LOADED)*100) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[OFFSET PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[0],1000)OTE(INKJET_PRINT_OFFSET_VIS);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[INKJET LEVEL LOW INDICATOR ON HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(INKJET_PRINTER_LEVEL_LOW)OTE(INKJET_PRINTER_LEVEL_OK_VIS);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[DRIVE POSITION FOR HMI]]>
</Comment>
<Text>
<![CDATA[DIV(INKJET_PRINT_DRV_INPUTS.Actual_Position,2540,INKJET_PRINT_DRV_CUR_POS_HMI);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET STATION HOME ROUTINE
***************************************************************************
RESET DRIVE FAULT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],0)[XIC(INKJET_PRINT_DRV_FAULT) OTL(INKJET_PRINT_DRV_RESET_PB) ,XIO(INKJET_PRINT_DRV_FAULT) MOV(10,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR ESTOP ACTIVE STATUS TO TURN OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],10)[XIO(INKJET_PRINT_DRV_ESTOP_ACTIVE) MOV(20,STEP_HOME[31]) ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(511,STEP_ALARM[31]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],20)[OTL(INKJET_PRINT_DRV_ENABLE_PB) ,XIC(INKJET_PRINT_DRV_READY) MOV(30,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF DRIVE REQUIRES HOMING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],30)[XIO(INKJET_PRINT_DRV_HOMED) MOV(35,STEP_HOME[31]) ,XIC(INKJET_PRINT_DRV_HOMED) MOV(40,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[START DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[31]) ,XIC(INKJET_PRINT_DRV_HOMED) MOV(40,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MOVE TO CORRECT POSITION BASED ON ACTIVE STATUS IF NOT ALREADY THERE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],40)[XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) [XIO(INKJET_PRINT_DRV_PARK_POS) MOV(50,STEP_HOME[31]) ,XIC(INKJET_PRINT_DRV_PARK_POS) MOV(100,STEP_HOME[31]) ] ,XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) [XIO(INKJET_PRINT_DRV_PRINT_POS) MOV(60,STEP_HOME[31]) ,XIC(INKJET_PRINT_DRV_PRINT_POS) MOV(70,STEP_HOME[31]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[INDEX TO PARK POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],50)[MOV(1,DRV_INDEX_NUM) ,ONS(ONS_ARRAY[2]) OTL(INKJET_PRINT_DRV_INDEX_PB) ,XIC(INKJET_PRINT_DRV_PARK_POS) XIO(INKJET_PRINT_DRV_INDEX_PB) MOV(100,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[INDEX TO PRINT POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],60)[MOV(2,DRV_INDEX_NUM) ,ONS(ONS_ARRAY[5]) OTL(INKJET_PRINT_DRV_INDEX_PB) ,XIC(INKJET_PRINT_DRV_PRINT_POS) XIO(INKJET_PRINT_DRV_INDEX_PB) MOV(70,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[READ AND COMPARE LABEL VALUE FROM PRINTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],70)[OTL(INKJET_PRINTER_CONTROL.CMD.print_command.command[10]) ,XIC(INKJET_PRINTER_CONTROL.STS.command.command[10]) [TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) [NEQ(INKJET_PRINTER_CONTROL.STS.command.label,DYNAMIC_LABEL) MOV(75,STEP_HOME[31]) [XIO(LABEL_WRITE_RETRY_COUNT.DN) CTU(LABEL_WRITE_RETRY_COUNT,?,?) ,XIC(LABEL_WRITE_RETRY_COUNT.DN) MOV(515,STEP_ALARM[31]) ] ,EQU(INKJET_PRINTER_CONTROL.STS.command.label,DYNAMIC_LABEL) MOV(80,STEP_HOME[31]) ] OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[10]) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[MOVE DYNAMIC LABEL TO PRINTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],75)[COP(DYNAMIC_LABEL,INKJET_PRINTER_CONTROL.CMD.print_command.label,1) OTL(INKJET_PRINTER_CONTROL.CMD.print_command.command[9]) ,XIC(INKJET_PRINTER_CONTROL.STS.command.command[9]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[9]) MOV(70,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[READ AND COMPARE SKU VALUE FROM PRINTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],80)[OTL(INKJET_PRINTER_CONTROL.CMD.print_command.command[4]) ,XIC(INKJET_PRINTER_CONTROL.STS.command.command[4]) [TON(TIMER_OPER[4],?,?) ,XIC(TIMER_OPER[4].DN) [NEQ(INKJET_PRINTER_CONTROL.STS.command.dynamic_fields[0].name,INKJET_PRINT_SKU_RECIPE_LOADED) MOV(85,STEP_HOME[31]) [XIO(SKU_WRITE_RETRY_COUNT.DN) CTU(SKU_WRITE_RETRY_COUNT,?,?) ,XIC(SKU_WRITE_RETRY_COUNT.DN) MOV(516,STEP_ALARM[31]) ] ,EQU(INKJET_PRINTER_CONTROL.STS.command.dynamic_fields[0].name,INKJET_PRINT_SKU_RECIPE_LOADED) MOV(90,STEP_HOME[31]) ] OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[WRITE SKU VALUE TO PRINTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],85)[MOV(1,INKJET_PRINTER_CONTROL.CMD.print_command.dynamic_fields[0].value) COP(INKJET_PRINT_SKU_RECIPE_LOADED,INKJET_PRINTER_CONTROL.CMD.print_command.dynamic_fields[0].name,1) OTL(INKJET_PRINTER_CONTROL.CMD.print_command.command[3]) ,XIC(INKJET_PRINTER_CONTROL.STS.command.command[3]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[3]) MOV(80,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[READ AND COMPARE PRINT HEAD OFFSET FROM PRINTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],90)[OTL(INKJET_PRINTER_CONTROL.CMD.print_command.command[8]) ,XIC(INKJET_PRINTER_CONTROL.STS.command.command[8]) [TON(TIMER_OPER[6],?,?) ,XIC(TIMER_OPER[6].DN) [NEQ(INKJET_PRINT_X_POS_OFF_VAL,INKJET_PRINTER_CONTROL.STS.command.head_offset) MOV(95,STEP_HOME[31]) [XIO(OFFSET_WRITE_RETRY_COUNT.DN) CTU(OFFSET_WRITE_RETRY_COUNT,?,?) ,XIC(OFFSET_WRITE_RETRY_COUNT.DN) MOV(517,STEP_ALARM[31]) ] ,EQU(INKJET_PRINT_X_POS_OFF_VAL,INKJET_PRINTER_CONTROL.STS.command.head_offset) MOV(97,STEP_HOME[31]) ] OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[8]) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[WRITE PRINT HEAD OFFSET VALUE TO PRINTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],95)[MOV(INKJET_PRINT_X_POS_OFF_VAL,INKJET_PRINTER_CONTROL.CMD.print_command.head_offset) OTL(INKJET_PRINTER_CONTROL.CMD.print_command.command[7]) ,XIC(INKJET_PRINTER_CONTROL.STS.command.command[7]) OTU(INKJET_PRINTER_CONTROL.CMD.print_command.command[7]) MOV(90,STEP_HOME[31]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[ENABLE PRINTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],97)[OTL(INKJET_PRINTER_ENABLE_PB) ,RES(LABEL_WRITE_RETRY_COUNT) RES(SKU_WRITE_RETRY_COUNT) RES(OFFSET_WRITE_RETRY_COUNT) ,XIC(INKJET_PRINTER_READY) MOV(100,STEP_HOME[31]) ,TON(TIMER_ALARM[10],?,?) ,XIC(TIMER_ALARM[10].DN) [OTU(INKJET_PRINTER_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(514,STEP_ALARM[31]) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[COMPLETE ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],100)[XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) MOV(0,STEP_AUTO[31]) ,MOV(500,STEP_HOME[31]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************
]]>
</Comment>
<Text>
<![CDATA[[CPS(DRV31:I,INKJET_PRINT_DRV_INPUTS,1) ,JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(HMI,0) ,JSR(POSITION_MONITOR,0) ,JSR(SERVO_HOMING,0) ,CPS(INKJET_PRINT_DRV_OUTPUTS,DRV31:O,1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET STATION DRIVE OUTPUTS
***************************************************************************

INITIATE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[31],1000)XIC(DRV_INTERNAL_HOME_REQ)[OTE(INKJET_PRINT_DRV_OUTPUTS.Home) ,[XIC(INKJET_PRINT_DRV_OUTPUTS.Home) XIC(INKJET_PRINT_DRV_INPUTS.Home_Complete) TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) OTU(DRV_INTERNAL_HOME_REQ) ] ,[TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) MOV(510,STEP_ALARM[31]) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONTROLS MANUAL MODE HMI INKJET DRIVE INDEXES]]>
</Comment>
<Text>
<![CDATA[EQU(CELL_HMI_CURRENT_SCREEN,18)XIO(CELL_STARTED)[EQU(STEP_HOME[31],500) ,EQU(STEP_HOME[31],1000) ][EQU(STEP_AUTO[31],0) ,EQU(STEP_AUTO[31],500) ,EQU(STEP_AUTO[31],1000) ]XIO(INKJET_PRINT_DRV_HOMING_IND)[EQU(INKJET_PRINT_DRV_POS_PB,1) MOV(1,DRV_INDEX_NUM) ,EQU(INKJET_PRINT_DRV_POS_PB,2) MOV(2,DRV_INDEX_NUM) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[DRIVE ALARM RESET]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[31],1000) XIC(INKJET_PRINT_DRV_RESET_PB) [OTE(INKJET_PRINT_DRV_OUTPUTS.Reset) ,XIO(INKJET_PRINT_DRV_FAULT) OTU(INKJET_PRINT_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) MOV(501,STEP_ALARM[31]) ] ] ,[XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(10,STEP_HOME[31],499) ] XIC(INKJET_PRINT_DRV_FAULT) MOV(505,STEP_ALARM[31]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[31],1000)XIC(INKJET_PRINT_DRV_ENABLE_PB)[OTE(INKJET_PRINT_DRV_OUTPUTS.Servo_On) ,[XIO(INKJET_PRINT_DRV_READY) ,XIC(INKJET_PRINT_DRV_FAULT) ] [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [OTU(INKJET_PRINT_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(502,STEP_ALARM[31]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[PARK POSITION CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[31],1000)XIC(INKJET_PRINT_DRV_INDEX_PB)EQU(DRV_INDEX_NUM,1)[PCON_Moves(MOTION_DRV_PARK_POS_CONT,0,INKJET_DRV_PARK_MOVE_TRIGGER,INKJET_PRINT_DRV_PARK_POS_VAL,10000,50,50,10,0,0,0,0,0,0,0,INKJET_PRINT_DRV_INPUTS,INKJET_PRINT_DRV_OUTPUTS) ,XIC(MOTION_DRV_PARK_POS_CONT.EN) XIO(INKJET_DRV_PARK_MOVE_TRIGGER) TON(TIMER_OPER[7],?,?) ,[XIO(INKJET_PRINT_DRV_MOVING) XIC(TIMER_OPER[7].DN) ONS(ONS_ARRAY[3]) OTL(INKJET_DRV_PARK_MOVE_TRIGGER) ,XIC(INKJET_PRINT_DRV_PARK_POS) [OTU(INKJET_PRINT_DRV_INDEX_PB) ,OTU(INKJET_DRV_PARK_MOVE_TRIGGER) ] ] ,[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) [OTU(INKJET_PRINT_DRV_INDEX_PB) ,OTU(INKJET_DRV_PARK_MOVE_TRIGGER) ,XIC(CELL_ALARMS_ACTIVE) MOV(503,STEP_ALARM[31]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[PRINT POSITION CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[31],1000)XIC(INKJET_PRINT_DRV_INDEX_PB)EQU(DRV_INDEX_NUM,2)[PCON_Moves(MOTION_DRV_PRINT_POS_CONT,0,INKJET_DRV_PRINT_MOVE_TRIGGER,INKJET_PRINT_Y_POS_OFF_VAL,10000,50,50,10,0,0,0,0,0,0,0,INKJET_PRINT_DRV_INPUTS,INKJET_PRINT_DRV_OUTPUTS) ,XIC(MOTION_DRV_PRINT_POS_CONT.EN) XIO(INKJET_DRV_PRINT_MOVE_TRIGGER) TON(TIMER_OPER[8],?,?) ,[XIO(INKJET_PRINT_DRV_MOVING) XIC(TIMER_OPER[8].DN) ONS(ONS_ARRAY[4]) OTL(INKJET_DRV_PRINT_MOVE_TRIGGER) ,XIC(INKJET_PRINT_DRV_PRINT_POS) [OTU(INKJET_PRINT_DRV_INDEX_PB) ,OTU(INKJET_DRV_PRINT_MOVE_TRIGGER) ] ] ,[TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) [OTU(INKJET_PRINT_DRV_INDEX_PB) ,OTU(INKJET_DRV_PRINT_MOVE_TRIGGER) ,XIC(CELL_ALARMS_ACTIVE) MOV(504,STEP_ALARM[31]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[INKJET PRINT REQUEST]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[31],1000) [XIC(INKJET_PRINTER_PRINT_REQ_PB) [OTE(Local:2:O.Pt03.Data) ,XIC(INKJET_PRINTER_PRINT_IP) [OTU(INKJET_PRINTER_PRINT_REQ_PB) ,OTL(INKJET_PRINTER_PRINT_STARTED) ] ,[[XIC(MAIN_DIAL_DRV_MOVING) ,XIC(TIMER_ALARM[5].TT) ] TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(INKJET_PRINTER_PRINT_REQ_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(512,STEP_ALARM[31]) ] ] ] ,XIC(INKJET_PRINTER_PRINT_STARTED) XIO(MAIN_DIAL_DRV_MOVING) [XIO(INKJET_PRINTER_PRINT_IP) OTU(INKJET_PRINTER_PRINT_STARTED) ,[TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(INKJET_PRINTER_PRINT_STARTED) ,XIC(CELL_ALARMS_ACTIVE) MOV(513,STEP_ALARM[31]) ] ] ] ] ,XIC(INKJET_PRINTER_DISABLE_PB) OTU(INKJET_PRINTER_PRINT_REQ_PB) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[INKJET DRIVE ENCODER MOTION AXIS GEAR
CONNECTS MAIN DIAL TO VIRTUAL ENCODER AXIS]]>
</Comment>
<Text>
<![CDATA[XIC(DRV01_ETHERNET_COMMS_OK)XIC(ENC31_ETHERNET_COMMS_OK)[XIO(DRV31_MAG_MOTION_CONT.ER) ,XIC(CELL_RESET_PRESSED) ]MAG(ENC31_VIRTUAL_AXIS,DRV01,DRV31_MAG_MOTION_CONT,0,1,1,1,0,0,0,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET STATION DRIVE POSITION MONITORING
***************************************************************

DRIVE POSITION VERIFICATION]]>
</Comment>
<Text>
<![CDATA[[XIC(INKJET_PRINT_DRV_HOMED) [[[ADD(INKJET_PRINT_DRV_PARK_POS_VAL,INKJET_PRINT_DRV_POS_TOL,INKJET_PRINT_DRV_PARK_POS_UP) SUB(INKJET_PRINT_DRV_PARK_POS_VAL,INKJET_PRINT_DRV_POS_TOL,INKJET_PRINT_DRV_PARK_POS_LOW) ,ADD(INKJET_PRINT_Y_POS_OFF_VAL,INKJET_PRINT_DRV_POS_TOL,INKJET_PRINT_DRV_PRINT_Y_POS_UP) SUB(INKJET_PRINT_Y_POS_OFF_VAL,INKJET_PRINT_DRV_POS_TOL,INKJET_PRINT_DRV_PRINT_Y_POS_LOW) ] ,[LIM(INKJET_PRINT_DRV_PARK_POS_LOW,INKJET_PRINT_DRV_INPUTS.Actual_Position,INKJET_PRINT_DRV_PARK_POS_UP) OTE(INKJET_PRINT_DRV_PARK_POS) ,LIM(INKJET_PRINT_DRV_PRINT_Y_POS_LOW,INKJET_PRINT_DRV_INPUTS.Actual_Position,INKJET_PRINT_DRV_PRINT_Y_POS_UP) OTE(INKJET_PRINT_DRV_PRINT_POS) ] OTE(INKJET_PRINT_DRV_IN_POSITION) ] ,LEQ(INKJET_PRINT_DRV_INPUTS.Actual_Position,29500) OTE(INKJET_PRINT_DRV_CLEAR_MAIN_DIAL) ] ,[XIC(CELL_STARTED) XIO(INKJET_PRINT_DRV_INPUTS.Moving) ,EQU(STEP_HOME[31],40) ] XIO(INKJET_PRINT_DRV_IN_POSITION) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [OTL(INKJET_PRINT_DRV_HOME_REQ) ,MOV(508,STEP_ALARM[31]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET PRINTING STATION DRIVE HOMING ROUTINE
***************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(INKJET_PRINT_DRV_HOME_PB)XIO(DRV_HOMING_REQ)XIO(INKJET_PRINT_DRV_HOMING_IND)XIC(INKJET_PRINT_DRV_INPUTS.Home_Complete)OTE(INKJET_PRINT_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[31],0) ,XIC(INKJET_PRINT_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[31],500) [EQU(STEP_HOMING[31],500) ,EQU(STEP_HOMING[31],1000) ] ][MOV(10,STEP_HOMING[31]) ,OTL(INKJET_PRINT_DRV_HOMING_IND) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[31],10)[ONS(ONS_ARRAY[12]) OTL(DRV_INTERNAL_HOME_REQ) ,XIC(INKJET_PRINT_DRV_INPUTS.Homing) MOV(15,STEP_HOMING[31]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[31],15)XIC(INKJET_PRINT_DRV_INPUTS.Home_Complete)XIO(INKJET_PRINT_DRV_INPUTS.Homing)XIO(DRV_INTERNAL_HOME_REQ)MOV(100,STEP_HOMING[31]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[31],100)[MOV(1,DRV_INDEX_NUM) ,OTU(INKJET_PRINT_DRV_HOMING_IND) OTU(INKJET_PRINT_DRV_HOME_PB) ,XIO(INKJET_PRINT_DRV_FAULT) OTU(DRV_HOMING_REQ) ,MOV(500,STEP_HOMING[31]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INKJET STATION STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[31],500)XIC(INKJET_PRINT_DRV_HOMED)XIC(INKJET_PRINT_DRV_READY)XIO(INKJET_PRINT_DRV_FAULT)[XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) XIC(INKJET_PRINT_DRV_PRINT_POS) XIC(INKJET_PRINTER_READY) XIO(INKJET_PRINTER_ALARM) XIO(INKJET_PRINTER_LEVEL_LOW) ,XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) XIC(INKJET_PRINT_DRV_PARK_POS) ]OTE(CELL_AUTO_READY[31]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
