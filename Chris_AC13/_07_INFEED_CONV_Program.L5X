<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INFEED CONVEYOR AUTO ROUTINE
*********************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[7],0) ,EQU(STEP_AUTO[7],10) ,EQU(STEP_AUTO[7],12) ]MOV(500,STEP_AUTO[7]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[REQUEST BAG VISION CHECK TO BAG LOAD ROBOT

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],0)[XIO(CELL_DRY_CYCLE_MODE_PB) XIC(CELL_STARTED) XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIC(R1:I.Data[0].29) [OTE(INFEED_CONV_BAG_VIS_REQ) ,XIC(R1:I.Data[1].0) MOV(10,STEP_AUTO[7]) ,XIC(R1:I.Data[1].1) MOV(20,STEP_AUTO[7]) ] ,XIO(CELL_STARTED) XIC(INFEED_CONV_INDEX_PB) MOV(30,STEP_AUTO[7]) ,XIC(CELL_DRY_CYCLE_MODE_PB) MOV(12,STEP_AUTO[7]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[VERIFY ROBOT HANDSHAKE IS OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],10)XIO(R1:I.Data[0].20)MOV(12,STEP_AUTO[7]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR BAG PICKED FROM CONVEYOR SIGNAL FROM ROBOT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],12)XIC(R1:I.Data[0].20)MOV(15,STEP_AUTO[7]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WAIT FOR ROBOT HANDSHAKES TO BE TURNED OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],15)XIO(R1:I.Data[1].1)XIO(R1:I.Data[1].0)[XIO(CELL_DRY_CYCLE_MODE_PB) MOV(0,STEP_AUTO[7]) ,XIC(CELL_DRY_CYCLE_MODE_PB) MOV(20,STEP_AUTO[7]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR CLEAR OF CONVEYOR SIGNAL FROM ROBOT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],20)XIC(R1:I.Data[0].27)MOV(30,STEP_AUTO[7]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[SET STARTING SPEED OF CONVEYOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],30)[XIC(INFEED_CONV_STOP_POS) MUL(INFEED_CONV_FAST_SPEED_HZ,100,DRV07:O.FreqCommand) ,XIO(INFEED_CONV_STOP_POS) MUL(INFEED_CONV_SLOW_SPEED_HZ,100,DRV07:O.FreqCommand) ,MOV(35,STEP_AUTO[7]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[INDEX CONVEYOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],35)[XIC(INFEED_CONV_SAFETY_FLAP_CLOSED) [[OTL(INFEED_CONV_RUN_FORWARD_PB) ,XIO(INFEED_CONV_STOP_POS) XIO(DRV07:O.Stop) MOV(40,STEP_AUTO[7]) ] ,[TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [XIC(INFEED_CONV_STOP_POS) MOV(107,STEP_ALARM[7]) ,XIC(DRV07:O.Stop) MOV(108,STEP_ALARM[7]) ] ] ] ,XIO(INFEED_CONV_SAFETY_FLAP_CLOSED) OTU(INFEED_CONV_RUN_FORWARD_PB) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SLOW DOWN AND STOP CONVEYOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],40)XIC(INFEED_CONV_SAFETY_FLAP_CLOSED)[XIC(INFEED_CONV_SLOW_POS) ONS(ONS_ARRAY[4]) MUL(INFEED_CONV_SLOW_SPEED_HZ,100,DRV07:O.FreqCommand) ,[XIC(INFEED_CONV_STOP_POS) ,XIC(DRV07:O.Stop) ] [OTU(INFEED_CONV_RUN_FORWARD_PB) ,XIO(DRV07:I.Active) [XIO(INFEED_CONV_STOP_POS) MOV(45,STEP_AUTO[7]) ,XIC(INFEED_CONV_STOP_POS) MOV(50,STEP_AUTO[7]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[RESTART CONVEYOR AFTER SAFETY FLAP INTERUPT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],45)XIC(INFEED_CONV_SAFETY_FLAP_CLOSED)[[OTL(INFEED_CONV_RUN_FORWARD_PB) ,XIO(DRV07:O.Stop) MOV(40,STEP_AUTO[7]) ] ,[TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) XIC(INFEED_CONV_STOP_POS) MOV(107,STEP_ALARM[7]) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STOP CONVEYOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],50)XIO(INFEED_CONV_INDEX_PB)MOV(60,STEP_AUTO[7]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[WAIT FOR ROBOT HANDSHAKES TO BE TURNED OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[7],60)XIO(R1:I.Data[1].1)XIO(R1:I.Data[1].0)MOV(0,STEP_AUTO[7]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[CONVEYOR INDEX TIME]]>
</Comment>
<Text>
<![CDATA[LIM(30,STEP_AUTO[7],40)[MOV(TIMER_OPER[3].ACC,INFEED_CONV1_INDEX_TIME) ,TON(TIMER_OPER[3],?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INFEED CONVEYOR E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[7],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[7]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[7],1000) EQU(STEP_ALARM_CAPTURE[7],0) MOV(STEP_ALARM[7],STEP_ALARM_CAPTURE[7]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[7],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.7) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[
E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[7],1000)[NEQ(STEP_ALARM[7],0) OTE(MAJOR_FAULT[7]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[7],STEP_AUTO_RET_ESTOP[7]) ,OTU(INFEED_CONV_RUN_FORWARD_PB) ,OTU(INFEED_CONV_DRV_RESET_PB) ,OTU(INFEED_CONV_BAG_LANE_EMPTY_VIS) ,MOV(1000,STEP_HOME[7]) ,MOV(1000,STEP_AUTO[7]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[
WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[7],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[7]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[7],10)[MOV(0,STEP_ALARM[7]) ,MOV(0,STEP_ALARM_CAPTURE[7]) ,MOV(20,STEP_ESTOP_RESET[7]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[7],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[7]) ,MOV(30,STEP_ESTOP_RESET[7]) ] ,XIC(CELL_KEY_MAN_MODE) [MOV(0,STEP_AUTO[7]) ,MOV(500,STEP_ESTOP_RESET[7]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[
WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[7],30)EQU(STEP_HOME[7],500)MOV(500,STEP_ESTOP_RESET[7]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INFEED CONVEYOR HMI
***************************************************************************

DISPLAY ARROWS AND DIRECTION WHEN IN MOTION]]>
</Comment>
<Text>
<![CDATA[XIC(DRV07:I.Active)OTE(INFEED_CONV_MOVING_FORWARD);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
HMI CONVEYOR BUTTON AND INDICATOR VISIBILITY]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[7],500)[XIO(CELL_STARTED) XIC(INFEED_CONV_DRV_READY) [OTE(INFEED_CONV_RUN_FORWARD_PB_VIS) ,OTE(INFEED_CONV_INDEX_PB_VIS) ] ,XIC(INFEED_CONV_DRV_FAULT) OTE(INFEED_CONV_DRV_FAULT_PB_VIS) ,XIC(CELL_STARTED) XIC(INFEED_CONV_STOP_POS) [XIO(INFEED_CONV_BAG_LANE_FULL) [ONS(ONS_ARRAY[5]) [OTL(INFEED_CONV_BAG_LANE_EMPTY_VIS) ,CTU(INFEED_CONV_EMPTY_COUNT,?,?) ] ,XIC(INFEED_CONV_EMPTY_COUNT.DN) MOV(895,STEP_ALARM[7]) ] ,XIC(INFEED_CONV_BAG_LANE_FULL) [OTU(INFEED_CONV_BAG_LANE_EMPTY_VIS) ,RES(INFEED_CONV_EMPTY_COUNT) ] ] ,XIO(CELL_STARTED) RES(INFEED_CONV_EMPTY_COUNT) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
INFEED CONVEYOR HOME ROUTINE
***************************************************************************

WAIT FOR DRIVE COMMS AND ROBOT HOME COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[7],0)XIC(DRV07_ETHERNET_COMMS_OK)XIC(R1_HOME)MOV(10,STEP_HOME[7]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
RESET DRIVE FAULT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[7],10)[XIC(INFEED_CONV_DRV_FAULT) OTL(INFEED_CONV_DRV_RESET_PB) ,XIO(INFEED_CONV_DRV_FAULT) [MOV(0,STEP_AUTO[7]) ,MOV(500,STEP_HOME[7]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INFEED CONVEYOR OUTPUTS
***************************************************************************

CLEAR DRIVE FAULT]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[7],1000) XIC(INFEED_CONV_DRV_RESET_PB) [[OTE(DRV07:O.ClearFaults) ,XIO(INFEED_CONV_DRV_FAULT) OTU(INFEED_CONV_DRV_RESET_PB) ] ,[TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) MOV(105,STEP_ALARM[7]) ] ] ,XIC(CELL_STARTED) XIC(INFEED_CONV_DRV_FAULT) MOV(105,STEP_ALARM[7]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONVEYOR MOTOR CONTROL
]]>
</Comment>
<Text>
<![CDATA[[[EQU(STEP_ESTOP_RESET[7],1000) ,XIO(INFEED_CONV_JOG_FORWARD_PB) XIO(INFEED_CONV_RUN_FORWARD_PB) ,XIO(INFEED_CONV_SAFETY_FLAP_CLOSED) ] OTE(DRV07:O.Stop) ,EQU(STEP_ESTOP_RESET[7],500) [XIO(DRV07:O.Stop) [XIC(INFEED_CONV_RUN_FORWARD_PB) ONS(ONS_ARRAY[2]) ,XIC(DRV07:O.Start) XIO(TIMER_OPER[2].DN) ] OTE(DRV07:O.Start) ,XIC(DRV07:O.Start) [XIC(DRV07:I.Active) TON(TIMER_OPER[2],?,?) ,XIC(CELL_ALARMS_ACTIVE) XIO(DRV07:I.Active) [TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) MOV(108,STEP_ALARM[7]) ] ] ] ,EQU(STEP_ESTOP_RESET[7],500) XIO(DRV07:O.Stop) XIC(INFEED_CONV_JOG_FORWARD_PB) OTE(DRV07:O.Jog) ,OTE(DRV07:O.Forward) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[SET CONVEYOR SPEED EXCEPT WHEN IN AUTO]]>
</Comment>
<Text>
<![CDATA[LIM(100,STEP_AUTO[7],0)MUL(INFEED_CONV_FAST_SPEED_HZ,100,DRV07:O.FreqCommand);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[INFEED CONVEYOR STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[7],500)XIC(DRV07_ETHERNET_COMMS_OK)XIC(INFEED_CONV_DRV_READY)XIO(INFEED_CONV_DRV_FAULT)OTE(CELL_AUTO_READY[7]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[MONITOR BAG DROP CLEAR SENSOR]]>
</Comment>
<Text>
<![CDATA[XIO(INFEED_CONV_BAG_DROP_BIN_CLEAR)[TON(TIMER_OPER[0],?,?) ,XIC(TIMER_OPER[0].DN) [EQU(CELL_MESSAGE,0) TON(TIMER_OPER[1],?,?) ,[ONS(ONS_ARRAY[0]) ,XIC(TIMER_OPER[1].DN) ONS(ONS_ARRAY[3]) ] MOV(906,CELL_MESSAGE) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[MONITOR SAFETY FLAP SENSOR]]>
</Comment>
<Text>
<![CDATA[XIO(INFEED_CONV_SAFETY_FLAP_CLOSED)[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(908,CELL_MESSAGE) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
