<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD STATION AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[19]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],0)XIC(CELL_STARTED)[XIO(RUN_PROCESS) MOV(5,STEP_AUTO[19]) ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],5)[OTE(BAG_OFFLOAD_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIO(BAG_SETUP_ONLY) [XIC(BAG_OFFLOAD_DATA_BAG_LOADED) [XIC(BAG_OFFLOAD_DATA_PNC_STARTED) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ] ,XIC(BAG_OFFLOAD_DATA_BAR_LOADED) XIC(BAG_OFFLOAD_DATA_BAR_REJECT) ] OTE(RUN_PROCESS) ,EQU(STEP_AUTO[19],10) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[19]) ,XIO(RUN_PROCESS) MOV(150,STEP_AUTO[19]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[EXAMINE WHAT NEEDS TO BE DONE TO PARTS ON DIAL]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],20)[XIC(BAG_OFFLOAD_DATA_BAG_LOADED) [XIC(BAG_OFFLOAD_DATA_PNC_STARTED) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ] MOV(30,STEP_AUTO[19]) ,XIC(BAG_OFFLOAD_DATA_BAR_LOADED) XIC(BAG_OFFLOAD_DATA_BAR_REJECT) MOV(60,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[EXTEND BAG RELEASE CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],30)[OTL(BAG_OFFLOAD_REL_CYL_EXT_PB) ,XIC(BAG_OFFLOAD_REL_CYL_EXT) [XIO(CELL_BAG_LOAD_ONLY_MODE_PB) MOV(35,STEP_AUTO[19]) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) MOV(38,STEP_AUTO[19]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[START CLAMP OPEN TIMER DURING BAG LOAD MODE ONLY]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],38)[TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) [OTU(BAG_OFFLOAD_DATA_BAG_LOADED) ,MOV(50,STEP_AUTO[19]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[VERIFY ROBOT HANDSHAKES ARE OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],35)XIO(R3:I.Data[0].20)XIO(R3:I.Data[0].29)MOV(40,STEP_AUTO[19]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[REQUEST BAG OFFLOAD
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],40)[XIO(BAG_OFFLOAD_DATA_BAG_REJECT) XIC(BAG_OFFLOAD_DATA_PNC_COMPLETE) OTE(BAG_PASSED_PICK_REQ) ,XIC(VISION_ACTIVE_PB) XIC(BAG_OFFLOAD_DATA_BAG_REJECT) XIC(BAG_OFFLOAD_DATA_PNC_COMPLETE) XIC(BAG_OFFLOAD_DATA_VISION_COMPLETE) XIO(BAG_OFFLOAD_DATA_VISION_PASS) [XIO(BAG_PASSED_PICK_REQ) XIO(BAG_FAILED_PICK_REQ) XIO(BARRIER_FAILED_PICK_REQ) ,XIC(BAG_VIS_FAILED_PICK_REQ) ] OTE(BAG_VIS_FAILED_PICK_REQ) ,XIC(BAG_OFFLOAD_DATA_BAG_REJECT) XIC(BAG_OFFLOAD_DATA_PNC_STARTED) [XIO(BAG_VIS_FAILED_PICK_REQ) XIO(BAG_PASSED_PICK_REQ) XIO(BARRIER_FAILED_PICK_REQ) ,XIC(BAG_FAILED_PICK_REQ) ] OTE(BAG_FAILED_PICK_REQ) ,[XIC(BAG_PASSED_PICK_REQ) XIC(R3:I.Data[0].20) [MOV(0,BAG_OFFLOAD_CTR_BAG_REJECT) ,MOV(0,BAG_OFFLOAD_CTR_BARRIER_REJECT) ] ,[XIC(BAG_VIS_FAILED_PICK_REQ) ,XIC(BAG_FAILED_PICK_REQ) ] XIC(R3:I.Data[0].29) [CTU(BAG_OFFLOAD_BAG_REJECT_CNT,?,?) ,ADD(CELL_DATA_COLLECTION[5],1,CELL_DATA_COLLECTION[5]) ,MOV(1,BAG_OFFLOAD_CTR_BAG_REJECT) ] ] [OTU(BAG_OFFLOAD_DATA_BAG_LOADED) ,OTU(BAG_OFFLOAD_DATA_GLUE_STARTED) ,OTU(BAG_OFFLOAD_DATA_GLUE_PRESS_OK) ,OTU(BAG_OFFLOAD_DATA_GLUE_OPEN_REJECT) ,OTU(BAG_OFFLOAD_DATA_GLUE_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_PNC_STARTED) ,OTU(BAG_OFFLOAD_DATA_PNC_PRESS_OK) ,OTU(BAG_OFFLOAD_DATA_PNC_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_BAG_REJECT) ,MOV(0,BAG_OFFLOAD_DATA_POS_BAG_REJECT) ,OTL(BAG_OFFLOAD_PART_PICKED) ,MOV(50,STEP_AUTO[19]) ] ,XIC(CELL_SHUTDOWN_REQ) [XIC(MAJOR_FAULT[30]) ,EQU(STEP_AUTO[30],500) ] MOV(50,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[RETRACT BAG RELEASE CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],50)[OTU(BAG_OFFLOAD_REL_CYL_EXT_PB) ,XIC(BAG_OFFLOAD_REL_CYL_RET) MOV(150,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[VERIFY ROBOT HANDSHAKES ARE OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],60)XIO(R3:I.Data[0].19)MOV(70,STEP_AUTO[19]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[REQUEST FAILED BARRIER OFFLOAD]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],70)[XIC(BAG_OFFLOAD_DATA_BAR_REJECT) XIO(BAG_PASSED_PICK_REQ) OTE(BARRIER_FAILED_PICK_REQ) ,[XIC(R3:I.Data[0].19) [OTU(MAIN_DIAL_VAC_PB[0].12) ,OTU(BAG_OFFLOAD_DATA_BAR_LOADED) ,OTU(BAG_OFFLOAD_DATA_PREHEAT1_STARTED) ,OTU(BAG_OFFLOAD_DATA_PREHEAT1_UP_TEMP_OK) ,OTU(BAG_OFFLOAD_DATA_PREHEAT1_LOW_TEMP_OK) ,OTU(BAG_OFFLOAD_DATA_PREHEAT1_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_PREHEAT2_STARTED) ,OTU(BAG_OFFLOAD_DATA_PREHEAT2_UP_TEMP_OK) ,OTU(BAG_OFFLOAD_DATA_PREHEAT2_LOW_TEMP_OK) ,OTU(BAG_OFFLOAD_DATA_PREHEAT2_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_FORMING_STARTED) ,OTU(BAG_OFFLOAD_DATA_FORMING_PRESS_OK) ,OTU(BAG_OFFLOAD_DATA_FORMING_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_PUNCH_STARTED) ,OTU(BAG_OFFLOAD_DATA_PUNCH_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_INKJET_STARTED) ,OTU(BAG_OFFLOAD_DATA_INKJET_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_PRINT_STARTED) ,OTU(BAG_OFFLOAD_DATA_PRINT_COMPLETE) ,OTU(BAG_OFFLOAD_DATA_BAR_REJECT) ,MOV(0,BAG_OFFLOAD_DATA_POS_BAR_REJECT) ,CTU(BAG_OFFLOAD_BARRIER_REJECT_CNT,?,?) ,ADD(CELL_DATA_COLLECTION[6],1,CELL_DATA_COLLECTION[6]) ,OTL(BAG_OFFLOAD_PART_PICKED) ,OTU(BAG_OFFLOAD_DATA_PRINT_COMPLETE) ,MOV(1,BAG_OFFLOAD_CTR_BARRIER_REJECT) ,MOV(150,STEP_AUTO[19]) ] ,XIO(R3:I.Data[0].19) TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(99,STEP_ALARM[19]) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],150)[OTL(BAG_OFFLOAD_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.13) XIO(R3_BAG_VAC_ON) XIO(R3_BARRIER_VAC_ON) OTL(CELL_EMPTY_COMPLETE.15) ,TON(TIMER_OPER[1],?,?) ,XIC(TIMER_OPER[1].DN) MOV(160,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[19],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(BAG_OFFLOAD_PROCESS_DONE) ,MOV(5,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(20,STEP_AUTO[19],150) TON(TIMER_OPER[0],?,?) ,EQU(STEP_AUTO[19],150) ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[0].ACC,1000,CELL_CYCLE_TIME[0].BAG_OFFLOAD) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[19],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].BAG_OFFLOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(12,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].BAG_OFFLOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].BAG_OFFLOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].BAG_OFFLOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(12,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].BAG_OFFLOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD STATION E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[19],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[19]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[19],1000) EQU(STEP_ALARM_CAPTURE[19],0) MOV(STEP_ALARM[19],STEP_ALARM_CAPTURE[19]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[19],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.19) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[19],1000)[NEQ(STEP_ALARM[19],0) OTE(MAJOR_FAULT[19]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[19],STEP_AUTO_RET_ESTOP[19]) ,OTU(BAG_OFFLOAD_REL_CYL_EXT_PB) ,OTU(BAG_OFFLOAD_PROCESS_DONE) ,OTU(BAG_OFFLOAD_PART_PICKED) ,MOV(1000,STEP_HOME[19]) ,MOV(1000,STEP_AUTO[19]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[19],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[19]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[19],10)[MOV(0,STEP_ALARM[19]) ,MOV(0,STEP_ALARM_CAPTURE[19]) ,MOV(20,STEP_ESTOP_RESET[19]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[19],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[19]) ,MOV(30,STEP_ESTOP_RESET[19]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[19]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[19],30)EQU(STEP_HOME[19],500)MOV(500,STEP_ESTOP_RESET[19]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD STATION HOME ROUTINE
***************************************************************************


SET COMPONENTS TO HOME STATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[19],0)[OTU(BAG_OFFLOAD_REL_CYL_EXT_PB) ,XIC(BAG_OFFLOAD_REL_CYL_RET) [MOV(0,STEP_AUTO[19]) ,MOV(500,STEP_HOME[19]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************

]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD STATION OUTPUTS
***************************************************************************

BAG RELEASE CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[19],1000)XIC(CELL_PRESSURE_OK)[XIC(BAG_OFFLOAD_REL_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN02:O.Data[4].4) ,XIC(CELL_ALARMS_ACTIVE) XIO(BAG_OFFLOAD_REL_CYL_EXT) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(210,STEP_ALARM[19]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(BAG_OFFLOAD_REL_CYL_EXT_PB) ] ,XIO(BAG_OFFLOAD_REL_CYL_EXT_PB) [OTE(MAN02:O.Data[4].5) ,XIC(CELL_ALARMS_ACTIVE) XIO(BAG_OFFLOAD_REL_CYL_RET) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) MOV(211,STEP_ALARM[19]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD STATION STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[19],500)XIC(BAG_OFFLOAD_REL_CYL_RET)OTE(CELL_AUTO_READY[19]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[PART OFFLOADED TAG FOR CUSTOMER DATA COLLECTION]]>
</Comment>
<Text>
<![CDATA[[XIC(BAG_OFFLOAD_PART_PICKED) ,XIC(TIMER_OPER[2].TT) ][TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) OTU(BAG_OFFLOAD_PART_PICKED) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
