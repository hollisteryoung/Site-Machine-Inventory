<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="500"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Element>
<Element Index="[1]">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="250"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Element>
<Element Index="[2]">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="1000"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Element>
<Element Index="[3]">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="250"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Element>
<Element Index="[4]">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="1000"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</Element>
</Array>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD ROBOT (R3) ROBOT AUTO
***************************************************************************

MONITOR CELL ENTRY REQUEST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[[XIC(R3:I.Data[0].18) ,XIC(TIMER_OPER[4].TT) ] TON(TIMER_OPER[4],?,?) ,XIC(TIMER_OPER[4].DN) MOV(500,STEP_AUTO[30]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[REQUEST STROBE OF PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[30],0)[XIO(CELL_BAG_TEST_PICK_MODE_PB) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) [OTL(R3_AUTO_PNS_STROBE_REQUEST) ,MOV(20,STEP_AUTO[30]) ] ,[XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ,XIC(CELL_BAG_TEST_PICK_MODE_PB) ] MOV(500,STEP_AUTO[30]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[VERIFY PNS TO PROGRAM MATCH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[30],20)XIO(R3_AUTO_PNS_STROBE_REQUEST)[XIC(R3_PNS_MATCH) MOV(30,STEP_AUTO[30]) ,[TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(96,STEP_ALARM[30]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[EXECUTE ROBOT PROGRAM
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[30],30)[TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].TT) OTE(R3:O.Data[0].18) ,XIC(TIMER_OPER[3].DN) [XIC(R3:I.Data[0].13) MOV(499,STEP_AUTO[30]) ,XIO(R3:I.Data[0].13) [TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(97,STEP_ALARM[30]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD ROBOT (R3) E-STOP RESET
***************************************************************************

ROBOT ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[30],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[30]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[30],1000) EQU(STEP_ALARM_CAPTURE[30],0) MOV(STEP_ALARM[30],STEP_ALARM_CAPTURE[30]) ,LIM(500,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[30],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.30) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CAPTURE ROBOT FAULT ALARM AFTER RESET IS COMPLETED]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_KEY_AUTO_MODE)EQU(STEP_ALARM[30],0)EQU(STEP_ESTOP_RESET[0],500)XIC(R3_FAULT)[XIO(CELL_STARTED) TON(TIMER_ALARM[5],?,?) ,[XIO(CELL_STARTED) XIC(TIMER_ALARM[5].DN) ,XIC(CELL_STARTED) ] MOV(98,STEP_ALARM[30]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[30],1000)[OTL(R3:O.Data[0].4) ,NEQ(STEP_ALARM[30],0) OTE(MAJOR_FAULT[30]) ,ONS(ONS_ARRAY[0]) MOV(STEP_AUTO[30],STEP_AUTO_RET_ESTOP[30]) ,OTU(R3:O.Data[0].24) ,MOV(1000,STEP_R3_RESET) ,MOV(1000,STEP_HOME[30]) ,MOV(1000,STEP_AUTO[30]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[30],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[30]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[30],10)[OTU(R3:O.Data[0].4) ,MOV(0,STEP_ALARM[30]) ,MOV(0,STEP_ALARM_CAPTURE[30]) ,MOV(20,STEP_ESTOP_RESET[30]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[30],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_R3_RESET) ,MOV(0,STEP_HOME[30]) ,MOV(30,STEP_ESTOP_RESET[30]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[30]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[30],30)EQU(STEP_HOME[30],500)MOV(500,STEP_ESTOP_RESET[30]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD ROBOT (R3) HOME ROUTINE
***************************************************************************

STROBE ROBOT FOR PROGRAM SELECTION
ONCE ROBOT IS RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[30],0)EQU(STEP_R3_RESET,500)[OTL(R3_HOME_PNS_STROBE_REQUEST) ,MOV(10,STEP_HOME[30]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR PNS MATCH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[30],10)XIO(R3_HOME_PNS_STROBE_REQUEST)[XIC(R3_PNS_MATCH) MOV(20,STEP_HOME[30]) ,[TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) MOV(96,STEP_ALARM[30]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[SEND ROBOT HOME]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[30],20)[OTE(R3:O.Data[0].7) ,TON(TIMER_ALARM[2],?,?) ,GRT(TIMER_ALARM[2].ACC,1000) XIC(R3_HOME) MOV(30,STEP_HOME[30]) ,XIC(TIMER_ALARM[2].DN) MOV(94,STEP_ALARM[30]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[CHECK  FOR SEQUENCE ERROR
IF SEQUENCE ERROR ALREADY LATCHED, JUMP OVER SEQUENCE ERROR ANALYSIS
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[30],30)[XIO(R3_SEQUENCE_ERROR) MOV(40,STEP_HOME[30]) ,XIC(R3_SEQUENCE_ERROR) MOV(50,STEP_HOME[30]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CHECK PROCESS STAGE COMING FROM ROBOT
1=EMPTY
2 = PASSED BAG ASSY
3= FAILED BAG ASSY]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[30],40)[[EQU(R3_STAGE_NUMBER_FROM_ROBOT,1) XIO(R3_BAG_VAC_ON) ,[EQU(R3_STAGE_NUMBER_FROM_ROBOT,2) ,EQU(R3_STAGE_NUMBER_FROM_ROBOT,3) ] XIC(R3_BAG_VAC_ON) ] [MOV(R3_STAGE_NUMBER_FROM_ROBOT,R3_STAGE_NUMBER_FROM_PLC) ,MOV(0,STEP_AUTO[30]) ,MOV(500,STEP_HOME[30]) ] ,[LIM(4,R3_STAGE_NUMBER_FROM_ROBOT,0) MOV(100,STEP_ALARM[30]) ,EQU(R3_STAGE_NUMBER_FROM_ROBOT,1) XIC(R3_BAG_VAC_ON) [MOV(101,STEP_ALARM[30]) ,COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[12],1) ] ,[EQU(R3_STAGE_NUMBER_FROM_ROBOT,2) ,EQU(R3_STAGE_NUMBER_FROM_ROBOT,3) ] XIO(R3_BAG_VAC_ON) [MOV(102,STEP_ALARM[30]) ,COP(MAIN_DIAL_DATA[0],MAIN_DIAL_DATA[12],1) ] ] [MOV(1,R3_STAGE_NUMBER_FROM_PLC) ,OTL(R3_SEQUENCE_ERROR) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[COMPLETE HOME ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[30],50)[MOV(0,STEP_AUTO[30]) ,MOV(500,STEP_HOME[30]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************

]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(RESET_STATUS,0) ,JSR(PROG_SELECT,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD ROBOT (R3) ROBOT OUTPUTS
*******************************************************************************

BAG VACUUM CONTROL]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_MANUAL_MODE) XIC(R3_BAG_VAC_ON_PB) ,XIO(CELL_MANUAL_MODE) XIC(R3:I.Data[1].2) ] [OTE(MAN03:O.Data[0].3) ,LIM(21,STEP_HOME[30],500) XIC(CELL_ALARMS_ACTIVE) XIO(R3_BAG_VAC_ON) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) MOV(99,STEP_ALARM[30]) ] ] ,XIO(CELL_MANUAL_MODE) [XIC(MAN03:O.Data[0].3) OTL(R3_BAG_VAC_ON_PB) ,XIO(MAN03:O.Data[0].3) OTU(R3_BAG_VAC_ON_PB) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[BAG BLOW CONTROL]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_MANUAL_MODE) XIC(R3_BAG_BLOW_ON_PB) ,XIO(CELL_MANUAL_MODE) XIC(R3:I.Data[1].5) ] OTE(R3:O.Data[1].5) ,XIO(CELL_MANUAL_MODE) [XIC(R3:O.Data[1].5) OTL(R3_BAG_BLOW_ON_PB) ,XIO(R3:O.Data[1].5) OTU(R3_BAG_BLOW_ON_PB) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[HMI ROBOT TOOL BUTTONS VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)OTE(R3_TOOL_PB_VIS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PROG_SELECT" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD ROBOT (R3) PROGRAM SELECT
*******************************************************************************

BROADCAST THE PROGRAM NUMBER
TO BE RUN TO THE ROBOT]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_DRY_CYCLE_MODE_PB) MOV(1,R3_PROG_NUM_FROM_PLC) ,XIC(CELL_DRY_CYCLE_MODE_PB) MOV(2,R3_PROG_NUM_FROM_PLC) ,BTD(R3_PROG_NUM_FROM_PLC,0,R3:O.Data[0],9,7) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[STORE THE PROGRAM NUMBER CURRENTLY
SELECTED IN THE ROBOT
]]>
</Comment>
<Text>
<![CDATA[MVM(R3:I.Data[0],127,R3_PROG_NUM_TO_PLC);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[VERIFY PROGRAM NUMBER TO BE RUN
MATCHES ROBOT SELECTED PROGRAM]]>
</Comment>
<Text>
<![CDATA[NEQ(R3_PROG_NUM_TO_PLC,0)EQU(R3_PROG_NUM_TO_PLC,R3_PROG_NUM_FROM_PLC)OTE(R3_PNS_MATCH);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[STROBE PNS ON
ROBOT]]>
</Comment>
<Text>
<![CDATA[[XIC(R3_HOME_PNS_STROBE_REQUEST) ,XIC(R3_AUTO_PNS_STROBE_REQUEST) ][TON(TIMER_OPER[0],?,?) ,OTE(R3:O.Data[0].17) ,XIC(TIMER_OPER[0].DN) [OTU(R3_HOME_PNS_STROBE_REQUEST) ,OTU(R3_AUTO_PNS_STROBE_REQUEST) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="RESET_STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG OFFLOAD ROBOT (R3) RESET AND STATUS
*********************************************************************************

STORE THE PROCESS STAGE CURRENTLY 
BEING RUN BY THE ROBOT]]>
</Comment>
<Text>
<![CDATA[[XIC(R3:I.Data[1].18) OTE(R3_STAGE_NUMBER_FROM_ROBOT.0) ,XIC(R3:I.Data[1].19) OTE(R3_STAGE_NUMBER_FROM_ROBOT.1) ,XIC(R3:I.Data[1].20) OTE(R3_STAGE_NUMBER_FROM_ROBOT.2) ,XIC(R3:I.Data[1].21) OTE(R3_STAGE_NUMBER_FROM_ROBOT.3) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SEND THE PROCESS STAGE CURRENTLY 
TO BE RUN  BY THE ROBOT]]>
</Comment>
<Text>
<![CDATA[[XIC(R3_STAGE_NUMBER_FROM_PLC.0) OTE(R3:O.Data[1].18) ,XIC(R3_STAGE_NUMBER_FROM_PLC.1) OTE(R3:O.Data[1].19) ,XIC(R3_STAGE_NUMBER_FROM_PLC.2) OTE(R3:O.Data[1].20) ,XIC(R3_STAGE_NUMBER_FROM_PLC.3) OTE(R3:O.Data[1].21) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[SEND THE ROBOT LOADING BAG TYPE FROM THE RECIPE
TO BE RUN  BY THE ROBOT
(USED TO DETERMINE PATH FOR PLACING ON OUTFEED CONVEYOR)
1 = CLOSED POUCH
2 = DRAINABLE
3 = LOCK-N-ROLL
4 = UROSTOMY
5=HIGH OUTPUT
]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_BAG_TYPE_RECIPE_LOADED.0) OTE(R3:O.Data[1].27) ,XIC(CELL_BAG_TYPE_RECIPE_LOADED.1) OTE(R3:O.Data[1].28) ,XIC(CELL_BAG_TYPE_RECIPE_LOADED.2) OTE(R3:O.Data[1].29) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ROBOT DIGITAL INPUTS]]>
</Comment>
<Text>
<![CDATA[[XIC(BAG_PASSED_PICK_REQ) OTE(R3:O.Data[0].22) ,XIC(OFFLOAD_CONV_BAG_REQ) OTE(R3:O.Data[0].23) ,XIC(BAG_FAILED_PICK_REQ) OTE(R3:O.Data[0].25) ,XIC(BARRIER_FAILED_PICK_REQ) OTE(R3:O.Data[0].26) ,XIC(BAG_VIS_FAILED_PICK_REQ) OTE(R3:O.Data[0].27) ,XIC(R3_SEQUENCE_ERROR) OTE(R3:O.Data[1].3) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ROBOT STATUS]]>
</Comment>
<Text>
<![CDATA[XIC(R3_IMSTD_ON)XIC(R3_HOLD_OFF)XIC(R3_SFSPD_ON)XIO(R3_FAULT)XIC(R3_ENABLE)XIC(R3_COMMAND_ENABLE)OTE(R3_IO_READY);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(CELL_KEY_AUTO_MODE)XIC(A:I.Data[9].8)XIO(R3_TP_ENABLE)XIC(R3_AUTO_SWITCH)XIO(R3_INPUTS_SIMULATED)OTE(R3_AUTO_MODE);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(R3_IO_READY)XIC(R3_AUTO_MODE)XIC(R3_PNS_MATCH)XIC(R3_HOME)OTE(CELL_AUTO_READY[30]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[OTE(R3_IMSTD_ON) ,[XIO(R3_AUTO_MODE) ,XIC(R3_AUTO_MODE) XIO(R3:O.Data[0].4) ] OTE(R3_HOLD_OFF) ,OTE(R3_SFSPD_ON) ,OTE(R3_ENABLE) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[RESET ROBOT ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_R3_RESET,0)XIC(R3_AUTO_MODE)[XIC(TIMER_OPER[2].TT) OTE(R3:O.Data[0].5) ,TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) [XIO(R3_FAULT) MOV(10,STEP_R3_RESET) ,XIC(R3_FAULT) [TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) MOV(95,STEP_ALARM[30]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CSTOP COMMAND TO ABORT ALL CURRENT PROGRAMS RUNNING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_R3_RESET,10)XIO(R3_FAULT)[TON(TIMER_OPER[1],?,?) ,XIC(TIMER_OPER[1].TT) OTL(R3:O.Data[0].4) ,XIC(TIMER_OPER[1].DN) [OTU(R3:O.Data[0].4) ,MOV(500,STEP_R3_RESET) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
