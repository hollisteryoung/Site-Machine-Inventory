<Programs Use="Context">
<Program Use="Target" Name="_10_BAG_GLUE_PRIORITY" TestEdits="false" MainRoutineName="MAIN" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG GLUE STATION GLUE GUN ROUTINE
***************************************************************************

CONTROL GLUE GUN DURING AUTO ROUTINE]]>
</Comment>
<Text>
<![CDATA[[XIO(GLUE_X_Y_PATH2_RUN) EQU(STEP_AUTO[10],80) ,XIC(GLUE_X_Y_PATH2_RUN) EQU(STEP_AUTO[10],120) ][XIC(GLUE_MOTION_X_Y_CIRCLE_CONT.PC) XIO(GLUE_X_Y_CIRCLE_INDEX) [XIO(CELL_DRY_CYCLE_MODE_PB) OTU(Local:2:O.Pt00.Data) ,XIO(CELL_DRY_CYCLE_MODE_PB) XIO(GLUE_TEMP_DETECTED) MOV(156,STEP_ALARM[10]) ,XIC(GLUE_TEMP_DETECTED) [XIO(GLUE_X_Y_PATH2_RUN) MOV(90,STEP_AUTO[10]) ,XIC(GLUE_X_Y_PATH2_RUN) MOV(130,STEP_AUTO[10]) ,OTU(GLUE_TEMP_DETECTED) ] ] ,XIO(CELL_DRY_CYCLE_MODE_PB) GRT(GLUE_X_Y.ActualPosition,GLUE_X_Y_PATH_GLUE_START_DEG) OTL(Local:2:O.Pt00.Data) ,[XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) XIC(GLUE_TEMP_PRESENT) ,XIC(CELL_INSERT_LOAD_ONLY_MODE_PB) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(GLUE_TEMP_DETECTED) ,CMP(GLUE_X_Y.ActualPosition>(GLUE_X_Y_PATH_LENGTH_DEG-GLUE_X_Y_PATH_STOP_DELTA_DEG)) OTU(Local:2:O.Pt00.Data) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONTROL GLUE GUN DURING GLUE SAMPLE WEIGHT ROUTINE]]>
</Comment>
<Text>
<![CDATA[[XIO(GLUE_X_Y_PATH2_RUN) EQU(STEP_AUTO[11],20) ,XIC(GLUE_X_Y_PATH2_RUN) EQU(STEP_AUTO[11],60) ][XIC(GLUE_MOTION_X_Y_CIRCLE_CONT.PC) XIO(GLUE_X_Y_CIRCLE_INDEX) [OTU(Local:2:O.Pt00.Data) ,XIO(GLUE_X_Y_PATH2_RUN) MOV(30,STEP_AUTO[11]) ,XIC(GLUE_X_Y_PATH2_RUN) MOV(70,STEP_AUTO[11]) ] ,XIO(CELL_DRY_CYCLE_MODE_PB) GRT(GLUE_X_Y.ActualPosition,GLUE_X_Y_PATH_GLUE_START_DEG) OTL(Local:2:O.Pt00.Data) ,CMP(GLUE_X_Y.ActualPosition>(GLUE_X_Y_PATH_LENGTH_DEG-GLUE_X_Y_PATH_STOP_DELTA_DEG)) OTU(Local:2:O.Pt00.Data) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[UPDATE LOCAL OUTPUT CARD]]>
</Comment>
<Text>
<![CDATA[IOT(Local:2:O);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_AUTO[10],80) ,EQU(STEP_AUTO[10],120) ,EQU(STEP_AUTO[11],20) ,EQU(STEP_AUTO[11],60) ]JSR(AUTO,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
