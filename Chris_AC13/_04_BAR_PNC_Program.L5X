<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION AUTO
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS

]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[4]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[PART STATUS]]>
</Comment>
<Text>
<![CDATA[XIC(PNC_DATA_BAR_LOADED)XIO(PNC_DATA_BAR_REJECT)[XIC(PNC_DATA_PREHEAT1_COMPLETE) ,XIO(PREHEAT1_ACTIVE_RECIPE_LOADED) ][XIC(PNC_DATA_PREHEAT2_COMPLETE) ,XIO(PREHEAT2_ACTIVE_RECIPE_LOADED) ][XIC(PNC_DATA_FORMING_COMPLETE) ,XIO(FORMING_ACTIVE_RECIPE_LOADED) ][XIC(PNC_DATA_PUNCH_COMPLETE) ,XIO(PUNCH_ACTIVE_RECIPE_LOADED) ][XIC(PNC_DATA_INKJET_COMPLETE) ,XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) ][XIC(PNC_DATA_PRINT_COMPLETE) ,XIO(PRINT_ACTIVE_RECIPE_LOADED) ]OTE(PNC_GOOD_BARRIER_ON_DIAL);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[4],0)[XIC(CELL_STARTED) [XIO(RUN_PROCESS) MOV(5,STEP_AUTO[4]) ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[4]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) [XIC(PNC_CURE_CYCLE_PB) ,XIC(PNC_PICK_CYCLE_PB) ] MOV(20,STEP_AUTO[4]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[4],5)[OTE(PNC_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(8,STEP_AUTO[4]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[VERIFY ROTATION OF PICK HEAD IS COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[4],8)EQU(STEP_AUTO[26],500)MOV(10,STEP_AUTO[4]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_EMPTY_COMPLETE.12) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) [XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIC(PNC_DATA_BAG_LOADED) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) [XIC(CELL_SINGLE_PART_GLUE_ONLY_PB) XIO(PNC_DATA_BAG_LOADED) ,XIO(CELL_SINGLE_PART_GLUE_ONLY_PB) ] ] XIC(PNC_ACTIVE_RECIPE_LOADED) OTE(RUN_PROCESS) ,EQU(STEP_AUTO[4],10) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[4]) ,XIO(RUN_PROCESS) MOV(150,STEP_AUTO[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[START PICK AND CURE ROUTINES AS REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[4],20)[EQU(STEP_AUTO[26],500) ,EQU(STEP_AUTO[26],1000) ]XIC(LAST_POS)[[[XIO(CELL_SHUTDOWN_REQ) XIO(PNC_DATA_EMPTY_LAST_BAG) XIC(PNC_GOOD_BARRIER_ON_DIAL) XIO(PNC_BARRIER_AT_PICK) ,XIC(PNC_PICK_CYCLE_PB) ] MOV(0,STEP_AUTO[24]) ,XIO(PNC_PICK_CYCLE_PB) [XIC(CELL_SHUTDOWN_REQ) ,XIC(PNC_DATA_EMPTY_LAST_BAG) ,XIO(PNC_GOOD_BARRIER_ON_DIAL) ,XIC(PNC_BARRIER_AT_PICK) ,XIC(PNC_CURE_CYCLE_PB) ] MOV(500,STEP_AUTO[24]) ] ,[[XIC(PNC_DATA_BAG_LOADED) XIC(PNC_DATA_GLUE_STARTED) XIO(PNC_DATA_PNC_STARTED) [XIC(PNC_BARRIER_AT_CURE) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] ,XIC(PNC_CURE_CYCLE_PB) ] MOV(0,STEP_AUTO[25]) ,XIO(PNC_CURE_CYCLE_PB) [XIO(PNC_DATA_BAG_LOADED) ,XIO(PNC_DATA_GLUE_STARTED) ,XIC(PNC_DATA_PNC_STARTED) ,XIO(CELL_DRY_CYCLE_MODE_PB) XIO(PNC_BARRIER_AT_CURE) ,XIC(PNC_PICK_CYCLE_PB) ] MOV(500,STEP_AUTO[25]) ] ,MOV(30,STEP_AUTO[4]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WAIT FOR PICK AND CURE ROUTINES TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[4],30)EQU(STEP_AUTO[24],500)EQU(STEP_AUTO[25],500)[XIC(CELL_STARTED) MOV(150,STEP_AUTO[4]) ,XIC(CELL_MANUAL_MODE) XIO(PNC_PICK_CYCLE_PB) XIO(PNC_CURE_CYCLE_PB) MOV(0,STEP_AUTO[4]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[4],150)[OTL(PNC_PROCESS_DONE) ,XIO(CELL_DRY_CYCLE_MODE_PB) XIO(PNC_DATA_BAG_REJECT) XIC(PNC_DATA_GLUE_COMPLETE) XIO(PNC_DATA_PNC_STARTED) OTL(PNC_DATA_GLUE_OPEN_REJECT) ,XIC(CELL_EMPTY_COMPLETE.11) XIC(PNC_DATA_EMPTY_LAST_BAG) OTL(CELL_EMPTY_COMPLETE.12) ,TON(TIMER_OPER[12],?,?) ,XIC(TIMER_OPER[12].DN) MOV(160,STEP_AUTO[4]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[4],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(PNC_PROCESS_DONE) ,MOV(5,STEP_AUTO[4]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(8,STEP_AUTO[4],150) TON(TIMER_OPER[11],?,?) ,EQU(STEP_AUTO[4],150) ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[11].ACC,1000,CELL_CYCLE_TIME[0].PNC) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[4],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].PNC,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(10,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].PNC,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].PNC,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].PNC,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(10,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].PNC,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="AUTO_CURE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION BAG CURE AUTO
***************************************************************************

EXTEND PICK CYLINDER AND PRESS CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[25],0)[[[XIC(PNC_SIDE_1_AT_CURE_POS) XIC(PNC_VAC1_ON) ,XIC(PNC_SIDE_2_AT_CURE_POS) XIC(PNC_VAC2_ON) ] XIC(PNC_PRESS_CYL_ACTIVE_RECIPE_LOADED) OTL(PNC_PRESS_CYL_EXT_PB) ,XIC(PNC_SIDE_1_AT_CURE_POS) [[XIC(PNC_VAC1_ON) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(PNC_PICK_CYL1_EXT_PB) ,XIC(PNC_PICK_CYL1_EXT_DETECTED) [XIC(PNC_PRESS_CYL_ACTIVE_RECIPE_LOADED) XIC(PNC_PRESS_CYL_EXT_DETECTED) ,XIO(PNC_PRESS_CYL_ACTIVE_RECIPE_LOADED) ] [XIC(CELL_STARTED) OTL(PNC_DATA_PNC_STARTED) ,MOV(20,STEP_AUTO[25]) ] ] ,XIC(PNC_SIDE_2_AT_CURE_POS) [[XIC(PNC_VAC2_ON) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(PNC_PICK_CYL2_EXT_PB) ,XIC(PNC_PICK_CYL2_EXT_DETECTED) [XIC(PNC_PRESS_CYL_ACTIVE_RECIPE_LOADED) XIC(PNC_PRESS_CYL_EXT_DETECTED) ,XIO(PNC_PRESS_CYL_ACTIVE_RECIPE_LOADED) ] [XIC(CELL_STARTED) OTL(PNC_DATA_PNC_STARTED) ,MOV(20,STEP_AUTO[25]) ] ] ] ,ONS(ONS_ARRAY[10]) XIO(CELL_DRY_CYCLE_MODE_PB) [XIC(PNC_SIDE_1_AT_CURE_POS) XIO(PNC_VAC1_ON) ,XIC(PNC_SIDE_2_AT_CURE_POS) XIO(PNC_VAC2_ON) ] MOV(500,STEP_AUTO[25]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR CURE TIME AND VERIFY PRESSURE OK
RELEASE VAC AFTER TIME]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[25],20)[MOV(PNC_CURE_TIME_RECIPE,TIMER_OPER[10].PRE) ,GRT(TIMER_OPER[10].ACC,500) [XIC(PNC_SIDE_1_AT_CURE_POS) OTU(PNC_VAC1_ON_PB) ,XIC(PNC_SIDE_2_AT_CURE_POS) OTU(PNC_VAC2_ON_PB) ] ,TON(TIMER_OPER[10],?,?) ,XIC(TIMER_OPER[10].DN) [XIC(CELL_STARTED) [XIC(PNC_PRESSURE_OK) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(PNC_DATA_PNC_PRESS_OK) ,OTL(PNC_DATA_PNC_COMPLETE) ,MOV(30,STEP_AUTO[25]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[RETRACT PRESS CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[25],30)[OTU(PNC_PRESS_CYL_EXT_PB) ,[XIC(PNC_PRESS_CYL_RET) ,XIO(PNC_PRESS_CYL_EXT) ] MOV(40,STEP_AUTO[25]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[RETRACT PICK CYLINDER AS REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[25],40)[XIC(PNC_SIDE_1_AT_CURE_POS) [OTU(PNC_PICK_CYL1_EXT_PB) ,XIC(PNC_PICK_CYL1_RET) MOV(500,STEP_AUTO[25]) ] ,XIC(PNC_SIDE_2_AT_CURE_POS) [OTU(PNC_PICK_CYL2_EXT_PB) ,XIC(PNC_PICK_CYL2_RET) MOV(500,STEP_AUTO[25]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="AUTO_PICK" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION PICK BARRIER AUTO
***************************************************************************
EXTEND SUPPORT CYLINDER AS REQUIRED BY RECIPE
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[24],0)[XIO(PNC_SUP_CYL_ACTIVE_RECIPE_LOADED) MOV(5,STEP_AUTO[24]) ,XIC(PNC_SUP_CYL_ACTIVE_RECIPE_LOADED) OTL(PNC_SUP_CYL_EXT_PB) ,XIC(PNC_SUP_CYL_EXT_PB) XIC(PNC_SUP_CYL_EXT) MOV(5,STEP_AUTO[24]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[EXTEND PICK CYLINDERS, AND TURN ON PRESS HEAD VACUUM AS REQUIRED
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[24],5)[XIC(PNC_SIDE_1_AT_CURE_POS) [[ONS(ONS_ARRAY[15]) XIO(PNC_VAC2_ON) ,XIC(PNC_PICK_CYL2_EXT_PB) ] [OTL(PNC_PICK_CYL2_EXT_PB) ,XIO(CELL_DRY_CYCLE_MODE_PB) OTL(PNC_VAC2_ON_PB) ,XIC(PNC_PICK_CYL2_EXT_DETECTED) MOV(10,STEP_AUTO[24]) ] ,ONS(ONS_ARRAY[11]) XIC(PNC_VAC2_ON) MOV(500,STEP_AUTO[24]) ] ,XIC(PNC_SIDE_2_AT_CURE_POS) [[ONS(ONS_ARRAY[16]) XIO(PNC_VAC1_ON) ,XIC(PNC_PICK_CYL1_EXT_PB) ] [OTL(PNC_PICK_CYL1_EXT_PB) ,XIO(CELL_DRY_CYCLE_MODE_PB) OTL(PNC_VAC1_ON_PB) ,XIC(PNC_PICK_CYL1_EXT_DETECTED) MOV(10,STEP_AUTO[24]) ] ,ONS(ONS_ARRAY[14]) XIC(PNC_VAC1_ON) MOV(500,STEP_AUTO[24]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[TURN OFF MAIN DIAL VACUUM, WAIT FOR VACUUM SWITCH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[24],10)[XIC(PNC_SIDE_1_AT_CURE_POS) [XIC(PNC_VAC2_ON) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] ,XIC(PNC_SIDE_2_AT_CURE_POS) [XIC(PNC_VAC1_ON) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] ][XIO(CELL_DRY_CYCLE_MODE_PB) OTU(MAIN_DIAL_VAC_PB[0].10) ,TON(TIMER_OPER[9],?,?) ,XIC(TIMER_OPER[9].DN) [XIC(PNC_SUP_CYL_ACTIVE_RECIPE_LOADED) XIO(PNC_SUP_CYL_RET) ,XIO(PNC_SUP_CYL_ACTIVE_RECIPE_LOADED) ] [OTU(PNC_DATA_BAR_LOADED) ,OTU(PNC_DATA_PREHEAT1_STARTED) ,OTU(PNC_DATA_PREHEAT1_UP_TEMP_OK) ,OTU(PNC_DATA_PREHEAT1_LOW_TEMP_OK) ,OTU(PNC_DATA_PREHEAT1_COMPLETE) ,OTU(PNC_DATA_PREHEAT2_STARTED) ,OTU(PNC_DATA_PREHEAT2_UP_TEMP_OK) ,OTU(PNC_DATA_PREHEAT2_LOW_TEMP_OK) ,OTU(PNC_DATA_PREHEAT2_COMPLETE) ,OTU(PNC_DATA_FORMING_STARTED) ,OTU(PNC_DATA_FORMING_PRESS_OK) ,OTU(PNC_DATA_FORMING_COMPLETE) ,OTU(PNC_DATA_PUNCH_STARTED) ,OTU(PNC_DATA_PUNCH_COMPLETE) ,OTU(PNC_DATA_INKJET_STARTED) ,OTU(PNC_DATA_INKJET_COMPLETE) ,OTU(PNC_DATA_PRINT_STARTED) ,OTU(PNC_DATA_PRINT_COMPLETE) ,OTU(PNC_DATA_BAR_REJECT) ,MOV(0,PNC_DATA_POS_BAR_REJECT) ,MOV(20,STEP_AUTO[24]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[RETRACT PICK CYLINDER AS REQUIRED
RETRACT SUPPORT CYLINDER IF REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[24],20)[[XIC(PNC_SIDE_1_AT_CURE_POS) [OTU(PNC_PICK_CYL2_EXT_PB) ,XIC(PNC_PICK_CYL2_RET) XIC(PNC_SUP_CYL_RET) MOV(500,STEP_AUTO[24]) ] ,XIC(PNC_SIDE_2_AT_CURE_POS) [OTU(PNC_PICK_CYL1_EXT_PB) ,XIC(PNC_PICK_CYL1_RET) XIC(PNC_SUP_CYL_RET) MOV(500,STEP_AUTO[24]) ] ] ,XIC(PNC_SUP_CYL_ACTIVE_RECIPE_LOADED) XIC(PNC_SUP_CYL_EXT) OTU(PNC_SUP_CYL_EXT_PB) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="AUTO_ROTATE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION PRESS HEAD ROTATE AUTO
********************************************************************************
INTITATE PRESS HEAD INDEX
WHEN DIAL INDEXES]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_BAG_LOAD_ONLY_MODE_PB)EQU(STEP_AUTO[26],500)XIC(CELL_STARTED)XIC(PNC_BARRIER_AT_PICK)LIM(0.1,DRV01.ActualVelocity,-0.1)XIC(MAIN_DIAL_DRV_MOVING)MOV(0,STEP_AUTO[26]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INDEX PRESS HEAD]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[26],0)[OTL(PNC_INDEX_PB) ,XIC(NEXT_POS) MOV(10,STEP_AUTO[26]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WAIT FOR POSITION MONITOR CALC COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[26],10)XIC(POS_MONITOR_CALC_COMPLETE)MOV(500,STEP_AUTO[26]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION ESTOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[4],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[4]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[4],1000) EQU(STEP_ALARM_CAPTURE[4],0) MOV(STEP_ALARM[4],STEP_ALARM_CAPTURE[4]) ,LIM(500,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[4],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.4) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[4],1000)[NEQ(STEP_ALARM[4],0) OTE(MAJOR_FAULT[4]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[4],STEP_AUTO_RET_ESTOP[4]) MOV(STEP_AUTO[24],STEP_AUTO_RET_ESTOP[24]) MOV(STEP_AUTO[25],STEP_AUTO_RET_ESTOP[25]) MOV(STEP_AUTO[26],STEP_AUTO_RET_ESTOP[26]) ,[OTU(PNC_DRV_RESET_PB) OTU(PNC_DRV_ENABLE_PB) OTU(PNC_INDEX_PB) OTU(PNC_ABORT_INDEX_PB) ,OTU(PNC_DRV_HOME_PB) OTU(DRV_INTERNAL_HOME_REQ) OTU(DRV_HOME_OFF_REQ) OTU(DRV_DEFINE_HOME) OTU(PNC_DRV_HOMING_IND) ] ,OTU(PNC_PICK_CYL1_EXT_PB) OTU(PNC_PICK_CYL2_EXT_PB) OTU(PNC_PRESS_CYL_EXT_PB) OTU(PNC_SUP_CYL_EXT_PB) ,OTU(PNC_CURE_CYCLE_PB) OTU(PNC_PROCESS_DONE) ,MOV(0,MAN02:O.Data[0]) ,XIO(CELL_DRY_CYCLE_MODE_PB) XIC(PNC_DATA_BAG_LOADED) XIO(PNC_DATA_BAG_REJECT) XIC(PNC_DATA_GLUE_COMPLETE) XIO(PNC_DATA_PNC_COMPLETE) OTE(PNC_PROCESS_FAILED) ,MOV(1000,STEP_HOME[4]) MOV(1000,STEP_HOMING[4]) MOV(1000,STEP_AUTO[4]) MOV(1000,STEP_AUTO[24]) MOV(1000,STEP_AUTO[25]) MOV(1000,STEP_AUTO[26]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[4],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[4]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[4],10)[MOV(0,STEP_ALARM[4]) ,MOV(0,STEP_ALARM_CAPTURE[4]) ,MOV(20,STEP_ESTOP_RESET[4]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[4],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[4]) ,MOV(30,STEP_ESTOP_RESET[4]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[4]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[4],30)EQU(STEP_HOME[4],500)MOV(500,STEP_ESTOP_RESET[4]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE HMI
***************************************************************************

DRIVE INDEXING ANIMATION]]>
</Comment>
<Text>
<![CDATA[[LIM(0.1,DRV04.ActualVelocity,-0.1) XIC(PNC_DRV_MOVING) ,XIC(PNC_INDEX_PB) ]OTE(PNC_INDEXING_IND);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ANIMATION FOR HMI DURING PICK HEAD ROTATION]]>
</Comment>
<Text>
<![CDATA[LIM(-.02,DRV04.ActualPosition,90)OTE(PNC_PICK_ROT_POS);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[AUTO READY ANIMATION]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_AUTO_READY[4])XIC(PNC_IN_POSITION)XIC(PNC_BARRIER_AT_PICK)XIO(PNC_BARRIER_AT_CURE)OTE(PNC_PICK_LOC_NOT_AUTO_READY);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[4],500)[XIO(CELL_STARTED) XIO(PNC_DRV_FAULT) XIO(PNC_DRV_SHUTDOWN) [XIO(PNC_DRV_HOMING_IND) OTE(PNC_DRV_ENABLE_PB_VIS) ,XIC(PNC_CLEAR_TO_INDEX) XIC(PNC_DRV_READY) [OTE(PNC_DRV_HOME_PB_VIS) ,XIC(PNC_DRV_HOMED) OTE(PNC_DRV_PB_VIS) ] ] ,[XIC(PNC_DRV_FAULT) ,XIC(PNC_DRV_SHUTDOWN) ,XIC(MOTION_DRV_ENABLE_CONT.ER) ] OTE(PNC_DRV_FAULT_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[PICK HEAD AND SUPPORT PUSH BUTTONS ON HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)XIC(CELL_MANUAL_MODE)XIC(PNC_DRV_HOMED)XIC(MAIN_DIAL_IN_POSITION)XIC(PNC_IN_POSITION)[[XIC(PNC_PRESS_CYL_RET) XIC(PNC_SIDE_1_AT_CURE_POS) ,XIC(PNC_SIDE_2_AT_CURE_POS) ] OTE(PNC_PICK_CYL1_EXT_PB_VIS) ,[XIC(PNC_PRESS_CYL_RET) XIC(PNC_SIDE_2_AT_CURE_POS) ,XIC(PNC_SIDE_1_AT_CURE_POS) ] OTE(PNC_PICK_CYL2_EXT_PB_VIS) ,[XIC(PNC_SIDE_1_AT_CURE_POS) XIC(PNC_PICK_CYL1_EXT_DETECTED) ,XIC(PNC_SIDE_2_AT_CURE_POS) XIC(PNC_PICK_CYL2_EXT_DETECTED) ] OTE(PNC_PRESS_CYL_EXT_PB_VIS) ,OTE(PNC_SUP_CYL_EXT_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MANUAL MODE CYCLES HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)XIC(CELL_KEY_AUTO_MODE)XIC(CELL_MANUAL_MODE)XIC(MAIN_DIAL_IN_POSITION)XIC(PNC_IN_POSITION)XIO(PNC_DRV_FAULT)XIC(PNC_DRV_READY)XIC(PNC_DRV_HOMED)OTE(PNC_CYCLE_PB_VIS);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[DRIVE POSITION FOR HMI]]>
</Comment>
<Text>
<![CDATA[MUL(DRV04.ActualPosition,100,PNC_CUR_POS_HMI);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(PNC_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(PNC_BYPASS_ANIMATION);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION HOME ROUTINE
***************************************************************************

RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],0)[[XIC(PNC_DRV_FAULT) ,XIC(PNC_DRV_SHUTDOWN) ] OTL(PNC_DRV_RESET_PB) ,XIO(PNC_DRV_FAULT) XIO(PNC_DRV_SHUTDOWN) MOV(10,STEP_HOME[4]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TORQUE SAFE INPUT TO ACTIVATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],10)[XIO(PNC_DRV_SAFE_TRQ_OFF) MOV(20,STEP_HOME[4]) ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(309,STEP_ALARM[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],20)[OTL(PNC_DRV_ENABLE_PB) ,XIC(PNC_DRV_READY) MOV(25,STEP_HOME[4]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[VERIFY GLUE STATION HOME ROUTINE IS COMPLETE
RETRACT ALL CYLINDERS AND CHECK VACUUM STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],25)EQU(STEP_HOME[10],500)[[OTU(PNC_PICK_CYL1_EXT_PB) ,OTU(PNC_PICK_CYL2_EXT_PB) ,OTU(PNC_PRESS_CYL_EXT_PB) ,XIO(PNC_VAC1_ON) OTU(PNC_VAC1_ON_PB) ,XIO(PNC_VAC2_ON) OTU(PNC_VAC2_ON_PB) ] ,XIC(PNC_PICK_CYL1_RET) XIC(PNC_PICK_CYL2_RET) XIC(PNC_PRESS_CYL_RET) MOV(30,STEP_HOME[4]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ CHECK TO SEE IF DRIVE REQUIRES HOMING
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],30)[XIO(PNC_DRV_HOMED) MOV(35,STEP_HOME[4]) ,XIC(PNC_DRV_HOMED) MOV(38,STEP_HOME[4]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[START DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[4]) ,XIC(PNC_DRV_HOMED) MOV(38,STEP_HOME[4]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[VERIFY CALC COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],38)[XIO(POS_MONITOR_CALC_COMPLETE) ONS(ONS_ARRAY[5]) MOV(20,STEP_POS_MONITOR[4]) ,XIC(POS_MONITOR_CALC_COMPLETE) MOV(40,STEP_HOME[4]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[DECIDE IF PICK HEAD NEEDS ROTATING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],40)[XIO(PNC_IN_POSITION) MOV(50,STEP_HOME[4]) ,XIC(PNC_IN_POSITION) MOV(80,STEP_HOME[4]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[COMPLETE MOVE TO CURE DESTINATION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],50)[ONS(ONS_ARRAY[6]) OTL(PNC_INDEX_PB) ,XIC(NEXT_POS) XIO(PNC_DRV_MOVING) MOV(70,STEP_HOME[4]) ,[TON(TIMER_ALARM[14],?,?) ,XIC(TIMER_ALARM[14].DN) MOV(310,STEP_ALARM[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CHECK FOR PRESS HEAD IN POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],70)XIC(PNC_IN_POSITION)MOV(80,STEP_HOME[4]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[CHECK STATUS OF PARTS AND LOCATION OF PICK HEAD]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[4],80)[[XIO(PNC_VAC1_ON) XIO(PNC_VAC2_ON) ,XIC(PNC_BARRIER_PICKED) XIC(PNC_BARRIER_AT_CURE) ] [MOV(0,STEP_AUTO[4]) ,MOV(500,STEP_AUTO[26]) ,MOV(500,STEP_HOME[4]) ] ,XIC(PNC_BARRIER_PICKED) XIO(PNC_BARRIER_AT_CURE) MOV(50,STEP_HOME[4]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(SERVO_HOMING,0) ,JSR(AUTO,0) ,JSR(AUTO_CURE,0) ,JSR(AUTO_PICK,0) ,JSR(AUTO_ROTATE,0) ,JSR(OUTPUTS,0) ,JSR(POSITION_MONITOR,0) ,JSR(PRESSURE_REG,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION OUTPUTS
***************************************************************************

INITIATE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)XIC(PNC_CLEAR_TO_INDEX)XIC(DRV_INTERNAL_HOME_REQ)[MAH(DRV04,MOTION_DRV_INTERNAL_HOME_CONT) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC) XIC(PNC_DRV_HOMED_STATUS) OTU(DRV_INTERNAL_HOME_REQ) ,[TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(311,STEP_ALARM[4]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE MOVING DEBOUNCE TIMER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)XIC(PNC_DRV_MOVING)TON(TIMER_OPER[1],?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ROTARY POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)[XIO(PNC_CLEAR_TO_INDEX) [XIC(PNC_INDEX_PB) ,XIC(DRV_HOME_OFF_REQ) ,XIC(DRV_INTERNAL_HOME_REQ) ] [XIO(PNC_PICK_CYL1_RET) OTU(PNC_PICK_CYL1_EXT_PB) ,XIO(PNC_PICK_CYL2_RET) OTU(PNC_PICK_CYL2_EXT_PB) ,XIO(PNC_PRESS_CYL_RET) OTU(PNC_PRESS_CYL_EXT_PB) ] ,XIC(PNC_CLEAR_TO_INDEX) XIC(PNC_INDEX_PB) [[XIC(NEXT_POS) ,XIC(TIMER_OPER[1].DN) ] [OTU(PNC_INDEX_PB) ,XIC(PNC_DRV_READY) OTU(POS_MONITOR_CALC_COMPLETE) ] ,EQU(DRV_INDEX_NUM,5) [[MAM(DRV04,MOTION_DRV_180_POS_CONT,0,180,700,Units per sec,3000,Units per sec2,3000,Units per sec2,S-Curve,50,50,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_180_POS_CONT.PC) OTU(PNC_INDEX_PB) ] ,[TON(TIMER_ALARM[12],?,?) ,XIC(TIMER_ALARM[12].DN) [OTU(PNC_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(326,STEP_ALARM[4]) ] ] ] ,EQU(DRV_INDEX_NUM,6) [[MAM(DRV04,MOTION_DRV_0_POS_CONT,0,0,700,Units per sec,3000,Units per sec2,3000,Units per sec2,S-Curve,50,50,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_0_POS_CONT.PC) OTU(PNC_INDEX_PB) ] ,[TON(TIMER_ALARM[11],?,?) ,XIC(TIMER_ALARM[11].DN) [OTU(PNC_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(327,STEP_ALARM[4]) ] ] ] ] ,[XIC(PNC_INDEX_PB) ONS(ONS_ARRAY[4]) RES(TIMER_OPER[8]) ,XIC(TIMER_OPER[8].TT) XIO(NEXT_POS) ] RTO(TIMER_OPER[8],?,?) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[HOMING OFFSET CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)XIC(PNC_CLEAR_TO_INDEX)XIC(DRV_HOME_OFF_REQ)[MAM(DRV04,MOTION_DRV_HOME_OFF_CONT,1,PNC_DRV_HOME_OFF,10,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,[XIC(MOTION_DRV_HOME_OFF_CONT.PC) ,XIO(PNC_CLEAR_TO_INDEX) ] OTU(DRV_HOME_OFF_REQ) ,[TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) [OTU(DRV_HOME_OFF_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(308,STEP_ALARM[4]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ABORT INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)[XIC(PNC_ABORT_INDEX_PB) ,XIO(PNC_CLEAR_TO_INDEX) ][MAS(DRV04,MOTION_DRV_ABORT_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,XIC(MOTION_DRV_ABORT_CONT.PC) OTU(PNC_ABORT_INDEX_PB) ,XIO(MOTION_DRV_ABORT_CONT.PC) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [OTU(PNC_ABORT_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(312,STEP_ALARM[4]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ZERO ENCODER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)XIC(DRV_DEFINE_HOME)[MRP(DRV04,MOTION_DRV_ZERO_CONT,Absolute,Actual,0.0) ,LIM(-.01,DRV04.ActualPosition,0.01) OTU(DRV_DEFINE_HOME) ,[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) [OTU(DRV_DEFINE_HOME) ,XIC(CELL_ALARMS_ACTIVE) MOV(307,STEP_ALARM[4]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[4],1000) XIC(PNC_DRV_RESET_PB) [MASR(DRV04,MOTION_DRV_RESET_CONT) ,XIC(MOTION_DRV_ENABLE_CONT.ER) OTU(MOTION_DRV_ENABLE_CONT.ER) ,XIO(PNC_DRV_FAULT) XIO(PNC_DRV_SHUTDOWN) XIO(MOTION_DRV_ENABLE_CONT.ER) OTU(PNC_DRV_RESET_PB) ,[TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(PNC_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(PNC_DRV_FAULT) MOV(303,STEP_ALARM[4]) ,XIC(PNC_DRV_SHUTDOWN) MOV(315,STEP_ALARM[4]) ] ] ] ] ,[XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(10,STEP_HOME[4],499) ] [XIC(PNC_DRV_FAULT) MOV(303,STEP_ALARM[4]) ,XIC(PNC_DRV_SHUTDOWN) MOV(315,STEP_ALARM[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)[XIC(PNC_DRV_ENABLE_PB) [MSO(DRV04,MOTION_DRV_ENABLE_CONT) ,[XIO(MOTION_DRV_ENABLE_CONT.DN) ,XIO(PNC_DRV_READY) ,XIC(PNC_DRV_FAULT) ,XIC(PNC_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) [OTU(PNC_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(313,STEP_ALARM[4]) ] ] ] ,XIO(PNC_DRV_ENABLE_PB) [MSF(DRV04,MOTION_DRV_DISABLE_CONT) ,XIO(MOTION_DRV_DISABLE_CONT.DN) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) XIC(CELL_ALARMS_ACTIVE) MOV(314,STEP_ALARM[4]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[PICK CYLINDER 1 CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)[XIC(PNC_PICK_CYL1_EXT_PB) [OTE(MAN02:O.Data[4].10) ,XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_PICK_CYL1_EXT_DETECTED) [TON(TIMER_ALARM[18],?,?) ,XIC(TIMER_ALARM[18].DN) MOV(316,STEP_ALARM[4]) ] ] ,XIO(PNC_PICK_CYL1_EXT_PB) XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_PICK_CYL1_RET) [TON(TIMER_ALARM[19],?,?) ,XIC(TIMER_ALARM[19].DN) MOV(317,STEP_ALARM[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[PICK CYLINDER 2 CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)[XIC(PNC_PICK_CYL2_EXT_PB) [OTE(MAN02:O.Data[4].12) ,XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_PICK_CYL2_EXT_DETECTED) [TON(TIMER_ALARM[20],?,?) ,XIC(TIMER_ALARM[20].DN) MOV(318,STEP_ALARM[4]) ] ] ,XIO(PNC_PICK_CYL2_EXT_PB) XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_PICK_CYL2_RET) [TON(TIMER_ALARM[21],?,?) ,XIC(TIMER_ALARM[21].DN) MOV(319,STEP_ALARM[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[PRESS CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)[XIC(PNC_PRESS_CYL_EXT_PB) [OTE(MAN02:O.Data[4].2) ,XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_PRESS_CYL_EXT_DETECTED) [TON(TIMER_ALARM[22],?,?) ,XIC(TIMER_ALARM[22].DN) MOV(320,STEP_ALARM[4]) ] ] ,XIO(PNC_PRESS_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_PRESS_CYL_RET) [TON(TIMER_ALARM[23],?,?) ,XIC(TIMER_ALARM[23].DN) MOV(321,STEP_ALARM[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[SUPPORT CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)[XIC(PNC_SUP_CYL_EXT_PB) [OTE(MAN02:O.Data[4].14) ,XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_SUP_CYL_EXT) [TON(TIMER_ALARM[15],?,?) ,XIC(TIMER_ALARM[15].DN) MOV(324,STEP_ALARM[4]) ] ] ,XIO(PNC_SUP_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_SUP_CYL_RET) [TON(TIMER_ALARM[16],?,?) ,XIC(TIMER_ALARM[16].DN) MOV(325,STEP_ALARM[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[VACUUM CONTROL]]>
</Comment>
<Text>
<![CDATA[[XIC(PNC_VAC1_ON_PB) [OTE(MAN02:O.Data[5].12) ,XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_VAC1_ON) [TON(TIMER_ALARM[24],?,?) ,XIC(TIMER_ALARM[24].DN) MOV(322,STEP_ALARM[4]) ] ] ,XIC(PNC_VAC2_ON_PB) [OTE(MAN02:O.Data[5].13) ,XIC(CELL_ALARMS_ACTIVE) [XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(26,STEP_HOME[4],500) ] XIO(PNC_VAC2_ON) [TON(TIMER_ALARM[25],?,?) ,XIC(TIMER_ALARM[25].DN) MOV(323,STEP_ALARM[4]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR BARRIER PRESS-N-CURE STATION
***************************************************************************
DETERMINE IF PRESS HEAD IS IN POSITION BY
 PRESS HEAD HAS REACHED IT'S TARGET
 PRESS HEAD HASN'T LEFT IT'S LAST TARGET POSITION
 PRESS HEAD IS IN ONE OF THE PROCESS POSITIONS
]]>
</Comment>
<Text>
<![CDATA[[XIC(PNC_DRV_HOMED) [CMP(NEXT_CALC_POS+0.1>DRV04.ActualPosition) CMP(NEXT_CALC_POS-0.1<DRV04.ActualPosition) OTE(NEXT_POS) ,CMP(LAST_KNOWN_POS+0.1>DRV04.ActualPosition) CMP(LAST_KNOWN_POS-0.1<DRV04.ActualPosition) OTE(LAST_POS) ,GRT(DRV04.ActualPosition,179.9) LES(DRV04.ActualPosition,180.1) OTE(PNC_SIDE_1_AT_CURE_POS) ,GRT(DRV04.ActualPosition,-0.1) LES(DRV04.ActualPosition,0.1) OTE(PNC_SIDE_2_AT_CURE_POS) ] OTE(PNC_IN_POSITION) ,[XIC(CELL_STARTED) XIC(POS_MONITOR_CALC_COMPLETE) ,EQU(STEP_HOME[4],70) ] XIO(PNC_IN_POSITION) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [OTL(DRV_HOMING_REQ) ,MOV(306,STEP_ALARM[4]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INITIATE POSITION UPDATE AND PART DATA TRANSFER]]>
</Comment>
<Text>
<![CDATA[[XIC(PNC_DRV_MOVING) OTU(POS_MONITOR_CALC_COMPLETE) ,NEQ(STEP_ESTOP_RESET[4],1000) XIO(POS_MONITOR_CALC_COMPLETE) XIO(PNC_DRV_MOVING) XIC(PNC_DRV_READY) XIO(PNC_DRV_FAULT) XIC(PNC_DRV_HOMED) XIC(PNC_IN_POSITION) [TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) ONS(ONS_ARRAY[13]) MOV(20,STEP_POS_MONITOR[4]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CACULATE THE NEXT POSITION SO THE MACHINE CAN RESUME FROM WHERE IT LEFT OFF.
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[4],20)[[XIC(PNC_SIDE_1_AT_CURE_POS) [MOV(180,LAST_KNOWN_POS) ,MOV(0,NEXT_CALC_POS) ,MOV(6,DRV_INDEX_NUM) ] ,XIC(PNC_SIDE_2_AT_CURE_POS) [MOV(0,LAST_KNOWN_POS) ,MOV(180,NEXT_CALC_POS) ,MOV(5,DRV_INDEX_NUM) ] ] ,MOV(60,STEP_POS_MONITOR[4]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[COMPLETE ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[4],60)[OTL(POS_MONITOR_CALC_COMPLETE) ,MOV(500,STEP_POS_MONITOR[4]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PRESSURE_REG" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION PRESSURE REGULATOR
*******************************************************************************

ADD OPERATOR ADJUSTMENT TO PRESSURE SETPOINT]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[LIM(PNC_PRESSURE_MAX,PRESSURE_SP_AUTO,PNC_PRESSURE_MIN) MOV(0,PNC_ADJ_PRESSURE) ,ADD(PNC_PRESSURE_RECIPE_SP,PNC_ADJ_PRESSURE,PRESSURE_SP_AUTO) ,ADD(PNC_PRESSURE_RECIPE_SP,PNC_ADJ_PRESSURE,PNC_PRESSURE_SP_AUTO_DISPLAY) ,MOV(PRESSURE_SP_AUTO,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CACULATE OPERATERS MAXIMUM  & MINIMUM ALLOWABLE SETPOINT ADJUSTMENT BASED ON RECIPE PRESSURE
]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[[SUB(PNC_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,PNC_PRESSURE_MIN) ,LES(PNC_PRESSURE_MIN,PRESSURE_MIN_ALLOWED) MOV(PRESSURE_MIN_ALLOWED,PNC_PRESSURE_MIN) ] ,[ADD(PNC_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,PNC_PRESSURE_MAX) ,GRT(PNC_PRESSURE_MAX,PRESSURE_MAX_ALLOWED) MOV(PRESSURE_MAX_ALLOWED,PNC_PRESSURE_MAX) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IF RECIPE VALUE CHANGES ZERO OUT OFFSET ADJUST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)MOV(0,PNC_ADJ_PRESSURE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****MANUAL MODE****

SET PRESSURE SETPOINT FOR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)ONS(ONS_ARRAY[2])MOV(PRESSURE_SP_AUTO,PNC_PRESSURE_SP_MAN_DISPLAY);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WHILE IN MANUAL MODE, ALLOW THE PRESSURE SLIDERS FULL SCALE OF OPERATION.]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[MUL(PNC_PRESSURE_SP_MAN_DISPLAY,1,PRESSURE_SP_MAN) ,MOV(PRESSURE_MIN_ALLOWED,PNC_PRESSURE_MIN) ,MOV(PRESSURE_MAX_ALLOWED,PNC_PRESSURE_MAX) ,MOV(PRESSURE_SP_MAN,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SEND REGULATOR PRESSURE INPUT COUNTS

SCALE, TRUNCATE AND BYTE SWAP]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[4],1000)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[MUL(PRESSURE_SP_GEN,PNC_PRES_SCALE_PAR.OUT_M,PRESSURE_WITH_M_DONE) ,ADD(PRESSURE_WITH_M_DONE,PNC_PRES_SCALE_PAR.OUT_B,SCALED_PRESSURE) ,TRN(SCALED_PRESSURE,MAN02:O.Data[0]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CACULATE FEEDBACK PRESSURE FROM REGULATOR]]>
</Comment>
<Text>
<![CDATA[[MOV(MAN02:I.Data[0],REG_FEEDBACK) ,SUB(REG_FEEDBACK,PNC_PRES_SCALE_PAR.IN_B,REG_FEEDBACK_M) ,DIV(REG_FEEDBACK_M,PNC_PRES_SCALE_PAR.IN_M,REG_FEEDBACK_SCALED) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[VERIFY PRESSURE USING REGULATOR FEEDBACK]]>
</Comment>
<Text>
<![CDATA[CMP(PNC_PRESSURE_SP_AUTO_DISPLAY-PRESSURE_DELTA_ALLOWED<REG_FEEDBACK_SCALED)OTE(PNC_PRESSURE_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION DRIVE HOMING ROUTINE
***************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(PNC_DRV_HOME_PB)XIO(DRV_HOMING_REQ)XIO(PNC_DRV_HOMING_IND)XIC(PNC_DRV_HOMED_STATUS)OTE(PNC_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[4],0) ,XIC(PNC_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[4],500) [EQU(STEP_HOMING[4],500) ,EQU(STEP_HOMING[4],1000) ] ][MOV(10,STEP_HOMING[4]) ,OTL(PNC_DRV_HOMING_IND) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[4],10)[XIC(PNC_CLEAR_TO_INDEX) ONS(ONS_ARRAY[12]) OTL(DRV_INTERNAL_HOME_REQ) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.IP) MOV(15,STEP_HOMING[4]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[4],15)XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC)XIC(PNC_DRV_HOMED_STATUS)XIO(DRV_INTERNAL_HOME_REQ)MOV(30,STEP_HOMING[4]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[PAUSE BEFORE INITIATING THE NEXT MOVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[4],30)[XIC(PNC_DRV_HOMED_STATUS) [TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) MOV(40,STEP_HOMING[4]) ] ,XIC(PNC_DRV_FAULT) MOV(100,STEP_HOMING[4]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[REQUEST INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[4],40)[XIC(PNC_CLEAR_TO_INDEX) ONS(ONS_ARRAY[29]) OTL(DRV_HOME_OFF_REQ) ,XIC(MOTION_DRV_HOME_OFF_CONT.IP) MOV(45,STEP_HOMING[4]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[COMPLETE INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[4],45)XIC(MOTION_DRV_HOME_OFF_CONT.PC)XIC(PNC_DRV_HOMED_STATUS)XIO(DRV_HOME_OFF_REQ)MOV(50,STEP_HOMING[4]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SET COUNTER TO ZERO]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[4],50)[ONS(ONS_ARRAY[9]) OTL(DRV_DEFINE_HOME) ,XIO(DRV_DEFINE_HOME) MOV(100,STEP_HOMING[4]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[4],100)[MOV(5,DRV_INDEX_NUM) ,OTU(PNC_DRV_HOMING_IND) OTU(PNC_DRV_HOME_PB) ,XIO(PNC_DRV_FAULT) OTU(DRV_HOMING_REQ) ,MOV(500,STEP_HOMING[4]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRESS-N-CURE STATION STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(PNC_DRV_HOMED)XIC(PNC_DRV_READY)XIO(PNC_DRV_FAULT)XIC(PNC_IN_POSITION)XIC(PNC_PICK_CYL1_RET)XIC(PNC_PICK_CYL2_RET)XIC(PNC_PRESS_CYL_RET)XIC(PNC_SUP_CYL_RET)[XIO(PNC_BARRIER_AT_PICK) ,XIC(PNC_BARRIER_AT_PICK) XIC(PNC_BARRIER_AT_CURE) ]OTE(CELL_AUTO_READY[4]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK THAT EVERYTHING IS CLEAR BEFORE INDEXING]]>
</Comment>
<Text>
<![CDATA[XIC(PNC_PICK_CYL1_RET)XIC(PNC_PICK_CYL2_RET)XIC(PNC_PRESS_CYL_RET)OTE(PNC_CLEAR_TO_INDEX);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[STATUS OF BARRIER PICKED ON EACH SIDE OF PICK HEAD]]>
</Comment>
<Text>
<![CDATA[[XIC(PNC_SIDE_1_AT_CURE_POS) [XIC(PNC_VAC1_ON) OTE(PNC_BARRIER_ON_SIDE_1_AT_CURE) ,XIC(PNC_VAC2_ON) OTE(PNC_BARRIER_ON_SIDE_2_AT_PICK) ] ,XIC(PNC_SIDE_2_AT_CURE_POS) [XIC(PNC_VAC2_ON) OTE(PNC_BARRIER_ON_SIDE_2_AT_CURE) ,XIC(PNC_VAC1_ON) OTE(PNC_BARRIER_ON_SIDE_1_AT_PICK) ] ,[XIC(PNC_BARRIER_ON_SIDE_1_AT_CURE) ,XIC(PNC_BARRIER_ON_SIDE_2_AT_CURE) ] OTE(PNC_BARRIER_AT_CURE) ,[XIC(PNC_BARRIER_ON_SIDE_1_AT_PICK) ,XIC(PNC_BARRIER_ON_SIDE_2_AT_PICK) ] OTE(PNC_BARRIER_AT_PICK) ,[XIC(PNC_BARRIER_AT_CURE) ,XIC(PNC_BARRIER_AT_PICK) ] OTE(PNC_BARRIER_PICKED) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[BARRIER STATUS AT PRESS-N-CURE FOR GLUE REQUIREMENT]]>
</Comment>
<Text>
<![CDATA[[XIC(PNC_GOOD_BARRIER_ON_DIAL) ,XIC(PNC_VAC1_ON) XIC(PNC_VAC2_ON) ,[XIC(PNC_DATA_BAG_LOADED) [XIO(PNC_DATA_GLUE_STARTED) ,XIC(PNC_DATA_PNC_COMPLETE) ] ,XIO(PNC_DATA_BAG_LOADED) ] [XIC(PNC_VAC1_ON) ,XIC(PNC_VAC2_ON) ] ]OTE(PNC_BARRIER_READY_FOR_GLUE);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
