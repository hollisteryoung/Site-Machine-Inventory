<Tag Name="DRV01" TagType="Base" DataType="AXIS_CIP_DRIVE" ExternalAccess="Read/Write">
<Description>
<![CDATA[MAIN DIAL DRIVE]]>
</Description>
<Comments>
<Comment Operand=".MOVESTATUS">
<![CDATA[DRIVE IS MOVNG
MAIN DIAL]]>
</Comment>
<Comment Operand=".ACTUALPOSITION">
<![CDATA[CURRENT ACTUAL POSITION
MAIN DIAL]]>
</Comment>
<Comment Operand=".ACTUALVELOCITY">
<![CDATA[VELOCITY
MAIN DIAL]]>
</Comment>
<Comment Operand=".CIPAXISSTATE">
<![CDATA[CIP AXIS STATE
0 = INITIALIZING
1 = PRE-CHARGE
2 = STOPPED
3 = STARTING
4 = RUNNING
5 = TESTING
6 = STOPPING
7 = ABORTING
8 = MAJOR FAULTED
9 = START INHIBITED
10 = SHUTDOWN
MAIN DIAL DRIVE]]>
</Comment>
</Comments>
