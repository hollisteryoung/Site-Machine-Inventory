<Tag Name="VACUUM_LOCATIONS_VALUE" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[VALUE OF VACUUM ON LOCATIONS WORD
MAIN DIAL]]>
</Description>
<Data Format="L5K">
<![CDATA[2044]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="2044"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL AUTO
***************************************************************************

WAIT FOR INDEX REQUEST FROM ALL STATIONS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[1],0)[XIC(BARRIER_LOAD_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[20]) ][XIC(BAG_LOAD_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[12]) ][XIC(PREHEAT1_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[13]) ][XIC(PREHEAT2_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[14]) ][XIC(FORMING_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[15]) ][XIC(PUNCH_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[16]) ][XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) [XIC(INKJET_PRINT_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[31]) ] ,XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) ][XIC(PRINT_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[17]) ][XIC(GLUE_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[10]) ][XIC(PNC_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[4]) ][XIC(VISION_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[18]) ][XIC(BAG_OFFLOAD_INDEX_DIAL_REQ) ,XIC(MAJOR_FAULT[19]) ][[XIO(CELL_SHUTDOWN_REQ) XIO(CELL_BAG_TEST_PICK_MODE_PB) ,XIC(CELL_SHUTDOWN_REQ) XIC(GLUE_DATA_GLUE_STARTED) ] XIC(MAIN_DIAL_CLEAR_TO_INDEX) MOV(10,STEP_AUTO[1]) ,XIC(CELL_SHUTDOWN_REQ) [XIO(GLUE_DATA_GLUE_STARTED) ,XIC(GLUE_DATA_GLUE_STARTED) XIC(TIMER_OPER[14].DN) ] MOV(500,STEP_AUTO[1]) ,TON(TIMER_OPER[14],?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INDEX]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[1],10)[ONS(ONS_ARRAY[52]) OTL(MAIN_DIAL_INDEX_PB) ,XIC(NEXT_POS) MOV(12,STEP_AUTO[1]) ,[TON(TIMER_ALARM[10],?,?) ,XIC(TIMER_ALARM[10].DN) MOV(45,STEP_ALARM[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WAIT FOR INKJET PROCESS DONE IF ACTIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[1],12)[XIC(INKJET_PRINT_ACTIVE_RECIPE_LOADED) XIC(INKJET_PRINT_PROCESS_DONE) ,XIO(INKJET_PRINT_ACTIVE_RECIPE_LOADED) ]MOV(15,STEP_AUTO[1]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR POSITION MONITOR CALC COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[1],15)XIC(POS_MONITOR_CALC_COMPLETE)MOV(18,STEP_AUTO[1]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INDEX]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[1],18)[TON(TIMER_OPER[12],?,?) ,XIC(TIMER_OPER[12].DN) [OTL(MAIN_DIAL_INDEX_DONE) ,MOV(19,STEP_AUTO[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR POSITION CALCULATION COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[1],19)XIC(POS_MONITOR_CALC_COMPLETE)MOV(20,STEP_AUTO[1]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR ALL STATIONS TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[1],20)[XIC(BARRIER_LOAD_PROCESS_DONE) ,XIC(MAJOR_FAULT[20]) ][XIC(BAG_LOAD_PROCESS_DONE) ,XIC(MAJOR_FAULT[12]) ][XIC(PREHEAT1_PROCESS_DONE) ,XIC(MAJOR_FAULT[13]) ][XIC(PREHEAT2_PROCESS_DONE) ,XIC(MAJOR_FAULT[14]) ][XIC(FORMING_PROCESS_DONE) ,XIC(MAJOR_FAULT[15]) ][XIC(PUNCH_PROCESS_DONE) ,XIC(MAJOR_FAULT[16]) ][XIC(PRINT_PROCESS_DONE) ,XIC(MAJOR_FAULT[17]) ][XIC(GLUE_PROCESS_DONE) ,XIC(MAJOR_FAULT[10]) ][XIC(PNC_PROCESS_DONE) ,XIC(MAJOR_FAULT[4]) ][XIC(VISION_PROCESS_DONE) ,XIC(MAJOR_FAULT[18]) ][XIC(BAG_OFFLOAD_PROCESS_DONE) ,XIC(MAJOR_FAULT[19]) ][OTU(MAIN_DIAL_INDEX_DONE) ,[XIO(CELL_SHUTDOWN_REQ) ,XIC(CELL_SHUTDOWN_REQ) XIC(GLUE_DATA_GLUE_STARTED) ] MOV(0,STEP_AUTO[1]) ,XIC(CELL_SHUTDOWN_REQ) XIO(GLUE_DATA_GLUE_STARTED) MOV(500,STEP_AUTO[1]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[MAIN DIAL INDEX CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(0,STEP_AUTO[1],18) TON(TIMER_OPER[11],?,?) ,EQU(STEP_AUTO[1],18) ONS(ONS_ARRAY[32]) DIV(TIMER_OPER[11].ACC,1000,CELL_CYCLE_TIME[0].MAIN_DIAL) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[1],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[1]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[1],1000) EQU(STEP_ALARM_CAPTURE[1],0) MOV(STEP_ALARM[1],STEP_ALARM_CAPTURE[1]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[1],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.1) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[1],1000)[NEQ(STEP_ALARM[1],0) OTE(MAJOR_FAULT[1]) ,ONS(ONS_ARRAY[1]) [MOV(STEP_AUTO[1],STEP_AUTO_RET_ESTOP[1]) ,MOV(0,MAIN_DIAL_DATA_CLEAR_REQ_ARRAY) ] ,[OTU(MAIN_DIAL_DRV_RESET_PB) OTU(MAIN_DIAL_DRV_ENABLE_PB) OTU(MAIN_DIAL_INDEX_PB) OTU(MAIN_DIAL_INDEX_DONE) OTU(MAIN_DIAL_ABORT_INDEX_PB) ,OTU(MAIN_DIAL_DRV_HOME_PB) OTU(DRV_HOME_NOTCH_SEARCH_REQ) OTU(DRV_INTERNAL_HOME_REQ) OTU(DRV_HOME_OFF_REQ) OTU(DRV_DEFINE_HOME) OTU(MAIN_DIAL_DRV_HOMING_IND) ] ,OTU(MAIN_DIAL_INDEX_MULTI_PB) RES(MAIN_DIAL_INDEX_MULTI_COUNTER) ,MOV(0,MAIN_DIAL_REG_HOME_OFF) ,MOV(1000,STEP_HOMING[1]) MOV(1000,STEP_HOME[1]) MOV(1000,STEP_AUTO[1]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[1],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[1]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[1],10)[MOV(0,STEP_ALARM[1]) ,MOV(0,STEP_ALARM_CAPTURE[1]) ,MOV(20,STEP_ESTOP_RESET[1]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[1],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[1]) ,MOV(30,STEP_ESTOP_RESET[1]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[1]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[1],30)EQU(STEP_HOME[1],500)MOV(500,STEP_ESTOP_RESET[1]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL HMI
***************************************************************************

DRIVE INDEXING ANIMATION]]>
</Comment>
<Text>
<![CDATA[[LIM(0.1,DRV01.ActualVelocity,-0.1) XIC(MAIN_DIAL_DRV_MOVING) ,XIC(MAIN_DIAL_INDEX_PB) ]OTE(MAIN_DIAL_INDEXING_IND);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[1],500) [XIO(CELL_STARTED) XIO(MAIN_DIAL_DRV_FAULT) XIO(MAIN_DIAL_DRV_SHUTDOWN) [XIO(MAIN_DIAL_DRV_HOMING_IND) OTE(MAIN_DIAL_DRV_ENABLE_PB_VIS) ,XIC(MAIN_DIAL_CLEAR_TO_INDEX) XIC(MAIN_DIAL_DRV_READY) [OTE(MAIN_DIAL_DRV_HOME_PB_VIS) ,XIC(MAIN_DIAL_DRV_HOMED) [OTE(MAIN_DIAL_DRV_PB_VIS) ,XIC(CELL_MANUAL_MODE) OTE(MAIN_DIAL_MULTI_INDEX_PB_VIS) ] ] ] ,[XIC(MAIN_DIAL_DRV_FAULT) ,XIC(MAIN_DIAL_DRV_SHUTDOWN) ,XIC(MOTION_DRV_ENABLE_CONT.ER) ] OTE(MAIN_DIAL_DRV_FAULT_PB_VIS) ] ,[EQU(STEP_ESTOP_RESET[1],1000) XIC(CELL_MANUAL_MODE) [XIO(MAIN_DIAL_DRV_READY) ,EQU(MAIN_DIAL_BRAKE_CONT,1) ] ,EQU(STEP_ESTOP_RESET[1],500) XIC(CELL_KEY_MAN_MODE) XIO(MAIN_DIAL_DRV_READY) ] OTE(MAIN_DIAL_BRAKE_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[STATION FUNCTION VISIBILITIES BASED ON MAIN DIAL STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[1],500)XIC(CELL_MANUAL_MODE)XIC(MAIN_DIAL_DRV_HOMED)XIC(MAIN_DIAL_IN_POSITION)[XIO(CELL_STARTED) OTE(MAIN_DIAL_ACTUATION_VIS) ,XIC(CELL_KEY_AUTO_MODE) OTE(MAIN_DIAL_CYCLE_VIS) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[DRIVE POSITION FOR HMI]]>
</Comment>
<Text>
<![CDATA[MUL(DRV01.ActualPosition,100,MAIN_DIAL_CUR_POS_HMI);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL HOME ROUTINE
***************************************************************************
RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],0)[[XIC(MAIN_DIAL_DRV_FAULT) ,XIC(MAIN_DIAL_DRV_SHUTDOWN) ] OTL(MAIN_DIAL_DRV_RESET_PB) ,XIO(MAIN_DIAL_DRV_FAULT) XIO(MAIN_DIAL_DRV_SHUTDOWN) MOV(10,STEP_HOME[1]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TORQUE SAFE INPUT TO ACTIVATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],10)[XIO(MAIN_DIAL_DRV_SAFE_TRQ_OFF) MOV(20,STEP_HOME[1]) ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(43,STEP_ALARM[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],20)[OTL(MAIN_DIAL_DRV_ENABLE_PB) ,XIC(MAIN_DIAL_DRV_READY) MOV(25,STEP_HOME[1]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[VERIFY MAIN DIAL IS CLEAR TO MOVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],25)XIC(MAIN_DIAL_CLEAR_TO_INDEX)XIC(R1_HOME)[XIO(CELL_TOOL_CHANGE_REQ_PB) XIC(R2_HOME) ,XIC(CELL_TOOL_CHANGE_REQ_PB) ]XIC(R3_HOME)MOV(30,STEP_HOME[1]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF DRIVE REQUIRES HOMING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],30)[XIO(MAIN_DIAL_DRV_HOMED) MOV(35,STEP_HOME[1]) ,XIC(MAIN_DIAL_DRV_HOMED) MOV(40,STEP_HOME[1]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[START DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[1]) ,XIC(MAIN_DIAL_DRV_HOMED) MOV(100,STEP_HOME[1]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[DETERMINE IF NEED TO INDEX OR MAIN DIAL IS IN POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],40)[XIO(MAIN_DIAL_IN_POSITION) MOV(50,STEP_HOME[1]) ,XIC(MAIN_DIAL_IN_POSITION) MOV(100,STEP_HOME[1]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[PAUSE BEFORE INDEXING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],50)[TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) MOV(60,STEP_HOME[1]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[INDEX]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],60)[ONS(ONS_ARRAY[51]) OTL(MAIN_DIAL_INDEX_PB) ,XIC(NEXT_POS) XIO(MAIN_DIAL_DRV_MOVING) MOV(100,STEP_HOME[1]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CHECK FOR DIAL IN POSITION
TURN OFF ALL DIAL VACUUM DURING TOOL CHANGE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[1],100)XIC(MAIN_DIAL_IN_POSITION)[XIC(CELL_TOOL_CHANGE_REQ_PB) MOV(0,MAIN_DIAL_VAC_PB[0]) ,[MOV(1,MAIN_DIAL_BRAKE_CONT) ,OTL(DRV_BRAKE_MSG) ] ,MOV(0,STEP_AUTO[1]) ,MOV(500,STEP_HOME[1]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(AUTO,0) ,JSR(STATUS,0) ,JSR(ESTOP_RESET,0) ,JSR(HMI,0) ,JSR(HOME,0) ,JSR(SERVO_HOMING,0) ,JSR(OUTPUTS,0) ,JSR(POSITION_MONITOR,0) ,JSR(PRESSURE_REG,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL OUTPUTS
***************************************************************************

INITIATE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)XIC(DRV_INTERNAL_HOME_REQ)XIC(MAIN_DIAL_CLEAR_TO_INDEX)[MAH(DRV01,MOTION_DRV_INTERNAL_HOME_CONT) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC) XIC(MAIN_DIAL_DRV_HOMED_STATUS) OTU(DRV_INTERNAL_HOME_REQ) ,[TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(47,STEP_ALARM[1]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE MOVING DEBOUNCE TIMER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)XIC(MAIN_DIAL_DRV_MOVING)TON(TIMER_OPER[1],?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[NORMAL INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)[[XIC(MAIN_DIAL_INDEX_PB) [XIC(NEXT_POS) ,XIC(TIMER_OPER[1].DN) ] [OTU(MAIN_DIAL_INDEX_PB) ,XIC(MAIN_DIAL_DRV_READY) OTU(POS_MONITOR_CALC_COMPLETE) ] ,XIC(MAIN_DIAL_CLEAR_TO_INDEX) XIC(MAIN_DIAL_INDEX_PB) XIO(NEXT_POS) [MAM(DRV01,MOTION_DRV_INDEX_CONT,2,NEXT_CALC_POS,MAIN_DIAL_DRV_INDEX_SPEED,Units per sec,MAIN_DIAL_DRV_INDEX_ACC,Units per sec2,MAIN_DIAL_DRV_INDEX_DEC,Units per sec2,Trapezoidal,50,50,% of Maximum,Disabled,Programmed,0,None,0,0) ,[TON(TIMER_ALARM[12],?,?) ,[XIC(CELL_IS_RESETTING) XIC(TIMER_ALARM[12].DN) ,XIO(CELL_IS_RESETTING) GEQ(TIMER_ALARM[12].ACC,5000) ] MOV(37,STEP_ALARM[1]) ] ] ,XIC(MOTION_DRV_INDEX_CONT.IP) [ONS(ONS_ARRAY[3]) RES(TIMER_OPER[9]) ,RTO(TIMER_OPER[9],?,?) ] ] ,[XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_INDEX_MULTI_PB) [ONS(ONS_ARRAY[31]) RES(MAIN_DIAL_INDEX_MULTI_COUNTER) ,XIC(POS_MONITOR_CALC_COMPLETE) XIO(MAIN_DIAL_INDEX_PB) XIO(MAIN_DIAL_INDEX_MULTI_COUNTER.DN) [OTL(MAIN_DIAL_INDEX_PB) ,CTU(MAIN_DIAL_INDEX_MULTI_COUNTER,?,?) ] ] ,[XIO(CELL_MANUAL_MODE) ,XIC(MAIN_DIAL_INDEX_MULTI_COUNTER.DN) ] OTU(MAIN_DIAL_INDEX_MULTI_PB) ] ,XIO(MAIN_DIAL_CLEAR_TO_INDEX) OTU(MAIN_DIAL_INDEX_PB) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[HOMING NOTCH SEARCH CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)[XIC(MAIN_DIAL_CLEAR_TO_INDEX) XIC(DRV_HOME_NOTCH_SEARCH_REQ) [MAM(DRV01,MOTION_DRV_HOME_NOTCH_SEARCH_CONT,1,-540,30,Units per sec,10,Units per sec2,10,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,[TON(TIMER_ALARM[13],?,?) ,[XIC(CELL_IS_RESETTING) XIC(TIMER_ALARM[13].DN) ,XIO(CELL_IS_RESETTING) GEQ(TIMER_ALARM[13].ACC,5000) ] MOV(39,STEP_ALARM[1]) ] ] ,[XIO(MAIN_DIAL_CLEAR_TO_INDEX) ,XIC(DRV_HOME_NOTCH_SEARCH_REQ) XIC(TIMER_OPER[1].DN) ] OTU(DRV_HOME_NOTCH_SEARCH_REQ) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[HOMING OFFSET CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)XIC(MAIN_DIAL_CLEAR_TO_INDEX)XIC(DRV_HOME_OFF_REQ)[[MAM(DRV01,MOTION_DRV_HOME_OFF_CONT,1,MAIN_DIAL_DRV_HOME_OFF,20,Units per sec,40,Units per sec2,40,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,[XIC(MOTION_DRV_HOME_OFF_CONT.PC) ,XIO(BARRIER_ELEV_CLEAR_TO_INDEX) ] OTU(DRV_HOME_OFF_REQ) ] ,[TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) [OTU(DRV_HOME_OFF_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(41,STEP_ALARM[1]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ABORT INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)[XIC(MAIN_DIAL_ABORT_INDEX_PB) ,XIO(MAIN_DIAL_CLEAR_TO_INDEX) ][MAS(DRV01,MOTION_DRV_ABORT_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,XIC(MOTION_DRV_ABORT_CONT.PC) OTU(MAIN_DIAL_ABORT_INDEX_PB) ,XIO(MOTION_DRV_ABORT_CONT.PC) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [OTU(MAIN_DIAL_ABORT_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(48,STEP_ALARM[1]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[ZERO ENCODER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)[MOV(0,MAIN_DIAL_REG_HOME_OFF) ,XIC(DRV_DEFINE_HOME) [MRP(DRV01,MOTION_DRV_ZERO_CONT,Absolute,Command,MAIN_DIAL_REG_HOME_OFF) ,MRP(ENC31_VIRTUAL_AXIS,MOTION_ENC_ZERO_CONT,Absolute,Command,MAIN_DIAL_REG_HOME_OFF) ,LIM(359.9,DRV01.ActualPosition,0.1) [OTU(DRV_DEFINE_HOME) ,RES(INDEX_COUNT) ] ,[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) [OTU(DRV_DEFINE_HOME) ,XIC(CELL_ALARMS_ACTIVE) MOV(40,STEP_ALARM[1]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)[XIC(MAIN_DIAL_DRV_RESET_PB) [MASR(DRV01,MOTION_DRV_RESET_CONT) ,XIC(MOTION_DRV_ENABLE_CONT.ER) OTU(MOTION_DRV_ENABLE_CONT.ER) ,XIO(MAIN_DIAL_DRV_FAULT) XIO(MAIN_DIAL_DRV_SHUTDOWN) XIO(MOTION_DRV_ENABLE_CONT.ER) OTU(MAIN_DIAL_DRV_RESET_PB) ,[TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(MAIN_DIAL_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(MAIN_DIAL_DRV_FAULT) MOV(42,STEP_ALARM[1]) ,XIC(MAIN_DIAL_DRV_SHUTDOWN) MOV(51,STEP_ALARM[1]) ] ] ] ] ,[XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(10,STEP_HOME[1],499) ] [XIC(MAIN_DIAL_DRV_FAULT) MOV(42,STEP_ALARM[1]) ,XIC(MAIN_DIAL_DRV_SHUTDOWN) MOV(51,STEP_ALARM[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[1],1000)[XIC(MAIN_DIAL_DRV_ENABLE_PB) [MSO(DRV01,MOTION_DRV_ENABLE_CONT) ,[XIO(MOTION_DRV_ENABLE_CONT.DN) ,XIO(MAIN_DIAL_DRV_READY) ,XIC(MAIN_DIAL_DRV_FAULT) ,XIC(MAIN_DIAL_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) [OTU(MAIN_DIAL_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(49,STEP_ALARM[1]) ] ] ] ,XIO(MAIN_DIAL_DRV_ENABLE_PB) [MSF(DRV01,MOTION_DRV_DISABLE_CONT) ,XIC(CELL_ALARMS_ACTIVE) XIO(MOTION_DRV_DISABLE_CONT.DN) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) MOV(50,STEP_ALARM[1]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[TRACK AND CONTROL THE VACUUM AROUND THE TABLE AS IT ROTATES FROM THE HMI
**************************************************************************************************************************

PHYSICAL POSITION 1 CORRESPONDS TO BARRIER LOAD POSITION
WITH DIAL HOMED

DIAL TABLE POSITION#1 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[CPT(POSITION_INDEX_CONTROL,MAIN_DIAL_VAC_TRACK_CNT.ACC) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_1) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_1) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_1]) OTE(MAN02:O.Data[5].0) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#2 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,1,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_2) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_2) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_2]) OTE(MAN02:O.Data[5].1) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#3 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,2,POSITION_INDEX_CONTROL) CPT(POSITION_INDEX_CONTROL,2+MAIN_DIAL_VAC_TRACK_CNT.ACC) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_3) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_3) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_3]) OTE(MAN02:O.Data[5].2) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#4 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,3,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_4) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_4) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_4]) OTE(MAN02:O.Data[5].3) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#5 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,4,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_5) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_5) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_5]) OTE(MAN02:O.Data[5].4) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#6 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,5,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_6) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_6) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_6]) OTE(MAN02:O.Data[5].5) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#7 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,6,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_7) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_7) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_7]) OTE(MAN02:O.Data[5].6) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#8 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,7,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_8) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_8) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_8]) OTE(MAN02:O.Data[5].7) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#9 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,8,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_9) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_9) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_9]) OTE(MAN02:O.Data[5].8) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#10 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,9,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_10) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_10) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_10]) OTE(MAN02:O.Data[5].9) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#11 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,10,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_11) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_11) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_11]) OTE(MAN02:O.Data[5].10) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[DIAL TABLE POSITION#12 VACUUM CONTROL
]]>
</Comment>
<Text>
<![CDATA[[ADD(MAIN_DIAL_VAC_TRACK_CNT.ACC,11,POSITION_INDEX_CONTROL) ,[LEQ(POSITION_INDEX_CONTROL,12) MOV(POSITION_INDEX_CONTROL,POSITION_INDEX_12) ,GRT(POSITION_INDEX_CONTROL,12) SUB(POSITION_INDEX_CONTROL,12,POSITION_INDEX_12) ] ,XIC(MAIN_DIAL_VAC_PB[0].[POSITION_INDEX_12]) OTE(MAN02:O.Data[5].11) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[ALL VACUUM CONTROL BUTTON FROM HMI
]]>
</Comment>
<Text>
<![CDATA[[[XIC(MAIN_DIAL_VAC_ALL_PB) ONS(ONS_ARRAY[27]) MOV(8191,MAIN_DIAL_VAC_PB[0]) ,[XIO(MAIN_DIAL_VAC_ALL_PB) ONS(ONS_ARRAY[28]) ,XIC(MAIN_DIAL_HOMING_COMPLETED) ONS(ONS_ARRAY[30]) ] MOV(0,MAIN_DIAL_VAC_PB[0]) ] ,MVM(MAIN_DIAL_VAC_PB[0],8190,VACUUM_LOCATIONS_VALUE) ,EQU(VACUUM_LOCATIONS_VALUE,8190) ONS(ONS_ARRAY[53]) OTL(MAIN_DIAL_VAC_ALL_PB) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[ACTIVATE BRAKE UPON LEAVING MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)XIO(DRV_BRAKE_FLIP_FLOP)ONS(ONS_ARRAY[8])OTL(MAIN_DIAL_BRAKE_PB);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[MAIN DIAL BRAKE FLIP FLOP CIRCUIT - ALLOWS ONE MOMENTARY PUSH BUTTON TO ACTIVATE AND DEACTIVE BRAKE]]>
</Comment>
<Text>
<![CDATA[XIC(MAIN_DIAL_BRAKE_PB)ONS(ONS_ARRAY[10])[MOV(1,MAIN_DIAL_BRAKE_CONT) ,XIC(DRV_BRAKE_FLIP_FLOP) MOV(0,MAIN_DIAL_BRAKE_CONT) ,EQU(MAIN_DIAL_BRAKE_CONT,1) OTL(DRV_BRAKE_FLIP_FLOP) ,NEQ(MAIN_DIAL_BRAKE_CONT,1) OTU(DRV_BRAKE_FLIP_FLOP) ,[OTU(MAIN_DIAL_BRAKE_PB) ,OTL(DRV_BRAKE_MSG) ] ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[FLIP FLOP BRAKE CONTROL
THROUGH THE SET SYSTEM VARIABLE
]]>
</Comment>
<Text>
<![CDATA[XIC(DRV_BRAKE_MSG)XIO(MAIN_DIAL_DRV_MOVING)SSV(Axis,DRV01,MechanicalBrakeControl,MAIN_DIAL_BRAKE_CONT);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR MAIN DIAL
***************************************************************************

DETERMINE IF DIAL IS IN POSITION BY
1. DIAL HAS REACHED IT'S TARGET
2. DIAL HAS BEEN HOMED AND IS NOW AT ZERO
3. THE DIAL HASN'T LEFT IT'S LAST TARGET POSITION
]]>
</Comment>
<Text>
<![CDATA[[XIC(MAIN_DIAL_DRV_HOMED) [[EQU(NEXT_CALC_POS,0) LIM(359.9,DRV01.ActualPosition,0.1) ,NEQ(NEXT_CALC_POS,0) CMP(NEXT_CALC_POS+0.1>DRV01.ActualPosition) CMP(NEXT_CALC_POS-0.1<DRV01.ActualPosition) ] OTE(NEXT_POS) ,LIM(359.9,DRV01.ActualPosition,0.1) OTE(HOME_POS) ,[EQU(LAST_KNOWN_POS,0) LIM(359.9,DRV01.ActualPosition,0.1) ,NEQ(LAST_KNOWN_POS,0) CMP(LAST_KNOWN_POS+0.1>DRV01.ActualPosition) CMP(LAST_KNOWN_POS-0.1<DRV01.ActualPosition) ] OTE(LAST_POS) ] OTE(MAIN_DIAL_IN_POSITION) ,[XIC(CELL_STARTED) XIC(POS_MONITOR_CALC_COMPLETE) ,EQU(STEP_HOME[1],100) ] XIO(MAIN_DIAL_IN_POSITION) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [OTL(DRV_HOMING_REQ) ,MOV(38,STEP_ALARM[1]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INITIATE POSITION UPDATE AND PART DATA TRANSFER]]>
</Comment>
<Text>
<![CDATA[[XIO(MAIN_DIAL_DRV_HOMING_IND) XIC(MAIN_DIAL_DRV_MOVING) OTU(POS_MONITOR_CALC_COMPLETE) ,EQU(STEP_ESTOP_RESET[1],500) [XIC(CELL_STARTED) EQU(STEP_AUTO[1],15) ,XIO(CELL_STARTED) ] XIO(POS_MONITOR_CALC_COMPLETE) XIO(MAIN_DIAL_DRV_MOVING) XIC(MAIN_DIAL_DRV_READY) XIO(MAIN_DIAL_DRV_FAULT) XIC(MAIN_DIAL_DRV_HOMED) XIC(MAIN_DIAL_IN_POSITION) [TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) ONS(ONS_ARRAY[2]) MOV(0,STEP_POS_MONITOR[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IF PRESENT POSITION IS AT FULL TURN OF DIAL
RESET THE POSITION OFFSET TRACKING COUNTER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[1],0)[XIC(MAIN_DIAL_VAC_TRACK_CNT.DN) RES(MAIN_DIAL_VAC_TRACK_CNT) ,MOV(10,STEP_POS_MONITOR[1]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[INCREMENT DIAL TRACKING COUNTER AND VACUUM CONTROL VALUES]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[1],10)[XIO(MAIN_DIAL_VAC_TRACK_CNT.DN) CTU(MAIN_DIAL_VAC_TRACK_CNT,?,?) ,[XIC(MAIN_DIAL_VAC_PB[0].12) OTL(MAIN_DIAL_VAC_PB[0].0) ,XIO(MAIN_DIAL_VAC_PB[0].12) OTU(MAIN_DIAL_VAC_PB[0].0) ,BSL(MAIN_DIAL_VAC_PB[0],MAIN_DIAL_VAC_PB_ARRAY_CONTROL,MAIN_DIAL_VAC_PB_ARRAY_SOURCE,?) ] ,MOV(20,STEP_POS_MONITOR[1]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[DETERMINE CURRENT POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[1],20)[XIC(HOME_POS) MOV(0.0,LAST_KNOWN_POS) ,XIO(HOME_POS) XIO(LAST_POS) MOV(NEXT_CALC_POS,LAST_KNOWN_POS) ,MOV(40,STEP_POS_MONITOR[1]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[DEFINE NEXT POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[1],40)[CPT(NEXT_CALC_POS,LAST_KNOWN_POS+(360/NUM_OF_STATION)) ,CTU(INDEX_COUNT,?,?) ,MOV(50,STEP_POS_MONITOR[1]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[SETUP INDEX
FOR NEXT POSITION

SET SPECIAL PARAMETERS FOR REGISTRATION INDEX
]]>
</Comment>
<Text>
<![CDATA[LIM(50,STEP_POS_MONITOR[1],60)[[MOV(MAIN_DIAL_DRV_ACC_PB,MAIN_DIAL_DRV_INDEX_ACC) ,MOV(MAIN_DIAL_DRV_DEC_PB,MAIN_DIAL_DRV_INDEX_DEC) ] ,MOV(60,STEP_POS_MONITOR[1]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[TRANSFER PART DATA]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[1],60)[XIO(DATA_XFER_BYPASS) ONS(ONS_ARRAY[33]) OTE(MAIN_DIAL_SHIFT_DATA) ,OTU(DATA_XFER_BYPASS) ,OTL(POS_MONITOR_CALC_COMPLETE) ,MOV(500,STEP_POS_MONITOR[1]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[MONITOR POSITION CALC ROUTINE FOR HANGUP]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_POS_MONITOR[1],500)[TON(TIMER_ALARM[14],?,?) ,XIC(TIMER_ALARM[14].DN) [MOV(36,STEP_ALARM[1]) ,MOV(STEP_POS_MONITOR[1],POSITION_MONITOR_RET_STEP) ,OTL(DRV_HOMING_REQ) ,MOV(500,STEP_POS_MONITOR[1]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PRESSURE_REG" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL VACUUM SUPPLY PRESSURE REGULATOR
*******************************************************************************

ADD OPERATOR ADJUSTMENT TO PRESSURE SETPOINT]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[LIM(MAIN_DIAL_VAC_PRESSURE_MAX,PRESSURE_SP_AUTO,MAIN_DIAL_VAC_PRESSURE_MIN) MOV(0,MAIN_DIAL_VAC_ADJ_PRESSURE) ,ADD(MAIN_DIAL_VAC_PRESSURE_RECIPE_SP,MAIN_DIAL_VAC_ADJ_PRESSURE,PRESSURE_SP_AUTO) ,ADD(MAIN_DIAL_VAC_PRESSURE_RECIPE_SP,MAIN_DIAL_VAC_ADJ_PRESSURE,MAIN_DIAL_VAC_PRESSURE_SP_AUTO_DISPLAY) ,MOV(PRESSURE_SP_AUTO,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CACULATE OPERATERS MAXIMUM  & MINIMUM ALLOWABLE SETPOINT ADJUSTMENT BASED ON RECIPE PRESSURE
]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[[SUB(MAIN_DIAL_VAC_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,MAIN_DIAL_VAC_PRESSURE_MIN) ,LES(MAIN_DIAL_VAC_PRESSURE_MIN,PRESSURE_MIN_ALLOWED) MOV(PRESSURE_MIN_ALLOWED,MAIN_DIAL_VAC_PRESSURE_MIN) ] ,[ADD(MAIN_DIAL_VAC_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,MAIN_DIAL_VAC_PRESSURE_MAX) ,GRT(MAIN_DIAL_VAC_PRESSURE_MAX,PRESSURE_MAX_ALLOWED) MOV(PRESSURE_MAX_ALLOWED,MAIN_DIAL_VAC_PRESSURE_MAX) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IF RECIPE VALUE CHANGES ZERO OUT OFFSET ADJUST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)MOV(0,MAIN_DIAL_VAC_ADJ_PRESSURE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****MANUAL MODE****

SET PRESSURE SETPOINT FOR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)ONS(ONS_ARRAY[5])MOV(PRESSURE_SP_AUTO,MAIN_DIAL_VAC_PRESSURE_SP_MAN_DISPLAY);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WHILE IN MANUAL MODE, ALLOW THE PRESSURE SLIDERS FULL SCALE OF OPERATION.]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[MUL(MAIN_DIAL_VAC_PRESSURE_SP_MAN_DISPLAY,1,PRESSURE_SP_MAN) ,MOV(PRESSURE_MIN_ALLOWED,MAIN_DIAL_VAC_PRESSURE_MIN) ,MOV(PRESSURE_MAX_ALLOWED,MAIN_DIAL_VAC_PRESSURE_MAX) ,MOV(PRESSURE_SP_MAN,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SEND REGULATOR PRESSURE INPUT COUNTS

SCALE, TRUNCATE AND BYTE SWAP]]>
</Comment>
<Text>
<![CDATA[[MUL(PRESSURE_SP_GEN,MAIN_DIAL_VAC_PRES_SCALE_PAR.OUT_M,PRESSURE_WITH_M_DONE) ,ADD(PRESSURE_WITH_M_DONE,MAIN_DIAL_VAC_PRES_SCALE_PAR.OUT_B,SCALED_PRESSURE) ,TRN(SCALED_PRESSURE,MAN02:O.Data[2]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CACULATE FEEDBACK PRESSURE FROM REGULATOR]]>
</Comment>
<Text>
<![CDATA[[MOV(MAN02:I.Data[2],REG_FEEDBACK) ,SUB(REG_FEEDBACK,MAIN_DIAL_VAC_PRES_SCALE_PAR.IN_B,REG_FEEDBACK_M) ,DIV(REG_FEEDBACK_M,MAIN_DIAL_VAC_PRES_SCALE_PAR.IN_M,REG_FEEDBACK_SCALED) CPT(REG_FEEDBACK_SCALED,REG_FEEDBACK_M/MAIN_DIAL_VAC_PRES_SCALE_PAR.IN_M) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[VERIFY FORM PRESSURE USING REGULATOR FEEDBACK]]>
</Comment>
<Text>
<![CDATA[CMP(MAIN_DIAL_VAC_PRESSURE_SP_AUTO_DISPLAY-PRESSURE_DELTA_ALLOWED<REG_FEEDBACK_SCALED)OTE(MAIN_DIAL_VAC_PRESSURE_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL DRIVE HOMING ROUTINE
***************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN
]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(MAIN_DIAL_DRV_HOME_PB)XIO(DRV_HOMING_REQ)XIO(MAIN_DIAL_DRV_HOMING_IND)XIC(MAIN_DIAL_DRV_HOMED_STATUS)OTE(MAIN_DIAL_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[1],0) ,XIC(MAIN_DIAL_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[1],500) [EQU(STEP_HOMING[1],500) ,EQU(STEP_HOMING[1],1000) ] ][OTL(MAIN_DIAL_DRV_HOMING_IND) ,OTL(DATA_XFER_BYPASS) ,MOV(10,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[START HOME NOTCH SEARCH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],10)[ONS(ONS_ARRAY[11]) OTL(DRV_HOME_NOTCH_SEARCH_REQ) ,XIC(TIMER_OPER[1].DN) XIO(DRV_HOME_NOTCH_SEARCH_REQ) MOV(20,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WAIT FOR MINIMUM TIME AND HOME SENSOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],20)[TON(TIMER_OPER[10],?,?) ,XIC(TIMER_OPER[10].DN) XIC(MAIN_DIAL_HOME_SENSOR) MOV(30,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR TO DETECT HOME NOTCH AND ISSUE ABORT COMMAND]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],30)[[XIO(MAIN_DIAL_HOME_SENSOR) ,XIC(TIMER_OPER[0].TT) ,XIC(TIMER_OPER[0].DN) ] TON(TIMER_OPER[0],?,?) ,XIC(TIMER_OPER[0].DN) [OTL(MAIN_DIAL_ABORT_INDEX_PB) ,MOV(40,STEP_HOMING[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[PAUSE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],40)XIO(MAIN_DIAL_ABORT_INDEX_PB)[TON(TIMER_OPER[4],?,?) ,XIC(TIMER_OPER[4].DN) MOV(50,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],50)[XIC(MAIN_DIAL_CLEAR_TO_INDEX) ONS(ONS_ARRAY[12]) OTL(DRV_INTERNAL_HOME_REQ) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.IP) MOV(55,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],55)XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC)XIC(MAIN_DIAL_DRV_HOMED_STATUS)XIC(DRV_INTERNAL_HOME_REQ)MOV(70,STEP_HOMING[1]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[VERIFY HOMED STATUS AND PAUSE BEFORE INITIATING THE NEXT MOVE
IF FAULTED END ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],70)[XIC(MAIN_DIAL_DRV_HOMED_STATUS) [TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) MOV(80,STEP_HOMING[1]) ] ,XIC(MAIN_DIAL_DRV_FAULT) MOV(100,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[REQUEST INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],80)[XIC(MAIN_DIAL_CLEAR_TO_INDEX) ONS(ONS_ARRAY[50]) OTL(DRV_HOME_OFF_REQ) ,XIC(MOTION_DRV_HOME_OFF_CONT.IP) MOV(85,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[COMPLETE INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],85)XIC(MOTION_DRV_HOME_OFF_CONT.PC)XIC(MAIN_DIAL_DRV_HOMED_STATUS)XIO(DRV_HOME_OFF_REQ)MOV(90,STEP_HOMING[1]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[SET COUNTER TO ZERO]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],90)[ONS(ONS_ARRAY[9]) OTL(DRV_DEFINE_HOME) ,XIO(DRV_DEFINE_HOME) MOV(100,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[1],100)[OTU(MAIN_DIAL_DRV_HOMING_IND) OTU(MAIN_DIAL_DRV_HOME_PB) ,XIO(MAIN_DIAL_DRV_FAULT) OTU(DRV_HOMING_REQ) ,OTU(POS_MONITOR_CALC_COMPLETE) ,RES(MAIN_DIAL_VAC_TRACK_CNT) ,MOV(110,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[COMPLETE ROUTINE
]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[1],110) ,XIC(CELL_RECIPE_LOAD_COMPLETE) ]XIC(POS_MONITOR_CALC_COMPLETE)[ONS(ONS_ARRAY[29]) OTE(MAIN_DIAL_HOMING_COMPLETED) ,MOV(500,STEP_HOMING[1]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN DIAL STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(MAIN_DIAL_DRV_HOMED)XIC(MAIN_DIAL_DRV_READY)XIO(MAIN_DIAL_DRV_FAULT)XIC(MAIN_DIAL_IN_POSITION)XIC(POS_MONITOR_CALC_COMPLETE)OTE(CELL_AUTO_READY[1]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK THAT EVERYTING IS CLEAR BEFORE INDEXING]]>
</Comment>
<Text>
<![CDATA[XIC(R1_CLEAR_MAIN_DIAL)XIC(BAG_LOAD_REL_CYL_RET)XIO(BAG_LOAD_REL_CYL_EXT)XIC(PREHEAT1_UP_CYL_RET)XIO(PREHEAT1_UP_CYL_EXT)XIC(PREHEAT1_LOW_CYL_RET)XIO(PREHEAT1_LOW_CYL_EXT)XIC(PREHEAT2_UP_CYL_RET)XIO(PREHEAT2_UP_CYL_EXT)XIC(PREHEAT2_LOW_CYL_RET)XIO(PREHEAT2_LOW_CYL_EXT)XIC(FORMING_UP_CYL_RET)XIO(FORMING_UP_CYL_EXT)XIC(FORMING_LOW_CYL_RET)XIC(PUNCH_CYL_RET)XIO(PUNCH_CYL_EXT)XIC(PUNCH_STRIP1_CYL_RET)XIO(PUNCH_STRIP1_CYL_EXT)XIC(PUNCH_STRIP2_CYL_RET)XIO(PUNCH_STRIP2_CYL_EXT)XIC(PUNCH_MOON_CYL_RET)XIO(PUNCH_MOON_CYL_EXT)XIC(PUNCH_SPRING_PACK_CYL_EXT)XIO(PUNCH_SPRING_PACK_CYL_RET)XIC(INKJET_PRINT_DRV_CLEAR_MAIN_DIAL)XIC(PRINT_SUP_CYL_RET)XIO(PRINT_SUP_CYL_EXT)XIC(PRINT_BAR_HOLD_DOWN_CYL_RET)XIO(PRINT_BAR_HOLD_DOWN_CYL_EXT)[XIC(PRINT_INK_POS) ,XIO(PRINT_INK_POS) XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET) [XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ] ]XIC(GLUE_Z_CYL_RET)XIO(GLUE_Z_CYL_EXT)XIC(PNC_PICK_CYL1_RET)XIO(PNC_PICK_CYL1_EXT)XIC(PNC_PICK_CYL2_RET)XIO(PNC_PICK_CYL2_EXT)XIC(PNC_PRESS_CYL_RET)XIO(PNC_PRESS_CYL_EXT)XIC(PNC_SUP_CYL_RET)XIO(PNC_SUP_CYL_EXT)XIC(BAG_OFFLOAD_REL_CYL_RET)XIO(BAG_OFFLOAD_REL_CYL_EXT)XIC(R2_CLEAR_MAIN_DIAL)XIC(R3_CLEAR_MAIN_DIAL)OTE(MAIN_DIAL_CLEAR_TO_INDEX);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[MAIN DIAL DOES NOT HAVE ANY PARTS]]>
</Comment>
<Text>
<![CDATA[XIO(BARRIER_LOAD_DATA_BAR_LOADED)XIO(BARRIER_LOAD_BARRIER_PRESENT)XIO(BARRIER_LOAD_DATA_BAG_LOADED)XIO(EMPTY_DATA_BAR_LOADED)XIO(EMPTY_DATA_BAG_LOADED)XIO(BAG_LOAD_DATA_BAR_LOADED)XIO(BAG_LOAD_DATA_BAG_LOADED)XIO(BAG_LOAD_BAG_PRESENT)[XIC(BAG_TOP_ACTIVE_RECIPE) XIC(BAG_LOAD_BAG_TOP_PRESENT) ,XIO(BAG_TOP_ACTIVE_RECIPE) ]XIO(PREHEAT1_DATA_BAR_LOADED)XIO(PREHEAT1_DATA_BAG_LOADED)XIO(PREHEAT2_DATA_BAR_LOADED)XIO(PREHEAT2_DATA_BAG_LOADED)XIO(FORMING_DATA_BAR_LOADED)XIO(FORMING_DATA_BAG_LOADED)XIO(PUNCH_DATA_BAR_LOADED)XIO(PUNCH_DATA_BAG_LOADED)XIO(PRINT_DATA_BAR_LOADED)XIO(PRINT_DATA_BAG_LOADED)XIO(GLUE_DATA_BAR_LOADED)XIO(GLUE_DATA_BAG_LOADED)XIO(PNC_DATA_BAR_LOADED)XIO(PNC_DATA_BAG_LOADED)XIO(VISION_DATA_BAR_LOADED)XIO(VISION_DATA_BAG_LOADED)XIO(BAG_OFFLOAD_DATA_BAR_LOADED)XIO(BAG_OFFLOAD_DATA_BAG_LOADED)XIC(MAIN_DIAL_IN_POSITION)OTE(MAIN_DIAL_EMPTY);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[LOAD DEFAULT DRIVE PARAMETERS AFTER RECIPE DOWNLOAD]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)ONS(ONS_ARRAY[49])[MOV(DRV_DEFAULT_ACC,MAIN_DIAL_DRV_ACC_PB) ,MOV(DRV_DEFAULT_DEC,MAIN_DIAL_DRV_DEC_PB) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MONITOR OPEN AIR GLUE TIME FOR ALL STATIONS ON MAIN DIAL
********************************************************************************************

BARRIER LOAD STATION]]>
</Comment>
<Text>
<![CDATA[XIC(BARRIER_LOAD_DATA_GLUE_COMPLETE)XIO(BARRIER_LOAD_DATA_BAG_REJECT)XIO(BARRIER_LOAD_DATA_PNC_STARTED)OTL(BARRIER_LOAD_DATA_GLUE_OPEN_REJECT);]]>
