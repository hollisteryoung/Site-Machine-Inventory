<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD STATION AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[12]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],0)XIC(CELL_STARTED)[XIO(RUN_PROCESS) [XIO(CELL_DRY_CYCLE_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) [XIO(BAG_LOAD_BAG_PRESENT) ,AFI() XIO(BAG_TAIL_PRESENT) ,XIC(BAG_TOP_ACTIVE_RECIPE) XIC(BAG_LOAD_BAG_TOP_PRESENT) ] XIC(BAG_LOAD_DATA_BAG_LOADED) [OTU(BAG_LOAD_DATA_BAG_LOADED) ,MOV(203,STEP_ALARM[12]) ] ,XIO(CELL_DRY_CYCLE_MODE_PB) [XIC(BAG_LOAD_BAG_PRESENT) ,AFI() XIC(BAG_TAIL_PRESENT) ,XIC(BAG_TOP_ACTIVE_RECIPE) XIO(BAG_LOAD_BAG_TOP_PRESENT) ] XIO(BAG_LOAD_DATA_BAG_LOADED) MOV(204,STEP_ALARM[12]) ,MOV(5,STEP_AUTO[12]) ] ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[12]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CHECK BAG CLAMPS DOWN SENSORS
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],5)[XIC(BAG_LOAD_BAG_CLAMP_PRESENT1) XIC(BAG_LOAD_BAG_CLAMP_PRESENT2) MOV(7,STEP_AUTO[12]) ,XIO(CELL_SHUTDOWN_REQ) [XIO(BAG_LOAD_BAG_CLAMP_PRESENT1) ,XIO(BAG_LOAD_BAG_CLAMP_PRESENT2) ] [TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) MOV(205,STEP_ALARM[12]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],7)[OTE(BAG_LOAD_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[12]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA
CHECK EMPTY REQUEST]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_EMPTY_COMPLETE.4) XIO(CELL_SHUTDOWN_REQ) [XIO(BARRIER_LOAD_DATA_BAR_LOADED) ,XIC(BARRIER_LOAD_DATA_BAR_REJECT) ] XIO(BARRIER_LOAD_DATA_BAG_LOADED) [XIO(EMPTY_DATA_BAR_LOADED) ,XIC(EMPTY_DATA_BAR_REJECT) ] XIO(EMPTY_DATA_BAG_LOADED) [XIO(BAG_LOAD_DATA_BAR_LOADED) ,XIC(BAG_LOAD_DATA_BAR_REJECT) ] XIO(BAG_LOAD_DATA_BAG_LOADED) OTL(CELL_EMPTY_LAST_BAG_REQUESTED) ,XIO(CELL_BAG_TEST_PICK_MODE_PB) XIO(CELL_EMPTY_COMPLETE.5) XIO(CELL_SHUTDOWN_REQ) [XIC(BAG_LOAD_DATA_BAR_LOADED) XIO(BAG_LOAD_DATA_BAR_REJECT) ,XIC(CELL_EMPTY_LAST_BAG_REQUESTED) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ] XIO(BAG_LOAD_BAG_PRESENT) XIO(BAG_LOAD_DATA_BAG_LOADED) OTE(RUN_PROCESS) ] ,EQU(STEP_AUTO[12],10) [XIC(RUN_PROCESS) [CTU(BAG_LOAD_BARRIER_COUNTER,?,?) ,MOV(20,STEP_AUTO[12]) ] ,XIO(RUN_PROCESS) [XIO(CELL_DRY_CYCLE_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) [XIO(BAG_LOAD_BAG_PRESENT) ,XIC(BAG_TOP_ACTIVE_RECIPE) XIC(BAG_LOAD_BAG_TOP_PRESENT) ] XIC(BAG_LOAD_DATA_BAG_LOADED) [OTU(BAG_LOAD_DATA_BAG_LOADED) ,MOV(203,STEP_ALARM[12]) ] ,XIO(CELL_DRY_CYCLE_MODE_PB) XIC(BAG_LOAD_BAG_PRESENT) [XIC(BAG_TOP_ACTIVE_RECIPE) XIO(BAG_LOAD_BAG_TOP_PRESENT) ,XIO(BAG_TOP_ACTIVE_RECIPE) ] XIO(BAG_LOAD_DATA_BAG_LOADED) MOV(204,STEP_ALARM[12]) ,MOV(150,STEP_AUTO[12]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[EXTEND BAG RELEASE CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],20)[OTL(BAG_LOAD_REL_CYL_EXT_PB) ,XIC(BAG_LOAD_REL_CYL_EXT) MOV(25,STEP_AUTO[12]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR ROBOT TO BE READY TO PLACE BAG
OR GLUE TIMERS FROM OTHER STATIONS TO RUN OUT
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],25)[[XIO(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIC(CELL_SINGLE_PART_PROCESS_PB) [XIC(PNC_BARRIER_PICKED) EQU(BAG_LOAD_BARRIER_COUNTER.ACC,1) ,XIO(PNC_BARRIER_PICKED) EQU(BAG_LOAD_BARRIER_COUNTER.ACC,2) ] ] XIC(R1:I.Data[0].22) MOV(30,STEP_AUTO[12]) ,[XIC(CELL_CYCLE_TIMEOUT_INDEX_REQ) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIC(CELL_SINGLE_PART_PROCESS_PB) XIO(PNC_BARRIER_PICKED) NEQ(BAG_LOAD_BARRIER_COUNTER.ACC,2) ] [OTU(BAG_LOAD_REL_CYL_EXT_PB) ,MOV(150,STEP_AUTO[12]) ] ,XIC(CELL_SHUTDOWN_REQ) [TON(TIMER_OPER[0],?,?) ,XIC(TIMER_OPER[0].DN) MOV(150,STEP_AUTO[12]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[REQUEST BAG LOAD
WAIT FOR ROBOT REQUEST TO CLAMP BAG
IF CELL EMPTY IN PROGRESS REQUEST ROBOT SHUTDOWN]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],30)[OTE(BAG_LOAD_REQ) ,XIC(R1:I.Data[1].8) MOV(35,STEP_AUTO[12]) ,XIC(CELL_SHUTDOWN_REQ) [TON(TIMER_OPER[1],?,?) ,XIC(TIMER_OPER[1].DN) [OTU(BAG_LOAD_REL_CYL_EXT_PB) ,MOV(150,STEP_AUTO[12]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[RETRACT BAG RELEASE CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],35)[OTU(BAG_LOAD_REL_CYL_EXT_PB) ,XIC(BAG_LOAD_REL_CYL_RET) MOV(38,STEP_AUTO[12]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[WAIT FOR ROBOT TO PLACE BAG
IF IN SINGLE PART MODE, INDEX COUNTER
IF CELL EMPTY IN PROGRESS REQUEST ROBOT SHUTDOWN]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],38)XIC(R1:I.Data[0].23)[[XIC(BAG_LOAD_BAG_PRESENT) [XIC(BAG_TAIL_PRESENT) ,] [XIC(BAG_TOP_ACTIVE_RECIPE) XIO(BAG_LOAD_BAG_TOP_PRESENT) ,XIO(BAG_TOP_ACTIVE_RECIPE) ] ,XIC(CELL_INSERT_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] [XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) OTL(BAG_LOAD_DATA_BAG_LOADED) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIC(CELL_SINGLE_PART_PROCESS_PB) CTU(CELL_SINGLE_PART_MODE_BAG_COUNTER,?,?) ,XIC(CELL_EMPTY_LAST_BAG_REQUESTED) [OTL(BAG_LOAD_DATA_EMPTY_LAST_BAG) ,OTL(CELL_EMPTY_COMPLETE.5) ,OTL(R1:O.Data[0].24) ] ,MOV(150,STEP_AUTO[12]) ] ,XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_INSERT_LOAD_ONLY_MODE_PB) XIO(CELL_DRY_CYCLE_MODE_PB) [XIO(BAG_LOAD_BAG_PRESENT) ,AFI() XIO(BAG_TAIL_PRESENT) ,XIC(BAG_TOP_ACTIVE_RECIPE) XIC(BAG_LOAD_BAG_TOP_PRESENT) ] MOV(202,STEP_ALARM[12]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],150)[OTL(BAG_LOAD_PROCESS_DONE) ,TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) MOV(160,STEP_AUTO[12]) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[12],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(BAG_LOAD_PROCESS_DONE) ,MOV(5,STEP_AUTO[12]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(20,STEP_AUTO[12],150) TON(TIMER_OPER[2],?,?) ,EQU(STEP_AUTO[12],150) ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[2].ACC,1000,CELL_CYCLE_TIME[0].BAG_LOAD) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[12],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].BAG_LOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(3,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].BAG_LOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].BAG_LOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].BAG_LOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(3,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].BAG_LOAD,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD STATION E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[12],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[12]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[12],1000) EQU(STEP_ALARM_CAPTURE[12],0) MOV(STEP_ALARM[12],STEP_ALARM_CAPTURE[12]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[12],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.12) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[12],1000)[TON(TIMER_OPER[4],?,?) ,NEQ(STEP_ALARM[12],0) OTE(MAJOR_FAULT[12]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[12],STEP_AUTO_RET_ESTOP[12]) ,OTU(BAG_LOAD_REL_CYL_EXT_PB) ,OTU(BAG_LOAD_PROCESS_DONE) ,MOV(1000,STEP_HOME[12]) ,MOV(1000,STEP_AUTO[12]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[12],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[12]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[12],10)[MOV(0,STEP_ALARM[12]) ,MOV(0,STEP_ALARM_CAPTURE[12]) ,MOV(20,STEP_ESTOP_RESET[12]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[12],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[12]) ,MOV(30,STEP_ESTOP_RESET[12]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[12]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[12],30)EQU(STEP_HOME[12],500)MOV(500,STEP_ESTOP_RESET[12]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD STATION HOME ROUTINE
***************************************************************************


SET COMPONENTS TO HOME STATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[12],0)[OTU(BAG_LOAD_REL_CYL_EXT_PB) ,XIC(BAG_LOAD_REL_CYL_RET) [MOV(0,STEP_AUTO[12]) ,MOV(500,STEP_HOME[12]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD STATION OUTPUTS
***************************************************************************

BAG RELEASE CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[12],1000) XIC(CELL_PRESSURE_OK) ,XIO(TIMER_OPER[4].DN) ][XIC(BAG_LOAD_REL_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN01:O.Data[3].0) ,XIC(CELL_ALARMS_ACTIVE) XIO(BAG_LOAD_REL_CYL_EXT) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(200,STEP_ALARM[12]) ] ] ,[XIO(MAIN_DIAL_IN_POSITION) ,XIC(CELL_SHUTDOWN_REQ) EQU(STEP_AUTO[21],500) XIC(R1_CLEAR_MAIN_DIAL) ] OTU(BAG_LOAD_REL_CYL_EXT_PB) ] ,XIO(BAG_LOAD_REL_CYL_EXT_PB) [OTE(MAN01:O.Data[3].1) ,XIC(CELL_ALARMS_ACTIVE) XIO(BAG_LOAD_REL_CYL_RET) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) MOV(201,STEP_ALARM[12]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD STATION STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[12],500)XIC(BAG_LOAD_REL_CYL_RET)OTE(CELL_AUTO_READY[12]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
