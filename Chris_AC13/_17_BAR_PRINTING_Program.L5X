<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRINTING STATION AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[17]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],0)[XIC(CELL_STARTED) [XIO(RUN_PROCESS) [XIC(PRINT_ACTIVE_RECIPE_LOADED) [XIO(PRINT_BAR_PRESENT) XIC(PRINT_DATA_BAR_LOADED) [OTU(PRINT_DATA_BAR_LOADED) ,MOV(553,STEP_ALARM[17]) ] ,XIO(CELL_DRY_CYCLE_MODE_PB) XIC(PRINT_BAR_PRESENT) XIO(PRINT_DATA_BAR_LOADED) MOV(554,STEP_ALARM[17]) ] ,MOV(5,STEP_AUTO[17]) ] ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[17]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(PRINT_CYCLE_PB) MOV(20,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],5)[OTE(PRINT_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIO(CELL_EMPTY_COMPLETE.10) XIO(CELL_BAG_LOAD_ONLY_MODE_PB) XIO(CELL_BAG_TEST_PICK_MODE_PB) XIC(PRINT_DATA_BAR_LOADED) XIO(PRINT_DATA_BAR_REJECT) [XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIC(PRINT_DATA_BAG_LOADED) XIO(PRINT_DATA_GLUE_STARTED) XIO(PRINT_DATA_BAG_REJECT) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ] [XIC(PRINT_DATA_PREHEAT1_COMPLETE) ,XIO(PREHEAT1_ACTIVE_RECIPE_LOADED) ] [XIC(PRINT_DATA_PREHEAT2_COMPLETE) ,XIO(PREHEAT2_ACTIVE_RECIPE_LOADED) ] [XIC(PRINT_DATA_FORMING_COMPLETE) ,XIO(FORMING_ACTIVE_RECIPE_LOADED) ] [XIC(PRINT_DATA_PUNCH_COMPLETE) ,XIO(PUNCH_ACTIVE_RECIPE_LOADED) ] XIC(PRINT_ACTIVE_RECIPE_LOADED) XIO(PRINT_DATA_PRINT_STARTED) XIO(PRINT_DATA_PRINT_COMPLETE) OTE(RUN_PROCESS) ,EQU(STEP_AUTO[17],10) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[17]) ,XIO(RUN_PROCESS) [XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) [OTL(PRINT_DATA_BAR_REJECT) ,MOV(8,PRINT_DATA_POS_BAR_REJECT) ] ,XIC(PRINT_ACTIVE_RECIPE_LOADED) [XIO(PRINT_BAR_PRESENT) XIC(PRINT_DATA_BAR_LOADED) [OTU(PRINT_DATA_BAR_LOADED) ,MOV(553,STEP_ALARM[17]) ] ,XIO(CELL_DRY_CYCLE_MODE_PB) XIC(PRINT_BAR_PRESENT) XIO(PRINT_DATA_BAR_LOADED) MOV(554,STEP_ALARM[17]) ] ,MOV(150,STEP_AUTO[17]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[INDEX TO GET INK POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],20)[XIO(PRINT_INK_POS) [MOV(1,DRV_INDEX_NUM) ,XIC(PRINT_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[3]) OTL(PRINT_INDEX_PB) ] ,XIC(PRINT_INK_POS) XIC(MOTION_DRV_INK_POS_CONT.PC) XIO(PRINT_INDEX_PB) MOV(25,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[EXTEND BARRIER HOLD CYLINDER AND EXTEND BARRIER SUPPORT
EXTEND CLICHE
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],25)[OTL(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB) OTL(PRINT_CLICHE_CYL_EXT_PB) ,XIC(PRINT_BAR_HOLD_DOWN_CYL_EXT) OTL(PRINT_SUP_CYL_EXT_PB) ,XIC(PRINT_BAR_HOLD_DOWN_CYL_EXT) XIC(PRINT_SUP_CYL_EXT) XIC(PRINT_CLICHE_CYL_EXT) MOV(30,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[GETTING INK
-
EXTEND MAIN PRINT PAD CYLINDER
CYLINDER ON TIME DEPENDENT ON TIMER
EXTEND SECONDARY PRINT PAD CYLINDER IF ACTIVE IN CURRENT RECIPE
(ALSO DEPENDENT ON TIMER)]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],30)[OTL(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) ,MOV(CLICHE_TIME_PB,TIMER_OPER[1].PRE) ,XIO(PRINT_MAIN_PRINT_HEAD_CYL_RET) TON(TIMER_OPER[1],?,?) ,XIC(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) OTL(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) ,XIO(PRINT_MAIN_PRINT_HEAD_CYL_RET) [XIC(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) XIO(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) ] XIC(TIMER_OPER[1].DN) MOV(40,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RETRACT PRINT HEADS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],40)[OTU(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) OTU(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) ,XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET) [XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ] MOV(50,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[MOVE DRIVE TO PRINT APPLY POSITION
RETRACT PRINT CLICHE CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],50)[[MOV(2,DRV_INDEX_NUM) ,XIC(PRINT_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[4]) OTL(PRINT_INDEX_PB) ,OTU(PRINT_CLICHE_CYL_EXT_PB) ] ,XIC(PRINT_CLICHE_CYL_RET) XIC(MOTION_DRV_APPLY_POS_CONT.PC) XIC(PRINT_APPLY_POS) MOV(60,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[APPLYING TO BARRIER
-
EXTEND MAIN PRINT PAD CYLINDER
CYLINDER ON TIME DEPENDENT ON TIMER
EXTEND SECONDARY PRINT PAD CYLINDER IF ACTIVE IN CURRENT RECIPE
(ALSO DEPENDENT ON TIMER)]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],60)[XIC(CELL_STARTED) OTL(PRINT_DATA_PRINT_STARTED) ,MOV(PRINT_TIME_RECIPE_PB,TIMER_OPER[2].PRE) ,OTL(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) ,XIO(PRINT_MAIN_PRINT_HEAD_CYL_RET) TON(TIMER_OPER[2],?,?) ,XIC(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) OTL(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) ,XIO(PRINT_MAIN_PRINT_HEAD_CYL_RET) [XIC(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) XIO(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_SW_RECIPE_LOADED) ] XIC(TIMER_OPER[2].DN) MOV(70,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[RETRACT PRINT HEADS
RETRACT SUPPORT CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],70)[OTU(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) OTU(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) ,XIC(CELL_STARTED) XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) OTL(PRINT_DATA_PRINT_COMPLETE) ,[TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) OTU(PRINT_SUP_CYL_EXT_PB) ] ,XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET) [XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE) ] XIC(PRINT_SUP_CYL_RET) MOV(80,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[RETRACT BARRIER HOLD DOWN CYLINDER
AND SEND PRINT HEAD MOVE TO GET INK POSITION REQUEST]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],80)[OTU(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB) ,[MOV(1,DRV_INDEX_NUM) ,OTL(PRINT_INDEX_PB) ] ,XIC(PRINT_BAR_HOLD_DOWN_CYL_RET) [XIC(CELL_STARTED) MOV(150,STEP_AUTO[17]) ,XIC(CELL_MANUAL_MODE) MOV(90,STEP_AUTO[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[WAIT FOR MOVE TO GET INK POSITION TO COMPLETE
AT COMPLETION OF A MANUAL CYCLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],90)XIC(CELL_MANUAL_MODE)XIO(PRINT_CYCLE_PB)XIC(PRINT_INK_POS)XIC(MOTION_DRV_INK_POS_CONT.PC)XIO(PRINT_INDEX_PB)MOV(0,STEP_AUTO[17]);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
SEND PRINT DRIVE TO INK POS
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],150)[OTL(PRINT_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.9) XIO(PUNCH_DATA_BAR_LOADED) OTL(CELL_EMPTY_COMPLETE.10) ,TON(TIMER_OPER[5],?,?) ,XIO(CELL_MANUAL_MODE) XIC(TIMER_OPER[5].DN) MOV(160,STEP_AUTO[17]) ,XIC(CELL_MANUAL_MODE) XIO(PRINT_CYCLE_PB) MOV(0,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[17],160)XIC(PRINT_INK_POS)XIO(MAIN_DIAL_INDEX_DONE)[OTU(PRINT_PROCESS_DONE) ,MOV(5,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(20,STEP_AUTO[17],150) TON(TIMER_OPER[4],?,?) ,EQU(STEP_AUTO[17],150) ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[4].ACC,1000,CELL_CYCLE_TIME[0].BARRIER_PRINT) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[17],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].BARRIER_PRINT,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(8,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_PRINT,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].BARRIER_PRINT,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].BARRIER_PRINT,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(8,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_PRINT,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRINTING STATION E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[17],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[17]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[17],1000) EQU(STEP_ALARM_CAPTURE[17],0) MOV(STEP_ALARM[17],STEP_ALARM_CAPTURE[17]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[17],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.17) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[17],1000)[NEQ(STEP_ALARM[17],0) OTE(MAJOR_FAULT[17]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[17],STEP_AUTO_RET_ESTOP[17]) ,[OTU(PRINT_DRV_RESET_PB) OTU(PRINT_DRV_ENABLE_PB) OTU(PRINT_INDEX_PB) OTU(PRINT_ABORT_INDEX_PB) ,OTU(PRINT_DRV_HOME_PB) OTU(DRV_INTERNAL_HOME_REQ) OTU(DRV_HOME_OFF_REQ) OTU(DRV_DEFINE_HOME) OTU(PRINT_DRV_HOMING_IND) ] ,OTU(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) OTU(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) OTU(PRINT_CLICHE_CYL_EXT_PB) OTU(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB) OTU(PRINT_SUP_CYL_EXT_PB) ,OTU(PRINT_CYCLE_PB) OTU(PRINT_PROCESS_DONE) ,XIC(PRINT_DATA_BAR_LOADED) XIO(PRINT_DATA_BAR_REJECT) XIC(PRINT_DATA_PRINT_STARTED) XIO(PRINT_DATA_PRINT_COMPLETE) OTE(PRINT_PROCESS_FAILED) ,MOV(1000,STEP_HOME[17]) MOV(1000,STEP_HOMING[17]) MOV(1000,STEP_AUTO[17]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[17],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[17]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[17],10)[MOV(0,STEP_ALARM[17]) ,MOV(0,STEP_ALARM_CAPTURE[17]) ,MOV(20,STEP_ESTOP_RESET[17]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[17],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[17]) ,MOV(30,STEP_ESTOP_RESET[17]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[17]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[17],30)EQU(STEP_HOME[17],500)MOV(500,STEP_ESTOP_RESET[17]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRINTING STATION HMI
***************************************************************************

BARRIER PRINTING STATION ANIMATION]]>
</Comment>
<Text>
<![CDATA[[LIM(0.1,DRV17.ActualVelocity,-0.1) XIC(PRINT_DRV_MOVING) ,XIC(PRINT_INDEX_PB) ]OTE(PRINT_INDEXING_IND);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[17],500)[XIO(CELL_STARTED) XIO(PRINT_DRV_FAULT) XIO(PRINT_DRV_SHUTDOWN) [XIO(PRINT_DRV_HOMING_IND) OTE(PRINT_DRV_ENABLE_PB_VIS) ,XIC(PRINT_CLEAR_TO_INDEX) XIC(PRINT_DRV_READY) [OTE(PRINT_DRV_HOME_PB_VIS) ,XIC(PRINT_DRV_HOMED) OTE(PRINT_DRV_PB_VIS) ] ] ,[XIC(PRINT_DRV_FAULT) ,XIC(PRINT_DRV_SHUTDOWN) ,XIC(MOTION_DRV_ENABLE_CONT.ER) ] OTE(PRINT_DRV_FAULT_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CORRECT THE PAD CLICHE & PRINT POSITION BASED ON HMI OFFSET VALUE

ADJUSTMENTS ARE LOCATED ON THE HMI SCREEN FOR THE BARRIER PRINTER STATION]]>
</Comment>
<Text>
<![CDATA[[[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) MOV(0,PRINT_Y_OFFSET_PB) ,GRT(PRINT_Y_OFFSET_PB,3) MOV(3,PRINT_Y_OFFSET_PB) ,LES(PRINT_Y_OFFSET_PB,-3) MOV(-3,PRINT_Y_OFFSET_PB) ,ADD(PRINT_Y_OFFSET_PB,PRINT_APPLY_POS_RECIPE_LOADED,BARRIER_PRINT_Y_APPLY_POS_OFF_VAL) [XIC(METRIC_MACHINE) MOV(BARRIER_PRINT_Y_APPLY_POS_OFF_VAL,BARRIER_PRINT_Y_APPLY_POS_OFF_VAL_SCALED) ,XIO(METRIC_MACHINE) MUL(BARRIER_PRINT_Y_APPLY_POS_OFF_VAL,25.4,BARRIER_PRINT_Y_APPLY_POS_OFF_VAL_SCALED) ] ] ,[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) MOV(0,CLICHE_Y_OFFSET_PB) ,GRT(CLICHE_Y_OFFSET_PB,3) MOV(3,CLICHE_Y_OFFSET_PB) ,LES(CLICHE_Y_OFFSET_PB,-3) MOV(-3,CLICHE_Y_OFFSET_PB) ,ADD(CLICHE_Y_OFFSET_PB,PRINT_INK_POS_RECIPE_LOADED,PRINT_Y_INK_POS_OFF_VAL) [XIC(METRIC_MACHINE) MOV(PRINT_Y_INK_POS_OFF_VAL,PRINT_Y_INK_POS_OFF_VAL_SCALED) ,XIO(METRIC_MACHINE) MUL(PRINT_Y_INK_POS_OFF_VAL,25.4,PRINT_Y_INK_POS_OFF_VAL_SCALED) ] ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[CYLINDERS PUSH BUTTON VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_STARTED) XIC(CELL_MANUAL_MODE) XIC(PRINT_DRV_HOMED) [[XIC(PRINT_INK_POS) XIC(PRINT_CLICHE_CYL_EXT) ,XIC(PRINT_APPLY_POS) XIC(MAIN_DIAL_IN_POSITION) XIC(PRINT_SUP_CYL_EXT) ] [OTE(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB_VIS) ,XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) OTE(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB_VIS) ] ,[XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET) [XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE) ] ,XIC(PRINT_APPLY_POS) XIC(MAIN_DIAL_IN_POSITION) ] OTE(PRINT_CLICHE_CYL_EXT_PB_VIS) ,XIC(MAIN_DIAL_IN_POSITION) [OTE(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB_VIS) ,OTE(PRINT_SUP_CYL_EXT_PB_VIS) ] ] ,XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) XIO(PRINT_INK_POS) OTE(PRINT_SEC_PRINT_HEAD_CYL_RET_VIS) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MANUAL MODE CYCLE HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)XIC(CELL_KEY_AUTO_MODE)XIC(CELL_MANUAL_MODE)XIC(MAIN_DIAL_IN_POSITION)XIO(PRINT_DRV_FAULT)XIC(PRINT_DRV_READY)OTE(PRINT_CYCLE_PB_VIS);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(PRINT_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(PRINT_BYPASS_ANIMATION);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[DRIVE POSITION FOR HMI]]>
</Comment>
<Text>
<![CDATA[MUL(DRV17.ActualPosition,3.93700787402,PRINT_CUR_POS_HMI);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRINTING STATION HOME ROUTINE
***************************************************************************

RESET FAULTS AND SHUTDOWN STATE OF DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],0)[[XIC(PRINT_DRV_FAULT) ,XIC(PRINT_DRV_SHUTDOWN) ] OTL(PRINT_DRV_RESET_PB) ,XIO(PRINT_DRV_FAULT) XIO(PRINT_DRV_SHUTDOWN) MOV(10,STEP_HOME[17]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TORQUE SAFE INPUT TO ACTIVATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],10)[XIO(PRINT_DRV_SAFE_TRQ_OFF) MOV(20,STEP_HOME[17]) ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(555,STEP_ALARM[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],20)[OTL(PRINT_DRV_ENABLE_PB) ,XIC(PRINT_DRV_READY) MOV(25,STEP_HOME[17]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[RETRACT ALL CYLINDERS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],25)[[OTU(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) ,OTU(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) ,OTU(PRINT_CLICHE_CYL_EXT_PB) ,OTU(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB) ,OTU(PRINT_SUP_CYL_EXT_PB) ] ,XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET) [XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ] XIC(PRINT_CLICHE_CYL_RET) XIC(PRINT_BAR_HOLD_DOWN_CYL_RET) XIC(PRINT_SUP_CYL_RET) MOV(30,STEP_HOME[17]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF DRIVE REQUIRES HOMING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],30)[XIO(PRINT_DRV_HOMED) MOV(35,STEP_HOME[17]) ,XIC(PRINT_DRV_HOMED) MOV(40,STEP_HOME[17]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[START DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[17]) ,XIC(PRINT_DRV_HOMED) MOV(40,STEP_HOME[17]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[MOVE TO INK POSITION IF NOT ALREADY THERE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],40)[XIO(PRINT_INK_POS) MOV(50,STEP_HOME[17]) ,XIC(PRINT_INK_POS) MOV(100,STEP_HOME[17]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[INDEX TO GET INK POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],50)[MOV(1,DRV_INDEX_NUM) ,XIC(PRINT_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[2]) OTL(PRINT_INDEX_PB) ,XIC(PRINT_INK_POS) XIC(MOTION_DRV_INK_POS_CONT.PC) XIO(PRINT_INDEX_PB) MOV(100,STEP_HOME[17]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[COMPLETE ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[17],100)[MOV(0,STEP_AUTO[17]) ,MOV(500,STEP_HOME[17]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="LIN_AXIS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRINTER STATION LINEAR X-AXIS ANALOG POSITION
************************************************************************************

LOAD POSTION DATA INTO VARIABLES]]>
</Comment>
<Text>
<![CDATA[[DIV(MAN04:I.Data[1],34.949,PRINT_X_POS) [XIC(METRIC_MACHINE) MOV(PRINT_X_POS,PRINT_X_POS_SCALED) ,XIO(METRIC_MACHINE) DIV(PRINT_X_POS,25.4,PRINT_X_POS_SCALED) ] ,EQU(PRINT_X_POS_RAW,32767) MOV(551,STEP_ALARM[17]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[VERIFY X-AXIS POSITION IS WITHIN REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[[SUB(PRINT_X_POS_RECIPE,PRINT_X_POS_TOL,PRINT_X_POS_LOWER) ADD(PRINT_X_POS_RECIPE,PRINT_X_POS_TOL,PRINT_X_POS_UPPER) ,LIM(PRINT_X_POS_LOWER,PRINT_X_POS_SCALED,PRINT_X_POS_UPPER) OTE(PRINT_X_POS_OK) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************
]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(SERVO_HOMING,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(HMI,0) ,JSR(POSITION_MONITOR,0) ,JSR(LIN_AXIS,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRINTING STATION DRIVE OUTPUTS
***************************************************************************

INITIATE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[17],1000)XIC(DRV_INTERNAL_HOME_REQ)[MAH(DRV17,MOTION_DRV_INTERNAL_HOME_CONT) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC) XIC(PRINT_DRV_HOMED_STATUS) OTU(DRV_INTERNAL_HOME_REQ) ,[TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(557,STEP_ALARM[17]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONTROLS MANUAL MODE  HMI BARRIER PRINT DRIVE INDEXES]]>
</Comment>
<Text>
<![CDATA[EQU(CELL_HMI_CURRENT_SCREEN,12)XIO(CELL_STARTED)[EQU(STEP_HOME[17],500) ,EQU(STEP_HOME[17],1000) ][EQU(STEP_AUTO[17],0) ,EQU(STEP_AUTO[17],500) ,EQU(STEP_AUTO[17],1000) ]XIO(PRINT_DRV_HOMING_IND)[EQU(PRINT_POS_PB,1) MOV(1,DRV_INDEX_NUM) ,EQU(PRINT_POS_PB,2) MOV(2,DRV_INDEX_NUM) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ABORT INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[17],1000)[XIC(PRINT_ABORT_INDEX_PB) ,XIO(PRINT_CLEAR_TO_INDEX) ][MAS(DRV17,MOTION_DRV_ABORT_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,XIC(MOTION_DRV_ABORT_CONT.PC) OTU(PRINT_ABORT_INDEX_PB) ,XIO(MOTION_DRV_ABORT_CONT.PC) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [OTU(PRINT_ABORT_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(558,STEP_ALARM[17]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[17],1000) XIC(PRINT_DRV_RESET_PB) [MASR(DRV17,MOTION_DRV_RESET_CONT) ,XIC(MOTION_DRV_ENABLE_CONT.ER) OTU(MOTION_DRV_ENABLE_CONT.ER) ,XIO(PRINT_DRV_FAULT) XIO(PRINT_DRV_SHUTDOWN) XIO(MOTION_DRV_ENABLE_CONT.ER) OTU(PRINT_DRV_RESET_PB) ,[TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(PRINT_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(PRINT_DRV_FAULT) MOV(550,STEP_ALARM[17]) ,XIC(PRINT_DRV_SHUTDOWN) MOV(561,STEP_ALARM[17]) ] ] ] ] ,[XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(10,STEP_HOME[17],499) ] [XIC(PRINT_DRV_FAULT) MOV(550,STEP_ALARM[17]) ,XIC(PRINT_DRV_SHUTDOWN) MOV(561,STEP_ALARM[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[17],1000)[XIC(PRINT_DRV_ENABLE_PB) [MSO(DRV17,MOTION_DRV_ENABLE_CONT) ,[XIO(MOTION_DRV_ENABLE_CONT.DN) ,XIO(PRINT_DRV_READY) ,XIC(PRINT_DRV_FAULT) ,XIC(PRINT_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) [OTU(PRINT_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(559,STEP_ALARM[17]) ] ] ] ,XIO(PRINT_DRV_ENABLE_PB) [MSF(DRV17,MOTION_DRV_DISABLE_CONT) ,XIO(MOTION_DRV_DISABLE_CONT.DN) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) XIC(CELL_ALARMS_ACTIVE) MOV(560,STEP_ALARM[17]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[GET INK POSITION CONTROL]]>
</Comment>
<Text>
<![CDATA[[LEQ(PRINT_Y_INK_POS_OFF_VAL,PRINT_INK_POS_VAL_MIN) MOV(PRINT_INK_POS_VAL_MIN,PRINT_Y_INK_POS_OFF_VAL) ,NEQ(STEP_ESTOP_RESET[17],1000) EQU(DRV_INDEX_NUM,1) XIC(PRINT_INDEX_PB) [XIC(PRINT_CLEAR_TO_INDEX) [MAM(DRV17,MOTION_DRV_INK_POS_CONT,0,PRINT_Y_INK_POS_OFF_VAL_SCALED,PRINT_DRV_SPEED_VAL,Units per sec,5000,Units per sec2,5000,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_INK_POS_CONT.PC) OTU(PRINT_INDEX_PB) ] ,[TON(TIMER_ALARM[11],?,?) ,XIC(TIMER_ALARM[11].DN) XIC(CELL_ALARMS_ACTIVE) MOV(573,STEP_ALARM[17]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[PRINT APPLY POSITION CONTROL]]>
</Comment>
<Text>
<![CDATA[[GEQ(BARRIER_PRINT_Y_APPLY_POS_OFF_VAL,PRINT_APPLY_POS_VAL_MAX) MOV(PRINT_APPLY_POS_VAL_MAX,BARRIER_PRINT_Y_APPLY_POS_OFF_VAL) ,NEQ(STEP_ESTOP_RESET[17],1000) EQU(DRV_INDEX_NUM,2) XIC(PRINT_INDEX_PB) [XIC(PRINT_CLEAR_TO_INDEX) [MAM(DRV17,MOTION_DRV_APPLY_POS_CONT,0,BARRIER_PRINT_Y_APPLY_POS_OFF_VAL_SCALED,PRINT_DRV_SPEED_VAL,Units per sec,5000,Units per sec2,5000,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_INK_POS_CONT.PC) OTU(PRINT_INDEX_PB) ] ,[TON(TIMER_ALARM[12],?,?) ,XIC(TIMER_ALARM[12].DN) XIC(CELL_ALARMS_ACTIVE) MOV(574,STEP_ALARM[17]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[MAIN PRINT HEAD CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[17],1000)[[XIC(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) [XIC(PRINT_INK_POS) ,XIC(PRINT_APPLY_POS) XIC(MAIN_DIAL_IN_POSITION) ] [OTE(MAN04:O.Data[2].0) ,XIC(CELL_ALARMS_ACTIVE) XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET) [TON(TIMER_ALARM[14],?,?) ,XIC(TIMER_ALARM[14].DN) MOV(563,STEP_ALARM[17]) ] ] ,XIO(PRINT_INK_POS) XIO(MAIN_DIAL_IN_POSITION) OTU(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) ] ,XIO(PRINT_MAIN_PRINT_HEAD_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_MAIN_PRINT_HEAD_CYL_RET) [TON(TIMER_ALARM[15],?,?) ,XIC(TIMER_ALARM[15].DN) MOV(564,STEP_ALARM[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SECONDARY PRINT HEAD CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED)NEQ(STEP_ESTOP_RESET[17],1000)XIC(CELL_PRESSURE_OK)[[XIC(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) [XIC(PRINT_INK_POS) ,XIC(PRINT_APPLY_POS) XIC(MAIN_DIAL_IN_POSITION) ] [OTE(MAN04:O.Data[2].2) ,XIC(CELL_ALARMS_ACTIVE) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) [TON(TIMER_ALARM[16],?,?) ,XIC(TIMER_ALARM[16].DN) MOV(565,STEP_ALARM[17]) ] ] ,XIO(PRINT_INK_POS) XIO(MAIN_DIAL_IN_POSITION) OTU(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) ] ,XIO(PRINT_SEC_PRINT_HEAD_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_SEC_PRINT_HEAD_CYL_RET) [TON(TIMER_ALARM[17],?,?) ,XIC(TIMER_ALARM[17].DN) MOV(566,STEP_ALARM[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CLICHE TRAVERSE CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[17],1000)XIC(CELL_PRESSURE_OK)[XIC(PRINT_CLICHE_CYL_EXT_PB) [OTE(MAN04:O.Data[2].4) ,XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_CLICHE_CYL_EXT) [TON(TIMER_ALARM[18],?,?) ,XIC(TIMER_ALARM[18].DN) MOV(567,STEP_ALARM[17]) ] ] ,XIO(PRINT_CLICHE_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_CLICHE_CYL_RET) [TON(TIMER_ALARM[19],?,?) ,XIC(TIMER_ALARM[19].DN) MOV(568,STEP_ALARM[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[BARRIER HOLD DOWN CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[17],1000)XIC(CELL_PRESSURE_OK)[XIC(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN04:O.Data[2].6) ,XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_BAR_HOLD_DOWN_CYL_EXT) [TON(TIMER_ALARM[20],?,?) ,XIC(TIMER_ALARM[10].DN) MOV(569,STEP_ALARM[17]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB) ] ,XIO(PRINT_BAR_HOLD_DOWN_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_BAR_HOLD_DOWN_CYL_RET) [TON(TIMER_ALARM[21],?,?) ,XIC(TIMER_ALARM[21].DN) MOV(570,STEP_ALARM[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[PRINT SUPPORT CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[17],1000)XIC(CELL_PRESSURE_OK)[XIC(PRINT_SUP_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN02:O.Data[4].6) ,XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_SUP_CYL_EXT) [TON(TIMER_ALARM[22],?,?) ,XIC(TIMER_ALARM[22].DN) MOV(571,STEP_ALARM[17]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(PRINT_SUP_CYL_EXT_PB) ] ,XIO(PRINT_SUP_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PRINT_SUP_CYL_RET) [TON(TIMER_ALARM[23],?,?) ,XIC(TIMER_ALARM[23].DN) MOV(572,STEP_ALARM[17]) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[SKU PAD PRINT CONTROL
OUTPUT ACTIVATED ENABLE SKU PAD PRINT]]>
</Comment>
<Text>
<![CDATA[[XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) [XIC(CELL_TOOL_CHANGE_REQ_PB) XIC(CELL_RESET_PRESSED) ONS(ONS_ARRAY[5]) OTU(MAN02:O.Data[5].14) ,XIO(CELL_TOOL_CHANGE_MODE) XIC(CELL_RESET_PRESSED) ONS(ONS_ARRAY[6]) OTL(MAN02:O.Data[5].14) ] ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) OTU(MAN02:O.Data[5].14) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR BARRIER PRINTING STATION
***************************************************************************

POSITION VERIFICATION]]>
</Comment>
<Text>
<![CDATA[[XIC(PRINT_DRV_HOMED) [[SUB(PRINT_Y_INK_POS_OFF_VAL_SCALED,PRINT_POS_TOL,PRINT_INK_POS_LOWER) ADD(PRINT_Y_INK_POS_OFF_VAL_SCALED,PRINT_POS_TOL,PRINT_INK_POS_UPPER) ,SUB(BARRIER_PRINT_Y_APPLY_POS_OFF_VAL_SCALED,PRINT_POS_TOL,PRINT_APPLY_POS_LOWER) ADD(BARRIER_PRINT_Y_APPLY_POS_OFF_VAL_SCALED,PRINT_POS_TOL,PRINT_APPLY_POS_UPPER) ] ,[LIM(PRINT_INK_POS_LOWER,DRV17.ActualPosition,PRINT_INK_POS_UPPER) OTE(PRINT_INK_POS) ,LIM(PRINT_APPLY_POS_LOWER,DRV17.ActualPosition,PRINT_APPLY_POS_UPPER) OTE(PRINT_APPLY_POS) ] OTE(PRINT_IN_POSITION) ] ,[XIC(CELL_STARTED) XIO(PRINT_DRV_MOVING) ,EQU(STEP_HOME[17],50) ] XIO(PRINT_IN_POSITION) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [OTL(DRV_HOMING_REQ) ,MOV(552,STEP_ALARM[17]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INK POSITION RECIPE LIMIT CHECK
]]>
</Comment>
<Text>
<![CDATA[[XIC(METRIC_MACHINE) [LES(PRINT_INK_POS_RECIPE_LOADED,3) MOV(3,PRINT_INK_POS_RECIPE_LOADED) ,GRT(PRINT_INK_POS_RECIPE_LOADED,40) MOV(40,PRINT_INK_POS_RECIPE_LOADED) ] ,XIO(METRIC_MACHINE) [LES(PRINT_INK_POS_RECIPE_LOADED,0.01) MOV(0.01,PRINT_INK_POS_RECIPE_LOADED) ,GRT(PRINT_INK_POS_RECIPE_LOADED,1.57) MOV(1.57,PRINT_INK_POS_RECIPE_LOADED) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PRINTING STATION DRIVE HOMING ROUTINE
***************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(PRINT_DRV_HOME_PB)XIO(DRV_HOMING_REQ)XIO(PRINT_DRV_HOMING_IND)XIC(PRINT_DRV_HOMED_STATUS)OTE(PRINT_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[17],0) ,XIC(PRINT_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[17],500) [EQU(STEP_HOMING[17],500) ,EQU(STEP_HOMING[17],1000) ] ][MOV(10,STEP_HOMING[17]) ,OTL(PRINT_DRV_HOMING_IND) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[17],10)[ONS(ONS_ARRAY[12]) OTL(DRV_INTERNAL_HOME_REQ) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.IP) MOV(15,STEP_HOMING[17]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[17],15)XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC)XIC(PRINT_DRV_HOMED_STATUS)XIO(DRV_INTERNAL_HOME_REQ)MOV(100,STEP_HOMING[17]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[17],100)[MOV(1,DRV_INDEX_NUM) ,OTU(PRINT_DRV_HOMING_IND) OTU(PRINT_DRV_HOME_PB) ,XIO(PRINT_DRV_FAULT) OTU(DRV_HOMING_REQ) ,MOV(500,STEP_HOMING[17]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(PRINT_DRV_HOMED)XIC(PRINT_DRV_READY)XIO(PRINT_DRV_FAULT)XIC(PRINT_SUP_CYL_RET)XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET)[XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ]XIC(PRINT_CLICHE_CYL_RET)XIC(PRINT_BAR_HOLD_DOWN_CYL_RET)XIC(PRINT_X_POS_OK)OTE(CELL_AUTO_READY[17]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK THAT EVERYTHING IS CLEAR BEFORE INDEXING]]>
</Comment>
<Text>
<![CDATA[XIC(PRINT_MAIN_PRINT_HEAD_CYL_RET)[XIC(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) XIC(PRINT_SEC_PRINT_HEAD_CYL_RET) ,XIO(PRINT_SKU_PAD_ACTIVE_HW_RECIPE_LOADED) ]OTE(PRINT_CLEAR_TO_INDEX);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
