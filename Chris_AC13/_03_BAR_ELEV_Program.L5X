<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS
]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[5],500) ,EQU(STEP_AUTO[5],1000) ][EQU(STEP_AUTO[2],500) ,EQU(STEP_AUTO[2],1000) ][EQU(STEP_AUTO[3],0) ,EQU(STEP_AUTO[3],10) ,EQU(STEP_AUTO[3],50) ]MOV(500,STEP_AUTO[3]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK BARRIER INFEED MAGAZINE STATUS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[3],0)[XIO(CELL_BAG_LOAD_ONLY_MODE_PB) [XIC(BARRIER_MAG_READY_FOR_PROCESS) MOV(10,STEP_AUTO[3]) ,XIO(BARRIER_MAG_READY_FOR_PROCESS) EQU(STEP_AUTO[2],20) XIO(BARRIER_ELEV_OUT_OF_MAG_POS) MOV(40,STEP_AUTO[3]) ] ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) MOV(500,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[DETERMINE WHERE TO GO BASED ON CURRENT POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],10)[XIC(BARRIER_ELEV_IN_POSITION) [[XIC(BARRIER_ELEV_OUT_OF_MAG_POS) ,XIC(BARRIER_ELEV_RET_INC_POS) ] MOV(20,STEP_AUTO[3]) ,[XIC(BARRIER_ELEV_PICK_POS) ,XIC(BARRIER_ELEV_TOP_POS) ,XIC(BARRIER_ELEV_RETURN_POS) ] MOV(40,STEP_AUTO[3]) ] ,XIO(BARRIER_ELEV_IN_POSITION) MOV(80,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[***START OF MAIN LOOP***

SET INDEX AND VERIFY READY TO START INDEX]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],20)[MOV(5,BARRIER_ELEV_DRV_INDEX_NUM) ,XIC(BARRIER_ELEV_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) [XIC(Local:1:I.Pt00.Data) MOV(30,STEP_AUTO[3]) ,XIC(BARRIER_ELEV_BAR_DETECT) MOV(50,STEP_AUTO[3]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[INDEX TO BARRIER DETECT SENSOR PLUS OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],30)[XIC(BARRIER_ELEV_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[5]) OTL(BARRIER_ELEV_INDEX_PB) ,XIC(BARRIER_ELEV_BAR_DETECT) XIC(BARRIER_ELEV_PICK_POS) [XIC(MOTION_DRV_TOP_POS_CONT.PC) ,XIC(MOTION_DRV_REG_ARM_PICK_CONT.PC) ] XIO(BARRIER_ELEV_INDEX_PB) [RES(BAR_DETECT_CNT) ,MOV(40,STEP_AUTO[3]) ] ,XIO(BARRIER_ELEV_BAR_DETECT) [TON(TIMER_ALARM[10],?,?) ,XIC(TIMER_ALARM[10].DN) [XIO(BAR_DETECT_CNT.DN) [CTU(BAR_DETECT_CNT,?,?) ,MOV(40,STEP_AUTO[3]) ] ,XIC(BAR_DETECT_CNT.DN) MOV(483,STEP_ALARM[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CHECK TOWER STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],40)[XIO(BARRIER_MAG_TWR_CHK) [XIC(BARRIER_ELEV_BAR_DETECT) OTL(BARRIER_ELEV_BAR_READY_PICK) ,XIO(BARRIER_ELEV_BAR_DETECT) OTU(BARRIER_ELEV_BAR_READY_PICK) ] MOV(50,STEP_AUTO[3]) ,XIC(BARRIER_MAG_TWR_CHK) MOV(80,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR BARRIER TO NOT BE READY FOR PICKING
SET INDEX FOR INCREMENTAL RETRACT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],50)[MOV(6,BARRIER_ELEV_DRV_INDEX_NUM) ,[XIC(BARRIER_MAG_READY_FOR_PROCESS) XIO(BARRIER_ELEV_BAR_READY_PICK) MOV(60,STEP_AUTO[3]) ,XIO(BARRIER_MAG_READY_FOR_PROCESS) [OTU(BARRIER_ELEV_BAR_READY_PICK) ,MOV(80,STEP_AUTO[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[INDEX TO INCREMENTAL RETRACT POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],60)[XIC(BARRIER_ELEV_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[4]) OTL(BARRIER_ELEV_INDEX_PB) ,XIC(BARRIER_ELEV_RET_INC_POS) XIC(MOTION_DRV_INC_RET_POS_CONT.PC) XIO(BARRIER_ELEV_INDEX_PB) [XIC(Local:1:I.Pt00.Data) [TON(TIMER_OPER[11],?,?) ,XIC(TIMER_OPER[11].DN) MOV(80,STEP_AUTO[3]) ] ,[TON(TIMER_OPER[12],?,?) ,[XIC(BARRIER_ELEV_BAR_DETECT) ,XIC(TIMER_OPER[12].DN) ] MOV(70,STEP_AUTO[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[INDEX TO RETURN POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],70)[MOV(8,BARRIER_ELEV_DRV_INDEX_NUM) ,XIC(BARRIER_ELEV_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[11]) OTL(BARRIER_ELEV_INDEX_PB) ,XIC(BARRIER_ELEV_RETURN_POS) XIC(MOTION_DRV_RETURN_POS_CONT.PC) XIO(BARRIER_ELEV_INDEX_PB) MOV(40,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CHECK BARRIER INFEED MAGAZINE STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],80)[XIC(BARRIER_MAG_READY_FOR_PROCESS) MOV(20,STEP_AUTO[3]) ,XIO(BARRIER_MAG_READY_FOR_PROCESS) MOV(90,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[INDEX TO OUT OF MAGAZINE POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],90)[MOV(7,BARRIER_ELEV_DRV_INDEX_NUM) ,XIC(BARRIER_ELEV_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[6]) OTL(BARRIER_ELEV_INDEX_PB) ,XIC(BARRIER_ELEV_OUT_OF_MAG_POS) XIC(MOTION_DRV_OUT_OF_MAG_POS_CONT.PC) XIO(BARRIER_ELEV_INDEX_PB) MOV(100,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[DELAY TIMER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[3],100)XIC(BARRIER_ELEV_OUT_OF_MAG_POS)[TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) MOV(0,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[3],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[3]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[3],1000) EQU(STEP_ALARM_CAPTURE[3],0) MOV(STEP_ALARM[3],STEP_ALARM_CAPTURE[3]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[3],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.3) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[3],1000)[NEQ(STEP_ALARM[3],0) OTE(MAJOR_FAULT[3]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[3],STEP_AUTO_RET_ESTOP[3]) ,[OTU(BARRIER_ELEV_DRV_RESET_PB) OTU(BARRIER_ELEV_DRV_ENABLE_PB) OTU(BARRIER_ELEV_INDEX_PB) OTU(BARRIER_ELEV_ABORT_INDEX_PB) ,OTU(BARRIER_ELEV_DRV_HOME_PB) OTU(DRV_INTERNAL_HOME_REQ) OTU(DRV_HOME_OFF_REQ) OTU(DRV_DEFINE_HOME) OTU(BARRIER_ELEV_DRV_HOMING_IND) ] ,RES(BAR_DETECT_CNT) OTU(BARRIER_ELEV_BAR_READY_PICK) ,MOV(1000,STEP_HOMING[3]) MOV(1000,STEP_HOME[3]) MOV(1000,STEP_AUTO[3]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[3],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[3]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[3],10)[MOV(0,STEP_ALARM[3]) ,MOV(0,STEP_ALARM_CAPTURE[3]) ,MOV(20,STEP_ESTOP_RESET[3]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[3],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[3]) ,MOV(30,STEP_ESTOP_RESET[3]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[3]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[3],30)EQU(STEP_HOME[3],500)MOV(500,STEP_ESTOP_RESET[3]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR HMI
***************************************************************************

ELEVATOR ANIMATION]]>
</Comment>
<Text>
<![CDATA[[LIM(0.1,DRV03.ActualVelocity,-0.1) XIC(BARRIER_ELEV_DRV_MOVING) ,XIC(BARRIER_ELEV_INDEX_PB) ]OTE(BARRIER_ELEV_INDEXING_IND);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[3],500) [XIO(CELL_STARTED) XIO(BARRIER_ELEV_DRV_FAULT) XIO(BARRIER_ELEV_DRV_SHUTDOWN) [XIO(BARRIER_ELEV_DRV_HOMING_IND) OTE(BARRIER_ELEV_DRV_ENABLE_PB_VIS) ,XIC(BARRIER_ELEV_DRV_READY) [OTE(BARRIER_ELEV_DRV_HOME_PB_VIS) ,XIC(BARRIER_ELEV_CLEAR_TO_INDEX) XIC(BARRIER_ELEV_DRV_HOMED) OTE(BARRIER_ELEV_DRV_PB_VIS) ] ] ,[XIC(BARRIER_ELEV_DRV_FAULT) ,XIC(BARRIER_ELEV_DRV_SHUTDOWN) ,XIC(MOTION_DRV_ENABLE_CONT.ER) ] OTE(BARRIER_ELEV_DRV_FAULT_PB_VIS) ] ,XIO(BARRIER_ELEV_DRV_READY) OTE(BARRIER_ELEV_BRAKE_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[DRIVE POSITION FOR HMI]]>
</Comment>
<Text>
<![CDATA[MUL(DRV03.ActualPosition,3.93700787402,BARRIER_ELEV_CUR_POS_HMI);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR HOME ROUTINE
***************************************************************************

RESET FAULTS AND SHUTDOWN STATE OF DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],0)[[XIC(BARRIER_ELEV_DRV_FAULT) ,XIC(BARRIER_ELEV_DRV_SHUTDOWN) ] OTL(BARRIER_ELEV_DRV_RESET_PB) ,XIO(BARRIER_ELEV_DRV_FAULT) XIO(BARRIER_ELEV_DRV_SHUTDOWN) MOV(10,STEP_HOME[3]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TORQUE SAFE INPUT TO ACTIVATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],10)[XIO(BARRIER_ELEV_DRV_SAFE_TRQ_OFF) MOV(20,STEP_HOME[3]) ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(476,STEP_ALARM[3]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],20)[OTL(BARRIER_ELEV_DRV_ENABLE_PB) ,XIC(BARRIER_ELEV_DRV_READY) MOV(30,STEP_HOME[3]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF DRIVE REQUIRES HOMING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],30)[XIO(BARRIER_ELEV_DRV_HOMED) MOV(35,STEP_HOME[3]) ,XIC(BARRIER_ELEV_DRV_HOMED) MOV(40,STEP_HOME[3]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[START DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[3]) ,XIC(BARRIER_ELEV_DRV_HOMED) MOV(40,STEP_HOME[3]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[DETERMINE IF NEED TO RETRACT ELEVATOR TO HOME POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],40)[[XIO(BARRIER_MAG_IN_POSITION) XIO(BARRIER_ELEV_OUT_OF_MAG_POS) ,XIC(CELL_TOOL_CHANGE_REQ_PB) ] MOV(50,STEP_HOME[3]) ,XIO(CELL_TOOL_CHANGE_REQ_PB) [XIC(BARRIER_MAG_IN_POSITION) ,XIC(BARRIER_ELEV_OUT_OF_MAG_POS) ] MOV(100,STEP_HOME[3]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[INDEX TO OUT OF MAGAZINE POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],50)[MOV(7,BARRIER_ELEV_DRV_INDEX_NUM) ,XIC(BARRIER_ELEV_CLEAR_TO_INDEX) XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[2]) OTL(BARRIER_ELEV_INDEX_PB) ,XIC(BARRIER_ELEV_OUT_OF_MAG_POS) XIC(MOTION_DRV_OUT_OF_MAG_POS_CONT.PC) XIO(BARRIER_ELEV_INDEX_PB) MOV(100,STEP_HOME[3]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[COMPLETE ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[3],100)[[MOV(0,BARRIER_ELEV_BRAKE_CONT) ,OTL(DRV_BRAKE_MSG) ] ,MOV(0,STEP_AUTO[3]) ,MOV(500,STEP_HOME[3]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[HOME ELEVATOR WATCHDOG]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)EQU(STEP_HOME[3],500)XIC(BARRIER_ELEV_HOME_REQUEST)MOV(60,STEP_HOME[3]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(SERVO_HOMING,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(POSITION_MONITOR,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR OUTPUTS
***************************************************************************

INITIATE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)XIC(DRV_INTERNAL_HOME_REQ)[MAH(DRV03,MOTION_DRV_INTERNAL_HOME_CONT) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC) XIC(BARRIER_ELEV_DRV_HOMED_STATUS) OTU(DRV_INTERNAL_HOME_REQ) ,[TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(478,STEP_ALARM[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONTROLS MANUAL MODE  HMI ELEVATOR DRIVE INDEXES]]>
</Comment>
<Text>
<![CDATA[EQU(CELL_HMI_CURRENT_SCREEN,30)XIO(CELL_STARTED)XIO(BARRIER_ELEV_DRV_HOMING_IND)[EQU(STEP_HOME[3],500) ,EQU(STEP_HOME[3],1000) ]XIO(BARRIER_ELEV_INDEX_PB)[EQU(BARRIER_ELEV_POS_PB,1) [XIO(BARRIER_ELEV_BAR_DETECT) MOV(5,BARRIER_ELEV_DRV_INDEX_NUM) ,XIC(BARRIER_ELEV_BAR_DETECT) MOV(4,BARRIER_ELEV_POS_PB) ] ,EQU(BARRIER_ELEV_POS_PB,2) [CMP(DRV03.ActualPosition-BARRIER_ELEV_RET_INC_OFFSET>0) MOV(6,BARRIER_ELEV_DRV_INDEX_NUM) ,CMP(DRV03.ActualPosition-BARRIER_ELEV_RET_INC_OFFSET<=0) MOV(4,BARRIER_ELEV_POS_PB) ] ,EQU(BARRIER_ELEV_POS_PB,4) MOV(7,BARRIER_ELEV_DRV_INDEX_NUM) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[REG PICK POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)EQU(BARRIER_ELEV_DRV_INDEX_NUM,5)[XIC(BARRIER_ELEV_INDEX_PB) [[ONS(ONS_ARRAY[13]) [OTU(BARRIER_ELEV_MOT_DRV_REG_PICK_POS_CONT.EN) ,OTU(BARRIER_ELEV_MOT_DRV_REG_PICK_POS_CONT.PC) ,MOV(0,BARRIER_ELEV_MOT_DRV_REG_PICK_POS_CONT.ERR) ,OTU(MOTION_DRV_TOP_POS_CONT.EN) ,OTU(MOTION_DRV_TOP_POS_CONT.PC) ,MOV(0,MOTION_DRV_TOP_POS_CONT.ERR) ] ,MAR(DRV03,MOTION_DRV_REG_ARM_PICK_CONT,Positive_Edge,Disabled,0,1000,2) ,[XIC(MOTION_DRV_REG_ARM_PICK_CONT.DN) MAM(DRV03,MOTION_DRV_TOP_POS_CONT,0,BARRIER_ELEV_TOP_POS_VAL,BARRIER_ELEV_MOT_DRV_REG_PICK_POS_SPD,Units per sec,1000,Units per sec2,1000,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,[XIC(BARRIER_ELEV_MOT_DRV_REG_PICK_POS_CONT.PC) ,XIC(MOTION_DRV_TOP_POS_CONT.PC) ] [OTU(BARRIER_ELEV_INDEX_PB) ,OTU(BARRIER_ELEV_MOT_DRV_REG_PICK_POS_CONT.EN) ] ] ] ,XIC(CELL_ALARMS_ACTIVE) [TON(TIMER_ALARM[14],?,?) ,XIC(TIMER_ALARM[14].DN) MOV(471,STEP_ALARM[3]) ] ] ,XIO(BARRIER_ELEV_INDEX_PB) MDR(DRV03,MOTION_DRV_REG_DISARM_PICK_POS_CONT,2) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[INCREMENTAL RETRACT POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)EQU(BARRIER_ELEV_DRV_INDEX_NUM,6)XIC(BARRIER_ELEV_INDEX_PB)[[ADD(BARRIER_ELEV_PICK_OFFSET_SCALED,BARRIER_ELEV_RET_INC_OFFSET_DELTA,BARRIER_ELEV_RET_INC_OFFSET) ,MUL(BARRIER_ELEV_RET_INC_OFFSET,-1,BARRIER_ELEV_RET_INC_OFFSET_NEG) ,MAM(DRV03,MOTION_DRV_INC_RET_POS_CONT,1,BARRIER_ELEV_RET_INC_OFFSET_NEG,75.0,Units per sec,1000.0,Units per sec2,1000.0,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_INC_RET_POS_CONT.PC) OTU(BARRIER_ELEV_INDEX_PB) ] ,XIC(CELL_ALARMS_ACTIVE) [TON(TIMER_ALARM[11],?,?) ,XIC(TIMER_ALARM[11].DN) MOV(477,STEP_ALARM[3]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[OUT OF MAGAZINE POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)EQU(BARRIER_ELEV_DRV_INDEX_NUM,7)XIC(BARRIER_ELEV_INDEX_PB)[[MAM(DRV03,MOTION_DRV_OUT_OF_MAG_POS_CONT,0,BARRIER_ELEV_OUT_OF_MAG_POS_ABS,300,Units per sec,800,Units per sec2,800,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,[XIC(MOTION_DRV_OUT_OF_MAG_POS_CONT.PC) ,LIM(BARRIER_ELEV_OUT_OF_MAG_POS_LOWER,DRV03.ActualPosition,BARRIER_ELEV_OUT_OF_MAG_POS_UPPER) ] OTU(BARRIER_ELEV_INDEX_PB) ] ,XIC(CELL_ALARMS_ACTIVE) [TON(TIMER_ALARM[12],?,?) ,XIC(TIMER_ALARM[12].DN) MOV(473,STEP_ALARM[3]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[RETURN PREV POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)EQU(BARRIER_ELEV_DRV_INDEX_NUM,8)XIC(BARRIER_ELEV_INDEX_PB)[[MAM(DRV03,MOTION_DRV_RETURN_POS_CONT,0,BARRIER_ELEV_RETURN_POS_ABS,75.0,Units per sec,1000.0,Units per sec2,1000.0,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_RETURN_POS_CONT.PC) XIC(BARRIER_ELEV_RETURN_POS) OTU(BARRIER_ELEV_INDEX_PB) ] ,XIC(CELL_ALARMS_ACTIVE) [TON(TIMER_ALARM[13],?,?) ,XIC(TIMER_ALARM[13].DN) MOV(475,STEP_ALARM[3]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[HOMING OFFSET CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)XIC(DRV_HOME_OFF_REQ)[[MAM(DRV03,MOTION_DRV_HOME_OFF_CONT,1,BARRIER_ELEV_DRV_HOME_OFF,30,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_DRV_HOME_OFF_CONT.PC) OTU(DRV_HOME_OFF_REQ) ] ,[TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) [OTU(DRV_HOME_OFF_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(474,STEP_ALARM[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ABORT INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)[XIC(BARRIER_ELEV_ABORT_INDEX_PB) ,XIO(BARRIER_ELEV_DRV_HOMING_IND) XIO(BARRIER_ELEV_CLEAR_TO_INDEX) ][MAS(DRV03,MOTION_DRV_ABORT_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,XIC(MOTION_DRV_ABORT_CONT.PC) OTU(BARRIER_ELEV_ABORT_INDEX_PB) ,XIO(MOTION_DRV_ABORT_CONT.PC) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [OTU(BARRIER_ELEV_ABORT_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(479,STEP_ALARM[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ZERO ENCODER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)XIC(DRV_DEFINE_HOME)[MRP(DRV03,MOTION_DRV_ZERO_CONT,Absolute,Actual,0.0) ,LIM(-.1,DRV03.ActualPosition,0.1) OTU(DRV_DEFINE_HOME) ,[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) [OTU(DRV_DEFINE_HOME) ,XIC(CELL_ALARMS_ACTIVE) MOV(470,STEP_ALARM[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[3],1000) XIC(BARRIER_ELEV_DRV_RESET_PB) [MASR(DRV03,MOTION_DRV_RESET_CONT) ,XIC(MOTION_DRV_ENABLE_CONT.ER) OTU(MOTION_DRV_ENABLE_CONT.ER) ,XIO(BARRIER_ELEV_DRV_FAULT) XIO(BARRIER_ELEV_DRV_SHUTDOWN) XIO(MOTION_DRV_ENABLE_CONT.ER) OTU(BARRIER_ELEV_DRV_RESET_PB) ,[TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(BARRIER_ELEV_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(BARRIER_ELEV_DRV_FAULT) MOV(467,STEP_ALARM[3]) ,XIC(BARRIER_ELEV_DRV_SHUTDOWN) MOV(482,STEP_ALARM[3]) ] ] ] ] ,[XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(10,STEP_HOME[3],499) ] [XIC(BARRIER_ELEV_DRV_FAULT) MOV(467,STEP_ALARM[3]) ,XIC(BARRIER_ELEV_DRV_SHUTDOWN) MOV(482,STEP_ALARM[3]) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[3],1000)[XIC(BARRIER_ELEV_DRV_ENABLE_PB) [MSO(DRV03,MOTION_DRV_ENABLE_CONT) ,[XIO(MOTION_DRV_ENABLE_CONT.DN) ,XIO(BARRIER_ELEV_DRV_READY) ,XIC(BARRIER_ELEV_DRV_FAULT) ,XIC(BARRIER_ELEV_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) [OTU(BARRIER_ELEV_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(480,STEP_ALARM[3]) ] ] ] ,XIO(BARRIER_ELEV_DRV_ENABLE_PB) [MSF(DRV03,MOTION_DRV_DISABLE_CONT) ,XIO(MOTION_DRV_DISABLE_CONT.DN) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) XIC(CELL_ALARMS_ACTIVE) MOV(481,STEP_ALARM[3]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[ACTIVATE BRAKE UPON LEAVING MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)XIO(DRV_BRAKE_FLIP_FLOP)ONS(ONS_ARRAY[8])OTL(BARRIER_ELEV_BRAKE_PB);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[MAIN DIAL BRAKE FLIP FLOP CIRCUIT - ALLOWS ONE MOMENTARY PUSH BUTTON TO ACTIVATE AND DEACTIVE BRAKE]]>
</Comment>
<Text>
<![CDATA[XIC(BARRIER_ELEV_BRAKE_PB)ONS(ONS_ARRAY[10])[MOV(1,BARRIER_ELEV_BRAKE_CONT) ,XIC(DRV_BRAKE_FLIP_FLOP) MOV(0,BARRIER_ELEV_BRAKE_CONT) ,EQU(BARRIER_ELEV_BRAKE_CONT,1) OTL(DRV_BRAKE_FLIP_FLOP) ,NEQ(BARRIER_ELEV_BRAKE_CONT,1) OTU(DRV_BRAKE_FLIP_FLOP) ,[OTU(BARRIER_ELEV_BRAKE_PB) ,OTL(DRV_BRAKE_MSG) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[FLIP FLOP BRAKE CONTROL
THROUGH THE SET SYSTEM VARIABLE
]]>
</Comment>
<Text>
<![CDATA[XIC(DRV_BRAKE_MSG)XIO(BARRIER_ELEV_DRV_MOVING)SSV(Axis,DRV03,MechanicalBrakeControl,BARRIER_ELEV_BRAKE_CONT);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR BARRIER INFEED ELEVATOR
***************************************************************************

POSITION VERIFICATION]]>
</Comment>
<Text>
<![CDATA[[[XIC(METRIC_MACHINE) MOV(BARRIER_ELEV_PICK_OFFSET_RECIPE,BARRIER_ELEV_PICK_OFFSET_SCALED) ,XIO(METRIC_MACHINE) MUL(BARRIER_ELEV_PICK_OFFSET_RECIPE,25.4,BARRIER_ELEV_PICK_OFFSET_SCALED) ] ,XIC(BARRIER_ELEV_DRV_HOMED) [[SUB(BARRIER_ELEV_OUT_OF_MAG_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_OUT_OF_MAG_POS_LOWER) ADD(BARRIER_ELEV_OUT_OF_MAG_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_OUT_OF_MAG_POS_UPPER) ,ADD(DRV03.Registration2Position,BARRIER_ELEV_PICK_OFFSET_SCALED,BARRIER_ELEV_PICK_POS_ABS) SUB(BARRIER_ELEV_PICK_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_PICK_POS_LOWER) ADD(BARRIER_ELEV_PICK_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_PICK_POS_UPPER) ,EQU(BARRIER_ELEV_DRV_INDEX_NUM,6) XIC(BARRIER_ELEV_INDEX_PB) ONS(ONS_ARRAY[7]) MOV(DRV03.ActualPosition,BARRIER_ELEV_CAPTURE_POS) [SUB(BARRIER_ELEV_CAPTURE_POS,BARRIER_ELEV_RET_INC_OFFSET,BARRIER_ELEV_RET_INC_POS_ABS) SUB(BARRIER_ELEV_RET_INC_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_RET_INC_POS_LOWER) ADD(BARRIER_ELEV_RET_INC_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_RET_INC_POS_UPPER) ,SUB(BARRIER_ELEV_CAPTURE_POS,BARRIER_ELEV_RETURN_POS_OFF,BARRIER_ELEV_RETURN_POS_ABS) SUB(BARRIER_ELEV_RETURN_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_RETURN_POS_LOWER) ADD(BARRIER_ELEV_RETURN_POS_ABS,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_RETURN_POS_UPPER) ] ,SUB(BARRIER_ELEV_TOP_POS_VAL,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_TOP_POS_LOWER) ADD(BARRIER_ELEV_TOP_POS_VAL,BARRIER_ELEV_POS_TOL,BARRIER_ELEV_TOP_POS_UPPER) ] ,[LIM(BARRIER_ELEV_OUT_OF_MAG_POS_LOWER,DRV03.ActualPosition,BARRIER_ELEV_OUT_OF_MAG_POS_UPPER) OTE(BARRIER_ELEV_OUT_OF_MAG_POS) ,LIM(BARRIER_ELEV_RET_INC_POS_LOWER,DRV03.ActualPosition,BARRIER_ELEV_RET_INC_POS_UPPER) OTE(BARRIER_ELEV_RET_INC_POS) ,LIM(BARRIER_ELEV_PICK_POS_LOWER,DRV03.ActualPosition,BARRIER_ELEV_PICK_POS_UPPER) OTE(BARRIER_ELEV_PICK_POS) ,LIM(BARRIER_ELEV_TOP_POS_LOWER,DRV03.ActualPosition,BARRIER_ELEV_TOP_POS_UPPER) OTE(BARRIER_ELEV_TOP_POS) ,LIM(BARRIER_ELEV_RETURN_POS_LOWER,DRV03.ActualPosition,BARRIER_ELEV_RETURN_POS_UPPER) OTE(BARRIER_ELEV_RETURN_POS) ] OTE(BARRIER_ELEV_IN_POSITION) ] ,[XIC(CELL_STARTED) XIO(BARRIER_ELEV_DRV_MOVING) ,EQU(STEP_HOME[3],75) ] XIO(BARRIER_ELEV_IN_POSITION) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [OTL(DRV_HOMING_REQ) ,MOV(469,STEP_ALARM[3]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR DRIVE HOMING ROUTINE
***************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(BARRIER_ELEV_DRV_HOME_PB)XIO(DRV_HOMING_REQ)XIO(BARRIER_ELEV_DRV_HOMING_IND)XIC(BARRIER_ELEV_DRV_HOMED_STATUS)OTE(BARRIER_ELEV_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[3],0) ,XIC(BARRIER_ELEV_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[3],500) [EQU(STEP_HOMING[3],500) ,EQU(STEP_HOMING[3],1000) ] ][MOV(10,STEP_HOMING[3]) ,OTL(BARRIER_ELEV_DRV_HOMING_IND) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[3],10)[ONS(ONS_ARRAY[12]) OTL(DRV_INTERNAL_HOME_REQ) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.IP) MOV(15,STEP_HOMING[3]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[3],15)XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC)XIC(BARRIER_ELEV_DRV_HOMED_STATUS)XIO(DRV_INTERNAL_HOME_REQ)MOV(20,STEP_HOMING[3]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[VERIFY HOMED STATUS AND PAUSE BEFORE INITIATING THE NEXT MOVE
IF FAULTED END ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[3],20)[XIC(BARRIER_ELEV_DRV_HOMED_STATUS) [TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) MOV(30,STEP_HOMING[3]) ] ,XIC(BARRIER_ELEV_DRV_FAULT) MOV(100,STEP_HOMING[3]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[REQUEST INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[3],30)[XIO(MOTION_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[3]) OTL(DRV_HOME_OFF_REQ) ,XIC(MOTION_DRV_HOME_OFF_CONT.IP) MOV(35,STEP_HOMING[3]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[COMPLETE INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[3],35)XIC(MOTION_DRV_HOME_OFF_CONT.PC)XIC(BARRIER_ELEV_DRV_HOMED_STATUS)XIO(DRV_HOME_OFF_REQ)MOV(40,STEP_HOMING[3]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SET COUNTER TO ZERO]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[3],40)[ONS(ONS_ARRAY[9]) OTL(DRV_DEFINE_HOME) ,XIO(DRV_DEFINE_HOME) MOV(100,STEP_HOMING[3]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[3],100)[MOV(5,BARRIER_ELEV_DRV_INDEX_NUM) ,OTU(BARRIER_ELEV_DRV_HOMING_IND) OTU(BARRIER_ELEV_DRV_HOME_PB) ,XIO(BARRIER_ELEV_DRV_FAULT) OTU(DRV_HOMING_REQ) ,MOV(500,STEP_HOMING[3]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED ELEVATOR STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(BARRIER_ELEV_DRV_HOMED)XIC(BARRIER_ELEV_DRV_READY)XIO(BARRIER_ELEV_DRV_FAULT)OTE(CELL_AUTO_READY[3]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK THAT EVERYTHING IS CLEAR BEFORE INDEXING]]>
</Comment>
<Text>
<![CDATA[XIC(BARRIER_MAG_IN_POSITION)OTE(BARRIER_ELEV_CLEAR_TO_INDEX);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ELEVATOR PART DETECTED SENSOR]]>
</Comment>
<Text>
<![CDATA[XIC(Local:2:O.Pt01.Data)OTE(BARRIER_ELEV_BAR_DETECT);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[BARRIER PRESENCE IN TOWER CHECK SENSOR DEBOUNCE]]>
</Comment>
<Text>
<![CDATA[[XIC(BARRIER_MAG_TWR_CHK) TON(TIMER_OPER[9],?,?) ,XIC(TIMER_OPER[9].TT) OTE(BARRIER_ELEV_PART_NOT_PRESENT_TIMING) ,[XIC(TIMER_OPER[9].DN) ,XIC(BARRIER_ELEV_TOP_POS) XIO(BARRIER_ELEV_BAR_DETECT) ] OTE(BARRIER_ELEV_PART_NOT_PRESENT) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
