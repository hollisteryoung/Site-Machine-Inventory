<Text>
<![CDATA[[XIC(PNC_PICK_CYL1_EXT_PB) ,XIC(PNC_PICK_CYL1_EXT_DETECTED) ,XIC(PNC_PICK_CYL2_EXT_PB) ,XIC(PNC_PICK_CYL2_EXT_DETECTED) ,XIC(PNC_PRESS_CYL_EXT_PB) ,XIC(PNC_PRESS_CYL_EXT_DETECTED) ]JSR(STATUS,0);]]>
