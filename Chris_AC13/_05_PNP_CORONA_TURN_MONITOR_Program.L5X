<Text>
<![CDATA[XIC(PNP_MOTION_PICK_HEAD_DRV_COR_POS_CONT.EN)[LIM(300,DRV06.ActualPosition,350) OTE(PNP_CORONA_PICK_HEAD_TURN_DIGITAL_SENSOR) ,XIC(PNP_CORONA_PICK_HEAD_TURN_DIGITAL_SENSOR) ONS(ONS_ARRAY[0]) CTU(PNP_CORONA_PICK_HEAD_DRV_COR_TURNS,?,?) ];]]>
