<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[PUNCH AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[16]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],0)[XIC(CELL_STARTED) [XIO(RUN_PROCESS) MOV(5,STEP_AUTO[16]) ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[16]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(PUNCH_CYCLE_PB) MOV(20,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],5)[OTE(PUNCH_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIO(CELL_EMPTY_COMPLETE.9) XIC(PUNCH_DATA_BAR_LOADED) XIO(PUNCH_DATA_BAR_REJECT) [XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIC(PUNCH_DATA_BAG_LOADED) XIO(PUNCH_DATA_GLUE_STARTED) XIO(PUNCH_DATA_BAG_REJECT) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ] [XIC(PUNCH_DATA_PREHEAT1_COMPLETE) ,XIO(PREHEAT1_ACTIVE_RECIPE_LOADED) ] [XIC(PUNCH_DATA_PREHEAT2_COMPLETE) ,XIO(PREHEAT2_ACTIVE_RECIPE_LOADED) ] [XIC(PUNCH_DATA_FORMING_COMPLETE) ,XIO(FORMING_ACTIVE_RECIPE_LOADED) ] XIC(PUNCH_ACTIVE_RECIPE_LOADED) XIO(PUNCH_DATA_PUNCH_STARTED) XIO(PUNCH_DATA_PUNCH_COMPLETE) OTE(RUN_PROCESS) ,EQU(STEP_AUTO[16],10) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[16]) ,XIO(RUN_PROCESS) MOV(150,STEP_AUTO[16]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[EXTEND HOLD DOWN STRIPPERS AND SPRING PACK]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],20)[OTL(PUNCH_STRIP_CYL_EXT_PB) ,OTL(PUNCH_SPRING_PACK_CYL_RET_PB) ,XIC(PUNCH_STRIP1_CYL_EXT) XIC(PUNCH_STRIP2_CYL_EXT) XIC(PUNCH_SPRING_PACK_CYL_RET) MOV(30,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[EXTEND PUNCH CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],30)[OTL(PUNCH_CYL_EXT_PB) ,XIC(CELL_STARTED) OTL(PUNCH_DATA_PUNCH_STARTED) ,XIC(PUNCH_CYL_EXT) MOV(40,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[DELAY TIMER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],40)[TON(TIMER_OPER[0],?,?) ,XIC(TIMER_OPER[0].DN) MOV(50,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[EXTEND MOON CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],50)[XIO(CELL_DRY_CYCLE_MODE_PB) OTL(PUNCH_MOON_CYL_EXT_PB) ,[XIC(PUNCH_MOON_CYL_EXT) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] [XIC(CELL_STARTED) OTL(PUNCH_DATA_PUNCH_COMPLETE) ,[XIC(PUNCH_MOON_BLOW_ACTIVE_RECIPE_LOADED) MOV(55,STEP_AUTO[16]) ,XIO(PUNCH_MOON_BLOW_ACTIVE_RECIPE_LOADED) MOV(60,STEP_AUTO[16]) ] ] ,XIO(PUNCH_MOON_CYL_EXT) [TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) MOV(304,STEP_ALARM[16]) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[MOON BLOW]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],55)[OTL(PUNCH_MOON_BLOW_PB) ,MOV(60,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[DELAY TIMER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],60)[MOV(PUNCH_MOON_BLOW_TIME_PB,TIMER_OPER[1].PRE) ,TON(TIMER_OPER[1],?,?) ,XIC(TIMER_OPER[1].DN) MOV(80,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[EXTEND SPRING PACK CYLINDER AND RETRACT HOLD DOWN STRIPPERS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],80)[OTU(PUNCH_MOON_CYL_EXT_PB) ,OTU(PUNCH_CYL_EXT_PB) ,[OTU(PUNCH_MOON_BLOW_PB) ,[TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) [OTU(PUNCH_SPRING_PACK_CYL_RET_PB) ,OTU(PUNCH_STRIP_CYL_EXT_PB) ] ] ] ,XIC(PUNCH_CYL_RET) XIC(PUNCH_MOON_CYL_RET) XIC(PUNCH_SPRING_PACK_CYL_EXT) XIC(PUNCH_STRIP1_CYL_RET) XIC(PUNCH_STRIP2_CYL_RET) [XIC(CELL_STARTED) MOV(150,STEP_AUTO[16]) ,XIC(CELL_MANUAL_MODE) XIO(PUNCH_CYCLE_PB) MOV(0,STEP_AUTO[16]) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],150)[OTL(PUNCH_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.8) XIO(FORMING_DATA_BAR_LOADED) OTL(CELL_EMPTY_COMPLETE.9) ,TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) MOV(160,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[16],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(PUNCH_PROCESS_DONE) ,MOV(5,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(20,STEP_AUTO[16],150) TON(TIMER_OPER[4],?,?) ,EQU(STEP_AUTO[16],150) ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[4].ACC,1000,CELL_CYCLE_TIME[0].BARRIER_PUNCH) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[16],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].BARRIER_PUNCH,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(7,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_PUNCH,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].BARRIER_PUNCH,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].BARRIER_PUNCH,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(7,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_PUNCH,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
BARRIER PUNCH STATION E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[16],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[16]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[16],1000) EQU(STEP_ALARM_CAPTURE[16],0) MOV(STEP_ALARM[16],STEP_ALARM_CAPTURE[16]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[16],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.16) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[
E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[16],1000)[NEQ(STEP_ALARM[16],0) OTE(MAJOR_FAULT[16]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[16],STEP_AUTO_RET_ESTOP[16]) ,OTU(PUNCH_CYL_EXT_PB) OTU(PUNCH_STRIP_CYL_EXT_PB) OTU(PUNCH_MOON_CYL_EXT_PB) OTU(PUNCH_SPRING_PACK_CYL_RET_PB) OTU(PUNCH_MOON_BLOW_PB) ,OTU(PUNCH_PROCESS_DONE) OTU(PUNCH_CYCLE_PB) ,XIC(PUNCH_DATA_BAR_LOADED) XIO(PUNCH_DATA_BAR_REJECT) XIC(PUNCH_DATA_PUNCH_STARTED) XIO(PUNCH_DATA_PUNCH_COMPLETE) OTE(PUNCH_PROCESS_FAILED) ,MOV(1000,STEP_HOME[16]) ,MOV(1000,STEP_AUTO[16]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[16],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[16]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[16],10)[MOV(0,STEP_ALARM[16]) ,MOV(0,STEP_ALARM_CAPTURE[16]) ,MOV(20,STEP_ESTOP_RESET[16]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[16],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[16]) ,MOV(30,STEP_ESTOP_RESET[16]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[16]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[16],30)EQU(STEP_HOME[16],500)MOV(500,STEP_ESTOP_RESET[16]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
BARRIER PUNCH STATION HMI
***************************************************************************

BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(PUNCH_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(PUNCH_BYPASS_ANIMATION);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PUNCH STATION HOME ROUTINE
***************************************************************************


SET COMPONENTS TO HOME STATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[16],0)[OTU(PUNCH_CYL_EXT_PB) ,OTU(PUNCH_STRIP_CYL_EXT_PB) ,OTU(PUNCH_MOON_CYL_EXT_PB) ,OTU(PUNCH_SPRING_PACK_CYL_RET_PB) ,XIC(PUNCH_CYL_RET) XIC(PUNCH_STRIP1_CYL_RET) XIC(PUNCH_STRIP2_CYL_RET) XIC(PUNCH_MOON_CYL_RET) XIC(PUNCH_SPRING_PACK_CYL_EXT) [MOV(0,STEP_AUTO[16]) ,MOV(500,STEP_HOME[16]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************

]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PUNCH STATION OUTPUTS
***************************************************************************

PUNCH CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[16],1000)XIC(CELL_PRESSURE_OK)[XIC(PUNCH_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [[XIC(PUNCH_PRESSURE_OK) ,XIC(MAN01:O.Data[3].12) ] [OTE(MAN01:O.Data[3].12) ,XIC(CELL_ALARMS_ACTIVE) XIO(PUNCH_CYL_EXT) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(267,STEP_ALARM[16]) ] ] ,XIC(CELL_ALARMS_ACTIVE) XIO(PUNCH_PRESSURE_OK) [TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) MOV(273,STEP_ALARM[16]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(PUNCH_CYL_EXT_PB) ] ,XIO(PUNCH_CYL_EXT_PB) [OTE(MAN01:O.Data[3].13) ,XIC(CELL_ALARMS_ACTIVE) XIO(PUNCH_CYL_RET) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) MOV(268,STEP_ALARM[16]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[PUNCH SPRING PACK CYLINDER CONTROLS]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[16],1000)XIC(CELL_PRESSURE_OK)[XIC(PUNCH_SPRING_PACK_CYL_RET_PB) [OTE(MAN01:O.Data[2].14) ,XIC(CELL_ALARMS_ACTIVE) XIO(PUNCH_SPRING_PACK_CYL_RET) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) MOV(272,STEP_ALARM[16]) ] ] ,XIO(PUNCH_SPRING_PACK_CYL_RET_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PUNCH_SPRING_PACK_CYL_EXT) [TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(274,STEP_ALARM[16]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[
STRIPPER CYLINDERS CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[16],1000)XIC(CELL_PRESSURE_OK)[XIC(PUNCH_STRIP_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN01:O.Data[3].14) ,XIC(CELL_ALARMS_ACTIVE) [XIO(PUNCH_STRIP1_CYL_EXT) ,XIO(PUNCH_STRIP2_CYL_EXT) ] [TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(269,STEP_ALARM[16]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(PUNCH_STRIP_CYL_EXT_PB) ] ,XIO(PUNCH_STRIP_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) [XIO(PUNCH_STRIP1_CYL_RET) ,XIO(PUNCH_STRIP2_CYL_RET) ] [TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) MOV(270,STEP_ALARM[16]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[
MOON CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[16],1000)XIC(CELL_PRESSURE_OK)[XIC(PUNCH_MOON_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) OTE(MAN01:O.Data[2].0) ,XIO(MAIN_DIAL_IN_POSITION) OTU(PUNCH_MOON_CYL_EXT_PB) ] ,XIO(PUNCH_MOON_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PUNCH_MOON_CYL_RET) [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) MOV(271,STEP_ALARM[16]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
MOON BLOW CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[16],1000)XIC(CELL_PRESSURE_OK)XIC(PUNCH_MOON_BLOW_PB)OTE(MAN01:O.Data[2].2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
