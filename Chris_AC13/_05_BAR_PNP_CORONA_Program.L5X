</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],0)[XIC(CELL_STARTED) [XIO(CELL_BAG_LOAD_ONLY_MODE_PB) [XIO(PNP_PICK_HEAD_VAC_ON) MOV(5,STEP_AUTO[5]) ,XIC(PNP_PICK_HEAD_VAC_ON) MOV(60,STEP_AUTO[5]) ] ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) MOV(500,STEP_AUTO[5]) ] ,XIO(CELL_STARTED) XIC(PNP_BASE_COR_POS) XIC(PNP_CORONA_CYCLE_PB) MOV(90,STEP_AUTO[5]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CHECK FOR MAGAZINE REQUEST AND EMPTY REQUEST]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],5)[XIO(CELL_EMPTY_ACTIVE) XIC(BARRIER_MAG_READY_FOR_PROCESS) MOV(10,STEP_AUTO[5]) ,XIC(CELL_EMPTY_ACTIVE) [OTL(CELL_EMPTY_COMPLETE.1) ,MOV(500,STEP_AUTO[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[SET INDEX]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],10)[[XIO(PNP_BASE_BAR_MAG_POS) XIO(BARRIER_ELEV_PART_NOT_PRESENT) XIC(BARRIER_MAG_IN_POSITION) [MOV(4,BASE_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[11]) OTL(PNP_BASE_INDEX_PB) ] ,XIO(PNP_PICK_HEAD_PICK_POS) [MOV(1,PICK_HEAD_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[19]) OTL(PNP_PICK_HEAD_INDEX_PB) ] ] ,XIO(MOTION_BASE_DRV_MAG_POS_CONT.IP) XIO(MOTION_PICK_HEAD_DRV_PICK_POS_CONT.IP) XIC(PNP_BASE_BAR_MAG_POS) XIC(PNP_PICK_HEAD_PICK_POS) MOV(30,STEP_AUTO[5]) ,[TON(TIMER_ALARM[34],?,?) ,XIC(TIMER_ALARM[34].DN) [XIC(PNP_BASE_INDEX_PB) MOV(400,STEP_ALARM[5]) ,XIC(PNP_PICK_HEAD_INDEX_PB) MOV(382,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[RETRACT PICK CYLINDER IF LOOPING AROUND FOR ANOTHER PICK ATTEMPT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],28)[OTU(PNP_PICK_HEAD_CYL_EXT_PB) ,XIC(PNP_PICK_HEAD_CYL_RET) MOV(30,STEP_AUTO[5]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ WAIT FOR ELEVATOR TO REACH POSITION
THEN EXTEND PICK CYLINDER
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],30)XIC(PNP_BASE_BAR_MAG_POS)XIC(PNP_PICK_HEAD_PICK_POS)[[XIC(BARRIER_ELEV_PICK_POS) OTL(PNP_PICK_HEAD_CYL_EXT_PB) ,XIO(PNP_PICK_HEAD_CYL_RET) [CTU(PNP_PICK_HEAD_COUNTER,?,?) ,MOV(40,STEP_AUTO[5]) ] ] ,[XIC(BARRIER_ELEV_PICK_POS) ,XIC(BARRIER_ELEV_RETURN_POS) ] XIC(BARRIER_ELEV_BAR_READY_PICK) [XIC(BARRIER_ELEV_TOP_POS) TON(TIMER_OPER[17],?,?) ,[XIO(BARRIER_ELEV_TOP_POS) ,XIC(TIMER_OPER[17].DN) ] [OTL(PNP_PICK_HEAD_CYL_EXT_PB) ,OTL(PNP_PICK_BAR_BLOW_PB) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[TURN ON VACUUM]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],40)[XIO(CELL_DRY_CYCLE_MODE_PB) OTL(PNP_PICK_HEAD_VAC_ON_PB) ,[XIC(PNP_PICK_HEAD_VAC_ON) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] [TON(TIMER_OPER[14],?,?) ,XIC(TIMER_OPER[14].DN) [OTU(PNP_PICK_FAIL_LAST_TOWER) ,MOV(50,STEP_AUTO[5]) ] ] ,XIO(CELL_DRY_CYCLE_MODE_PB) XIO(PNP_PICK_HEAD_VAC_ON) [TON(TIMER_OPER[15],?,?) ,XIC(TIMER_OPER[15].DN) [XIO(PNP_PICK_HEAD_COUNTER.DN) MOV(28,STEP_AUTO[5]) ,XIC(PNP_PICK_HEAD_COUNTER.DN) MOV(50,STEP_AUTO[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[RETRACT PICK CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],50)[OTU(PNP_PICK_HEAD_CYL_EXT_PB) ,XIC(PNP_PICK_HEAD_CYL_RET) [[XIC(PNP_PICK_HEAD_VAC_ON) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] [XIC(PNP_TAP_ACTIVE_RECIPE) XIC(PNP_PICK_HEAD_CYL_RET) MOV(55,STEP_AUTO[5]) ,XIO(PNP_TAP_ACTIVE_RECIPE) [RES(PNP_PICK_HEAD_COUNTER) ,OTU(BARRIER_ELEV_BAR_READY_PICK) ,OTU(PNP_PICK_BAR_BLOW_PB) ,XIC(PNP_PICK_HEAD_CYL_RET) MOV(60,STEP_AUTO[5]) ] ] ,XIC(PNP_PICK_HEAD_CYL_RET) XIO(CELL_DRY_CYCLE_MODE_PB) XIO(PNP_PICK_HEAD_VAC_ON) [XIO(PNP_PICK_HEAD_COUNTER.DN) MOV(30,STEP_AUTO[5]) ,XIC(PNP_PICK_HEAD_COUNTER.DN) [XIC(PNP_PICK_FAIL_LAST_TOWER) MOV(406,STEP_ALARM[5]) ,XIO(PNP_PICK_FAIL_LAST_TOWER) [OTL(BARRIER_MAG_INDEX_REQ_FROM_PNP) ,OTL(PNP_PICK_FAIL_LAST_TOWER) ,OTU(BARRIER_ELEV_BAR_READY_PICK) ,MOV(170,STEP_AUTO[5]) ] ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[EXTEND PICK CYLINDER A NUMBER OF TIMES TO KNOCK OFF EXTRA BARRIERS IF ACTIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],55)[[XIO(PNP_PICK_HEAD_CYL_EXT_CNT.DN) XIC(PNP_PICK_HEAD_CYL_RET) OTL(PNP_PICK_HEAD_CYL_EXT_PB) ,XIC(PNP_PICK_HEAD_CYL_EXT_PB) [TON(TIMER_OPER[0],?,?) ,CTU(PNP_PICK_HEAD_CYL_EXT_CNT,?,?) ] ,XIC(TIMER_OPER[0].DN) [OTU(PNP_PICK_HEAD_CYL_EXT_PB) ,RES(TIMER_OPER[0]) ] ] ,XIC(PNP_PICK_HEAD_CYL_RET) [XIC(PNP_TAP_ACTIVE_RECIPE) XIC(PNP_PICK_HEAD_CYL_EXT_CNT.DN) ,XIO(PNP_TAP_ACTIVE_RECIPE) XIC(PNP_PICK_HEAD_VAC_ON) ] [[XIC(PNP_PICK_HEAD_VAC_ON) MOV(60,STEP_AUTO[5]) ,XIC(BARRIER_MAG_INDEX_REQ_FROM_PNP) MOV(170,STEP_AUTO[5]) ] ,XIO(PNP_PICK_HEAD_VAC_ON) [XIO(PNP_PICK_HEAD_COUNTER.DN) MOV(30,STEP_AUTO[5]) ,XIC(PNP_PICK_HEAD_COUNTER.DN) [XIO(PNP_PICK_FAIL_LAST_TOWER) [OTL(BARRIER_MAG_INDEX_REQ_FROM_PNP) ,OTL(PNP_PICK_FAIL_LAST_TOWER) ,OTU(BARRIER_ELEV_BAR_READY_PICK) ,MOV(170,STEP_AUTO[5]) ] ,XIC(PNP_PICK_FAIL_LAST_TOWER) MOV(406,STEP_ALARM[5]) ] ] ] [OTU(PNP_PICK_HEAD_CYL_EXT_PB) ,OTU(PNP_PICK_BAR_BLOW_PB) ,RES(PNP_PICK_HEAD_CYL_EXT_CNT) ,OTU(BARRIER_ELEV_BAR_READY_PICK) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[VERIFY BARRIER NOT PRESENT ON CORONA HEAD]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],60)[[XIC(PNP_CORONA_ACTIVE_RECIPE_LOADED) XIC(PNP_BAR_NOT_PRESENT) [XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIO(CELL_BARRIER_PNP_ONLY_MODE_PB) ,[XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_PNP_ONLY_MODE_PB) ] ] MOV(70,STEP_AUTO[5]) ,XIO(PNP_CORONA_ACTIVE_RECIPE_LOADED) MOV(110,STEP_AUTO[5]) ] ,XIC(PNP_CORONA_ACTIVE_RECIPE_LOADED) XIO(PNP_BAR_NOT_PRESENT) MOV(414,STEP_ALARM[5]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[INDEX BASE TO CORONA POS
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],70)[[MOV(6,BASE_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[13]) OTL(PNP_BASE_INDEX_PB) ] ,XIO(MOTION_BASE_DRV_COR_POS_CONT.IP) XIC(PNP_BASE_COR_POS) [XIC(PNP_CORONA_ACTIVE_RECIPE_LOADED) MOV(80,STEP_AUTO[5]) ,XIO(PNP_CORONA_ACTIVE_RECIPE_LOADED) MOV(110,STEP_AUTO[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[ROTATE PART ON PICK HEAD]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],80)[OTL(PNP_CORONA_ON_PB) ,XIC(A:I.Data[3].9) [[MOV(2,PICK_HEAD_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[4]) OTL(PNP_PICK_HEAD_INDEX_PB) ] ,XIO(PNP_MOTION_PICK_HEAD_DRV_COR_POS_CONT.IP) XIC(PNP_PICK_HEAD_COR_POS) MOV(90,STEP_AUTO[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[WAIT FOR MOVE TO COMPLETE AND TURN OFF FLAME]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],90)[[OTU(PNP_CORONA_ON_PB) ,XIC(PNP_MOTION_PICK_HEAD_DRV_COR_POS_CONT.PC) [RES(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER) ,XIC(CELL_STARTED) MOV(110,STEP_AUTO[5]) ,XIO(CELL_STARTED) XIO(PNP_CORONA_CYCLE_PB) MOV(0,STEP_AUTO[5]) ] ] ,[TON(TIMER_ALARM[32],?,?) ,XIC(TIMER_ALARM[32].DN) [[CTU(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER,?,?) ,[CTU(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER_TOT,?,?) ,XIC(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER_TOT.DN) RES(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER_TOT) ] ] ,XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIO(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER.DN) [OTL(PNP_PICK_HEAD_BARRIER_COR_REJECT) ,MOV(110,STEP_AUTO[5]) ] ,[XIC(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER.DN) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) ] MOV(419,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[CHECK FOR BARRIER PLACE REQUEST FROM LIGHT TABLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],110)[XIO(CELL_SHUTDOWN_REQ) XIC(PNP_BARRIER_PLACE_REQ) MOV(120,STEP_AUTO[5]) ,XIC(CELL_SHUTDOWN_REQ) TON(TIMER_OPER[12],?,?) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[INDEX TO LIGHT TABLE POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],120)[[MOV(7,BASE_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[14]) OTL(PNP_BASE_INDEX_PB) ] ,XIO(PNP_PICK_HEAD_PLACE_POS) [MOV(3,PICK_HEAD_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[10]) OTL(PNP_PICK_HEAD_INDEX_PB) ] ,XIC(PNP_BASE_LT_TBL_POS) XIO(MOTION_BASE_DRV_LT_TBL_POS_CONT.IP) XIC(PNP_PICK_HEAD_PLACE_POS) [XIC(PNP_PICK_HEAD_VAC_ON) ,XIC(PNP_BARRIER_DROP_CUR) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] [XIO(CELL_DRY_CYCLE_MODE_PB) XIC(LT_TBL_VAC_ACTIVE_PB) MOV(130,STEP_AUTO[5]) ,[XIO(LT_TBL_VAC_ACTIVE_PB) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] MOV(140,STEP_AUTO[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[EXTEND PICK CYLINDER
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],130)[XIC(LT_TBL_VAC_ACTIVE_PB) OTL(LT_TBL_VAC_ON_PB) ,OTL(PNP_PICK_HEAD_CYL_EXT_PB) ,XIO(PNP_PICK_HEAD_CYL_RET) [TON(TIMER_OPER[8],?,?) ,XIC(TIMER_OPER[8].DN) MOV(140,STEP_AUTO[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[TURN OFF VACUUM ON PNP
ACTIVATE LIGHT TABLE VACUUM IF REQUESTED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],140)[OTU(PNP_PICK_HEAD_VAC_ON_PB) ,XIO(PNP_PICK_HEAD_VAC_ON) XIC(MAN04:O.Data[2].9) [XIO(PNP_BARRIER_DROP_CUR) [OTL(PNP_BARRIER_PRESENT_ON_LT_TBL) ,RES(PNP_BARRIER_DROP_CNT) ] ,XIC(PNP_PICK_HEAD_BARRIER_COR_REJECT) OTL(PNP_BARRIER_ON_LT_TBL_COR_REJECT) ,OTU(PNP_PICK_HEAD_BARRIER_COR_REJECT) ,[TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) [OTU(PNP_BARRIER_DROP_CUR) ,MOV(150,STEP_AUTO[5]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[RETRACT PICK CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],150)[OTU(PNP_PICK_HEAD_CYL_EXT_PB) ,XIC(PNP_PICK_HEAD_CYL_RET) XIO(PNP_PICK_HEAD_VAC_ON) MOV(160,STEP_AUTO[5]) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[ROTATE PICK HEAD BACK TO PICK POSITION IF REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],160)[XIO(PNP_PICK_HEAD_PICK_POS) [MOV(1,PICK_HEAD_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[18]) OTL(PNP_PICK_HEAD_INDEX_PB) ] ,[XIC(MOTION_PICK_HEAD_DRV_PICK_POS_CONT.IP) ,XIC(PNP_PICK_HEAD_PICK_POS) ] MOV(165,STEP_AUTO[5]) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[CHECK IF THE MAGAZINE IS READY FOR PROCESS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],165)[XIO(CELL_EMPTY_ACTIVE) XIC(BARRIER_MAG_READY_FOR_PROCESS) MOV(10,STEP_AUTO[5]) ,[XIO(BARRIER_MAG_READY_FOR_PROCESS) ,XIC(CELL_EMPTY_ACTIVE) ] MOV(170,STEP_AUTO[5]) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[INDEX TO PARK POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[5],170)[[MOV(5,BASE_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) ONS(ONS_ARRAY[8]) OTL(PNP_BASE_INDEX_PB) ] ,XIO(MOTION_PICK_HEAD_DRV_PICK_POS_CONT.IP) XIO(PNP_BASE_DRV_PARK_POS_CONT.IP) XIC(PNP_PICK_HEAD_PICK_POS) XIC(PNP_BASE_PARK_POS) MOV(5,STEP_AUTO[5]) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[MONITOR VACUUM SWITCH DURING AUTO ROUTINE]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_DRY_CYCLE_MODE_PB)LIM(50,STEP_AUTO[5],149)XIO(PNP_PICK_HEAD_VAC_ON)XIO(BARRIER_MAG_INDEX_REQ_FROM_PNP)[TON(TIMER_ALARM[35],?,?) ,XIC(TIMER_ALARM[35].DN) [XIC(PNP_CORONA_ACTIVE_RECIPE_LOADED) MOV(412,STEP_ALARM[5]) ,XIO(PNP_CORONA_ACTIVE_RECIPE_LOADED) [OTL(PNP_BARRIER_DROP_CUR) ,CTU(PNP_BARRIER_DROP_CNT,?,?) ,XIC(PNP_BARRIER_DROP_CNT.DN) MOV(412,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[5],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[5]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[5],1000) EQU(STEP_ALARM_CAPTURE[5],0) MOV(STEP_ALARM[5],STEP_ALARM_CAPTURE[5]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[5],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.5) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[5],1000)[NEQ(STEP_ALARM[5],0) OTE(MAJOR_FAULT[5]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[5],STEP_AUTO_RET_ESTOP[5]) ,[OTU(PNP_BASE_DRV_RESET_PB) OTU(PNP_BASE_DRV_ENABLE_PB) OTU(PNP_BASE_INDEX_PB) OTU(PNP_BASE_ABORT_INDEX_PB) ,OTU(PNP_BASE_DRV_HOME_PB) OTU(BASE_DRV_INTERNAL_HOME_REQ) OTU(BASE_DRV_HOME_OFF_REQ) OTU(BASE_DRV_DEFINE_HOME) OTU(PNP_BASE_DRV_HOMING_IND) ] ,[OTU(PNP_PICK_HEAD_DRV_RESET_PB) OTU(PNP_PICK_HEAD_DRV_ENABLE_PB) OTU(PNP_PICK_HEAD_INDEX_PB) OTU(PNP_PICK_HEAD_ABORT_INDEX_PB) ,OTU(PNP_PICK_HEAD_DRV_HOME_PB) OTU(PICK_HEAD_DRV_INTERNAL_HOME_REQ) OTU(PNP_PICK_HEAD_DRV_HOME_OFF_REQ) OTU(PNP_PICK_HEAD_DRV_DEFINE_HOME) OTU(PNP_PICK_HEAD_DRV_HOMING_IND) ] ,OTU(PNP_PICK_HEAD_CYL_EXT_PB) OTU(PNP_PICK_FAIL_LAST_TOWER) OTU(PNP_BARRIER_DROP_CUR) OTU(PNP_BARRIER_PRESENT_ON_LT_TBL) RES(PNP_BARRIER_DROP_CNT) OTU(PNP_PICK_BAR_BLOW_PB) ,OTU(PNP_CORONA_CYCLE_PB) OTU(PNP_CORONA_ENABLE_PB) OTU(PNP_CORONA_ON_PB) OTU(PNP_PICK_HEAD_BARRIER_COR_REJECT) RES(PNP_PICK_HEAD_COR_INDEX_FAIL_COUNTER) ,MOV(1000,STEP_HOMING[5]) MOV(1000,STEP_HOMING[6]) MOV(1000,STEP_HOME[5]) MOV(1000,STEP_AUTO[5]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[5],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[5]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[5],10)[MOV(0,STEP_ALARM[5]) ,MOV(0,STEP_ALARM_CAPTURE[5]) ,MOV(20,STEP_ESTOP_RESET[5]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[5],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[RES(DRV_ENABLE_COUNTER) ,XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[5]) ,MOV(30,STEP_ESTOP_RESET[5]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[5]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[5],30)EQU(STEP_HOME[5],500)MOV(500,STEP_ESTOP_RESET[5]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT HMI
***************************************************************************

BASE DRIVE INDEXING ANIMATION]]>
</Comment>
<Text>
<![CDATA[[[LIM(0.1,DRV05.ActualVelocity,-0.1) XIC(PNP_BASE_DRV_MOVING) ,XIC(PNP_BASE_INDEX_PB) ] [OTE(PNP_BASE_INDEXING_IND) ,TON(TIMER_OPER[16],?,?) ] ,XIC(TIMER_OPER[16].TT) MOV(TIMER_OPER[16].ACC,BASE_INDEXING_CYCLE_TIME) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT HMI
***************************************************************************

PICK HEAD DRIVE INDEXING ANIMATION]]>
</Comment>
<Text>
<![CDATA[[[LIM(0.1,DRV06.ActualVelocity,-0.1) XIC(PNP_PICK_HEAD_DRV_MOVING) ,XIC(PNP_PICK_HEAD_INDEX_PB) ] [OTE(PNP_PICK_HEAD_INDEXING_IND) ,TON(TIMER_OPER[18],?,?) ] ,XIC(TIMER_OPER[18].TT) MOV(TIMER_OPER[18].ACC,PICK_HEAD_INDEXING_CYCLE_TIME) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[BASE DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[5],500)[[XIO(CELL_STARTED) XIO(PNP_BASE_DRV_FAULT) XIO(PNP_BASE_DRV_SHUTDOWN) [XIO(PNP_BASE_DRV_HOMING_IND) OTE(PNP_BASE_DRV_ENABLE_PB_VIS) ,XIC(PNP_CLEAR_TO_INDEX) XIC(PNP_BASE_DRV_READY) [OTE(PNP_BASE_DRV_HOME_PB_VIS) ,XIC(PNP_BASE_DRV_HOMED) OTE(PNP_BASE_DRV_PB_VIS) ] ] ,[XIC(PNP_BASE_DRV_FAULT) ,XIC(PNP_BASE_DRV_SHUTDOWN) ,XIC(MOTION_BASE_DRV_ENABLE_CONT.ER) ] OTE(PNP_BASE_DRV_FAULT_PB_VIS) ] ,[XIO(CELL_STARTED) XIO(PNP_PICK_HEAD_DRV_FAULT) XIO(PNP_PICK_HEAD_DRV_SHUTDOWN) [XIO(PNP_PICK_HEAD_DRV_HOMING_IND) OTE(PNP_PICK_HEAD_DRV_ENABLE_PB_VIS) ,XIC(PNP_PICK_HEAD_DRV_READY) [OTE(PNP_PICK_HEAD_DRV_HOME_PB_VIS) ,XIC(PNP_PICK_HEAD_DRV_HOMED) OTE(PNP_PICK_HEAD_DRV_PB_VIS) ] ] ,[XIC(PNP_PICK_HEAD_DRV_FAULT) ,XIC(PNP_PICK_HEAD_DRV_SHUTDOWN) ,XIC(MOTION_PICK_HEAD_DRV_ENABLE_CONT.ER) ] OTE(PNP_PICK_HEAD_DRV_FAULT_PB_VIS) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[PICK HEAD EXTEND PUSH BUTTON VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[XIC(PNP_BASE_BAR_MAG_POS) ,XIC(PNP_BASE_LT_TBL_POS) ]OTE(PNP_PICK_HEAD_CYL_EXT_PB_VIS);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CORONA PUSH BUTTON ON HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)XIO(CELL_STARTED)XIC(CELL_MANUAL_MODE)[OTE(PNP_CORONA_ENABLE_PB_VIS) ,XIC(A:O.Data[3].9) OTE(PNP_CORONA_ON_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MANUAL MODE CYCLE HMI VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_STARTED)XIC(CELL_KEY_AUTO_MODE)XIC(CELL_MANUAL_MODE)XIO(PNP_BASE_DRV_FAULT)XIC(PNP_BASE_DRV_READY)XIO(PNP_BASE_INDEXING_IND)XIC(PNP_BASE_COR_POS)XIC(PNP_CORONA_ACTIVE_RECIPE_LOADED)XIO(PNP_CORONA_FAULTED)OTE(PNP_CORONA_CYCLE_PB_VIS);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(PNP_CORONA_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(PNP_CORONA_BYPASS_ANIMATION);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[DRIVE POSITION FOR HMI]]>
</Comment>
<Text>
<![CDATA[[MUL(DRV05.ActualPosition,100.0,PNP_BASE_CUR_POS_HMI) ,MUL(DRV06.ActualPosition,100.0,PNP_PICK_HEAD_CUR_POS_HMI) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT HOME ROUTINE
***************************************************************************

RESET FAULTS AND SHUTDOWN STATE OF DRIVES
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],0)[[XIC(PNP_BASE_DRV_FAULT) ,XIC(PNP_BASE_DRV_SHUTDOWN) ] OTL(PNP_BASE_DRV_RESET_PB) ,[XIC(PNP_PICK_HEAD_DRV_FAULT) ,XIC(PNP_PICK_HEAD_DRV_SHUTDOWN) ] OTL(PNP_PICK_HEAD_DRV_RESET_PB) ,XIO(PNP_BASE_DRV_FAULT) XIO(PNP_BASE_DRV_SHUTDOWN) XIO(PNP_PICK_HEAD_DRV_FAULT) XIO(PNP_PICK_HEAD_DRV_SHUTDOWN) MOV(10,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TORQUE SAFE INPUTS TO ACTIVATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],10)[XIO(PNP_BASE_DRV_SAFE_TRQ_OFF) XIO(PNP_PICK_HEAD_DRV_SAFE_TRQ_OFF) MOV(20,STEP_HOME[5]) ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) [XIC(PNP_BASE_DRV_SAFE_TRQ_OFF) MOV(413,STEP_ALARM[5]) ,XIC(PNP_PICK_HEAD_DRV_SAFE_TRQ_OFF) MOV(375,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVES]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],20)[OTL(PNP_BASE_DRV_ENABLE_PB) OTL(PNP_PICK_HEAD_DRV_ENABLE_PB) ,XIC(PNP_BASE_DRV_READY) XIC(PNP_PICK_HEAD_DRV_READY) MOV(25,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[RESET COMPONENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],25)[OTL(PNP_CORONA_ENABLE_PB) ,XIO(PNP_PICK_HEAD_VAC_ON) OTU(PNP_PICK_HEAD_VAC_ON_PB) ,XIC(PNP_PICK_HEAD_CYL_RET) MOV(30,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF DRIVES REQUIRE HOMING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],30)[[XIO(PNP_BASE_DRV_HOMED) [OTL(PNP_BASE_DRV_HOMING_IND) ,MOV(35,STEP_HOME[5]) ] ,XIC(PNP_BASE_DRV_HOMED) XIO(PNP_PICK_HEAD_DRV_HOMED) [OTL(PNP_PICK_HEAD_DRV_HOMING_IND) ,MOV(38,STEP_HOME[5]) ] ] ,XIC(PNP_BASE_DRV_HOMED) XIC(PNP_PICK_HEAD_DRV_HOMED) MOV(40,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[START BASE DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[5]) ,XIC(PNP_BASE_DRV_HOMED) MOV(30,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[START PICK HEAD DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],38)[ONS(ONS_ARRAY[7]) MOV(0,STEP_HOMING[6]) ,XIC(PNP_BASE_DRV_HOMED) XIC(PNP_PICK_HEAD_DRV_HOMED) MOV(40,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[DETERMINE IF NEED TO MOVE THE PICK-N-PLACE TO THE PARK POSITION OR THE PICK HEAD TO THE PICK POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],40)[XIO(PNP_BASE_PARK_POS) MOV(50,STEP_HOME[5]) ,XIC(PNP_BASE_PARK_POS) XIO(PNP_PICK_HEAD_PICK_POS) MOV(60,STEP_HOME[5]) ,XIC(PNP_BASE_PARK_POS) XIC(PNP_PICK_HEAD_PICK_POS) MOV(100,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[INDEX TO PARK POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],50)[MOV(5,BASE_DRV_INDEX_NUM) ,XIC(PNP_CLEAR_TO_INDEX) XIO(MOTION_BASE_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[2]) OTL(PNP_BASE_INDEX_PB) ,XIC(PNP_BASE_PARK_POS) XIC(MOTION_BASE_DRV_PARK_POS_CONT.PC) XIO(PNP_BASE_INDEX_PB) [XIO(PNP_PICK_HEAD_PICK_POS) MOV(60,STEP_HOME[5]) ,XIC(PNP_PICK_HEAD_PICK_POS) MOV(100,STEP_HOME[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[INDEX PICK HEAD TO THE START POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],60)[MOV(1,PICK_HEAD_DRV_INDEX_NUM) ,XIO(MOTION_PICK_HEAD_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[5]) OTL(PNP_PICK_HEAD_INDEX_PB) ,XIC(PNP_PICK_HEAD_PICK_POS) XIC(MOTION_PICK_HEAD_DRV_PICK_POS_CONT.PC) XIO(PNP_PICK_HEAD_INDEX_PB) MOV(100,STEP_HOME[5]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[COMPLETE ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],100)[MOV(0,STEP_AUTO[5]) ,MOV(500,STEP_HOME[5]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************
]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(SERVO_HOMING_BASE,0) ,JSR(SERVO_HOMING_PICK_HEAD,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(POSITION_MONITOR,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT OUTPUTS
***************************************************************************

INITIATE INTERNAL DRIVE HOMING ROUTINES]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)[XIC(BASE_DRV_INTERNAL_HOME_REQ) [MAH(DRV05,MOTION_BASE_DRV_INTERNAL_HOME_CONT) ,XIC(MOTION_BASE_DRV_INTERNAL_HOME_CONT.PC) XIC(DRV05.AxisHomedStatus) OTU(BASE_DRV_INTERNAL_HOME_REQ) ,[TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(BASE_DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(417,STEP_ALARM[5]) ] ] ] ,XIC(PICK_HEAD_DRV_INTERNAL_HOME_REQ) [MAH(DRV06,MOTION_PICK_HEAD_DRV_INTERNAL_HOME_CONT) ,XIC(MOTION_PICK_HEAD_DRV_INTERNAL_HOME_CONT.PC) XIC(PNP_PICK_HEAD_DRV_HOMED_STATUS) OTU(PICK_HEAD_DRV_INTERNAL_HOME_REQ) ,[TON(TIMER_ALARM[15],?,?) ,XIC(TIMER_ALARM[15].DN) [OTU(PICK_HEAD_DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(377,STEP_ALARM[5]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONTROLS MANUAL MODE  HMI PICK-N-PLACE BASE DRIVE INDEXES]]>
</Comment>
<Text>
<![CDATA[EQU(CELL_HMI_CURRENT_SCREEN,32)XIO(CELL_STARTED)[EQU(STEP_HOME[5],500) ,EQU(STEP_HOME[5],1000) ][XIO(PNP_BASE_DRV_HOMING_IND) [EQU(PNP_BASE_POS_PB,1) MOV(4,BASE_DRV_INDEX_NUM) ,EQU(PNP_BASE_POS_PB,2) MOV(5,BASE_DRV_INDEX_NUM) ,EQU(PNP_BASE_POS_PB,4) MOV(6,BASE_DRV_INDEX_NUM) ,EQU(PNP_BASE_POS_PB,8) MOV(7,BASE_DRV_INDEX_NUM) ] ,XIO(PNP_PICK_HEAD_DRV_HOMING_IND) [EQU(PNP_PICK_HEAD_POS_PB,1) MOV(1,PICK_HEAD_DRV_INDEX_NUM) ,EQU(PNP_PICK_HEAD_POS_PB,2) MOV(2,PICK_HEAD_DRV_INDEX_NUM) ,EQU(PNP_PICK_HEAD_POS_PB,4) MOV(3,PICK_HEAD_DRV_INDEX_NUM) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[DRIVE INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)[[[EQU(BASE_DRV_INDEX_NUM,4) XIC(PNP_BASE_BAR_MAG_POS) ,EQU(BASE_DRV_INDEX_NUM,5) XIC(PNP_BASE_PARK_POS) ,EQU(BASE_DRV_INDEX_NUM,6) XIC(PNP_BASE_COR_POS) ,EQU(BASE_DRV_INDEX_NUM,7) XIC(PNP_BASE_LT_TBL_POS) ] OTU(PNP_BASE_INDEX_PB) ,XIO(PNP_CLEAR_TO_INDEX) [XIC(PNP_BASE_INDEX_PB) ,XIC(BASE_DRV_HOME_OFF_REQ) ,XIC(BASE_DRV_INTERNAL_HOME_REQ) ] XIO(PNP_PICK_HEAD_CYL_RET) OTU(PNP_PICK_HEAD_CYL_EXT_PB) ] ,[EQU(PICK_HEAD_DRV_INDEX_NUM,1) XIC(PNP_PICK_HEAD_PICK_POS) ,EQU(PICK_HEAD_DRV_INDEX_NUM,2) XIC(PNP_PICK_HEAD_COR_POS) ,EQU(PICK_HEAD_DRV_INDEX_NUM,3) XIC(PNP_PICK_HEAD_PLACE_POS) ] OTU(PNP_PICK_HEAD_INDEX_PB) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[HOMING OFFSET CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)[XIC(BASE_DRV_HOME_OFF_REQ) [[MAM(DRV05,MOTION_BASE_DRV_HOME_OFF_CONT,1,PNP_BASE_DRV_HOME_OFF,30,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_BASE_DRV_HOME_OFF_CONT.PC) OTU(BASE_DRV_HOME_OFF_REQ) ] ,[TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) [OTU(BASE_DRV_HOME_OFF_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(416,STEP_ALARM[5]) ] ] ] ,XIC(PNP_PICK_HEAD_DRV_HOME_OFF_REQ) [[MAM(DRV06,MOTION_PICK_HEAD_DRV_HOME_OFF_CONT,1,PNP_PICK_HEAD_DRV_HOME_OFF,30,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_PICK_HEAD_DRV_HOME_OFF_CONT.PC) OTU(PNP_PICK_HEAD_DRV_HOME_OFF_REQ) ] ,[TON(TIMER_ALARM[14],?,?) ,XIC(TIMER_ALARM[14].DN) [OTU(PNP_PICK_HEAD_DRV_HOME_OFF_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(374,STEP_ALARM[5]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MAGAZINE POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)EQU(BASE_DRV_INDEX_NUM,4)XIC(PNP_BASE_INDEX_PB)[[MAM(DRV05,MOTION_BASE_DRV_MAG_POS_CONT,0,PNP_BASE_BAR_MAG_POS_VAL,300,Units per sec,1300,Units per sec2,1300,Units per sec2,Trapezoidal,40,40,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_BASE_DRV_MAG_POS_CONT.PC) OTU(PNP_BASE_INDEX_PB) ] ,[TON(TIMER_ALARM[21],?,?) ,XIC(TIMER_ALARM[21].DN) [OTU(PNP_BASE_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(400,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[PARK POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)EQU(BASE_DRV_INDEX_NUM,5)XIC(PNP_BASE_INDEX_PB)[[MAM(DRV05,MOTION_BASE_DRV_PARK_POS_CONT,0,PNP_BASE_PARK_POS_VAL,300,Units per sec,1300,Units per sec2,1300,Units per sec2,Trapezoidal,40,40,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_BASE_DRV_PARK_POS_CONT.PC) OTU(PNP_BASE_INDEX_PB) ] ,[TON(TIMER_ALARM[22],?,?) ,XIC(TIMER_ALARM[22].DN) [OTU(PNP_BASE_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(403,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CORONA POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)EQU(BASE_DRV_INDEX_NUM,6)XIC(PNP_BASE_INDEX_PB)[[MAM(DRV05,MOTION_BASE_DRV_COR_POS_CONT,0,PNP_BASE_COR_POS_RECIPE,300,Units per sec,1300,Units per sec2,1300,Units per sec2,Trapezoidal,40,40,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_BASE_DRV_COR_POS_CONT.PC) OTU(PNP_BASE_INDEX_PB) ] ,[TON(TIMER_ALARM[23],?,?) ,XIC(TIMER_ALARM[23].DN) [OTU(PNP_BASE_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(404,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[LIGHT TABLE POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)EQU(BASE_DRV_INDEX_NUM,7)XIC(PNP_BASE_INDEX_PB)[[MAM(DRV05,MOTION_BASE_DRV_LT_TBL_POS_CONT,0,PNP_BASE_LT_TBL_POS_VAL,300,Units per sec,1300,Units per sec2,1300,Units per sec2,Trapezoidal,40,40,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_BASE_DRV_LT_TBL_POS_CONT.PC) OTU(PNP_BASE_INDEX_PB) ] ,[TON(TIMER_ALARM[24],?,?) ,XIC(TIMER_ALARM[24].DN) [OTU(PNP_BASE_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(405,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[PICK HEAD PICK POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)EQU(PICK_HEAD_DRV_INDEX_NUM,1)XIC(PNP_PICK_HEAD_INDEX_PB)[[MAM(DRV06,MOTION_PICK_HEAD_DRV_PICK_POS_CONT,2,PNP_PICK_HEAD_PICK_POS_VAL,1100,Units per sec,5000,Units per sec2,5000,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_PICK_HEAD_DRV_PICK_POS_CONT.PC) OTU(PNP_PICK_HEAD_INDEX_PB) ] ,[TON(TIMER_ALARM[27],?,?) ,XIC(TIMER_ALARM[27].DN) [OTU(PNP_PICK_HEAD_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(382,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[PICK HEAD CORONA POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)EQU(PICK_HEAD_DRV_INDEX_NUM,2)XIC(PNP_PICK_HEAD_INDEX_PB)[[MUL(PNP_PICK_HEAD_COR_TURN_RECIPE,360,PNP_PICK_HEAD_COR_TURN_VAL) ,MAM(DRV06,PNP_MOTION_PICK_HEAD_DRV_COR_POS_CONT,1,PNP_PICK_HEAD_COR_TURN_VAL,PNP_PICK_HEAD_COR_SPD_RECIPE,Units per sec,7500,Units per sec2,7500,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(PNP_MOTION_PICK_HEAD_DRV_COR_POS_CONT.PC) OTU(PNP_PICK_HEAD_INDEX_PB) ] ,[TON(TIMER_ALARM[28],?,?) ,XIC(TIMER_ALARM[28].DN) [OTU(PNP_PICK_HEAD_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(383,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[PICK HEAD PLACE POSITION INDEX CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)EQU(PICK_HEAD_DRV_INDEX_NUM,3)XIC(PNP_PICK_HEAD_INDEX_PB)[[MAM(DRV06,MOTION_PICK_HEAD_DRV_PLACE_POS_CONT,2,PNP_ORIENT_RECIPE_VAL,1100,Units per sec,5000,Units per sec2,5000,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MOTION_PICK_HEAD_DRV_PLACE_POS_CONT.PC) OTU(PNP_PICK_HEAD_INDEX_PB) ] ,[TON(TIMER_ALARM[29],?,?) ,XIC(TIMER_ALARM[29].DN) [OTU(PNP_PICK_HEAD_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(384,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[ABORT INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)[[XIC(PNP_BASE_ABORT_INDEX_PB) ,XIO(PNP_CLEAR_TO_INDEX) ] [MAS(DRV05,MOTION_BASE_DRV_ABORT_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,XIC(MOTION_BASE_DRV_ABORT_CONT.PC) OTU(PNP_BASE_ABORT_INDEX_PB) ,XIO(MOTION_BASE_DRV_ABORT_CONT.PC) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [OTU(PNP_BASE_ABORT_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(418,STEP_ALARM[5]) ] ] ] ,XIC(PNP_PICK_HEAD_ABORT_INDEX_PB) [MAS(DRV06,MOTION_PICK_HEAD_DRV_ABORT_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,XIC(MOTION_PICK_HEAD_DRV_ABORT_CONT.PC) OTU(PNP_PICK_HEAD_ABORT_INDEX_PB) ,XIO(MOTION_PICK_HEAD_DRV_ABORT_CONT.PC) [TON(TIMER_ALARM[12],?,?) ,XIC(TIMER_ALARM[12].DN) [OTU(PNP_PICK_HEAD_ABORT_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(378,STEP_ALARM[5]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[ZERO ENCODER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)[XIC(BASE_DRV_DEFINE_HOME) [MRP(DRV05,MOTION_BASE_DRV_ZERO_CONT,Absolute,Actual,0.0) ,LIM(-0.01,DRV05.ActualPosition,0.01) OTU(BASE_DRV_DEFINE_HOME) ,[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) [OTU(BASE_DRV_DEFINE_HOME) ,XIC(CELL_ALARMS_ACTIVE) MOV(401,STEP_ALARM[5]) ] ] ] ,XIC(PNP_PICK_HEAD_DRV_DEFINE_HOME) [MRP(DRV06,MOTION_PICK_HEAD_DRV_ZERO_CONT,Absolute,Actual,0.0) ,LIM(359.8,DRV06.ActualPosition,0.1) OTU(PNP_PICK_HEAD_DRV_DEFINE_HOME) ,[TON(TIMER_ALARM[13],?,?) ,XIC(TIMER_ALARM[13].DN) [OTU(PNP_PICK_HEAD_DRV_DEFINE_HOME) ,XIC(CELL_ALARMS_ACTIVE) MOV(373,STEP_ALARM[5]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[5],1000) [XIC(PNP_BASE_DRV_RESET_PB) [MASR(DRV05,MOTION_BASE_DRV_RESET_CONT) ,XIC(MOTION_BASE_DRV_ENABLE_CONT.ER) OTU(MOTION_BASE_DRV_ENABLE_CONT.ER) ,XIO(PNP_BASE_DRV_FAULT) XIO(PNP_BASE_DRV_SHUTDOWN) XIO(MOTION_BASE_DRV_ENABLE_CONT.ER) OTU(PNP_BASE_DRV_RESET_PB) ,TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(PNP_BASE_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(PNP_BASE_DRV_FAULT) MOV(402,STEP_ALARM[5]) ,XIC(PNP_BASE_DRV_SHUTDOWN) MOV(421,STEP_ALARM[5]) ] ] ] ,XIC(PNP_PICK_HEAD_DRV_RESET_PB) [MASR(DRV06,MOTION_PICK_HEAD_DRV_RESET_CONT) ,XIC(MOTION_PICK_HEAD_DRV_ENABLE_CONT.ER) OTU(MOTION_PICK_HEAD_DRV_ENABLE_CONT.ER) ,XIO(PNP_PICK_HEAD_DRV_FAULT) XIO(PNP_PICK_HEAD_DRV_SHUTDOWN) XIO(MOTION_PICK_HEAD_DRV_ENABLE_CONT.ER) OTU(PNP_PICK_HEAD_DRV_RESET_PB) ,TON(TIMER_ALARM[18],?,?) ,XIC(TIMER_ALARM[18].DN) [OTU(PNP_PICK_HEAD_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(PNP_BASE_DRV_FAULT) MOV(370,STEP_ALARM[5]) ,XIC(PNP_BASE_DRV_SHUTDOWN) MOV(381,STEP_ALARM[5]) ] ] ] ] ,[XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(10,STEP_HOME[5],499) ] [[XIC(PNP_BASE_DRV_FAULT) MOV(402,STEP_ALARM[5]) ,XIC(PNP_BASE_DRV_SHUTDOWN) MOV(421,STEP_ALARM[5]) ] ,[XIC(PNP_PICK_HEAD_DRV_FAULT) MOV(370,STEP_ALARM[5]) ,XIC(PNP_PICK_HEAD_DRV_SHUTDOWN) MOV(381,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)[[XIC(PNP_BASE_DRV_ENABLE_PB) [MSO(DRV05,MOTION_BASE_DRV_ENABLE_CONT) ,[XIO(MOTION_BASE_DRV_ENABLE_CONT.DN) ,XIO(PNP_BASE_DRV_READY) ,XIC(PNP_BASE_DRV_FAULT) ,XIC(PNP_BASE_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) [OTU(PNP_BASE_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(419,STEP_ALARM[5]) ] ] ] ,XIC(PNP_PICK_HEAD_DRV_ENABLE_PB) [MSO(DRV06,MOTION_PICK_HEAD_DRV_ENABLE_CONT) ,[XIO(MOTION_PICK_HEAD_DRV_ENABLE_CONT.DN) ,XIO(PNP_PICK_HEAD_DRV_READY) ,XIC(PNP_PICK_HEAD_DRV_FAULT) ,XIC(PNP_PICK_HEAD_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[16],?,?) ,XIC(TIMER_ALARM[16].DN) [OTU(PNP_PICK_HEAD_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(379,STEP_ALARM[5]) ] ] ] ] ,[XIO(PNP_BASE_DRV_ENABLE_PB) [MSF(DRV05,MOTION_BASE_DRV_DISABLE_CONT) ,XIO(MOTION_BASE_DRV_DISABLE_CONT.DN) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) XIC(CELL_ALARMS_ACTIVE) MOV(420,STEP_ALARM[5]) ] ] ,XIO(PNP_PICK_HEAD_DRV_ENABLE_PB) [MSF(DRV06,MOTION_PICK_HEAD_DRV_DISABLE_CONT) ,XIO(MOTION_PICK_HEAD_DRV_DISABLE_CONT.DN) [TON(TIMER_ALARM[17],?,?) ,XIC(TIMER_ALARM[17].DN) XIC(CELL_ALARMS_ACTIVE) MOV(380,STEP_ALARM[5]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[PNP PICK HEAD DRIVE POSITION REDEFINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)XIC(PNP_PICK_HEAD_POS_REDEFINE)[MRP(DRV06,MOTION_PICK_HEAD_DRV_POS_REDEFINE,Absolute,Actual,0) ,XIO(MOTION_PICK_HEAD_DRV_POS_REDEFINE.DN) [TON(TIMER_ALARM[30],?,?) ,XIC(TIMER_ALARM[30].DN) XIC(CELL_ALARMS_ACTIVE) MOV(385,STEP_ALARM[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[PICK-N-PLACE PICK CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)XIC(CELL_PRESSURE_OK)[[XIC(PNP_BASE_BAR_MAG_POS) XIO(BARRIER_MAG_INDEXING_IND) ,XIC(PNP_BASE_LT_TBL_POS) ] XIC(PNP_PICK_HEAD_CYL_EXT_PB) [OTE(MAN03:O.Data[0].0) ,XIC(CELL_ALARMS_ACTIVE) XIC(PNP_PICK_HEAD_CYL_RET) [TON(TIMER_ALARM[25],?,?) ,XIC(TIMER_ALARM[25].DN) MOV(410,STEP_ALARM[5]) ] ] ,[XIO(PNP_BASE_BAR_MAG_POS) ,XIC(BARRIER_MAG_INDEXING_IND) ] XIO(PNP_BASE_LT_TBL_POS) OTU(PNP_PICK_HEAD_CYL_EXT_PB) ,XIO(PNP_PICK_HEAD_CYL_EXT_PB) XIC(CELL_ALARMS_ACTIVE) XIO(PNP_PICK_HEAD_CYL_RET) [TON(TIMER_ALARM[26],?,?) ,XIC(TIMER_ALARM[26].DN) MOV(411,STEP_ALARM[5]) ] ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[BARRIER PICK BLOW CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)XIC(CELL_PRESSURE_OK)XIC(PNP_PICK_BAR_BLOW_PB)OTE(PNP_PICK_BAR_BLOW);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[CORONA CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[5],1000)[XIC(PNP_CORONA_ON_PB) [OTE(A:O.Data[3].8) ,XIC(CELL_ALARMS_ACTIVE) XIO(A:I.Data[3].9) [TON(TIMER_ALARM[33],?,?) ,XIC(TIMER_ALARM[33].DN) MOV(422,STEP_ALARM[5]) ] ] ,XIC(PNP_CORONA_ENABLE_PB) OTE(A:O.Data[3].9) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[VACUUM CONTROL]]>
</Comment>
<Text>
<![CDATA[XIC(PNP_PICK_HEAD_VAC_ON_PB)OTE(MAN03:O.Data[0].2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR BARRIER PICK-N-PLACE/CORONA TREAT
********************************************************************************

BASE DRIVE POSITION VERIFICATION]]>
</Comment>
<Text>
<![CDATA[[XIC(PNP_BASE_DRV_HOMED) [[[SUB(PNP_BASE_BAR_MAG_POS_VAL,PNP_POS_TOL,PNP_BASE_BAR_MAG_POS_LOW) ADD(PNP_BASE_BAR_MAG_POS_VAL,PNP_POS_TOL,PNP_BASE_BAR_MAG_POS_UP) ,SUB(PNP_BASE_PARK_POS_VAL,PNP_POS_TOL,PNP_BASE_PARK_POS_LOW) ADD(PNP_BASE_PARK_POS_VAL,PNP_POS_TOL,PNP_BASE_PARK_POS_UP) ,SUB(PNP_BASE_COR_POS_RECIPE,PNP_POS_TOL,PNP_BASE_CORONA_POS_LOW) ADD(PNP_BASE_COR_POS_RECIPE,PNP_POS_TOL,PNP_BASE_CORONA_POS_UP) ,SUB(PNP_BASE_LT_TBL_POS_VAL,PNP_POS_TOL,PNP_BASE_LT_TBL_POS_LOW) ADD(PNP_BASE_LT_TBL_POS_VAL,PNP_POS_TOL,PNP_BASE_LT_TBL_POS_UP) ] ,[LIM(PNP_BASE_BAR_MAG_POS_LOW,DRV05.ActualPosition,PNP_BASE_BAR_MAG_POS_UP) OTE(PNP_BASE_BAR_MAG_POS) ,LIM(PNP_BASE_PARK_POS_LOW,DRV05.ActualPosition,PNP_BASE_PARK_POS_UP) OTE(PNP_BASE_PARK_POS) ,LIM(PNP_BASE_CORONA_POS_LOW,DRV05.ActualPosition,PNP_BASE_CORONA_POS_UP) OTE(PNP_BASE_COR_POS) ,LIM(PNP_BASE_LT_TBL_POS_LOW,DRV05.ActualPosition,PNP_BASE_LT_TBL_POS_UP) OTE(PNP_BASE_LT_TBL_POS) ] OTE(PNP_BASE_IN_POSITION) ] ,LEQ(DRV05.ActualPosition,100) OTE(PNP_BASE_CLEAR_LT_TBL) ] ,[XIC(CELL_STARTED) XIO(PNP_BASE_DRV_MOVING) XIO(PNP_BASE_IN_POSITION) ,EQU(STEP_HOME[5],50) XIO(PNP_BASE_PARK_POS) ] [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [OTL(BASE_DRV_HOMING_REQ) ,MOV(407,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[PICK HEAD DRIVE POSITION VERIFICATION]]>
</Comment>
<Text>
<![CDATA[[XIC(PNP_PICK_HEAD_DRV_HOMED) [[SUB(360,PNP_POS_TOL,PNP_PICK_HEAD_PICK_POS_LOW) ADD(0,PNP_POS_TOL,PNP_PICK_HEAD_PICK_POS_UP) ,SUB(360,PNP_POS_TOL,PNP_PICK_HEAD_COR_POS_LOW) ADD(0,PNP_POS_TOL,PNP_PICK_HEAD_COR_POS_UP) ,SUB(PNP_ORIENT_RECIPE_VAL,PNP_POS_TOL,PNP_PICK_HEAD_PLACE_POS_LOW) ADD(PNP_ORIENT_RECIPE_VAL,PNP_POS_TOL,PNP_PICK_HEAD_PLACE_POS_UP) ] ,XIO(MOTION_PICK_HEAD_DRV_PICK_POS_CONT.IP) XIO(MOTION_PICK_HEAD_DRV_PLACE_POS_CONT.IP) XIO(PNP_MOTION_PICK_HEAD_DRV_COR_POS_CONT.IP) [LIM(PNP_PICK_HEAD_PICK_POS_LOW,DRV06.ActualPosition,PNP_PICK_HEAD_PICK_POS_UP) EQU(PNP_CORONA_PICK_HEAD_DRV_COR_TURNS.ACC,0) OTE(PNP_PICK_HEAD_PICK_POS) ,LIM(PNP_PICK_HEAD_COR_POS_LOW,DRV06.ActualPosition,PNP_PICK_HEAD_COR_POS_UP) EQU(PNP_CORONA_PICK_HEAD_DRV_COR_TURNS.ACC,PNP_PICK_HEAD_COR_TURN_RECIPE) OTE(PNP_PICK_HEAD_COR_POS) ,LIM(PNP_PICK_HEAD_PLACE_POS_LOW,DRV06.ActualPosition,PNP_PICK_HEAD_PLACE_POS_UP) EQU(PNP_CORONA_PICK_HEAD_DRV_COR_TURNS.ACC,0) OTE(PNP_PICK_HEAD_PLACE_POS) ] OTE(PNP_PICK_HEAD_IN_POSITION) ] ,[XIC(CELL_STARTED) XIO(PNP_PICK_HEAD_DRV_MOVING) XIO(PNP_PICK_HEAD_IN_POSITION) ,EQU(STEP_HOME[5],60) XIO(PNP_PICK_HEAD_PICK_POS) ] [TON(TIMER_ALARM[11],?,?) ,XIC(TIMER_ALARM[11].DN) [OTL(PICK_HEAD_DRV_HOMING_REQ) ,MOV(372,STEP_ALARM[5]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[PICK HEAD CORONA TURN COUNTER RESET]]>
</Comment>
<Text>
<![CDATA[NEQ(PICK_HEAD_DRV_INDEX_NUM,2)XIC(PNP_PICK_HEAD_INDEX_PB)ONS(ONS_ARRAY[21])RES(PNP_CORONA_PICK_HEAD_DRV_COR_TURNS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING_BASE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT BASE DRIVE HOMING ROUTINE
******************************************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(BASE_DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(PNP_BASE_DRV_HOME_PB)XIO(BASE_DRV_HOMING_REQ)XIO(PNP_BASE_DRV_HOMING_IND)XIC(DRV05.AxisHomedStatus)OTE(PNP_BASE_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[5],0) ,XIC(PNP_BASE_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[5],500) [EQU(STEP_HOMING[5],500) ,EQU(STEP_HOMING[5],1000) ] ][MOV(10,STEP_HOMING[5]) ,OTL(PNP_BASE_DRV_HOMING_IND) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[5],10)[ONS(ONS_ARRAY[12]) OTL(BASE_DRV_INTERNAL_HOME_REQ) ,XIC(MOTION_BASE_DRV_INTERNAL_HOME_CONT.IP) MOV(15,STEP_HOMING[5]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[5],15)XIC(MOTION_BASE_DRV_INTERNAL_HOME_CONT.PC)XIC(DRV05.AxisHomedStatus)XIO(BASE_DRV_INTERNAL_HOME_REQ)MOV(20,STEP_HOMING[5]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[VERIFY HOMED STATUS AND PAUSE BEFORE INITIATING THE NEXT MOVE
IF FAULTED END ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[5],20)[XIC(DRV05.AxisHomedStatus) [TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) MOV(30,STEP_HOMING[5]) ] ,XIC(PNP_BASE_DRV_FAULT) MOV(100,STEP_HOMING[5]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[REQUEST INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[5],30)[XIO(MOTION_BASE_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[3]) OTL(BASE_DRV_HOME_OFF_REQ) ,XIC(MOTION_BASE_DRV_HOME_OFF_CONT.IP) MOV(35,STEP_HOMING[5]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[COMPLETE INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[5],35)XIC(MOTION_BASE_DRV_HOME_OFF_CONT.PC)XIC(DRV05.AxisHomedStatus)XIO(BASE_DRV_HOME_OFF_REQ)MOV(40,STEP_HOMING[5]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SET COUNTER TO ZERO]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[5],40)[ONS(ONS_ARRAY[9]) OTL(BASE_DRV_DEFINE_HOME) ,XIO(BASE_DRV_DEFINE_HOME) MOV(100,STEP_HOMING[5]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[5],100)[MOV(5,BASE_DRV_INDEX_NUM) ,OTU(PNP_BASE_DRV_HOMING_IND) OTU(PNP_BASE_DRV_HOME_PB) ,XIO(PNP_BASE_DRV_FAULT) OTU(BASE_DRV_HOMING_REQ) ,MOV(500,STEP_HOMING[5]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING_PICK_HEAD" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT PICK HEAD DRIVE HOMING ROUTINE
******************************************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(PICK_HEAD_DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(PNP_PICK_HEAD_DRV_HOME_PB)XIO(PICK_HEAD_DRV_HOMING_REQ)XIO(PNP_PICK_HEAD_DRV_HOMING_IND)XIC(PNP_PICK_HEAD_DRV_HOMED_STATUS)OTE(PNP_PICK_HEAD_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[6],0) ,XIC(PNP_PICK_HEAD_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[5],500) [EQU(STEP_HOMING[6],500) ,EQU(STEP_HOMING[6],1000) ] ][MOV(10,STEP_HOMING[6]) ,OTL(PNP_PICK_HEAD_DRV_HOMING_IND) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[6],10)[ONS(ONS_ARRAY[16]) OTL(PICK_HEAD_DRV_INTERNAL_HOME_REQ) ,XIC(MOTION_PICK_HEAD_DRV_INTERNAL_HOME_CONT.IP) MOV(15,STEP_HOMING[6]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[6],15)XIC(MOTION_PICK_HEAD_DRV_INTERNAL_HOME_CONT.PC)XIC(PNP_PICK_HEAD_DRV_HOMED_STATUS)XIO(PICK_HEAD_DRV_INTERNAL_HOME_REQ)MOV(20,STEP_HOMING[6]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[VERIFY HOMED STATUS AND PAUSE BEFORE INITIATING THE NEXT MOVE
IF FAULTED END ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[6],20)[XIC(PNP_PICK_HEAD_DRV_HOMED_STATUS) [TON(TIMER_OPER[4],?,?) ,XIC(TIMER_OPER[4].DN) MOV(30,STEP_HOMING[6]) ] ,XIC(PNP_PICK_HEAD_DRV_FAULT) MOV(100,STEP_HOMING[6]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[REQUEST INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[6],30)[XIO(MOTION_PICK_HEAD_DRV_ABORT_CONT.IP) ONS(ONS_ARRAY[17]) OTL(PNP_PICK_HEAD_DRV_HOME_OFF_REQ) ,XIC(MOTION_PICK_HEAD_DRV_HOME_OFF_CONT.IP) MOV(35,STEP_HOMING[6]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[COMPLETE INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[6],35)XIC(MOTION_PICK_HEAD_DRV_HOME_OFF_CONT.PC)XIC(PNP_PICK_HEAD_DRV_HOMED_STATUS)XIO(PNP_PICK_HEAD_DRV_HOME_OFF_REQ)MOV(40,STEP_HOMING[6]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SET COUNTER TO ZERO]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[6],40)[ONS(ONS_ARRAY[6]) OTL(PNP_PICK_HEAD_DRV_DEFINE_HOME) ,XIO(PNP_PICK_HEAD_DRV_DEFINE_HOME) MOV(100,STEP_HOMING[6]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[6],100)[MOV(1,PICK_HEAD_DRV_INDEX_NUM) ,OTU(PNP_PICK_HEAD_DRV_HOMING_IND) OTU(PNP_PICK_HEAD_DRV_HOME_PB) ,XIO(PNP_PICK_HEAD_DRV_FAULT) OTU(PICK_HEAD_DRV_HOMING_REQ) ,MOV(500,STEP_HOMING[6]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER PICK-N-PLACE/CORONA TREAT STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[5],500)XIC(PNP_BASE_PARK_POS)XIC(PNP_BASE_DRV_HOMED)XIC(PNP_BASE_DRV_READY)XIO(PNP_BASE_DRV_FAULT)XIC(PNP_PICK_HEAD_PICK_POS)XIC(PNP_PICK_HEAD_DRV_HOMED)XIC(PNP_PICK_HEAD_DRV_READY)XIO(PNP_PICK_HEAD_DRV_FAULT)XIC(PNP_PICK_HEAD_CYL_RET)[XIO(PNP_CORONA_FAULTED) XIC(PNP_BAR_NOT_PRESENT) ,XIO(PNP_CORONA_ACTIVE_RECIPE_LOADED) ]OTE(CELL_AUTO_READY[5]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK THAT EVERYTHING IS CLEAR BEFORE INDEXING]]>
</Comment>
<Text>
<![CDATA[XIC(PNP_PICK_HEAD_CYL_RET)OTE(PNP_CLEAR_TO_INDEX);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CHECK IF PICK HEAD NEEDS TO CHANGE ORIENTATION FOR LIGHT TABLE]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_KEY_MAN_MODE) XIO(CELL_MANUAL_MODE) NEQ(PNP_ORIENT_RECIPE_VAL,0) ,[XIC(CELL_KEY_MAN_MODE) ,XIC(CELL_MANUAL_MODE) ] NEQ(PNP_PICK_HEAD_TARGET,0) ]OTE(PNP_ORIENT_REQUIRED);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
