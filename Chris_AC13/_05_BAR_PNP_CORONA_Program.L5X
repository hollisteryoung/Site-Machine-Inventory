<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(0,STEP_AUTO[5],10) ,EQU(STEP_AUTO[5],30) ,EQU(STEP_AUTO[5],110) XIC(TIMER_OPER[12].DN) ]XIC(CELL_SHUTDOWN_REQ)MOV(500,STEP_AUTO[5]);]]>
