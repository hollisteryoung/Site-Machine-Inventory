<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED MAGAZINE AUTO
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS
]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[2],0) ,[EQU(STEP_AUTO[3],500) ,EQU(STEP_AUTO[3],1000) ] EQU(STEP_AUTO[2],20) ]MOV(500,STEP_AUTO[2]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SEND OUT READY FOR PROCESS TO STATIONS]]>
</Comment>
<Text>
<![CDATA[XIO(BARRIER_ELEV_PART_NOT_PRESENT_TIMING)[[XIC(BARRIER_ELEV_OUT_OF_MAG_POS) XIO(BARRIER_ELEV_BAR_DETECT) ,XIO(BARRIER_ELEV_OUT_OF_MAG_POS) ] XIC(BARRIER_MAG_IN_POSITION) XIO(BARRIER_ELEV_PART_NOT_PRESENT) XIO(BARRIER_MAG_INDEX_REQ_FROM_PNP) OTE(BARRIER_MAG_READY_FOR_PROCESS) ,XIC(CELL_STARTED) EQU(STEP_AUTO[2],0) [XIO(CELL_BAG_LOAD_ONLY_MODE_PB) XIO(BARRIER_MAG_READY_FOR_PROCESS) MOV(20,STEP_AUTO[2]) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) MOV(500,STEP_AUTO[2]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[INDEX]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[2],20)[OTL(BARRIER_MAG_INDEX_PB) ,XIC(NEXT_POS) [OTU(BARRIER_MAG_INDEX_REQ_FROM_PNP) ,MOV(30,STEP_AUTO[2]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR POSITION MONITOR CALC COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[2],30)XIC(POS_MONITOR_CALC_COMPLETE)MOV(40,STEP_AUTO[2]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[SEE IF TOWER LOCATION IN FRONT OF PICK-N-PLACE IS EMPTY]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_AUTO[2],40) [XIO(BARRIER_MAG_TWR_CHK) XIO(BARRIER_ELEV_BAR_DETECT) [RES(BARRIER_MAG_CONCUR_INDEX_COUNT) ,MOV(0,STEP_AUTO[2]) ] ,[XIC(BARRIER_MAG_TWR_CHK) ,XIC(BARRIER_ELEV_BAR_DETECT) ] [CTU(BARRIER_MAG_CONCUR_INDEX_COUNT,?,?) ,XIO(BARRIER_MAG_CONCUR_INDEX_COUNT.DN) MOV(20,STEP_AUTO[2]) ,XIC(BARRIER_MAG_CONCUR_INDEX_COUNT.DN) [MOV(432,STEP_ALARM[2]) ,RES(BARRIER_MAG_CONCUR_INDEX_COUNT) ] ] ] ,XIO(BARRIER_MAG_LT_CURTAIN_CLEAR) RES(BARRIER_MAG_CONCUR_INDEX_COUNT) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED MAGAZINE E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) [NEQ(STEP_ALARM[2],0) ,XIO(BARRIER_MAG_LT_CURTAIN_CLEAR) [EQU(STEP_ESTOP_RESET[0],500) [XIO(BARRIER_MAG_DRV_HOMING_IND) ,XIC(BARRIER_MAG_DRV_HOMING_IND) [OTL(DRV_HOMING_REQ) ,MOV(431,STEP_ALARM[2]) ] ] ,NEQ(STEP_ESTOP_RESET[0],500) NEQ(STEP_ESTOP_RESET[0],1000) MOV(431,STEP_ALARM[2]) ] ] ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[2]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[2],1000) EQU(STEP_ALARM_CAPTURE[2],0) MOV(STEP_ALARM[2],STEP_ALARM_CAPTURE[2]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[2],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.2) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[2],1000)[NEQ(STEP_ALARM[2],0) OTE(MAJOR_FAULT[2]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[2],STEP_AUTO_RET_ESTOP[2]) ,[OTU(BARRIER_MAG_DRV_RESET_PB) OTU(BARRIER_MAG_DRV_ENABLE_PB) OTU(BARRIER_MAG_INDEX_PB) OTU(BARRIER_MAG_ABORT_INDEX_PB) ,OTU(BARRIER_MAG_DRV_HOME_PB) OTU(DRV_INTERNAL_HOME_REQ) OTU(DRV_HOME_OFF_REQ) OTU(DRV_DEFINE_HOME) OTU(BARRIER_MAG_DRV_HOMING_IND) ] ,MOV(1000,STEP_HOMING[2]) MOV(1000,STEP_HOME[2]) MOV(1000,STEP_AUTO[2]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[2],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)[XIC(CELL_RESET_PRESSED) ,EQU(STEP_ESTOP_RESET[0],500) XIC(BARRIER_MAG_LT_CURTAIN_CLEAR) EQU(STEP_ALARM[2],0) ]MOV(10,STEP_ESTOP_RESET[2]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[2],10)[MOV(0,STEP_ALARM[2]) ,MOV(0,STEP_ALARM_CAPTURE[2]) ,MOV(20,STEP_ESTOP_RESET[2]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[2],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[2]) ,MOV(30,STEP_ESTOP_RESET[2]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[2]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[2],30)EQU(STEP_HOME[2],500)MOV(500,STEP_ESTOP_RESET[2]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED MAGAZINE HMI
***************************************************************************

MAGAZINE ANIMATION]]>
</Comment>
<Text>
<![CDATA[[LIM(0.1,DRV02.ActualVelocity,-0.1) XIC(BARRIER_MAG_DRV_MOVING) ,XIC(BARRIER_MAG_INDEX_PB) ]OTE(BARRIER_MAG_INDEXING_IND);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[2],500) [XIO(CELL_STARTED) XIO(BARRIER_MAG_DRV_FAULT) XIO(BARRIER_MAG_DRV_SHUTDOWN) [XIO(BARRIER_MAG_DRV_HOMING_IND) OTE(BARRIER_MAG_DRV_ENABLE_PB_VIS) ,XIC(BARRIER_MAG_CLEAR_TO_INDEX) XIC(BARRIER_MAG_DRV_READY) [XIC(CELL_KEY_AUTO_MODE) ,XIC(CELL_KEY_MAN_MODE) XIC(BARRIER_ELEV_OUT_OF_MAG_POS) ] [OTE(BARRIER_MAG_DRV_HOME_PB_VIS) ,XIC(BARRIER_MAG_DRV_HOMED) OTE(BARRIER_MAG_DRV_PB_VIS) ] ] ,[XIC(BARRIER_MAG_DRV_FAULT) ,XIC(BARRIER_MAG_DRV_SHUTDOWN) ,XIC(MOTION_DRV_ENABLE_CONT.ER) ] OTE(BARRIER_MAG_DRV_FAULT_PB_VIS) ] ,[EQU(STEP_ESTOP_RESET[2],1000) [XIC(BARRIER_ELEV_OUT_OF_MAG_POS) XIO(BARRIER_MAG_DRV_READY) ,EQU(BARRIER_MAG_BRAKE_CONT,1) ] ,EQU(STEP_ESTOP_RESET[2],500) XIC(CELL_KEY_MAN_MODE) XIO(BARRIER_MAG_DRV_READY) ] OTE(BARRIER_MAG_BRAKE_PB_VIS) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[DRIVE POSITION FOR HMI]]>
</Comment>
<Text>
<![CDATA[MUL(DRV02.ActualPosition,100,BARRIER_MAG_CUR_POS_HMI);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED MAGAZINE HOME ROUTINE
***************************************************************************

RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],0)[[XIC(BARRIER_MAG_DRV_FAULT) ,XIC(BARRIER_MAG_DRV_SHUTDOWN) ] OTL(BARRIER_MAG_DRV_RESET_PB) ,XIO(BARRIER_MAG_DRV_FAULT) XIO(BARRIER_MAG_DRV_SHUTDOWN) MOV(10,STEP_HOME[2]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR TORQUE SAFE INPUT TO ACTIVATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],10)[XIO(BARRIER_MAG_DRV_SAFE_TRQ_OFF) MOV(20,STEP_HOME[2]) ,[TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(441,STEP_ALARM[2]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ENABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],20)[OTL(BARRIER_MAG_DRV_ENABLE_PB) ,XIC(BARRIER_MAG_DRV_READY) MOV(25,STEP_HOME[2]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[INFEED ELEVATOR HOME ROUTINE MUST BE COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],25)EQU(STEP_HOME[3],500)MOV(30,STEP_HOME[2]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ CHECK TO SEE IF DRIVE REQUIRES HOMING
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],30)[XIO(BARRIER_MAG_DRV_HOMED) MOV(35,STEP_HOME[2]) ,XIC(BARRIER_MAG_DRV_HOMED) MOV(40,STEP_HOME[2]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[START DRIVE HOMING ROUTINE AND WAIT FOR COMPLETION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],35)[ONS(ONS_ARRAY[0]) MOV(0,STEP_HOMING[2]) ,XIC(BARRIER_MAG_DRV_HOMED) MOV(100,STEP_HOME[2]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[DETERMINE IF NEED TO INDEX OR BARRIER INFEED MAGAZINE IS IN POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],40)[XIO(BARRIER_MAG_IN_POSITION) MOV(50,STEP_HOME[2]) ,XIC(BARRIER_MAG_IN_POSITION) MOV(100,STEP_HOME[2]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[INDEX]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],50)[ONS(ONS_ARRAY[28]) OTL(BARRIER_MAG_INDEX_PB) ,XIC(NEXT_POS) XIO(BARRIER_MAG_DRV_MOVING) MOV(100,STEP_HOME[2]) ,[TON(TIMER_ALARM[13],?,?) ,XIC(TIMER_ALARM[13].DN) MOV(442,STEP_ALARM[2]) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[CHECK FOR MAGAZINE IN POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],100)XIC(BARRIER_MAG_IN_POSITION)MOV(110,STEP_HOME[2]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[ACTIVATE BRAKE ON MAGAZINE AT COMPLETION OF RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[2],110)[XIO(CELL_TOOL_CHANGE_REQ_PB) MOV(0,BARRIER_MAG_BRAKE_CONT) ,XIC(CELL_TOOL_CHANGE_REQ_PB) MOV(1,BARRIER_MAG_BRAKE_CONT) ,OTL(DRV_BRAKE_MSG) ,MOV(0,STEP_AUTO[2]) ,MOV(500,STEP_HOME[2]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(SERVO_HOMING,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(POSITION_MONITOR,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED MAGAZINE OUTPUTS
***************************************************************************

INITIATE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[2],1000)XIC(DRV_INTERNAL_HOME_REQ)XIC(BARRIER_MAG_CLEAR_TO_INDEX)[MAH(DRV02,MOTION_DRV_INTERNAL_HOME_CONT) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC) XIC(BARRIER_MAG_DRV_HOMED_STATUS) OTU(DRV_INTERNAL_HOME_REQ) ,[TON(TIMER_ALARM[5],?,?) ,XIC(TIMER_ALARM[5].DN) [OTU(DRV_INTERNAL_HOME_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(443,STEP_ALARM[2]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DRIVE MOVING DEBOUNCE TIMER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[2],1000)XIC(BARRIER_MAG_DRV_MOVING)TON(TIMER_OPER[1],?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[NORMAL INDEX CONTROL
AND HOME REQUEST FOR ELEVATOR IF BARRIER MAGAZINE IS NOT CLEAR TO INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[2],1000)[XIO(BARRIER_MAG_CLEAR_TO_INDEX) [XIC(BARRIER_MAG_INDEX_PB) ,XIC(DRV_HOME_OFF_REQ) ,XIC(DRV_INTERNAL_HOME_REQ) ] [XIO(BARRIER_ELEV_OUT_OF_MAG_POS) EQU(STEP_HOME[3],500) OTE(BARRIER_ELEV_HOME_REQUEST) ,XIO(PNP_PICK_HEAD_CYL_RET) OTU(PNP_PICK_HEAD_CYL_EXT_PB) ] ,XIC(BARRIER_MAG_INDEX_PB) [[XIC(NEXT_POS) ,XIC(TIMER_OPER[1].DN) ] [OTU(BARRIER_MAG_INDEX_PB) ,XIC(BARRIER_MAG_DRV_READY) OTU(POS_MONITOR_CALC_COMPLETE) ] ,XIC(BARRIER_MAG_CLEAR_TO_INDEX) XIO(NEXT_POS) [MAM(DRV02,MOTION_DRV_INDEX_CONT,3,NEXT_CALC_POS,72,Units per sec,180,Units per sec2,180,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,[TON(TIMER_ALARM[14],?,?) ,[XIC(CELL_IS_RESETTING) XIC(TIMER_ALARM[14].DN) ,XIO(CELL_IS_RESETTING) GEQ(TIMER_ALARM[14].ACC,5000) ] MOV(435,STEP_ALARM[2]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[HOMING OFFSET CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[2],1000)XIC(BARRIER_MAG_CLEAR_TO_INDEX)XIC(DRV_HOME_OFF_REQ)[MAM(DRV02,MOTION_DRV_HOME_OFF_CONT,0,BARRIER_MAG_DRV_HOME_OFF,72,Units per sec,180,Units per sec2,180,Units per sec2,Trapezoidal,100.0,100.0,% of Maximum,Disabled,Programmed,0,None,0,0) ,[XIC(MOTION_DRV_HOME_OFF_CONT.PC) ,XIO(BARRIER_MAG_CLEAR_TO_INDEX) ] OTU(DRV_HOME_OFF_REQ) ,[TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) [OTU(DRV_HOME_OFF_REQ) ,XIC(CELL_ALARMS_ACTIVE) MOV(440,STEP_ALARM[2]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ABORT INDEX]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[2],1000)[XIC(BARRIER_MAG_ABORT_INDEX_PB) ,XIO(BARRIER_MAG_CLEAR_TO_INDEX) ][MAS(DRV02,MOTION_DRV_ABORT_CONT,All,No,100,% of Maximum,No,100,% of Maximum) ,XIC(MOTION_DRV_ABORT_CONT.PC) OTU(BARRIER_MAG_ABORT_INDEX_PB) ,XIO(MOTION_DRV_ABORT_CONT.PC) [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [OTU(BARRIER_MAG_ABORT_INDEX_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(444,STEP_ALARM[2]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ZERO ENCODER]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[2],1000)XIC(DRV_DEFINE_HOME)[MRP(DRV02,MOTION_DRV_ZERO_CONT,Absolute,Actual,0.0) ,LIM(359.9,DRV02.ActualPosition,0.1) [OTU(DRV_DEFINE_HOME) ,RES(INDEX_COUNT) ] ,[TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) [OTU(DRV_DEFINE_HOME) ,XIC(CELL_ALARMS_ACTIVE) MOV(439,STEP_ALARM[2]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[RESET FAULTS AND SHUTDOWN STATE OF DRIVE
]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[2],1000) XIC(BARRIER_MAG_DRV_RESET_PB) [MASR(DRV02,MOTION_DRV_RESET_CONT) ,XIC(MOTION_DRV_ENABLE_CONT.ER) OTU(MOTION_DRV_ENABLE_CONT.ER) ,XIO(BARRIER_MAG_DRV_FAULT) XIO(BARRIER_MAG_DRV_SHUTDOWN) XIO(MOTION_DRV_ENABLE_CONT.ER) OTU(BARRIER_MAG_DRV_RESET_PB) ,[TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(BARRIER_MAG_DRV_RESET_PB) ,XIC(CELL_ALARMS_ACTIVE) [XIC(BARRIER_MAG_DRV_FAULT) MOV(433,STEP_ALARM[2]) ,XIC(BARRIER_MAG_DRV_SHUTDOWN) MOV(447,STEP_ALARM[2]) ] ] ] ] ,[XIC(CELL_STARTED) ,XIO(CELL_STARTED) LIM(10,STEP_HOME[2],499) ] [XIC(BARRIER_MAG_DRV_FAULT) MOV(433,STEP_ALARM[2]) ,XIC(BARRIER_MAG_DRV_SHUTDOWN) MOV(447,STEP_ALARM[2]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ENABLE/DISABLE DRIVE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[2],1000)[XIC(BARRIER_MAG_DRV_ENABLE_PB) [MSO(DRV02,MOTION_DRV_ENABLE_CONT) ,[XIO(MOTION_DRV_ENABLE_CONT.DN) ,XIO(BARRIER_MAG_DRV_READY) ,XIC(BARRIER_MAG_DRV_FAULT) ,XIC(BARRIER_MAG_DRV_SHUTDOWN) ] [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) [OTU(BARRIER_MAG_DRV_ENABLE_PB) ,XIC(CELL_ALARMS_ACTIVE) MOV(445,STEP_ALARM[2]) ] ] ] ,XIO(BARRIER_MAG_DRV_ENABLE_PB) [MSF(DRV02,MOTION_DRV_DISABLE_CONT) ,XIO(MOTION_DRV_DISABLE_CONT.DN) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) XIC(CELL_ALARMS_ACTIVE) MOV(446,STEP_ALARM[2]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ACTIVATE BRAKE UPON LEAVING MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)XIO(DRV_BRAKE_FLIP_FLOP)ONS(ONS_ARRAY[8])OTL(BARRIER_MAG_BRAKE_PB);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[MAIN DIAL BRAKE FLIP FLOP CIRCUIT - ALLOWS ONE MOMENTARY PUSH BUTTON TO ACTIVATE AND DEACTIVE BRAKE]]>
</Comment>
<Text>
<![CDATA[XIC(BARRIER_MAG_BRAKE_PB)ONS(ONS_ARRAY[10])[MOV(1,BARRIER_MAG_BRAKE_CONT) ,XIC(DRV_BRAKE_FLIP_FLOP) MOV(0,BARRIER_MAG_BRAKE_CONT) ,EQU(BARRIER_MAG_BRAKE_CONT,1) OTL(DRV_BRAKE_FLIP_FLOP) ,NEQ(BARRIER_MAG_BRAKE_CONT,1) OTU(DRV_BRAKE_FLIP_FLOP) ,[OTU(BARRIER_MAG_BRAKE_PB) ,OTL(DRV_BRAKE_MSG) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[FLIP FLOP BRAKE CONTROL
THROUGH THE SET SYSTEM VARIABLE
]]>
</Comment>
<Text>
<![CDATA[XIC(DRV_BRAKE_MSG)XIO(BARRIER_MAG_DRV_MOVING)SSV(Axis,DRV02,MechanicalBrakeControl,BARRIER_MAG_BRAKE_CONT);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR BARRIER INFEED MAGAZINE
***************************************************************************
DETERMINE IF MAGAZINE IS IN POSITION BY
1. MAGAZINE HAS REACHED IT'S TARGET
2. MAGAZINE HAS BEEN HOMED AND IS NOW AT ZERO
3. THE MAGAZINE HASN'T LEFT IT'S LAST TARGET POSITION]]>
</Comment>
<Text>
<![CDATA[[XIC(BARRIER_MAG_DRV_HOMED) [CMP(NEXT_CALC_POS+0.1>DRV02.ActualPosition) CMP(NEXT_CALC_POS-0.1<DRV02.ActualPosition) OTE(NEXT_POS) ,LIM(359.9,DRV02.ActualPosition,0.1) OTE(HOME_POS) ,CMP(LAST_KNOWN_POS+0.1>DRV02.ActualPosition) CMP(LAST_KNOWN_POS-0.1<DRV02.ActualPosition) OTE(LAST_POS) ] OTE(BARRIER_MAG_IN_POSITION) ,[XIC(CELL_STARTED) XIC(POS_MONITOR_CALC_COMPLETE) ,EQU(STEP_HOME[2],100) ] XIO(BARRIER_MAG_IN_POSITION) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) [OTL(DRV_HOMING_REQ) ,MOV(437,STEP_ALARM[2]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[INITIATE POSITION UPDATE]]>
</Comment>
<Text>
<![CDATA[[XIO(BARRIER_MAG_DRV_HOMING_IND) XIC(BARRIER_MAG_DRV_MOVING) OTU(POS_MONITOR_CALC_COMPLETE) ,EQU(STEP_ESTOP_RESET[2],500) XIO(POS_MONITOR_CALC_COMPLETE) XIO(BARRIER_MAG_DRV_MOVING) XIC(BARRIER_MAG_DRV_READY) XIO(BARRIER_MAG_DRV_FAULT) XIC(BARRIER_MAG_DRV_HOMED) XIC(BARRIER_MAG_IN_POSITION) [TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) ONS(ONS_ARRAY[11]) MOV(20,STEP_POS_MONITOR[2]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[DETERMINE CURRENT POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[2],20)[XIC(HOME_POS) MOV(0.0,LAST_KNOWN_POS) ,XIO(HOME_POS) XIO(LAST_POS) MOV(NEXT_CALC_POS,LAST_KNOWN_POS) ,MOV(30,STEP_POS_MONITOR[2]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[DEFINE NEXT POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[2],30)[CPT(NEXT_CALC_POS,LAST_KNOWN_POS+(360/NUM_OF_STATION)) ,GRT(NEXT_CALC_POS,360) SUB(NEXT_CALC_POS,360,NEXT_CALC_POS) ,CTU(INDEX_COUNT,?,?) ,MOV(50,STEP_POS_MONITOR[2]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ CALCULATION COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_POS_MONITOR[2],50)[OTL(POS_MONITOR_CALC_COMPLETE) ,MOV(500,STEP_POS_MONITOR[2]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SERVO_HOMING" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER INFEED MAGAZINE DRIVE HOMING ROUTINE
***************************************************************************

SET HOMING REQUIREMENT DURING FIRST SCAN]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)OTL(DRV_HOMING_REQ);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DETERMINE IF DRIVE IS HOMED
]]>
</Comment>
<Text>
<![CDATA[XIO(BARRIER_MAG_DRV_HOME_PB)XIO(DRV_HOMING_REQ)XIO(BARRIER_MAG_DRV_HOMING_IND)XIC(BARRIER_MAG_DRV_HOMED_STATUS)OTE(BARRIER_MAG_DRV_HOMED);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[START HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_HOMING[2],0) ,XIC(BARRIER_MAG_DRV_HOME_PB) EQU(STEP_ESTOP_RESET[2],500) [EQU(STEP_HOMING[2],500) ,EQU(STEP_HOMING[2],1000) ] ][OTL(BARRIER_MAG_DRV_HOMING_IND) ,MOV(10,STEP_HOMING[2]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[2],10)[XIC(BARRIER_MAG_CLEAR_TO_INDEX) ONS(ONS_ARRAY[12]) OTL(DRV_INTERNAL_HOME_REQ) ,XIC(MOTION_DRV_INTERNAL_HOME_CONT.IP) MOV(15,STEP_HOMING[2]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[COMPLETE INTERNAL DRIVE HOMING ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[2],15)XIC(MOTION_DRV_INTERNAL_HOME_CONT.PC)XIC(BARRIER_MAG_DRV_HOMED_STATUS)XIO(DRV_INTERNAL_HOME_REQ)MOV(30,STEP_HOMING[2]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[VERIFY HOMED STATUS AND PAUSE BEFORE INITIATING THE NEXT MOVE
IF FAULTED END ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[2],30)[XIC(BARRIER_MAG_DRV_HOMED_STATUS) [TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].DN) MOV(40,STEP_HOMING[2]) ] ,XIC(BARRIER_MAG_DRV_FAULT) MOV(100,STEP_HOMING[2]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[REQUEST INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[2],40)[XIC(BARRIER_MAG_CLEAR_TO_INDEX) ONS(ONS_ARRAY[29]) OTL(DRV_HOME_OFF_REQ) ,XIC(MOTION_DRV_HOME_OFF_CONT.IP) MOV(45,STEP_HOMING[2]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[COMPLETE INDEX DRIVE TO HOME OFFSET POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[2],45)XIC(MOTION_DRV_HOME_OFF_CONT.PC)XIC(BARRIER_MAG_DRV_HOMED_STATUS)XIO(DRV_HOME_OFF_REQ)MOV(50,STEP_HOMING[2]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[SET COUNTER TO ZERO]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[2],50)[ONS(ONS_ARRAY[9]) OTL(DRV_DEFINE_HOME) ,XIO(DRV_DEFINE_HOME) MOV(100,STEP_HOMING[2]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[FINISH ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOMING[2],100)[OTU(BARRIER_MAG_DRV_HOMING_IND) OTU(BARRIER_MAG_DRV_HOME_PB) ,XIO(BARRIER_MAG_DRV_FAULT) OTU(DRV_HOMING_REQ) ,OTU(POS_MONITOR_CALC_COMPLETE) ,MOV(500,STEP_HOMING[2]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
