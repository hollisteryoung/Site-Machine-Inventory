<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER FORMING STATION AUTO ROUTINE
***************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[1],500) ,EQU(STEP_AUTO[1],1000) ]MOV(500,STEP_AUTO[15]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CHECK TO SEE IF STATION CAN RUN BEFORE INITIAL INDEX AFTER STARTING CELL

IF MANUAL CYCLE MOVE TO NEXT STEP]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[15],0)[XIC(CELL_STARTED) [XIO(RUN_PROCESS) MOV(5,STEP_AUTO[15]) ,XIC(RUN_PROCESS) MOV(20,STEP_AUTO[15]) ] ,XIC(CELL_MANUAL_MODE) XIC(MAIN_DIAL_IN_POSITION) XIC(FORMING_CYCLE_PB) MOV(20,STEP_AUTO[15]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ REQUEST DIAL INDEX
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[15],5)[OTE(FORMING_INDEX_DIAL_REQ) ,XIC(MAIN_DIAL_INDEX_DONE) MOV(10,STEP_AUTO[15]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ANALYZE PART DATA]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_SHUTDOWN_REQ) XIO(CELL_EMPTY_COMPLETE.8) XIC(FORMING_DATA_BAR_LOADED) XIO(FORMING_DATA_BAR_REJECT) [XIO(CELL_SINGLE_PART_MODE_ACTIVE) XIC(FORMING_DATA_BAG_LOADED) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ] [XIC(FORMING_DATA_PREHEAT1_COMPLETE) ,XIO(PREHEAT1_ACTIVE_RECIPE_LOADED) ] [XIC(FORMING_DATA_PREHEAT2_COMPLETE) ,XIO(PREHEAT2_ACTIVE_RECIPE_LOADED) ] XIC(FORMING_ACTIVE_RECIPE_LOADED) XIO(FORMING_DATA_FORMING_STARTED) XIO(FORMING_DATA_FORMING_COMPLETE) OTE(RUN_PROCESS) ,EQU(STEP_AUTO[15],10) [XIC(RUN_PROCESS) MOV(20,STEP_AUTO[15]) ,XIO(RUN_PROCESS) MOV(150,STEP_AUTO[15]) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[EXTEND FORMING CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[15],20)[OTL(FORMING_CYL_EXT_PB) ,XIC(CELL_STARTED) OTL(FORMING_DATA_FORMING_STARTED) ,XIO(FORMING_LOW_CYL_RET) XIC(FORMING_UP_CYL_EXT) MOV(30,STEP_AUTO[15]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[BLOW FOR TIME AND BLOW RELEASE FOR AMOUNT OF TIME AT END OF CYCLE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[15],30)[XIO(CELL_DRY_CYCLE_MODE_PB) OTL(FORMING_BLOW_PB) ,MOV(FORMING_BLOW_TIME_RECIPE,TIMER_OPER[0].PRE) ,SUB(TIMER_OPER[0].PRE,FORMING_BARRIER_RELEASE_BLOW_TIME,FORMING_BARRIER_RELEASE_BLOW_START_TIME) ,TON(TIMER_OPER[0],?,?) ,GRT(FORMING_BARRIER_RELEASE_BLOW_TIME,0) GEQ(TIMER_OPER[0].ACC,FORMING_BARRIER_RELEASE_BLOW_START_TIME) OTL(FORMING_BARRIER_RELEASE_BLOW_PB) ,XIC(TIMER_OPER[0].DN) [OTU(FORMING_BLOW_PB) ,XIC(CELL_STARTED) [[XIC(FORMING_PRESSURE_OK) ,XIC(CELL_DRY_CYCLE_MODE_PB) ] OTL(FORMING_DATA_FORMING_PRESS_OK) ,OTL(FORMING_DATA_FORMING_COMPLETE) ] ,MOV(40,STEP_AUTO[15]) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[RETRACT FORMING CYLINDER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[15],40)[OTU(FORMING_CYL_EXT_PB) ,XIC(FORMING_LOW_CYL_RET) XIC(FORMING_UP_CYL_RET) [OTU(FORMING_BARRIER_RELEASE_BLOW_PB) ,XIC(CELL_STARTED) MOV(150,STEP_AUTO[15]) ,XIC(CELL_MANUAL_MODE) XIO(FORMING_CYCLE_PB) MOV(0,STEP_AUTO[15]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[SET PROCESS DONE
MONITOR EMPTY STATUS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[15],150)[OTL(FORMING_PROCESS_DONE) ,XIC(CELL_EMPTY_COMPLETE.7) XIO(PREHEAT2_DATA_BAR_LOADED) OTL(CELL_EMPTY_COMPLETE.8) ,TON(TIMER_OPER[5],?,?) ,XIC(TIMER_OPER[5].DN) MOV(160,STEP_AUTO[15]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[WAIT FOR MAIN DIAL TO TURN OFF INDEX DONE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[15],160)XIO(MAIN_DIAL_INDEX_DONE)[OTU(FORMING_PROCESS_DONE) ,MOV(5,STEP_AUTO[15]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[STATION CYCLE TIME]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[LIM(20,STEP_AUTO[15],150) TON(TIMER_OPER[4],?,?) ,EQU(STEP_AUTO[15],150) ONS(ONS_ARRAY[30]) DIV(TIMER_OPER[4].ACC,1000,CELL_CYCLE_TIME[0].BARRIER_FORMING) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[STATION CYCLE EXCESS TIME
THIS STATION HAS BECOME CRITICAL PATH

STATION NUMBERS
BARRIER LOAD =1, BAG LOAD=2, PREHEAT 1=3, PREHEAT2=4,
FORMING=5, PUNCH=6, PRINT=7,
BAG GLUE=8, PNC=9, BAG OFFLOAD=10]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[15],150)ONS(ONS_ARRAY[28])[GRT(CELL_CYCLE_TIME[0].BARRIER_FORMING,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [[MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ,[MOV(6,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_FORMING,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) ] ] ,GRT(CELL_CYCLE_TIME[0].BARRIER_FORMING,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) LES(CELL_CYCLE_TIME[0].BARRIER_FORMING,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[0].CYCLE_TIME) [MOV(6,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].STATION) ,MOV(CELL_CYCLE_TIME[0].BARRIER_FORMING,CELL_CYCLE_TIME[0].ST_TIME_CRITICAL[1].CYCLE_TIME) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER FORMING STATION E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[15],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[15]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[15],1000) EQU(STEP_ALARM_CAPTURE[15],0) MOV(STEP_ALARM[15],STEP_ALARM_CAPTURE[15]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[15],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.15) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[15],1000)[NEQ(STEP_ALARM[15],0) OTE(MAJOR_FAULT[15]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[15],STEP_AUTO_RET_ESTOP[15]) ,OTU(FORMING_CYL_EXT_PB) ,OTU(FORMING_BLOW_PB) ,OTU(FORMING_PROCESS_DONE) ,OTU(FORMING_CYCLE_PB) ,OTU(FORMING_BARRIER_RELEASE_BLOW_PB) ,MOV(0,MAN01:O.Data[0]) ,XIC(FORMING_DATA_BAR_LOADED) XIO(FORMING_DATA_BAR_REJECT) XIC(FORMING_DATA_FORMING_STARTED) XIO(FORMING_DATA_FORMING_COMPLETE) OTE(FORMING_PROCESS_FAILED) ,XIO(FORMING_DATA_BAR_REJECT) XIO(FORMING_DATA_FORMING_STARTED) [XIO(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) [XIC(FORMING_DATA_PREHEAT1_STARTED) ,XIC(FORMING_DATA_PREHEAT2_STARTED) ] OTE(FORMING_PREHEAT2_PROCESS_FAILED) ,XIC(PREHEAT_BAR_RERUN_ALLOW_RECIPE_LOADED) [OTU(FORMING_DATA_PREHEAT1_STARTED) ,OTU(FORMING_DATA_PREHEAT1_UP_TEMP_OK) ,OTU(FORMING_DATA_PREHEAT1_LOW_TEMP_OK) ,OTU(FORMING_DATA_PREHEAT1_COMPLETE) ,OTU(FORMING_DATA_PREHEAT2_STARTED) ,OTU(FORMING_DATA_PREHEAT2_UP_TEMP_OK) ,OTU(FORMING_DATA_PREHEAT2_LOW_TEMP_OK) ,OTU(FORMING_DATA_PREHEAT2_COMPLETE) ] ] ,MOV(1000,STEP_HOME[15]) ,MOV(1000,STEP_AUTO[15]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[15],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[15]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[15],10)[MOV(0,STEP_ALARM[15]) ,MOV(0,STEP_ALARM_CAPTURE[15]) ,MOV(20,STEP_ESTOP_RESET[15]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[15],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[15]) ,MOV(30,STEP_ESTOP_RESET[15]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[15]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[15],30)EQU(STEP_HOME[15],500)MOV(500,STEP_ESTOP_RESET[15]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER FORMING STATION HMI
***************************************************************************

BYPASS ANIMATION FOR HMI]]>
</Comment>
<Text>
<![CDATA[XIO(FORMING_ACTIVE_RECIPE_LOADED)XIC(CELL_TIMING_BIT_1000)OTE(FORMING_BYPASS_ANIMATION);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[FORMING CYLINDER EXTEND PUSH BUTTON VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[1],500)XIC(CELL_MANUAL_MODE)XIC(MAIN_DIAL_DRV_HOMED)XIC(MAIN_DIAL_IN_POSITION)XIC(FORMING_TOOL_LATCH_PIN_DET_LH)XIC(FORMING_TOOL_LATCH_PIN_DET_RH)OTE(FORMING_CYL_EXT_PB_VIS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER FORMING STATION HOME ROUTINE
***************************************************************************


SET COMPONENTS TO HOME STATE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[15],0)[OTU(FORMING_CYL_EXT_PB) ,OTU(FORMING_BLOW_PB) ,XIC(FORMING_LOW_CYL_RET) XIC(FORMING_UP_CYL_RET) [MOV(0,STEP_AUTO[15]) ,MOV(500,STEP_HOME[15]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************

]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(PRESSURE_REG,0) ,JSR(HMI,0) ,JSR(STOP_POS,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER FORMING STATION OUTPUTS
***************************************************************************

FORMING CYLINDER CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[15],1000)XIC(CELL_PRESSURE_OK)[XIC(FORMING_TOOL_LATCH_PIN_DET_LH) XIC(FORMING_TOOL_LATCH_PIN_DET_RH) XIC(FORMING_CYL_EXT_PB) [XIC(MAIN_DIAL_IN_POSITION) [OTE(MAN01:O.Data[3].10) ,XIC(CELL_ALARMS_ACTIVE) XIO(FORMING_UP_CYL_EXT) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(280,STEP_ALARM[15]) ] ] ,XIO(MAIN_DIAL_IN_POSITION) OTU(FORMING_CYL_EXT_PB) ] ,[XIO(FORMING_TOOL_LATCH_PIN_DET_LH) ,XIO(FORMING_TOOL_LATCH_PIN_DET_RH) ] OTU(FORMING_CYL_EXT_PB) ,XIO(FORMING_CYL_EXT_PB) [OTE(MAN01:O.Data[3].11) ,XIC(CELL_ALARMS_ACTIVE) [XIO(FORMING_UP_CYL_RET) ,XIO(FORMING_LOW_CYL_RET) ] [TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) [XIO(FORMING_UP_CYL_RET) MOV(281,STEP_ALARM[15]) ,XIO(FORMING_LOW_CYL_RET) MOV(283,STEP_ALARM[15]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[FORMING BLOW CONTROL]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[15],1000)XIC(CELL_PRESSURE_OK)XIC(FORMING_BLOW_PB)OTE(MAN01:O.Data[2].6);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ BARRIER RELEASE FROM FORM TOOL BLOW]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[15],1000)XIC(CELL_PRESSURE_OK)XIC(FORMING_BARRIER_RELEASE_BLOW_PB)OTE(MAN01:O.Data[2].7);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PRESSURE_REG" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER FORMING STATION PRESSURE REGULATOR
*******************************************************************************

ADD OPERATOR ADJUSTMENT TO PRESSURE SETPOINT]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[LIM(FORMING_PRESSURE_MAX,PRESSURE_SP_AUTO,FORMING_PRESSURE_MIN) MOV(0,FORMING_ADJ_PRESSURE) ,ADD(FORMING_PRESSURE_RECIPE_SP,FORMING_ADJ_PRESSURE,PRESSURE_SP_AUTO) ,ADD(FORMING_PRESSURE_RECIPE_SP,FORMING_ADJ_PRESSURE,FORMING_PRESSURE_SP_AUTO_DISPLAY) ,MOV(PRESSURE_SP_AUTO,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CACULATE OPERATERS MAXIMUM  & MINIMUM ALLOWABLE SETPOINT ADJUSTMENT BASED ON RECIPE PRESSURE
]]>
</Comment>
<Text>
<![CDATA[XIO(CELL_MANUAL_MODE)[[SUB(FORMING_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,FORMING_PRESSURE_MIN) ,LES(FORMING_PRESSURE_MIN,PRESSURE_MIN_ALLOWED) MOV(PRESSURE_MIN_ALLOWED,FORMING_PRESSURE_MIN) ] ,[ADD(FORMING_PRESSURE_RECIPE_SP,PRESSURE_DELTA_ALLOWED,FORMING_PRESSURE_MAX) ,GRT(FORMING_PRESSURE_MAX,PRESSURE_MAX_ALLOWED) MOV(PRESSURE_MAX_ALLOWED,FORMING_PRESSURE_MAX) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IF RECIPE VALUE CHANGES ZERO OUT OFFSET ADJUST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_RECIPE_LOAD_COMPLETE)MOV(0,FORMING_ADJ_PRESSURE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****MANUAL MODE****

SET PRESSURE SETPOINT FOR MANUAL MODE]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)ONS(ONS_ARRAY[2])MOV(PRESSURE_SP_AUTO,FORMING_PRESSURE_SP_MAN_DISPLAY);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WHILE IN MANUAL MODE, ALLOW THE PRESSURE SLIDERS FULL SCALE OF OPERATION.]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_MANUAL_MODE)[MUL(FORMING_PRESSURE_SP_MAN_DISPLAY,1,PRESSURE_SP_MAN) ,MOV(PRESSURE_MIN_ALLOWED,FORMING_PRESSURE_MIN) ,MOV(PRESSURE_MAX_ALLOWED,FORMING_PRESSURE_MAX) ,MOV(PRESSURE_SP_MAN,PRESSURE_SP_GEN) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SEND REGULATOR PRESSURE INPUT COUNTS

SCALE, TRUNCATE AND BYTE SWAP]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[15],1000)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[MUL(PRESSURE_SP_GEN,FORM_PRES_SCALE_PAR.OUT_M,PRESSURE_WITH_M_DONE) ,ADD(PRESSURE_WITH_M_DONE,FORM_PRES_SCALE_PAR.OUT_B,SCALED_PRESSURE) ,TRN(SCALED_PRESSURE,SCALED_PRESS_TRUNC) ,MOV(SCALED_PRESS_TRUNC,MAN01:O.Data[0]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CACULATE FEEDBACK PRESSURE FROM REGULATOR]]>
</Comment>
<Text>
<![CDATA[[MOV(MAN01:I.Data[0],REG_FEEDBACK) ,SUB(REG_FEEDBACK,FORM_PRES_SCALE_PAR.IN_B,REG_FEEDBACK_M) ,DIV(REG_FEEDBACK_M,FORM_PRES_SCALE_PAR.IN_M,REG_FEEDBACK_SCALED) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[VERIFY PRESSURE USING REGULATOR FEEDBACK]]>
</Comment>
<Text>
<![CDATA[CMP(FORMING_PRESSURE_SP_AUTO_DISPLAY-PRESSURE_DELTA_ALLOWED<REG_FEEDBACK_SCALED)OTE(FORMING_PRESSURE_OK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BARRIER FORMING STATION STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[15],500)XIC(FORMING_LOW_CYL_RET)XIC(FORMING_UP_CYL_RET)XIC(FORMING_TOOL_LATCH_PIN_DET_LH)XIC(FORMING_TOOL_LATCH_PIN_DET_RH)[XIC(FORMING_PRESSURE_OK) XIC(FORMING_CYL_STOP_POS_OK) ,XIO(FORMING_ACTIVE_RECIPE_LOADED) ,XIC(CELL_BAG_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_BAG_TEST_PICK_MODE_PB) ]OTE(CELL_AUTO_READY[15]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[MONITOR FOR FORM TOOLING SENSORS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[XIO(MAN01:I.Data[2].12) MOV(284,STEP_ALARM[15]) ,XIO(MAN01:I.Data[2].13) MOV(285,STEP_ALARM[15]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STOP_POS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[FORMING STATION STOP ANALOG POSITION
************************************************************************************

LOAD POSTION DATA INTO VARIABLES]]>
</Comment>
<Text>
<![CDATA[[[MOV(MAN02:I.Data[1],FORMING_CYL_STOP_POS_RAW) ,CPT(FORMING_CYL_STOP_POS_MM,(FORMING_CYL_STOP_POS_RAW/303.48)-.7593555) ,XIC(METRIC_MACHINE) MOV(FORMING_CYL_STOP_POS_MM,FORMING_CYL_STOP_POS) ,XIO(METRIC_MACHINE) DIV(FORMING_CYL_STOP_POS_MM,25.4,FORMING_CYL_STOP_POS) ] ,EQU(FORMING_CYL_STOP_POS_RAW,0) MOV(282,STEP_ALARM[15]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[VERIFY FORMING CYLINDER POSITION IS WITHIN REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[[SUB(FORMING_CYL_STOP_POS_RECIPE,FORMING_CYL_STOP_POS_TOL,FORMING_CYL_STOP_POS_LOWER) ADD(FORMING_CYL_STOP_POS_RECIPE,FORMING_CYL_STOP_POS_TOL,FORMING_CYL_STOP_POS_UPPER) ,LIM(FORMING_CYL_STOP_POS_LOWER,FORMING_CYL_STOP_POS,FORMING_CYL_STOP_POS_UPPER) OTE(FORMING_CYL_STOP_POS_OK) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
