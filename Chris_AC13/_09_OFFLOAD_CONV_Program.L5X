<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[OFFLOAD CONVEYOR AUTO ROUTINE
*********************************************************************************

SHUTDOWN REQUEST REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)XIC(CELL_SHUTDOWN_REQ)[EQU(STEP_AUTO[30],500) ,XIC(MAJOR_FAULT[30]) ]EQU(STEP_AUTO[9],0)MOV(500,STEP_AUTO[9]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[REQUEST PART FROM BARRIER LOAD/BAG OFFLOAD ROBOT
WAIT FOR ASSY TO BE PLACED ON CONVEYOR]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[9],0)[OTE(OFFLOAD_CONV_BAG_REQ) ,XIC(R3:I.Data[0].21) [ADD(OFFLOAD_CONV_GOOD_PARTS,1,OFFLOAD_CONV_GOOD_PARTS) ,ADD(CELL_DATA_COLLECTION[4],1,CELL_DATA_COLLECTION[4]) ,CTU(OFFLOAD_CONV_STACK_COUNT,?,?) ,MOV(10,STEP_AUTO[9]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[WAIT FOR ROBOT CLEAR OF CONVEYOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[9],10)XIC(R3:I.Data[0].28)MOV(20,STEP_AUTO[9]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[HANDSHAKE DELAY TIMER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[9],20)[TON(TIMER_OPER[0],?,?) ,XIC(TIMER_OPER[0].DN) MOV(30,STEP_AUTO[9]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[DETERMINE IF FINISHED PART STACK SIZE HAS BEEN REACHED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[9],30)[LES(OFFLOAD_CONV_STACK_COUNT.ACC,OFFLOAD_CONV_STACK_SIZE_RECIPE_LOADED) XIO(R3:I.Data[0].21) MOV(0,STEP_AUTO[9]) ,GEQ(OFFLOAD_CONV_STACK_COUNT.ACC,OFFLOAD_CONV_STACK_SIZE_RECIPE_LOADED) [XIO(R3:O.Data[1].0) MOV(35,STEP_AUTO[9]) ,XIC(R3:O.Data[1].0) MOV(40,STEP_AUTO[9]) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CHANGE LANES ON OFFLOAD CONVEYOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[9],35)[OTL(R3:O.Data[1].0) ,RES(OFFLOAD_CONV_STACK_COUNT) ,XIO(R3:I.Data[0].21) MOV(0,STEP_AUTO[9]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[RUN CONVEYOR FOR INDEX LENGTH
Rev 07 2014-03-24 DRB/GH Note that INDEX_SCALE_FACTOR should be about 17000.]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[9],40)[OTU(R3:O.Data[1].0) ,OTL(OFFLOAD_CONV_RUN_FORWARD_PB) ,CPT(TIMER_OPER[1].PRE,OFFLOAD_CONV_INDEX_LEN_RECIPE_LOADED/OFFLOAD_CONV_SPEED_HZ*OFFLOAD_CONV_INDEX_SCALE_FACTOR) ,XIC(DRV09:I.Active) TON(TIMER_OPER[1],?,?) ,XIC(TIMER_OPER[1].DN) [OTU(OFFLOAD_CONV_RUN_FORWARD_PB) ,RES(OFFLOAD_CONV_STACK_COUNT) ,MOV(50,STEP_AUTO[9]) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WAIT FOR HANDSHAKE TO TURN OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[9],50)XIO(R3:I.Data[0].21)MOV(0,STEP_AUTO[9]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[OFFLOAD CONVEYOR E-STOP RESET
***************************************************************************

ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[9],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[9]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[9],1000) EQU(STEP_ALARM_CAPTURE[9],0) MOV(STEP_ALARM[9],STEP_ALARM_CAPTURE[9]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[9],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.9) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[9],1000)[NEQ(STEP_ALARM[9],0) OTE(MAJOR_FAULT[9]) ,ONS(ONS_ARRAY[1]) MOV(STEP_AUTO[9],STEP_AUTO_RET_ESTOP[9]) ,OTU(OFFLOAD_CONV_RUN_FORWARD_PB) ,OTU(OFFLOAD_CONV_RUN_FORWARD_FAST_PB) ,OTU(OFFLOAD_CONV_DRV_RESET_PB) ,MOV(1000,STEP_HOME[9]) ,MOV(1000,STEP_AUTO[9]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[9],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[9]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[GENERAL CELL SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[9],10)[MOV(0,STEP_ALARM[9]) ,MOV(0,STEP_ALARM_CAPTURE[9]) ,MOV(20,STEP_ESTOP_RESET[9]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[9],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_HOME[9]) ,MOV(30,STEP_ESTOP_RESET[9]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[9]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[9],30)EQU(STEP_HOME[9],500)MOV(500,STEP_ESTOP_RESET[9]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[OFFLOAD CONVEYOR HMI
***************************************************************************

DISPLAY ARROWS AND DIRECTION WHEN IN MOTION]]>
</Comment>
<Text>
<![CDATA[XIC(DRV09:I.Active)OTE(OFFLOAD_CONV_MOVING_FORWARD);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[HMI CONVEYOR BUTTON VISIBILITY]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[9],500)[XIC(OFFLOAD_CONV_DRV_READY) OTE(OFFLOAD_CONV_MAN_RUN_PB_VIS) ,XIC(OFFLOAD_CONV_DRV_FAULT) OTE(OFFLOAD_CONV_DRV_FAULT_PB_VIS) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[OFFLOAD CONVEYOR HOME ROUTINE
***************************************************************************

WAIT FOR DRIVE COMMS AND ROBOT HOME COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[9],0)XIC(DRV07_ETHERNET_COMMS_OK)XIC(R3_HOME)MOV(10,STEP_HOME[9]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[RESET DRIVE FAULT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[9],10)[XIC(OFFLOAD_CONV_DRV_FAULT) OTL(OFFLOAD_CONV_DRV_RESET_PB) ,XIO(OFFLOAD_CONV_DRV_FAULT) [MOV(0,STEP_AUTO[9]) ,MOV(500,STEP_HOME[9]) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(STATUS,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(OUTPUTS,0) ,JSR(HMI,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="OUTPUTS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[OFFLOAD CONVEYOR OUTPUTS
***************************************************************************

CLEAR DRIVE FAULT]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[9],1000) XIC(OFFLOAD_CONV_DRV_RESET_PB) [[OTE(DRV09:O.ClearFaults) ,XIO(OFFLOAD_CONV_DRV_FAULT) OTU(OFFLOAD_CONV_DRV_RESET_PB) ] ,[TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) MOV(115,STEP_ALARM[9]) ] ] ,XIC(CELL_STARTED) XIC(OFFLOAD_CONV_DRV_FAULT) MOV(115,STEP_ALARM[9]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CONVEYOR MOTOR CONTROL
]]>
</Comment>
<Text>
<![CDATA[[XIC(MAN02:I.Data[4].0) ONS(ONS_ARRAY[3]) [XIC(DRV09:O.Stop) OTL(OFFLOAD_CONV_RUN_FORWARD_FAST_PB) ,XIC(DRV09:I.Active) OTU(OFFLOAD_CONV_RUN_FORWARD_FAST_PB) ] ,[EQU(STEP_ESTOP_RESET[9],1000) ,XIO(OFFLOAD_CONV_RUN_FORWARD_PB) XIO(OFFLOAD_CONV_RUN_FORWARD_FAST_PB) ] OTE(DRV09:O.Stop) ,EQU(STEP_ESTOP_RESET[9],500) [XIO(DRV09:O.Stop) [[XIC(OFFLOAD_CONV_RUN_FORWARD_PB) ,XIC(OFFLOAD_CONV_RUN_FORWARD_FAST_PB) ,XIC(MAN02:I.Data[4].0) ] ONS(ONS_ARRAY[2]) ,XIC(DRV09:O.Start) XIO(TIMER_OPER[2].DN) ] OTE(DRV09:O.Start) ,XIC(DRV09:O.Start) [XIC(DRV09:I.Active) TON(TIMER_OPER[2],?,?) ,XIC(CELL_ALARMS_ACTIVE) XIO(DRV09:I.Active) [TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(116,STEP_ALARM[9]) ] ] ] ,[AFI() OTE(DRV09:O.Forward) ,OTE(DRV09:O.Reverse) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[SET CONVEYOR SPEED
Rev 07 2014-03-24 DRB/GH Added high speed jog. DRV09 parameter 35, max freq., increased from 60 to 120Hz.]]>
</Comment>
<Text>
<![CDATA[[MUL(OFFLOAD_CONV_SPEED_HZ,100,DRV09:O.FreqCommand) ,[XIC(MAN02:I.Data[4].0) ,XIC(OFFLOAD_CONV_RUN_FORWARD_FAST_PB) ] MUL(OFFLOAD_CONV_JOG_SPEED_HZ,100,DRV09:O.FreqCommand) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[OFFLOAD CONVEYOR STATUS
***************************************************************************

AUTO READY REQUIREMENTS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[9],500)XIC(DRV07_ETHERNET_COMMS_OK)XIC(OFFLOAD_CONV_DRV_READY)XIO(OFFLOAD_CONV_DRV_FAULT)OTE(CELL_AUTO_READY[9]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
