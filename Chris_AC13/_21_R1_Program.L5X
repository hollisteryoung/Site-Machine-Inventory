<Routines>
<Routine Name="AUTO" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT (R1) ROBOT AUTO
***************************************************************************

MONITOR CELL ENTRY REQUEST]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)[[XIC(R1:I.Data[0].18) ,XIC(TIMER_OPER[8].TT) ] TON(TIMER_OPER[8],?,?) ,XIC(TIMER_OPER[8].DN) MOV(500,STEP_AUTO[21]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[REQUEST STROBE OF PROGRAM]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_STARTED)EQU(STEP_AUTO[21],0)[OTL(R1_AUTO_PNS_STROBE_REQUEST) ,MOV(20,STEP_AUTO[21]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[VERIFY PNS TO PROGRAM MATCH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[21],20)XIO(R1_AUTO_PNS_STROBE_REQUEST)[XIC(R1_PNS_MATCH) MOV(30,STEP_AUTO[21]) ,[TON(TIMER_ALARM[1],?,?) ,XIC(TIMER_ALARM[1].DN) MOV(74,STEP_ALARM[21]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[EXECUTE ROBOT PROGRAM
]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[21],30)[TON(TIMER_OPER[3],?,?) ,XIC(TIMER_OPER[3].TT) OTE(R1:O.Data[0].18) ,XIC(TIMER_OPER[3].DN) [XIC(R1:I.Data[0].13) [XIO(CELL_DRY_CYCLE_MODE_PB) MOV(0,STEP_AUTO[27]) ,MOV(499,STEP_AUTO[21]) ] ,XIO(R1:I.Data[0].13) [TON(TIMER_ALARM[3],?,?) ,XIC(TIMER_ALARM[3].DN) MOV(75,STEP_ALARM[21]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="AUTO_VIS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT (R1) ROBOT IR VISION AUTO
***************************************************************************

CHECK BAG VISION REQUESTS FROM CONVEYOR TO ROBOT]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[27],0)[XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIC(INFEED_CONV_BAG_VIS_REQ) MOV(10,STEP_AUTO[27]) ,[XIC(CELL_BARRIER_LOAD_ONLY_MODE_PB) ,XIC(CELL_BARRIER_PROD_ONLY_MODE_PB) ] MOV(20,STEP_AUTO[27]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR VISION RESULTS FROM ROBOT FOR CONVEYOR BAG]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[27],10)[XIC(R1:I.Data[1].0) MOV(15,STEP_AUTO[27]) ,XIC(R1:I.Data[1].1) MOV(30,STEP_AUTO[27]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[VERIFY ROBOT HANDSHAKE IS OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[27],15)XIO(R1:I.Data[0].20)MOV(20,STEP_AUTO[27]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[REQUEST BAG PICK TO ROBOT FROM CONVEYOR]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[27],20)[[XIO(CELL_SINGLE_PART_MODE_ACTIVE) ,XIC(CELL_SINGLE_PART_MODE_ACTIVE) XIC(CELL_SINGLE_PART_PROCESS_PB) XIO(CELL_SINGLE_PART_MODE_BAG_COUNTER.DN) ] OTE(INFEED_CONV_BAG_PICK_REQ) ,XIO(CELL_BARRIER_PROD_ONLY_MODE_PB) XIO(CELL_BARRIER_LOAD_ONLY_MODE_PB) XIC(R1:I.Data[0].20) MOV(30,STEP_AUTO[27]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[VERIFY VISION REQUEST FROM CONVEYOR IS OFF]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_AUTO[27],30)XIO(INFEED_CONV_BAG_VIS_REQ)MOV(0,STEP_AUTO[27]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[R1 VISION LIGHTS
*******************************************************************************

UV VISION LIGHT CONTROL]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[0],1000) XIO(CELL_MANUAL_MODE) GRT(R1_SNF_VIS_PROCESS_RECIPE_LOADED,20) EQU(R1_RIGID_VIS_PROCESS_RECIPE,0) [OTL(R1_UV_LIGHT_ON_PB) ,OTU(R1_RED_LIGHT_ON_PB) ] ,XIC(R1_UV_LIGHT_ON_PB) OTE(Local:2:O.Pt08.Data) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[RED VISION LIGHT CONTROL]]>
</Comment>
<Text>
<![CDATA[[NEQ(STEP_ESTOP_RESET[0],1000) XIO(CELL_MANUAL_MODE) [LES(R1_SNF_VIS_PROCESS_RECIPE_LOADED,20) ,NEQ(R1_RIGID_VIS_PROCESS_RECIPE,0) ] [OTL(R1_RED_LIGHT_ON_PB) ,OTU(R1_UV_LIGHT_ON_PB) ] ,XIC(R1_RED_LIGHT_ON_PB) OTE(Local:2:O.Pt07.Data) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESTOP_RESET" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT (R1) E-STOP RESET
***************************************************************************

ROBOT ALARM]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_KEY_AUTO_MODE) NEQ(STEP_ALARM[21],0) ,EQU(STEP_ESTOP_RESET[0],1000) ]MOV(1000,STEP_ESTOP_RESET[21]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[CAPTURE INITIAL ALARM
AND DETERMINE IF THIS IS THE PRIMARY ALARM FOR THE ENTIRE CELL]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[21],1000) EQU(STEP_ALARM_CAPTURE[21],0) MOV(STEP_ALARM[21],STEP_ALARM_CAPTURE[21]) ,LIM(900,STEP_ALARM[0],0) NEQ(STEP_ALARM_CAPTURE[21],0) EQU(STEP_ALARM_TRIGGER_WORD_1,0) OTL(STEP_ALARM_TRIGGER_WORD_1.21) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CAPTURE ROBOT FAULT ALARM AFTER RESET IS COMPLETED]]>
</Comment>
<Text>
<![CDATA[XIC(CELL_KEY_AUTO_MODE)EQU(STEP_ALARM[21],0)EQU(STEP_ESTOP_RESET[0],500)XIC(R1_FAULT)[XIO(CELL_STARTED) TON(TIMER_ALARM[5],?,?) ,[XIO(CELL_STARTED) XIC(TIMER_ALARM[5].DN) ,XIC(CELL_STARTED) ] MOV(76,STEP_ALARM[21]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[E-STOP SETTINGS]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[21],1000)[OTL(R1:O.Data[0].4) ,NEQ(STEP_ALARM[21],0) OTE(MAJOR_FAULT[21]) ,ONS(ONS_ARRAY[0]) [MOV(STEP_AUTO[21],STEP_AUTO_RET_ESTOP[21]) ,MOV(STEP_AUTO[27],STEP_AUTO_RET_ESTOP[27]) ,MOV(DRV08:O.Data[0],R1_GRIPPER_HEAD_STEP_OUT_0_VAL_FAULTED) ,MOV(DRV08:I.Data[0],R1_GRIPPER_HEAD_STEP_IN_0_VAL_FAULTED) ,MOV(DRV08:I.Data[1],R1_GRIPPER_HEAD_STEP_IN_1_VAL_FAULTED) ] ,OTU(R1:O.Data[0].24) ,OTU(R1_GRIPPER_RESET_PB) ,OTU(R1_GRIPPER_STOP_PB) ,OTU(R1_GRIPPER_HOME_PB) ,OTU(R1_GRIPPER_ENABLE_PB) ,OTU(R1_GRIPPER_PICK_PB) ,OTU(R1_GRIPPER_REL_PB) ,OTU(R1_GRIPPER_PICKING) ,OTU(R1_GRIPPER_RELEASING) ,OTU(R1_GRIPPER_CONFIG_PB) ,MOV(1000,STEP_R1_RESET) ,MOV(1000,STEP_HOME[21]) ,MOV(1000,STEP_AUTO[21]) ,MOV(1000,STEP_AUTO[27]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[21],1000)XIO(CELL_ESTOP_PRESSED)XIO(CELL_SHUTDOWN_REQ)XIC(CELL_RESET_READY)XIC(CELL_RESET_PRESSED)MOV(10,STEP_ESTOP_RESET[21]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[SETTINGS UPON RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[21],10)[OTU(R1:O.Data[0].4) ,MOV(0,STEP_ALARM[21]) ,MOV(0,STEP_ALARM_CAPTURE[21]) ,MOV(20,STEP_ESTOP_RESET[21]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO BE RELEASED
WAIT FOR CELL PRESSURE OK
RESET BASED ON MACHINE MODE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[21],20)XIO(CELL_RESET_PRESSED)XIC(CELL_PRESSURE_OK)XIO(CELL_SAFETY_DOOR_OPEN)[XIC(CELL_KEY_AUTO_MODE) [MOV(0,STEP_R1_RESET) ,MOV(0,STEP_HOME[21]) ,MOV(30,STEP_ESTOP_RESET[21]) ] ,XIC(CELL_KEY_MAN_MODE) MOV(500,STEP_ESTOP_RESET[21]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[WAIT FOR RESET TO COMPLETE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_ESTOP_RESET[21],30)EQU(STEP_HOME[21],500)MOV(500,STEP_ESTOP_RESET[21]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HMI" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT (R1) HMI
***************************************************************************

GRIPPER DRIVE PUSH BUTTONS VISIBILITY ON HMI]]>
</Comment>
<Text>
<![CDATA[[EQU(STEP_ESTOP_RESET[21],500) [XIO(CELL_STARTED) [EQU(R1_GRIPPER_COMMAND_ERROR,0) EQU(R1_GRIPPER_COMMAND_WARNING,0) OTE(R1_GRIPPER_ENABLE_PB_VIS) ,[NEQ(R1_GRIPPER_COMMAND_ERROR,0) ,NEQ(R1_GRIPPER_COMMAND_WARNING,0) ] OTE(R1_GRIPPER_RESET_PB_VIS) ] ,[[XIC(R1_GRIPPER_READY) ,XIC(DRV08_ETHERNET_COMMS_OK) NEQ(R1_GRIPPER_MODE_IN,0) ,XIC(R1_GRIPPER_HOME_PB) ] [OTE(R1_GRIPPER_PB_VIS) ,XIC(CELL_MANUAL_MODE) XIO(R1_GRIPPER_PICK_PB) XIO(R1_GRIPPER_REL_PB) OTE(R1_GRIPPER_HOME_PB_VIS) ] ,XIC(CELL_MANUAL_MODE) XIC(R1_GRIPPER_READY) XIO(R1_GRIPPER_HOME_PB) XIO(DRV08:I.Data[0].10) [XIO(R1_GRIPPER_REL_PB) [XIO(R1_GRIPPER_PICK_POS) ,XIC(R1_GRIPPER_PICKING) ] OTE(R1_GRIPPER_PICK_PB_VIS) ,XIO(R1_GRIPPER_PICK_PB) [XIO(R1_GRIPPER_REL_POS) ,XIC(R1_GRIPPER_RELEASING) ] OTE(R1_GRIPPER_REL_PB_VIS) ] ] ,XIO(CELL_STARTED) XIC(CELL_MANUAL_MODE) OTE(R1_LIGHT_VIS) ] ,XIO(CELL_STARTED) OTE(R1_OFFSET_VIS) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[HMI VISIBILITY FOR GRIPPER RELEASE CLEARANCES FOR SNF OR RIGID]]>
</Comment>
<Text>
<![CDATA[[NEQ(R1_SNF_VIS_PROCESS_RECIPE_LOADED,0) [XIC(CELL_MANUAL_MODE) OTE(R1_GRIPPER_REL_CLR_SNF_ENT_VIS) ,XIO(CELL_MANUAL_MODE) OTE(R1_GRIPPER_REL_CLR_SNF_DIS_VIS) ] ,NEQ(R1_RIGID_VIS_PROCESS_RECIPE,0) [XIC(CELL_MANUAL_MODE) OTE(R1_GRIPPER_REL_CLR_RIGID_ENT_VIS) ,XIO(CELL_MANUAL_MODE) OTE(R1_GRIPPER_REL_CLR_RIGID_DIS_VIS) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[HMI INFORMATION FOR DEBUG VISIBILITY]]>
</Comment>
<Text>
<![CDATA[XIC(R1_GRIPPER_HMI_DEBUG_VIS)OTE(R1_GRIPPER_HMI_DEBUG_VIS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HOME" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT (R1) HOME ROUTINE
***************************************************************************

STROBE ROBOT FOR PROGRAM SELECTION
ONCE ROBOT IS RESET]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[21],0)EQU(STEP_R1_RESET,500)[OTL(R1_HOME_PNS_STROBE_REQUEST) ,MOV(10,STEP_HOME[21]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[WAIT FOR PNS MATCH]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[21],10)XIO(R1_HOME_PNS_STROBE_REQUEST)[XIC(R1_PNS_MATCH) MOV(20,STEP_HOME[21]) ,[TON(TIMER_ALARM[0],?,?) ,XIC(TIMER_ALARM[0].DN) MOV(74,STEP_ALARM[21]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[SEND ROBOT HOME]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[21],20)[OTE(R1:O.Data[0].7) ,GRT(TIMER_ALARM[2].ACC,1000) XIC(R1_HOME) MOV(30,STEP_HOME[21]) ,[TON(TIMER_ALARM[2],?,?) ,XIC(TIMER_ALARM[2].DN) MOV(72,STEP_ALARM[21]) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[RESET GRIPPER IF REQUIRED]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[21],30)[NEQ(R1_GRIPPER_ERRORS,0) [ONS(ONS_ARRAY[9]) [OTU(R1_GRIPPER_ENABLE_PB) ,OTL(R1_GRIPPER_RESET_PB) ] ,XIC(R1_GRIPPER_RESET_PB) [TON(TIMER_ALARM[16],?,?) ,XIC(TIMER_ALARM[16].DN) MOV(61,STEP_ALARM[21]) ] ] ,EQU(R1_GRIPPER_ERRORS,0) XIO(R1_GRIPPER_RESET_PB) MOV(40,STEP_HOME[21]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ENABLE GRIPPER]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[21],40)[NEQ(R1_GRIPPER_MODE_IN,2) OTL(R1_GRIPPER_ENABLE_PB) ,XIC(R1_GRIPPER_READY) MOV(50,STEP_HOME[21]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[RUN GRIPPER INTERNAL HOME SEQUENCE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[21],50)XIO(R1:I.Data[1].4)XIO(R1:I.Data[1].5)[XIO(R1_GRIPPER_HOMED) ONS(ONS_ARRAY[12]) OTL(R1_GRIPPER_HOME_PB) ,XIC(R1_GRIPPER_HOMED) XIO(R1_GRIPPER_HOME_PB) MOV(60,STEP_HOME[21]) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[MOVE GRIPPER TO RELEASED POSITION]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_HOME[21],60)[OTL(R1_GRIPPER_REL_PB) ,XIC(R1_GRIPPER_REL_POS) [[OTU(R1_GRIPPER_REL_PB) ,OTU(R1_GRIPPER_RELEASING) ] ,XIO(R1_GRIPPER_REL_PB) [MOV(0,STEP_AUTO[21]) ,MOV(500,STEP_HOME[21]) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MAIN" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MAIN ROUTINE
***************************************************************************

]]>
</Comment>
<Text>
<![CDATA[[JSR(ESTOP_RESET,0) ,JSR(POSITION_MONITOR,0) ,JSR(RESET_STATUS,0) ,JSR(PROG_SELECT,0) ,JSR(HOME,0) ,JSR(AUTO,0) ,JSR(AUTO_VIS,0) ,JSR(HMI,0) ,JSR(STEPPER_CONTROL,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="POSITION_MONITOR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[POSITION MONITOR BAG LOAD ROBOT (R1)
***************************************************************************

POSITION VERIFICATION]]>
</Comment>
<Text>
<![CDATA[EQU(R1_GRIPPER_MODE_IN,2)[[SUB(R1_GRIPPER_PICK_TARGET_POS,GRIPPER_POS_TOL,GRIPPER_POS_PICK_LOWER) ADD(R1_GRIPPER_PICK_TARGET_POS,GRIPPER_POS_TOL,GRIPPER_POS_PICK_UPPER) ,LIM(GRIPPER_POS_PICK_LOWER,R1_GRIPPER_POSITION_INPUT,GRIPPER_POS_PICK_UPPER) OTE(R1_GRIPPER_PICK_POS) ] ,[SUB(R1_GRIPPER_REL_TARGET_POS,GRIPPER_POS_TOL,GRIPPER_DRV_POS_REL_LOWER) ADD(R1_GRIPPER_REL_TARGET_POS,GRIPPER_POS_TOL,GRIPPER_DRV_POS_REL_UPPER) ,LIM(GRIPPER_DRV_POS_REL_LOWER,R1_GRIPPER_POSITION_INPUT,GRIPPER_DRV_POS_REL_UPPER) OTE(R1_GRIPPER_REL_POS) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PROG_SELECT" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT (R1) PROGRAM SELECT
*******************************************************************************

BROADCAST THE PROGRAM NUMBER
TO BE RUN TO THE ROBOT]]>
</Comment>
<Text>
<![CDATA[[XIO(CELL_DRY_CYCLE_MODE_PB) MOV(1,R1_PROG_NUM_FROM_PLC) ,XIC(CELL_DRY_CYCLE_MODE_PB) MOV(2,R1_PROG_NUM_FROM_PLC) ,BTD(R1_PROG_NUM_FROM_PLC,0,R1:O.Data[0],9,7) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[STORE THE PROGRAM NUMBER CURRENTLY
SELECTED IN THE ROBOT
]]>
</Comment>
<Text>
<![CDATA[MVM(R1:I.Data[0],127,R1_PROG_NUM_TO_PLC);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[VERIFY PROGRAM NUMBER TO BE RUN
MATCHES ROBOT SELECTED PROGRAM]]>
</Comment>
<Text>
<![CDATA[NEQ(R1_PROG_NUM_TO_PLC,0)EQU(R1_PROG_NUM_TO_PLC,R1_PROG_NUM_FROM_PLC)OTE(R1_PNS_MATCH);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[STROBE PNS ON
ROBOT]]>
</Comment>
<Text>
<![CDATA[[XIC(R1_HOME_PNS_STROBE_REQUEST) ,XIC(R1_AUTO_PNS_STROBE_REQUEST) ][TON(TIMER_OPER[0],?,?) ,OTE(R1:O.Data[0].17) ,XIC(TIMER_OPER[0].DN) [OTU(R1_HOME_PNS_STROBE_REQUEST) ,OTU(R1_AUTO_PNS_STROBE_REQUEST) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="RESET_STATUS" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT (R1) RESET AND STATUS
*********************************************************************************

SEND THE RIGID INSERT SIZE VISION PROCESS
TO BE RUN  BY THE ROBOT
1 = A,B,C,D
2 = E
3 = F,G,H
4 = I
5 = J,K,L]]>
</Comment>
<Text>
<![CDATA[[XIC(R1_RIGID_VIS_PROCESS_RECIPE.0) OTE(R1:O.Data[1].22) ,XIC(R1_RIGID_VIS_PROCESS_RECIPE.1) OTE(R1:O.Data[1].23) ,XIC(R1_RIGID_VIS_PROCESS_RECIPE.2) OTE(R1:O.Data[1].24) ,XIC(R1_RIGID_VIS_PROCESS_RECIPE.3) OTE(R1:O.Data[1].25) ,XIC(R1_RIGID_VIS_PROCESS_RECIPE.4) OTE(R1:O.Data[1].26) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SEND THE SOFT-N-FLEXIBLE VISION PROCESS
TO BE RUN  BY THE ROBOT
6 = CLOSED 35-45MM
7 = DRAINABLE 25-30MM
8 = DRAINABLE 35-45MM
9 = DRAINABLE 50-60MM
10 = CLOSED 50-60MM
]]>
</Comment>
<Text>
<![CDATA[[XIC(R1_SNF_VIS_PROCESS_RECIPE_LOADED.0) OTE(R1:O.Data[1].14) ,XIC(R1_SNF_VIS_PROCESS_RECIPE_LOADED.1) OTE(R1:O.Data[1].15) ,XIC(R1_SNF_VIS_PROCESS_RECIPE_LOADED.2) OTE(R1:O.Data[1].16) ,XIC(R1_SNF_VIS_PROCESS_RECIPE_LOADED.3) OTE(R1:O.Data[1].17) ,XIC(R1_SNF_VIS_PROCESS_RECIPE_LOADED.4) OTE(R1:O.Data[1].18) ,XIC(R1_SNF_VIS_PROCESS_RECIPE_LOADED.5) OTE(R1:O.Data[1].19) ,XIC(R1_SNF_VIS_PROCESS_RECIPE_LOADED.6) OTE(R1:O.Data[1].20) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[SEND THE ROBOT LOADING BAG TYPE FROM THE RECIPE
TO BE RUN  BY THE ROBOT
(USED TO DETERMINE PATH FOR LOADING ON MAIN DIAL)
1 = DRAINABLE]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_BAG_TYPE_RECIPE_LOADED.0) OTE(R1:O.Data[1].27) ,XIC(CELL_BAG_TYPE_RECIPE_LOADED.1) OTE(R1:O.Data[1].28) ,XIC(CELL_BAG_TYPE_RECIPE_LOADED.2) OTE(R1:O.Data[1].29) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[SEND THE BAG PLACEMENT ON THE MAIN DIAL OFFSET VALUE TO THE BAG LOAD ROBOT (R1)

ADJUSTMENTS ARE LOCATED ON THE HMI SCREEN FOR THE BAG LOAD ROBOT (R1)]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) [MOV(0,R1_BAG_X_POS_OFFSET_PB) ,MOV(0,R1_BAG_Y_POS_OFFSET_PB) ] ,[[LES(R1_BAG_X_POS_OFFSET_PB,0) OTE(R1:O.Data[2].6) ,ABS(R1_BAG_X_POS_OFFSET_PB,R1_BAG_X_POS_OFFSET_ABS) [XIC(METRIC_MACHINE) MUL(R1_BAG_X_POS_OFFSET_ABS,10,R1_BAG_X_POS_OFFSET_SCALED) ,XIO(METRIC_MACHINE) MUL(R1_BAG_X_POS_OFFSET_ABS,254,R1_BAG_X_POS_OFFSET_SCALED) ] BTD(R1_BAG_X_POS_OFFSET_SCALED,0,R1:O.Data[2],0,6) ] ,LES(R1_BAG_Y_POS_OFFSET_PB,0) OTE(R1:O.Data[2].13) ,ABS(R1_BAG_Y_POS_OFFSET_PB,R1_BAG_Y_POS_OFFSET_ABS) [XIC(METRIC_MACHINE) MUL(R1_BAG_Y_POS_OFFSET_ABS,10,R1_BAG_Y_POS_OFFSET_SCALED) ,XIO(METRIC_MACHINE) MUL(R1_BAG_Y_POS_OFFSET_ABS,254,R1_BAG_Y_POS_OFFSET_SCALED) ] BTD(R1_BAG_Y_POS_OFFSET_SCALED,0,R1:O.Data[2],7,6) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[SEND THE BAG PICK FROM CONVEYOR OFFSET VALUE TO THE BAG LOAD ROBOT (R1)

ADJUSTMENTS ARE LOCATED ON THE HMI SCREEN FOR THE BAG LOAD ROBOT (R1)]]>
</Comment>
<Text>
<![CDATA[[XIC(CELL_RECIPE_DOWNLOAD_DETECTED) [MOV(0,R1_BAG_X_PICK_OFFSET_PB) ,MOV(0,R1_BAG_Y_PICK_OFFSET_PB) ,MOV(0,R1_BAG_R_PICK_OFFSET_PB) ] ,[[LES(R1_BAG_X_PICK_OFFSET_PB,0) OTE(R1:O.Data[2].20) ,ABS(R1_BAG_X_PICK_OFFSET_PB,R1_BAG_X_PICK_OFFSET_ABS) [XIC(METRIC_MACHINE) MUL(R1_BAG_X_PICK_OFFSET_ABS,10,R1_BAG_X_PICK_OFFSET_SCALED) ,XIO(METRIC_MACHINE) MUL(R1_BAG_X_PICK_OFFSET_ABS,0.3937007874,R1_BAG_X_PICK_OFFSET_SCALED) ] BTD(R1_BAG_X_PICK_OFFSET_SCALED,0,R1:O.Data[2],14,6) ] ,[LES(R1_BAG_Y_PICK_OFFSET_PB,0) OTE(R1:O.Data[2].27) ,ABS(R1_BAG_Y_PICK_OFFSET_PB,R1_BAG_Y_PICK_OFFSET_ABS) [XIC(METRIC_MACHINE) MUL(R1_BAG_Y_PICK_OFFSET_ABS,10,R1_BAG_Y_PICK_OFFSET_SCALED) ,XIO(METRIC_MACHINE) MUL(R1_BAG_Y_PICK_OFFSET_ABS,0.3937007874,R1_BAG_Y_PICK_OFFSET_SCALED) ] BTD(R1_BAG_Y_PICK_OFFSET_SCALED,0,R1:O.Data[2],21,6) ] ,[LES(R1_BAG_R_PICK_OFFSET_PB,0) OTE(R1:O.Data[1].11) ,ABS(R1_BAG_R_PICK_OFFSET_PB,R1_BAG_R_PICK_OFFSET_ABS) MUL(R1_BAG_R_PICK_OFFSET_ABS,10,R1_BAG_R_PICK_OFFSET_SCALED) BTD(R1_BAG_R_PICK_OFFSET_SCALED,0,R1:O.Data[1],5,6) ] ,[LES(R1_Z_OFFSET_RECIPE,0) OTE(R1:O.Data[2].31) ,ABS(R1_Z_OFFSET_RECIPE,R1_BAG_Z_OFFSET_ABS) [XIC(METRIC_MACHINE) MUL(R1_BAG_Z_OFFSET_ABS,10,R1_BAG_Z_OFFSET_SCALED) ,XIO(METRIC_MACHINE) MUL(R1_BAG_Z_OFFSET_ABS,0.3937007874,R1_BAG_Z_OFFSET_SCALED) ] BTD(R1_BAG_Z_OFFSET_SCALED,0,R1:O.Data[3],0,6) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ROBOT DIGITAL INPUTS]]>
</Comment>
<Text>
<![CDATA[[XIC(INFEED_CONV_BAG_PICK_REQ) OTE(R1:O.Data[0].20) ,XIC(R1_GRIPPER_PICK_POS) OTE(R1:O.Data[0].21) ,XIC(R1_GRIPPER_REL_POS) OTE(R1:O.Data[0].22) ,XIC(BAG_LOAD_REQ) OTE(R1:O.Data[0].23) ,XIC(CELL_INSERT_LOAD_ONLY_MODE_PB) OTE(R1:O.Data[0].25) ,XIC(INFEED_CONV_BAG_VIS_REQ) OTE(R1:O.Data[0].26) ,XIC(BAG_LOAD_REL_CYL_RET) OTE(R1:O.Data[1].4) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[ROBOT STATUS]]>
</Comment>
<Text>
<![CDATA[XIC(R1_IMSTD_ON)XIC(R1_HOLD_OFF)XIC(R1_SFSPD_ON)XIO(R1_FAULT)XIC(R1_ENABLE)XIC(R1_COMMAND_ENABLE)OTE(R1_IO_READY);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(CELL_KEY_AUTO_MODE)XIC(A:I.Data[9].4)XIO(R1_TP_ENABLE)XIC(R1_AUTO_SWITCH)XIO(R1_INPUTS_SIMULATED)OTE(R1_AUTO_MODE);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(R1_IO_READY)XIC(R1_AUTO_MODE)XIC(R1_PNS_MATCH)XIC(R1_HOME)XIC(R1_GRIPPER_REL_POS)OTE(CELL_AUTO_READY[21]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[OTE(R1_IMSTD_ON) ,[XIO(R1_AUTO_MODE) ,XIC(R1_AUTO_MODE) XIO(R1:O.Data[0].4) ] OTE(R1_HOLD_OFF) ,OTE(R1_SFSPD_ON) ,OTE(R1_ENABLE) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[RESET ROBOT ROUTINE]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_R1_RESET,0)XIC(R1_AUTO_MODE)[XIC(TIMER_OPER[2].TT) OTE(R1:O.Data[0].5) ,TON(TIMER_OPER[2],?,?) ,XIC(TIMER_OPER[2].DN) [XIO(R1_FAULT) MOV(10,STEP_R1_RESET) ,XIC(R1_FAULT) [TON(TIMER_ALARM[4],?,?) ,XIC(TIMER_ALARM[4].DN) MOV(73,STEP_ALARM[21]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[CSTOP COMMAND TO ABORT ALL CURRENT PROGRAMS RUNNING]]>
</Comment>
<Text>
<![CDATA[EQU(STEP_R1_RESET,10)XIO(R1_FAULT)[TON(TIMER_OPER[1],?,?) ,XIC(TIMER_OPER[1].TT) OTL(R1:O.Data[0].4) ,XIC(TIMER_OPER[1].DN) [OTU(R1:O.Data[0].4) ,MOV(500,STEP_R1_RESET) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="STEPPER_CONTROL" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[BAG LOAD ROBOT GRIPPER STEPPER CONTROL
******************************************************************************

RESET STEPPER MOTOR]]>
</Comment>
<Text>
<![CDATA[XIO(DRV08:I.Data[0].15)XIC(R1_GRIPPER_RESET_PB)[[NEQ(R1_GRIPPER_COMMAND_ERROR,0) ,NEQ(R1_GRIPPER_COMMAND_WARNING,0) ] ONS(ONS_ARRAY[18]) OTU(R1_GRIPPER_ENABLE_PB) ,EQU(R1_GRIPPER_COMMAND_WARNING,0) EQU(R1_GRIPPER_COMMAND_ERROR,0) [MOV(0,R1_GRIPPER_COMMAND_WORD) ,EQU(R1_GRIPPER_COMMAND_WORD,0) OTL(R1_GRIPPER_ENABLE_PB) ,EQU(R1_GRIPPER_COMMAND_WORD,0) EQU(R1_GRIPPER_MODE_IN,2) OTU(R1_GRIPPER_RESET_PB) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[DISABLE/ENABLE STEPPER MOTOR]]>
</Comment>
<Text>
<![CDATA[[XIO(R1_GRIPPER_ENABLE_PB) NEQ(R1_GRIPPER_MODE_OUT,0) MOV(0,R1_GRIPPER_MODE_OUT) ,XIC(R1_GRIPPER_ENABLE_PB) XIO(R1_GRIPPER_HOME_PB) [ONS(ONS_ARRAY[22]) MOV(DRV08:I.Data[5],DRV08:O.Data[1]) MOV(2,R1_GRIPPER_MODE_OUT) ,[NEQ(R1_GRIPPER_MODE_IN,2) TON(TIMER_ALARM[9],?,?) ,XIC(TIMER_ALARM[9].DN) MOV(60,STEP_ALARM[21]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[R1 GRIPPER HOME]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[21],1000)XIC(R1_GRIPPER_HOME_PB)[EQU(R1_GRIPPER_ERRORS,0) [ONS(ONS_ARRAY[29]) CPS(R1_GRIPPER_HOME_PARAM[0],DRV08:O.Data[0],8) ,TON(TIMER_OPER[5],?,?) XIC(TIMER_OPER[5].DN) XIC(R1_GRIPPER_HOMED) ONS(ONS_ARRAY[10]) [MOV(2,R1_GRIPPER_MODE_OUT) MOV(R1_GRIPPER_HOME_OFFSET,R1_GRIPPER_POS_REQ) ,OTU(R1_GRIPPER_HOME_PB) ,OTU(R1_GRIPPER_ERROR_LATCH) ] ,XIO(R1_GRIPPER_HOMED) [TON(TIMER_ALARM[6],?,?) ,XIC(TIMER_ALARM[6].DN) MOV(57,STEP_ALARM[21]) ] ] ,NEQ(R1_GRIPPER_ERRORS,0) OTU(R1_GRIPPER_HOME_PB) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[BAG GRIPPER PICK]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[21],1000)EQU(R1_GRIPPER_MODE_IN,2)EQU(R1_GRIPPER_ERRORS,0)[XIO(CELL_MANUAL_MODE) [XIC(R1:I.Data[1].5) XIO(R1_GRIPPER_HOME_PB) XIO(R1_GRIPPER_REL_PB) XIO(R1_GRIPPER_RELEASING) XIO(R1_GRIPPER_PICK_POS) ONS(ONS_ARRAY[4]) OTL(R1_GRIPPER_PICK_PB) ,XIO(R1:I.Data[1].5) ONS(ONS_ARRAY[5]) OTU(R1_GRIPPER_PICK_PB) ] ,XIC(R1_GRIPPER_PICK_PB) XIO(R1_GRIPPER_HOME_PB) XIO(R1_GRIPPER_REL_PB) [ONS(ONS_ARRAY[3]) MOV(R1_GRIPPER_PICK_TARGET_POS,R1_GRIPPER_PICK_PARAM[1]) ,EQU(R1_GRIPPER_PICK_PARAM[1],R1_GRIPPER_PICK_TARGET_POS) CPS(R1_GRIPPER_PICK_PARAM[0],DRV08:O.Data[0],8) ,XIO(R1_GRIPPER_STOPPED) OTL(R1_GRIPPER_PICKING) ,[XIC(R1_GRIPPER_PICKING) ,XIC(R1_GRIPPER_STOPPED) ] XIC(R1_GRIPPER_PICK_POS) XIC(R1_GRIPPER_IN_POSITION) [OTU(R1_GRIPPER_PICK_PB) ,OTU(R1_GRIPPER_PICKING) ] ,XIC(CELL_ALARMS_ACTIVE) XIO(R1_GRIPPER_PICK_POS) [TON(TIMER_ALARM[7],?,?) ,XIC(TIMER_ALARM[7].DN) [OTU(R1_GRIPPER_PICKING) ,MOV(58,STEP_ALARM[21]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[ BAG GRIPPER RELEASE]]>
</Comment>
<Text>
<![CDATA[NEQ(STEP_ESTOP_RESET[21],1000)EQU(R1_GRIPPER_MODE_IN,2)EQU(R1_GRIPPER_ERRORS,0)[XIO(CELL_MANUAL_MODE) [XIC(R1:I.Data[1].4) XIO(R1_GRIPPER_HOME_PB) XIO(R1_GRIPPER_PICK_PB) XIO(R1_GRIPPER_PICKING) XIO(R1_GRIPPER_REL_POS) ONS(ONS_ARRAY[6]) OTL(R1_GRIPPER_REL_PB) ,XIO(R1:I.Data[1].4) ONS(ONS_ARRAY[7]) OTU(R1_GRIPPER_REL_PB) ] ,XIC(R1_GRIPPER_REL_PB) XIO(R1_GRIPPER_HOME_PB) XIO(R1_GRIPPER_PICK_PB) [ONS(ONS_ARRAY[30]) MOV(R1_GRIPPER_REL_TARGET_POS,R1_GRIPPER_REL_PARAM[1]) ,XIO(R1_GRIPPER_STOPPED) OTL(R1_GRIPPER_RELEASING) ,[XIC(R1_GRIPPER_RELEASING) ,XIC(R1_GRIPPER_STOPPED) ] XIC(R1_GRIPPER_REL_POS) XIC(R1_GRIPPER_IN_POSITION) [OTU(R1_GRIPPER_REL_PB) ,OTU(R1_GRIPPER_RELEASING) ] ,EQU(R1_GRIPPER_REL_TARGET_POS,R1_GRIPPER_REL_PARAM[1]) CPS(R1_GRIPPER_REL_PARAM[0],DRV08:O.Data[0],8) ,XIC(CELL_ALARMS_ACTIVE) XIO(R1_GRIPPER_REL_POS) [TON(TIMER_ALARM[8],?,?) ,XIC(TIMER_ALARM[8].DN) [OTU(R1_GRIPPER_REL_PB) ,OTU(R1_GRIPPER_RELEASING) ,MOV(64,STEP_ALARM[21]) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[BAG STEPPER GRIPPER PICK DIAMETER CALCULATIONS
****************************************************************************

CALCULATE CENTER DISTANCE BETWEEN DRIVE GEAR AND JAW GRIP PIN BASED ON CURRENT RECIPE PICK DIAMETER]]>
</Comment>
<Text>
<![CDATA[[XIC(METRIC_MACHINE) DIV(R1_GRIPPER_DIA_RECIPE_MM,25.4,R1_GRIPPER_DIA_RECIPE_IN) ,CPT(GRIPPER_DRV_JAW_PIN_CD_PICK,(R1_GRIPPER_DIA_RECIPE_IN-GRIPPER_JAW_PIN_DIA)/2) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[CALCULATE TOTAL OPEN ANGLE OF GRIPPER JAW]]>
</Comment>
<Text>
<![CDATA[[CPT(GRIPPER_JAW_TOT_PICK_ANGLE_RAD,ACS((GRIPPER_DRV_JAW_PIN_CD_PICK**2-(GRIPPER_JAW_PIVOT_RAD**2)-(CELL_PAR[CELL_ID_NUM].R1_GRIP_PAR.GRIP_DRIVE_PLANET_CD**2))/(-2*GRIPPER_JAW_PIVOT_RAD*CELL_PAR[CELL_ID_NUM].R1_GRIP_PAR.GRIP_DRIVE_PLANET_CD))) ,CPT(GRIPPER_JAW_TOT_PICK_ANGLE_DEG,GRIPPER_JAW_TOT_PICK_ANGLE_RAD*180/(22/7)) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[CALCULATE AMOUNT OF ANGLE TO OPEN THE GRIPPER
AND THE ASSOCIATED MOTOR COUNTS]]>
</Comment>
<Text>
<![CDATA[[SUB(GRIPPER_JAW_TOT_PICK_ANGLE_DEG,CELL_PAR[CELL_ID_NUM].R1_GRIP_PAR.GRIP_JAW_INIT_ANGLE,GRIPPER_DRV_DELTA_OUT_PICK_ANGLE) ,DIV(GRIPPER_DRV_DELTA_OUT_PICK_ANGLE,GRIPPER_OUTPUT_RATIO,GRIPPER_DRV_DELTA_IN_PICK_ANGLE) ,CPT(R1_GRIPPER_PICK_TARGET_POS,GRIPPER_DRV_DELTA_IN_PICK_ANGLE/360*R1_GRIPPER_STEP_CNT_TURN) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[BAG STEPPER GRIPPER DIAMETER RELEASED CALCULATIONS
*******************************************************************************

CALCULATE CENTER DISTANCE BETWEEN DRIVE GEAR AND JAW GRIP PIN]]>
</Comment>
<Text>
<![CDATA[[NEQ(R1_RIGID_VIS_PROCESS_RECIPE,0) [XIC(METRIC_MACHINE) DIV(R1_GRIPPER_DIA_DELTA_RIGID_MM,25.4,R1_GRIPPER_DIA_DELTA_RIGID_IN) ,XIO(METRIC_MACHINE) ] SUB(R1_GRIPPER_DIA_RECIPE_IN,R1_GRIPPER_DIA_DELTA_RIGID_IN,R1_GRIPPER_DIA_REL_IN) ,NEQ(R1_SNF_VIS_PROCESS_RECIPE_LOADED,0) [XIC(METRIC_MACHINE) DIV(R1_GRIPPER_DIA_DELTA_SNF_MM,25.4,R1_GRIPPER_DIA_DELTA_SNF_IN) ,XIO(METRIC_MACHINE) ] SUB(R1_GRIPPER_DIA_RECIPE_IN,R1_GRIPPER_DIA_DELTA_SNF_IN,R1_GRIPPER_DIA_REL_IN) ,LES(R1_GRIPPER_DIA_REL_IN,R1_GRIPPER_DIA_MIN) MOV(R1_GRIPPER_DIA_MIN,R1_GRIPPER_DIA_REL_IN) ,XIC(METRIC_MACHINE) MUL(R1_GRIPPER_DIA_REL_IN,25.4,R1_GRIPPER_DIA_REL_MM) ,CPT(GRIPPER_DRV_JAW_PIN_CD_REL,(R1_GRIPPER_DIA_REL_IN-GRIPPER_JAW_PIN_DIA)/2) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CALCULATE TOTAL OPEN ANGLE OF GRIPPER JAW]]>
</Comment>
<Text>
<![CDATA[[CPT(GRIPPER_JAW_TOT_REL_ANGLE_RAD,ACS((GRIPPER_DRV_JAW_PIN_CD_REL**2-(GRIPPER_JAW_PIVOT_RAD**2)-(CELL_PAR[CELL_ID_NUM].R1_GRIP_PAR.GRIP_DRIVE_PLANET_CD**2))/(-2*GRIPPER_JAW_PIVOT_RAD*CELL_PAR[CELL_ID_NUM].R1_GRIP_PAR.GRIP_DRIVE_PLANET_CD))) ,CPT(GRIPPER_JAW_TOT_REL_ANGLE_DEG,GRIPPER_JAW_TOT_REL_ANGLE_RAD*180/(22/7)) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[CALCULATE AMOUNT OF ANGLE TO OPEN THE GRIPPER
AND THE ASSOCIATED MOTOR COUNTS]]>
</Comment>
<Text>
<![CDATA[[SUB(GRIPPER_JAW_TOT_REL_ANGLE_DEG,CELL_PAR[CELL_ID_NUM].R1_GRIP_PAR.GRIP_JAW_INIT_ANGLE,GRIPPER_DRV_DELTA_OUT_REL_ANGLE) ,DIV(GRIPPER_DRV_DELTA_OUT_REL_ANGLE,GRIPPER_OUTPUT_RATIO,GRIPPER_DRV_DELTA_IN_REL_ANGLE) ,CPT(R1_GRIPPER_REL_TARGET_POS,GRIPPER_DRV_DELTA_IN_REL_ANGLE/360*R1_GRIPPER_STEP_CNT_TURN) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[***********STEPPER MOTOR PARAMETERS**********

BUILD STEPPER MOTOR VELOCITY FROM PANELVIEW]]>
</Comment>
<Text>
<![CDATA[[MUL(R1_GRIPPER_FWD_SPEED_PB,100,R1_GRIPPER_PICK_PARAM[2]) ,MUL(R1_GRIPPER_FWD_SPEED_PB,100,R1_GRIPPER_REL_PARAM[2]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[R1 GRIPPER STOPPED STATUS]]>
</Comment>
<Text>
<![CDATA[XIO(DRV08:I.Data[4].3)XIO(DRV08:I.Data[4].5)XIO(DRV08:I.Data[4].6)OTE(R1_GRIPPER_STOPPED);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[R1 GRIPPER READY STATUS]]>
</Comment>
<Text>
<![CDATA[NEQ(R1_GRIPPER_MODE_IN,0)[XIC(R1_GRIPPER_HOMED) ,XIO(R1_GRIPPER_HOMED) XIC(R1_GRIPPER_HOME_PB) ,XIC(DRV08_ETHERNET_COMMS_OK) ]XIO(R1_GRIPPER_ERROR_LATCH)OTE(R1_GRIPPER_READY);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[R1 GRIPPER ERROR STATUS]]>
</Comment>
<Text>
<![CDATA[[XIC(DRV08:I.Data[3].1) ,XIC(DRV08:I.Data[3].8) ,XIC(DRV08:I.Data[3].9) ,XIC(DRV08:I.Data[3].14) ]OTL(R1_GRIPPER_ERROR_LATCH);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
